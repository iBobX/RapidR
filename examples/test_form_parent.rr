' test_form_parent.rr — nested form-in-form via parent= (web only for now)
' Form2 is created as a child of Form1, appearing inside Form1's client area.

$APPTYPE GUI

CREATE Form1 AS RFORM
    Caption = "Parent form"
    Width = 600
    Height = 420
    Left = 80
    Top = 80
END CREATE

CREATE Form2 AS RFORM
    Parent = "Form1"
    Caption = "Nested child form"
    Width = 320
    Height = 220
    Left = 60
    Top = 60
    CREATE Lbl AS RLABEL
        Caption = "I am inside Form1!"
        Left = 20
        Top = 60
        Width = 280
        Height = 24
    END CREATE
END CREATE

Form1.ShowModal()
