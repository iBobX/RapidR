' ============================================================
' DESIGN SURFACE EVENT HANDLERS
' ============================================================

SUB DesignSelect(Index AS INTEGER)
    SaveEvents
    SelIndex = Index + 1
    UpdateObjCombo
    FillProperties
    FillEvents
    DIM CN AS STRING
    CN = DesignSurface.GetName(Index)
    DIM CT AS STRING
    CT = DesignSurface.GetType(Index)
    StatusBar.Caption = CT + ": " + CN + " selected"
END SUB

SUB DesignMove(Index AS INTEGER, X AS INTEGER, Y AS INTEGER, W AS INTEGER, H AS INTEGER)
    IF SyncGuard = 1 THEN EXIT SUB
    SyncGuard = 1
    CodeDirty = 1
    IF SelIndex = Index + 1 THEN
        FillProperties
    END IF
    SyncGuard = 0
END SUB

SUB DesignDblClick(Index AS INTEGER)
    ' Save current events before switching to code view
    SaveEvents

    ' Update selection to this widget
    SelIndex = Index + 1

    DIM CN AS STRING
    DIM CT AS STRING
    CN = DesignSurface.GetName(Index)
    CT = DesignSurface.GetType(Index)
    DIM DefEvt AS STRING
    DefEvt = GetDefaultEvent(CT)
    DIM HandlerName AS STRING
    HandlerName = CN + "_" + DefEvt

    DIM CI AS INTEGER
    CI = Index + 1

    ' Only set the default event if not already set
    IF UCASE$(DefEvt) = "ONCLICK" AND EvtOnClick(CI) = "" THEN EvtOnClick(CI) = HandlerName
    IF UCASE$(DefEvt) = "ONCHANGE" AND EvtOnChange(CI) = "" THEN EvtOnChange(CI) = HandlerName
    IF UCASE$(DefEvt) = "ONTIMER" AND EvtOnTimer(CI) = "" THEN EvtOnTimer(CI) = HandlerName
    IF UCASE$(DefEvt) = "ONPAINT" AND EvtOnPaint(CI) = "" THEN EvtOnPaint(CI) = HandlerName
    IF UCASE$(DefEvt) = "ONQUERYDONE" AND EvtOnQueryDone(CI) = "" THEN EvtOnQueryDone(CI) = HandlerName

    ' Use the existing handler name if one was already set
    IF UCASE$(DefEvt) = "ONCLICK" AND EvtOnClick(CI) <> "" THEN HandlerName = EvtOnClick(CI)
    IF UCASE$(DefEvt) = "ONCHANGE" AND EvtOnChange(CI) <> "" THEN HandlerName = EvtOnChange(CI)
    IF UCASE$(DefEvt) = "ONTIMER" AND EvtOnTimer(CI) <> "" THEN HandlerName = EvtOnTimer(CI)
    IF UCASE$(DefEvt) = "ONPAINT" AND EvtOnPaint(CI) <> "" THEN HandlerName = EvtOnPaint(CI)
    IF UCASE$(DefEvt) = "ONQUERYDONE" AND EvtOnQueryDone(CI) <> "" THEN HandlerName = EvtOnQueryDone(CI)

    GenerateCode
    CodeDirty = 0
    DIM Code AS STRING
    Code = CodeEditor.Text
    Code = GenerateSubCode(Code, HandlerName, CN, DefEvt, GetEventCodeBody(CI, DefEvt))
    CodeEditor.Text = Code

    IF ShowingCode = 0 THEN
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
        BtnCode.Caption = "< Design"
    END IF

    CodeEditor.GotoSub(HandlerName)
    FillEvents
    StatusBar.Caption = "Editing: SUB " + HandlerName
END SUB

SUB DesignBgClick(X AS INTEGER, Y AS INTEGER)
    SaveEvents
    IF CurrentTool <> "" THEN
        CodeDirty = 1
        DIM CompName AS STRING
        CompName = GenerateCompName(CurrentTool)
        DIM CW AS INTEGER
        DIM CH AS INTEGER
        CW = DefaultWidth(CurrentTool)
        CH = DefaultHeight(CurrentTool)
        DIM SX AS INTEGER
        DIM SY AS INTEGER
        SX = SnapToGrid(X)
        SY = SnapToGrid(Y)

        DesignSurface.AddComponent(CurrentTool, CompName, SX, SY, CW, CH)

        IF CurrentTool = "RBUTTON" OR CurrentTool = "RLABEL" OR CurrentTool = "RCHECKBOX" OR CurrentTool = "RRADIOBUTTON" OR CurrentTool = "RCOOLBTN" OR CurrentTool = "ROVALBTN" THEN
            DIM NewIdx AS INTEGER
            NewIdx = DesignSurface.CompCount - 1
            DesignSurface.SetProp(NewIdx, "caption", CompName)
        END IF
        IF CurrentTool = "RGROUPBOX" THEN
            DesignSurface.SetProp(DesignSurface.CompCount - 1, "caption", CompName)
        END IF
        IF CurrentTool = "RTIMER" THEN
            DesignSurface.SetProp(DesignSurface.CompCount - 1, "interval", "1000")
            DesignSurface.SetProp(DesignSurface.CompCount - 1, "enabled", "True")
        END IF

        SelIndex = DesignSurface.CompCount
        DesignSurface.SelectComp(DesignSurface.CompCount - 1)
        StatusBar.Caption = "Placed " + CurrentTool + ": " + CompName
        CurrentTool = ""
        UpdateObjCombo
        UpdateProjectTree
        FillProperties
        FillEvents
    ELSE
        SelIndex = 0
        UpdateObjCombo
        FillProperties
        FillEvents
        StatusBar.Caption = "Form1 selected"
    END IF
END SUB

' ============================================================
' PROPERTY GRID CHANGE HANDLER
' ============================================================

SUB PropGridChange
    IF SyncGuard = 1 THEN EXIT SUB
    SyncGuard = 1
    CodeDirty = 1

    DIM R AS INTEGER
    DIM PropName AS STRING
    DIM PropVal AS STRING
    R = PropGrid.SelectedRow
    IF R < 1 THEN SyncGuard = 0 : EXIT SUB
    PropName = UCASE$(PropGrid.Cell(R, 0))
    PropVal = PropGrid.Cell(R, 1)

    IF SelIndex = 0 THEN
        IF PropName = "CAPTION" THEN DesignSurface.FormCaption = PropVal
        IF PropName = "WIDTH" THEN DesignSurface.Width = VAL(PropVal)
        IF PropName = "HEIGHT" THEN DesignSurface.Height = VAL(PropVal)
    ELSE
        DIM CI AS INTEGER
        CI = SelIndex - 1

        IF PropName = "(NAME)" THEN
            DesignSurface.SetName(CI, PropVal)
            UpdateObjCombo
            UpdateProjectTree
        ELSEIF PropName = "LEFT" THEN
            DesignSurface.SetCompBounds(CI, VAL(PropVal), DesignSurface.GetCompY(CI), DesignSurface.GetCompW(CI), DesignSurface.GetCompH(CI))
        ELSEIF PropName = "TOP" THEN
            DesignSurface.SetCompBounds(CI, DesignSurface.GetCompX(CI), VAL(PropVal), DesignSurface.GetCompW(CI), DesignSurface.GetCompH(CI))
        ELSEIF PropName = "WIDTH" THEN
            DesignSurface.SetCompBounds(CI, DesignSurface.GetCompX(CI), DesignSurface.GetCompY(CI), VAL(PropVal), DesignSurface.GetCompH(CI))
        ELSEIF PropName = "HEIGHT" THEN
            DesignSurface.SetCompBounds(CI, DesignSurface.GetCompX(CI), DesignSurface.GetCompY(CI), DesignSurface.GetCompW(CI), VAL(PropVal))
        ELSE
            DesignSurface.SetProp(CI, LCASE$(PropName), PropVal)
        END IF
    END IF

    SyncGuard = 0
END SUB

' Property grid double-click — opens pickers for color/font, toggles booleans
SUB PropGridDblClick
    IF SyncGuard = 1 THEN EXIT SUB
    SyncGuard = 1
    CodeDirty = 1

    DIM R AS INTEGER
    DIM PropName AS STRING
    DIM PropVal AS STRING
    R = PropGrid.SelectedRow
    IF R < 1 THEN SyncGuard = 0 : EXIT SUB
    PropName = UCASE$(PropGrid.Cell(R, 0))
    PropVal = PropGrid.Cell(R, 1)

    IF SelIndex = 0 THEN
        ' Boolean toggle for form-level boolean properties
        IF PropName = "KEYPREVIEW" THEN
            IF UCASE$(PropVal) = "TRUE" OR PropVal = "1" THEN
                PropVal = "False"
            ELSE
                PropVal = "True"
            END IF
            PropGrid.SetCell(R, 1, PropVal)
        END IF
        SyncGuard = 0
        EXIT SUB
    END IF

    DIM CI AS INTEGER
    CI = SelIndex - 1

    ' Boolean properties: toggle on double-click
    IF PropName = "CHECKED" OR PropName = "VISIBLE" OR PropName = "ENABLED" OR PropName = "READONLY" OR PropName = "WORDWRAP" OR PropName = "STRETCH" OR PropName = "FLAT" OR PropName = "DOWN" OR PropName = "ALLOWALLUP" THEN
        IF UCASE$(PropVal) = "TRUE" OR PropVal = "1" THEN
            PropVal = "False"
        ELSE
            PropVal = "True"
        END IF
        PropGrid.SetCell(R, 1, PropVal)
        DesignSurface.SetProp(CI, LCASE$(PropName), PropVal)
        SyncGuard = 0
        EXIT SUB
    END IF

    ' Color properties: launch color picker
    IF PropName = "FONTCOLOR" OR PropName = "COLOR" OR PropName = "BACKGROUNDCOLOR" THEN
        IF ColorDlg.Execute THEN
            PropVal = ColorDlg.Color
            PropGrid.SetCell(R, 1, PropVal)
            DesignSurface.SetProp(CI, LCASE$(PropName), PropVal)
        END IF
        SyncGuard = 0
        EXIT SUB
    END IF

    ' Font properties: launch font picker
    IF PropName = "FONT.NAME" OR PropName = "FONTNAME" OR PropName = "FONT.SIZE" THEN
        IF FontDlg.Execute THEN
            DIM FName AS STRING
            DIM FSize AS STRING
            FName = FontDlg.FontName
            FSize = FontDlg.FontSize
            DesignSurface.SetProp(CI, "font.name", FName)
            DesignSurface.SetProp(CI, "font.size", FSize)
            DIM GR AS INTEGER
            FOR GR = 1 TO PropGrid.RowCount
                DIM GN AS STRING
                GN = UCASE$(PropGrid.Cell(GR, 0))
                IF GN = "FONT.NAME" OR GN = "FONTNAME" THEN PropGrid.SetCell(GR, 1, FName)
                IF GN = "FONT.SIZE" THEN PropGrid.SetCell(GR, 1, FSize)
            NEXT GR
        END IF
        SyncGuard = 0
        EXIT SUB
    END IF

    ' Alignment property: cycle through values
    IF PropName = "ALIGNMENT" THEN
        DIM AlNum AS INTEGER
        AlNum = VAL(PropVal)
        AlNum = AlNum + 1
        IF AlNum > 2 THEN AlNum = 0
        PropVal = STR$(AlNum)
        PropGrid.SetCell(R, 1, PropVal)
        DesignSurface.SetProp(CI, "alignment", PropVal)
        SyncGuard = 0
        EXIT SUB
    END IF

    ' BorderStyle property: cycle
    IF PropName = "BORDERSTYLE" THEN
        DIM BsNum AS INTEGER
        BsNum = VAL(PropVal)
        BsNum = BsNum + 1
        IF BsNum > 1 THEN BsNum = 0
        PropVal = STR$(BsNum)
        PropGrid.SetCell(R, 1, PropVal)
        DesignSurface.SetProp(CI, "borderstyle", PropVal)
        SyncGuard = 0
        EXIT SUB
    END IF

    SyncGuard = 0
END SUB

' ============================================================
' EVENT GRID HANDLERS
' ============================================================

SUB EvtGridChange
    SaveEvents
    CodeDirty = 1
END SUB

SUB EvtGridDblClick
    ' Save all current events first to prevent loss
    SaveEvents

    DIM R AS INTEGER
    R = EvtGrid.SelectedRow
    IF R < 1 THEN EXIT SUB
    DIM EvtName AS STRING
    EvtName = EvtGrid.Cell(R, 0)
    DIM HandlerName AS STRING
    HandlerName = EvtGrid.Cell(R, 1)
    DIM CompName AS STRING

    IF SelIndex = 0 THEN
        CompName = "Form1"
    ELSE
        CompName = DesignSurface.GetName(SelIndex - 1)
    END IF

    IF HandlerName = "" THEN
        HandlerName = CompName + "_" + EvtName
        EvtGrid.SetCell(R, 1, HandlerName)
        SaveEvents
    END IF

    DIM EvtCI AS INTEGER
    IF SelIndex = 0 THEN
        EvtCI = 0
    ELSE
        EvtCI = SelIndex
    END IF

    ' Check if "..." column was clicked — open Event Editor dialog
    DIM ClickedCol AS INTEGER
    ClickedCol = EvtGrid.SelectedCol
    IF ClickedCol = 2 THEN
        OpenEventEditor EvtCI, EvtName, HandlerName
        FillEvents
        EXIT SUB
    END IF

    ' Otherwise, switch to code view (existing behavior)
    GenerateCode
    CodeDirty = 0
    DIM Code AS STRING
    Code = CodeEditor.Text
    Code = GenerateSubCode(Code, HandlerName, CompName, EvtName, GetEventCodeBody(EvtCI, EvtName))
    CodeEditor.Text = Code

    IF ShowingCode = 0 THEN
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
        BtnCode.Caption = "< Design"
    END IF

    CodeEditor.GotoSub(HandlerName)
    StatusBar.Caption = "Editing: SUB " + HandlerName
END SUB

' ============================================================
' CODE GENERATION (with marker-based code preservation)
' ============================================================

SUB GenerateCode
    DIM Code AS STRING
    DIM I AS INTEGER
    DIM N AS INTEGER
    DIM CT AS STRING
    N = DesignSurface.CompCount

    ' === Build the DECLARATIONS block ===
    DIM DeclBlock AS STRING
    DeclBlock = "' [AUTO-DECLARATIONS]" + CHR$(10)
    DeclBlock = DeclBlock + "' Generated by RapidR Visual IDE" + CHR$(10)
    DeclBlock = DeclBlock + "$THEME AquaClassic" + CHR$(10) + CHR$(10)
    ' Only DIM non-visual components (dialogs) — visual components use CREATE blocks
    FOR I = 0 TO N - 1
        CT = UCASE$(DesignSurface.GetType(I))
        IF CT = "ROPENDIALOG" OR CT = "RSAVEDIALOG" OR CT = "RCOLORDIALOG" OR CT = "RFONTDIALOG" THEN
            DeclBlock = DeclBlock + "DIM " + DesignSurface.GetName(I) + " AS " + CT + CHR$(10)
        END IF
    NEXT I
    DeclBlock = DeclBlock + "' [END AUTO-DECLARATIONS]" + CHR$(10)

    ' === Build the FORM block ===
    DIM FormBlock AS STRING
    FormBlock = "' [AUTO-FORM]" + CHR$(10)
    FormBlock = FormBlock + "' === Main Form ===" + CHR$(10)
    FormBlock = FormBlock + "CREATE Form1 AS RFORM" + CHR$(10)
    FormBlock = FormBlock + "    Caption = " + CHR$(34) + DesignSurface.FormCaption + CHR$(34) + CHR$(10)
    FormBlock = FormBlock + "    Width = " + STR$(DesignSurface.Width) + CHR$(10)
    FormBlock = FormBlock + "    Height = " + STR$(DesignSurface.Height) + CHR$(10)
    FormBlock = FormBlock + "    Center" + CHR$(10)

    IF FormOnShow <> "" THEN FormBlock = FormBlock + "    OnShow = " + FormOnShow + CHR$(10)
    IF FormOnClose <> "" THEN FormBlock = FormBlock + "    OnClose = " + FormOnClose + CHR$(10)
    IF FormOnResize <> "" THEN FormBlock = FormBlock + "    OnResize = " + FormOnResize + CHR$(10)
    IF FormOnClick <> "" THEN FormBlock = FormBlock + "    OnClick = " + FormOnClick + CHR$(10)
    IF FormOnKeyDown <> "" THEN FormBlock = FormBlock + "    OnKeyDown = " + FormOnKeyDown + CHR$(10)
    IF FormOnPaint <> "" THEN FormBlock = FormBlock + "    OnPaint = " + FormOnPaint + CHR$(10)

    FOR I = 0 TO N - 1
        CT = DesignSurface.GetType(I)
        DIM CN3 AS STRING
        CN3 = DesignSurface.GetName(I)
        FormBlock = FormBlock + CHR$(10) + "    CREATE " + CN3 + " AS " + CT + CHR$(10)
        FormBlock = FormBlock + "        Left = " + STR$(DesignSurface.GetCompX(I)) + CHR$(10)
        FormBlock = FormBlock + "        Top = " + STR$(DesignSurface.GetCompY(I)) + CHR$(10)
        FormBlock = FormBlock + "        Width = " + STR$(DesignSurface.GetCompW(I)) + CHR$(10)
        FormBlock = FormBlock + "        Height = " + STR$(DesignSurface.GetCompH(I)) + CHR$(10)

        DIM UCT AS STRING
        UCT = UCASE$(CT)
        DIM PropV AS STRING

        PropV = DesignSurface.GetProp(I, "caption")
        IF PropV <> "" AND (UCT = "RBUTTON" OR UCT = "RLABEL" OR UCT = "RCHECKBOX" OR UCT = "RRADIOBUTTON" OR UCT = "RGROUPBOX" OR UCT = "RCOOLBTN" OR UCT = "ROVALBTN") THEN
            FormBlock = FormBlock + "        Caption = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)
        END IF

        PropV = DesignSurface.GetProp(I, "text")
        IF PropV <> "" AND (UCT = "REDIT" OR UCT = "RRICHEDIT") THEN
            FormBlock = FormBlock + "        Text = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)
        END IF

        PropV = DesignSurface.GetProp(I, "color")
        IF PropV <> "" THEN FormBlock = FormBlock + "        Color = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "fontcolor")
        IF PropV <> "" THEN FormBlock = FormBlock + "        FontColor = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "fontsize")
        IF PropV <> "" THEN FormBlock = FormBlock + "        FontSize = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "font.name")
        IF PropV <> "" AND PropV <> "Helvetica" THEN FormBlock = FormBlock + "        Font.Name = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "font.size")
        IF PropV <> "" AND PropV <> "12" THEN FormBlock = FormBlock + "        Font.Size = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "checked")
        IF PropV <> "" AND (UCT = "RCHECKBOX" OR UCT = "RRADIOBUTTON") THEN
            FormBlock = FormBlock + "        Checked = " + PropV + CHR$(10)
        END IF

        PropV = DesignSurface.GetProp(I, "alignment")
        IF PropV <> "" AND PropV <> "0" THEN FormBlock = FormBlock + "        Alignment = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "interval")
        IF PropV <> "" AND UCT = "RTIMER" THEN FormBlock = FormBlock + "        Interval = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "enabled")
        IF PropV <> "" THEN FormBlock = FormBlock + "        Enabled = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "bmp")
        IF PropV <> "" AND (UCT = "RIMAGE" OR UCT = "RCOOLBTN") THEN FormBlock = FormBlock + "        BMP = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "stretch")
        IF PropV <> "" AND UCT = "RIMAGE" THEN FormBlock = FormBlock + "        Stretch = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "readonly")
        IF PropV <> "" THEN FormBlock = FormBlock + "        ReadOnly = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "cols")
        IF PropV <> "" AND UCT = "RSTRINGGRID" THEN FormBlock = FormBlock + "        Cols = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "colwidth")
        IF PropV <> "" AND UCT = "RSTRINGGRID" THEN FormBlock = FormBlock + "        ColWidth = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "visible")
        IF PropV <> "" AND UCASE$(PropV) = "FALSE" THEN FormBlock = FormBlock + "        Visible = 0" + CHR$(10)
        IF PropV = "0" THEN FormBlock = FormBlock + "        Visible = 0" + CHR$(10)

        PropV = DesignSurface.GetProp(I, "database")
        IF PropV <> "" THEN FormBlock = FormBlock + "        Database = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "host")
        IF PropV <> "" THEN FormBlock = FormBlock + "        Host = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "csvfile")
        IF PropV <> "" AND UCT = "RDATAFRAME" THEN FormBlock = FormBlock + "        CsvFile = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "datasource")
        IF PropV <> "" THEN FormBlock = FormBlock + "        DataSource = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "title")
        IF PropV <> "" AND UCT = "RPLOT" THEN FormBlock = FormBlock + "        Title = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "xlabel")
        IF PropV <> "" AND UCT = "RPLOT" THEN FormBlock = FormBlock + "        XLabel = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "ylabel")
        IF PropV <> "" AND UCT = "RPLOT" THEN FormBlock = FormBlock + "        YLabel = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "grid")
        IF PropV <> "" AND UCT = "RPLOT" THEN FormBlock = FormBlock + "        Grid = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "min")
        IF PropV <> "" THEN FormBlock = FormBlock + "        Min = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "max")
        IF PropV <> "" THEN FormBlock = FormBlock + "        Max = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "position")
        IF PropV <> "" THEN FormBlock = FormBlock + "        Position = " + PropV + CHR$(10)

        ' RCoolBtn / ROvalBtn properties
        IF UCT = "RCOOLBTN" OR UCT = "ROVALBTN" THEN
            PropV = DesignSurface.GetProp(I, "flat")
            IF PropV <> "" AND UCASE$(PropV) <> "FALSE" AND PropV <> "0" THEN FormBlock = FormBlock + "        Flat = " + PropV + CHR$(10)
            PropV = DesignSurface.GetProp(I, "groupindex")
            IF PropV <> "" AND PropV <> "0" THEN FormBlock = FormBlock + "        GroupIndex = " + PropV + CHR$(10)
            PropV = DesignSurface.GetProp(I, "down")
            IF PropV <> "" AND UCASE$(PropV) <> "FALSE" AND PropV <> "0" THEN FormBlock = FormBlock + "        Down = " + PropV + CHR$(10)
            PropV = DesignSurface.GetProp(I, "allowallup")
            IF PropV <> "" AND UCASE$(PropV) <> "FALSE" AND PropV <> "0" THEN FormBlock = FormBlock + "        AllowAllUp = " + PropV + CHR$(10)
        END IF
        IF UCT = "RCOOLBTN" THEN
            PropV = DesignSurface.GetProp(I, "numbmps")
            IF PropV <> "" AND PropV <> "1" THEN FormBlock = FormBlock + "        NumBMPs = " + PropV + CHR$(10)
        END IF
        IF UCT = "ROVALBTN" THEN
            PropV = DesignSurface.GetProp(I, "colorhighlight")
            IF PropV <> "" THEN FormBlock = FormBlock + "        ColorHighlight = " + PropV + CHR$(10)
            PropV = DesignSurface.GetProp(I, "colorshadow")
            IF PropV <> "" THEN FormBlock = FormBlock + "        ColorShadow = " + PropV + CHR$(10)
        END IF

        DIM CI3 AS INTEGER
        CI3 = I + 1
        IF EvtOnClick(CI3) <> "" THEN FormBlock = FormBlock + "        OnClick = " + EvtOnClick(CI3) + CHR$(10)
        IF EvtOnDblClick(CI3) <> "" THEN FormBlock = FormBlock + "        OnDblClick = " + EvtOnDblClick(CI3) + CHR$(10)
        IF EvtOnChange(CI3) <> "" THEN FormBlock = FormBlock + "        OnChange = " + EvtOnChange(CI3) + CHR$(10)
        IF EvtOnTimer(CI3) <> "" THEN FormBlock = FormBlock + "        OnTimer = " + EvtOnTimer(CI3) + CHR$(10)
        IF EvtOnPaint(CI3) <> "" THEN FormBlock = FormBlock + "        OnPaint = " + EvtOnPaint(CI3) + CHR$(10)
        IF EvtOnMouseDown(CI3) <> "" THEN FormBlock = FormBlock + "        OnMouseDown = " + EvtOnMouseDown(CI3) + CHR$(10)
        IF EvtOnMouseMove(CI3) <> "" THEN FormBlock = FormBlock + "        OnMouseMove = " + EvtOnMouseMove(CI3) + CHR$(10)
        IF EvtOnMouseUp(CI3) <> "" THEN FormBlock = FormBlock + "        OnMouseUp = " + EvtOnMouseUp(CI3) + CHR$(10)
        IF EvtOnKeyDown(CI3) <> "" THEN FormBlock = FormBlock + "        OnKeyDown = " + EvtOnKeyDown(CI3) + CHR$(10)
        IF EvtOnQueryDone(CI3) <> "" THEN FormBlock = FormBlock + "        OnQueryDone = " + EvtOnQueryDone(CI3) + CHR$(10)

        FormBlock = FormBlock + "    END CREATE" + CHR$(10)
    NEXT I

    FormBlock = FormBlock + "END CREATE" + CHR$(10) + CHR$(10)
    FormBlock = FormBlock + "Form1.ShowModal" + CHR$(10)
    FormBlock = FormBlock + "' [END AUTO-FORM]" + CHR$(10)

    ' === Check for existing markers in current code ===
    DIM ExistingCode AS STRING
    ExistingCode = CodeEditor.Text

    DIM DeclStartPos AS INTEGER
    DIM DeclEndPos AS INTEGER
    DIM FormStartPos AS INTEGER
    DIM FormEndPos AS INTEGER
    DeclStartPos = INSTR(ExistingCode, "' [AUTO-DECLARATIONS]")
    DeclEndPos = INSTR(ExistingCode, "' [END AUTO-DECLARATIONS]")
    FormStartPos = INSTR(ExistingCode, "' [AUTO-FORM]")
    FormEndPos = INSTR(ExistingCode, "' [END AUTO-FORM]")

    IF DeclStartPos > 0 AND DeclEndPos > 0 AND FormStartPos > 0 AND FormEndPos > 0 THEN
        ' === Markers found — preserve user code between sections ===
        DIM BeforeDecl AS STRING
        BeforeDecl = LEFT$(ExistingCode, DeclStartPos - 1)

        DIM DeclEndTagLen AS INTEGER
        DeclEndTagLen = LEN("' [END AUTO-DECLARATIONS]")
        DIM AfterDeclEnd AS INTEGER
        AfterDeclEnd = DeclEndPos + DeclEndTagLen
        ' Skip newline after the end marker
        IF MID$(ExistingCode, AfterDeclEnd, 1) = CHR$(10) THEN AfterDeclEnd = AfterDeclEnd + 1

        DIM MiddlePart AS STRING
        MiddlePart = MID$(ExistingCode, AfterDeclEnd, FormStartPos - AfterDeclEnd)

        DIM FormEndTagLen AS INTEGER
        FormEndTagLen = LEN("' [END AUTO-FORM]")
        DIM AfterFormEnd AS INTEGER
        AfterFormEnd = FormEndPos + FormEndTagLen
        IF MID$(ExistingCode, AfterFormEnd, 1) = CHR$(10) THEN AfterFormEnd = AfterFormEnd + 1

        DIM AfterForm AS STRING
        AfterForm = MID$(ExistingCode, AfterFormEnd)

        ' Ensure event handler stubs exist in the middle section
        IF FormOnShow <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, FormOnShow, "Form1", "OnShow", FormCodeOnShow)
        IF FormOnClose <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, FormOnClose, "Form1", "OnClose", FormCodeOnClose)
        IF FormOnResize <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, FormOnResize, "Form1", "OnResize", FormCodeOnResize)
        IF FormOnClick <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, FormOnClick, "Form1", "OnClick", FormCodeOnClick)
        IF FormOnKeyDown <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, FormOnKeyDown, "Form1", "OnKeyDown", FormCodeOnKeyDown)
        IF FormOnPaint <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, FormOnPaint, "Form1", "OnPaint", FormCodeOnPaint)

        FOR I = 0 TO N - 1
            DIM CI4 AS INTEGER
            CI4 = I + 1
            DIM CmpN2 AS STRING
            CmpN2 = DesignSurface.GetName(I)
            IF EvtOnClick(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnClick(CI4), CmpN2, "OnClick", EvtCodeOnClick(CI4))
            IF EvtOnDblClick(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnDblClick(CI4), CmpN2, "OnDblClick", EvtCodeOnDblClick(CI4))
            IF EvtOnChange(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnChange(CI4), CmpN2, "OnChange", EvtCodeOnChange(CI4))
            IF EvtOnTimer(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnTimer(CI4), CmpN2, "OnTimer", EvtCodeOnTimer(CI4))
            IF EvtOnPaint(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnPaint(CI4), CmpN2, "OnPaint", EvtCodeOnPaint(CI4))
            IF EvtOnMouseDown(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnMouseDown(CI4), CmpN2, "OnMouseDown", EvtCodeOnMouseDown(CI4))
            IF EvtOnMouseMove(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnMouseMove(CI4), CmpN2, "OnMouseMove", EvtCodeOnMouseMove(CI4))
            IF EvtOnMouseUp(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnMouseUp(CI4), CmpN2, "OnMouseUp", EvtCodeOnMouseUp(CI4))
            IF EvtOnKeyDown(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnKeyDown(CI4), CmpN2, "OnKeyDown", EvtCodeOnKeyDown(CI4))
            IF EvtOnQueryDone(CI4) <> "" THEN MiddlePart = GenerateSubCode(MiddlePart, EvtOnQueryDone(CI4), CmpN2, "OnQueryDone", EvtCodeOnQueryDone(CI4))
        NEXT I

        Code = BeforeDecl + DeclBlock + MiddlePart + FormBlock + AfterForm
    ELSE
        ' === No markers (first generation or legacy code) ===
        ' Preserve existing SUBs/FUNCTIONs from old code
        IF FormOnShow <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnShow, "Form1", "OnShow", FormCodeOnShow)
        IF FormOnClose <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnClose, "Form1", "OnClose", FormCodeOnClose)
        IF FormOnResize <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnResize, "Form1", "OnResize", FormCodeOnResize)
        IF FormOnClick <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnClick, "Form1", "OnClick", FormCodeOnClick)
        IF FormOnKeyDown <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnKeyDown, "Form1", "OnKeyDown", FormCodeOnKeyDown)
        IF FormOnPaint <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnPaint, "Form1", "OnPaint", FormCodeOnPaint)

        FOR I = 0 TO N - 1
            DIM CI2 AS INTEGER
            CI2 = I + 1
            DIM CmpN AS STRING
            CmpN = DesignSurface.GetName(I)
            IF EvtOnClick(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnClick(CI2), CmpN, "OnClick", EvtCodeOnClick(CI2))
            IF EvtOnDblClick(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnDblClick(CI2), CmpN, "OnDblClick", EvtCodeOnDblClick(CI2))
            IF EvtOnChange(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnChange(CI2), CmpN, "OnChange", EvtCodeOnChange(CI2))
            IF EvtOnTimer(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnTimer(CI2), CmpN, "OnTimer", EvtCodeOnTimer(CI2))
            IF EvtOnPaint(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnPaint(CI2), CmpN, "OnPaint", EvtCodeOnPaint(CI2))
            IF EvtOnMouseDown(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnMouseDown(CI2), CmpN, "OnMouseDown", EvtCodeOnMouseDown(CI2))
            IF EvtOnMouseMove(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnMouseMove(CI2), CmpN, "OnMouseMove", EvtCodeOnMouseMove(CI2))
            IF EvtOnMouseUp(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnMouseUp(CI2), CmpN, "OnMouseUp", EvtCodeOnMouseUp(CI2))
            IF EvtOnKeyDown(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnKeyDown(CI2), CmpN, "OnKeyDown", EvtCodeOnKeyDown(CI2))
            IF EvtOnQueryDone(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnQueryDone(CI2), CmpN, "OnQueryDone", EvtCodeOnQueryDone(CI2))
        NEXT I

        DIM SubPart AS STRING
        DIM SubStart AS INTEGER
        SubStart = INSTR(UCASE$(ExistingCode), CHR$(10) + "SUB ")
        IF SubStart = 0 THEN SubStart = INSTR(UCASE$(ExistingCode), "SUB ")
        IF SubStart > 0 THEN
            DIM CreateMarker AS INTEGER
            CreateMarker = INSTR(ExistingCode, "' === Main Form ===")
            IF CreateMarker = 0 THEN CreateMarker = INSTR(UCASE$(ExistingCode), "CREATE FORM1 AS RFORM")
            IF CreateMarker > SubStart THEN
                SubPart = MID$(ExistingCode, SubStart, CreateMarker - SubStart)
            ELSE
                SubPart = MID$(ExistingCode, SubStart)
            END IF
        ELSE
            SubPart = ""
        END IF

        DIM EndCreatePos AS INTEGER
        EndCreatePos = INSTR(UCASE$(ExistingCode), "FORM1.SHOWMODAL")
        IF EndCreatePos > 0 THEN
            DIM AfterCreate AS STRING
            AfterCreate = MID$(ExistingCode, EndCreatePos + 15)
            DIM PostSubStart AS INTEGER
            PostSubStart = INSTR(UCASE$(AfterCreate), "SUB ")
            IF PostSubStart > 0 THEN
                SubPart = SubPart + MID$(AfterCreate, PostSubStart)
            END IF
        END IF

        Code = DeclBlock + CHR$(10) + SubPart + CHR$(10) + CHR$(10) + FormBlock
    END IF

    CodeEditor.Text = Code
END SUB

' ============================================================
' VIEW TOGGLE
' ============================================================

SUB ToggleCodeView
    IF ShowingCode = 0 THEN
        SaveEvents
        IF CodeDirty = 1 OR CodeEditor.Text = "" THEN
            GenerateCode
            CodeDirty = 0
        END IF
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
        BtnCode.Caption = "< Design"
        StatusBar.Caption = "Code View"
    ELSE
        SyncEventCodeFromSource
        CodeEditor.Visible = 0
        DesignSurface.Show
        ShowingCode = 0
        BtnCode.Caption = "Code >"
        StatusBar.Caption = "Design View"
    END IF
END SUB

SUB ShowDesignView
    IF ShowingCode = 1 THEN
        SyncEventCodeFromSource
        CodeEditor.Visible = 0
        DesignSurface.Show
        ShowingCode = 0
        BtnCode.Caption = "Code >"
        StatusBar.Caption = "Design View"
    END IF
END SUB

SUB ShowCodeView
    IF ShowingCode = 0 THEN
        SaveEvents
        IF CodeDirty = 1 OR CodeEditor.Text = "" THEN
            GenerateCode
            CodeDirty = 0
        END IF
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
        BtnCode.Caption = "< Design"
        StatusBar.Caption = "Code View"
    END IF
END SUB

SUB ShowPropsGrid
    PropGrid.Visible = 1
    EvtGrid.Visible = 0
    StatusBar.Caption = "Properties"
END SUB

SUB ShowEvtsGrid
    PropGrid.Visible = 0
    EvtGrid.Visible = 1
    StatusBar.Caption = "Events"
END SUB

' ============================================================
' FILE / PROJECT OPERATIONS
' ============================================================

SUB NewProject
    DIM I AS INTEGER
    DesignSurface.ClearAll
    BtnCount = 0 : LblCount = 0 : EdtCount = 0
    ChkCount = 0 : CmbCount = 0 : PnlCount = 0
    RadCount = 0 : LstCount = 0 : GrpCount = 0
    PrgCount = 0 : TmrCount = 0 : RchCount = 0
    CnvCount = 0 : MySqlCount = 0 : SQLiteCount = 0
    TrvCount = 0 : ImgCount = 0 : TrkCount = 0
    SplCount = 0 : SgdCount = 0 : SbxCount = 0
    CoolBtnCount = 0 : OvalBtnCount = 0 : JsnCount = 0
    SelIndex = 0
    FormOnShow = "" : FormOnClose = "" : FormOnResize = "" : FormOnKeyDown = "" : FormOnKeyPress = ""
    FormOnKeyUp = "" : FormOnClick = "" : FormOnMouseDown = "" : FormOnMouseMove = "" : FormOnMouseUp = ""
    FormOnPaint = ""
    FormCodeOnShow = "" : FormCodeOnClose = "" : FormCodeOnResize = "" : FormCodeOnKeyDown = ""
    FormCodeOnKeyPress = "" : FormCodeOnKeyUp = "" : FormCodeOnClick = ""
    FormCodeOnMouseDown = "" : FormCodeOnMouseMove = "" : FormCodeOnMouseUp = "" : FormCodeOnPaint = ""
    FOR I = 1 TO 100
        EvtOnClick(I) = "" : EvtOnDblClick(I) = "" : EvtOnChange(I) = ""
        EvtOnMouseDown(I) = "" : EvtOnMouseMove(I) = "" : EvtOnMouseUp(I) = ""
        EvtOnKeyDown(I) = "" : EvtOnKeyPress(I) = "" : EvtOnKeyUp(I) = ""
        EvtOnTimer(I) = "" : EvtOnPaint(I) = "" : EvtOnEnter(I) = ""
        EvtOnConnect(I) = "" : EvtOnDisconnect(I) = "" : EvtOnError(I) = "" : EvtOnQueryDone(I) = ""
        EvtCodeOnClick(I) = "" : EvtCodeOnDblClick(I) = "" : EvtCodeOnChange(I) = ""
        EvtCodeOnMouseDown(I) = "" : EvtCodeOnMouseMove(I) = "" : EvtCodeOnMouseUp(I) = ""
        EvtCodeOnKeyDown(I) = "" : EvtCodeOnKeyPress(I) = "" : EvtCodeOnKeyUp(I) = ""
        EvtCodeOnTimer(I) = "" : EvtCodeOnPaint(I) = "" : EvtCodeOnEnter(I) = ""
        EvtCodeOnConnect(I) = "" : EvtCodeOnDisconnect(I) = "" : EvtCodeOnError(I) = "" : EvtCodeOnQueryDone(I) = ""
    NEXT I
    ProjectFile = ""
    CodeEditor.Text = ""
    DesignSurface.FormCaption = "Form1"
    IF ShowingCode = 1 THEN
        CodeEditor.Visible = 0
        DesignSurface.Show
        ShowingCode = 0
    END IF
    UpdateObjCombo
    UpdateProjectTree
    FillProperties
    FillEvents
    StatusBar.Caption = "New project created"
END SUB

SUB OpenProject
    OpenDlg.Filter = "RapidR Files\t*.rr"
    OpenDlg.Title = "Open RapidR Project"
    IF OpenDlg.Execute THEN
        ProjectFile = OpenDlg.FileName
        DIM FS AS RFILESTREAM
        CREATE FS AS RFILESTREAM
        END CREATE
        FS.Open(ProjectFile)
        DIM Content AS STRING
        Content = FS.ReadAll
        FS.Close
        CodeEditor.Text = Content
        IF ShowingCode = 0 THEN
            DesignSurface.Hide
            CodeEditor.Visible = 1
            ShowingCode = 1
        END IF
        StatusBar.Caption = "Opened: " + ProjectFile
    END IF
END SUB

SUB SaveProject
    GenerateCode
    IF ProjectFile = "" THEN
        SaveDlg.Filter = "RapidR Files\t*.rr"
        SaveDlg.Title = "Save RapidR Project"
        IF SaveDlg.Execute THEN
            ProjectFile = SaveDlg.FileName
        ELSE
            EXIT SUB
        END IF
    END IF
    DIM FS AS RFILESTREAM
    CREATE FS AS RFILESTREAM
    END CREATE
    FS.Open(ProjectFile, 65535)
    FS.WriteLn(CodeEditor.Text)
    FS.Close
    StatusBar.Caption = "Saved: " + ProjectFile
END SUB

SUB SaveAsProject
    GenerateCode
    SaveDlg.Filter = "RapidR Files\t*.rr"
    SaveDlg.Title = "Save RapidR Project As"
    IF SaveDlg.Execute THEN
        ProjectFile = SaveDlg.FileName
        DIM FS AS RFILESTREAM
        CREATE FS AS RFILESTREAM
        END CREATE
        FS.Open(ProjectFile, 65535)
        FS.WriteLn(CodeEditor.Text)
        FS.Close
        StatusBar.Caption = "Saved: " + ProjectFile
    END IF
END SUB

' ============================================================
' COMPILE & RUN
' ============================================================

SUB CompileAndRun
    GenerateCode
    DIM Code AS STRING
    Code = CodeEditor.Text

    ' Use a unique temp directory based on random number
    DIM RandId AS INTEGER
    RandId = INT(RND(1) * 999999) + 100000
    DIM TmpName AS STRING
    TmpName = "rr_run_" + STR$(RandId)
    DIM TmpFile AS STRING
    TmpFile = "/tmp/" + TmpName + ".rr"
    DIM TmpDir AS STRING
    TmpDir = "/tmp/" + TmpName

    DIM FS AS RFILESTREAM
    CREATE FS AS RFILESTREAM
    END CREATE
    FS.Open(TmpFile, 65535)
    FS.WriteLn(Code)
    FS.Close

    StatusBar.Caption = "Compiling..."
    ErrorList.Clear
    ErrorList.Visible = 1
    ErrorCount = 0

    DIM CmdStr AS STRING
    DIM OutputFile AS STRING
    OutputFile = "/tmp/" + TmpName + "_build.log"
    CmdStr = "export RAPIDR_HOME=" + RapidRHome + " && " + CHR$(34) + RapidRHome + "/rapidr" + CHR$(34) + " build " + TmpFile + " " + TmpDir + " --release > " + OutputFile + " 2>&1"

    DIM Result AS INTEGER
    Result = SHELL(CmdStr)

    IF Result = 0 THEN
        StatusBar.Caption = "Compilation successful — running..."
        SHELL(TmpDir + "/target/release/" + TmpName + " &")
        StatusBar.Caption = "Running project"
    ELSE
        StatusBar.Caption = "Compilation failed — check errors"
        ' Read build output and parse errors (reuse FS)
        FS.Open(OutputFile)
        DIM LogContent AS STRING
        LogContent = FS.ReadAll
        FS.Close
        IF LogContent <> "" THEN
            ' Split lines and show in ErrorList
            DIM LineStart AS INTEGER
            DIM LineEnd AS INTEGER
            LineStart = 1
            DIM LogLen AS INTEGER
            LogLen = LEN(LogContent)
            DIM LineText AS STRING
            DO WHILE LineStart <= LogLen
                LineEnd = INSTR(LineStart, LogContent, CHR$(10))
                IF LineEnd = 0 THEN LineEnd = LogLen + 1
                LineText = MID$(LogContent, LineStart, LineEnd - LineStart)
                IF LineText <> "" THEN
                    ErrorList.AddItems(LineText)
                END IF
                LineStart = LineEnd + 1
            LOOP
        ELSE
            ErrorList.AddItems("Compilation failed (exit code: " + STR$(Result) + "). Run 'rapidr build' manually to see details.")
        END IF
    END IF
END SUB

SUB BuildStandalone
    GenerateCode
    DIM Code AS STRING
    Code = CodeEditor.Text

    SaveDlg.Filter = "RapidR Files\t*.rr"
    SaveDlg.Title = "Save before building"
    IF ProjectFile = "" THEN
        IF SaveDlg.Execute THEN
            ProjectFile = SaveDlg.FileName
        ELSE
            EXIT SUB
        END IF
    END IF

    DIM FS AS RFILESTREAM
    CREATE FS AS RFILESTREAM
    END CREATE
    FS.Open(ProjectFile, 65535)
    FS.WriteLn(Code)
    FS.Close

    StatusBar.Caption = "Building standalone executable..."
    ErrorList.Clear
    ErrorList.Visible = 1

    DIM OutDir AS STRING
    OutDir = ProjectFile + "_rust"
    DIM Result AS INTEGER
    Result = SHELL("export RAPIDR_HOME=" + RapidRHome + " && " + CHR$(34) + RapidRHome + "/rapidr" + CHR$(34) + " build " + ProjectFile + " " + OutDir + " --release 2>&1")

    IF Result = 0 THEN
        StatusBar.Caption = "Build successful: " + OutDir
        ErrorList.AddItems("Build succeeded: " + OutDir)
    ELSE
        StatusBar.Caption = "Build failed"
        ErrorList.AddItems("Build failed. Check output for errors.")
    END IF
END SUB

SUB RunCodegen
    GenerateCode
    StatusBar.Caption = "Code generated"
    IF ShowingCode = 0 THEN
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
    END IF
END SUB

' ============================================================
' TOOLS MENU HANDLERS
' ============================================================

SUB ToolsPickColor
    IF ColorDlg.Execute THEN
        DIM ColorVal AS STRING
        ColorVal = ColorDlg.Color
        StatusBar.Caption = "Color: " + ColorVal
        IF SelIndex > 0 THEN
            DIM CI AS INTEGER
            CI = SelIndex - 1
            DesignSurface.SetProp(CI, "color", ColorVal)
            FillProperties
        END IF
    END IF
END SUB

SUB ToolsPickFont
    IF FontDlg.Execute THEN
        DIM FontName AS STRING
        FontName = FontDlg.FontName
        StatusBar.Caption = "Font: " + FontName
    END IF
END SUB

SUB ShowAbout
    MSGBOX("RapidR Visual IDE v1.2" + CHR$(10) + CHR$(10) + "A production visual development environment" + CHR$(10) + "for building RapidR BASIC applications." + CHR$(10) + CHR$(10) + "Transpiles BASIC to native Rust executables.")
END SUB

SUB OpenInVSCode
    IF ProjectFile <> "" THEN
        SHELL("code " + CHR$(34) + ProjectFile + CHR$(34) + " &")
        StatusBar.Caption = "Opened in VS Code: " + ProjectFile
    ELSE
        ' Save to temp file first
        GenerateCode
        DIM TmpFile AS STRING
        TmpFile = "/tmp/rapidr_vscode_temp.rr"
        DIM FS AS RFILESTREAM
        CREATE FS AS RFILESTREAM
        END CREATE
        FS.Open(TmpFile, 65535)
        FS.WriteLn(CodeEditor.Text)
        FS.Close
        SHELL("code " + CHR$(34) + TmpFile + CHR$(34) + " &")
        StatusBar.Caption = "Opened temp file in VS Code"
    END IF
END SUB

' ============================================================
' CONFIG SYSTEM
' ============================================================

SUB LoadConfig
    DIM Result AS INTEGER
    Result = Config.LoadFile("ide.config.json")
    IF Result = 1 THEN
        IF Config.Has("RapidRHome") = 1 THEN
            RapidRHome = Config.Get("RapidRHome")
        END IF
    ELSE
        ' No config file — create with defaults
        Config.Parse("{}")
        Config.Set("RapidRHome", RapidRHome)
        Config.SaveFile("ide.config.json")
    END IF
END SUB

SUB SaveConfig
    Config.Set("RapidRHome", RapidRHome)
    Config.SaveFile("ide.config.json")
END SUB

SUB ShowSettings
    ' Save current config and show info
    SaveConfig
    MSGBOX("RapidR IDE Settings" + CHR$(10) + CHR$(10) + "RapidR Home: " + RapidRHome + CHR$(10) + CHR$(10) + "Edit ide.config.json to change settings." + CHR$(10) + "Restart IDE after saving changes.")
END SUB

' ============================================================
' MISC HANDLERS
' ============================================================

SUB DeleteSelected
    IF SelIndex > 0 THEN
        CodeDirty = 1
        DIM CI AS INTEGER
        CI = SelIndex - 1
        DIM CN AS STRING
        CN = DesignSurface.GetName(CI)
        DesignSurface.RemoveComponent(CI)

        ' Clear events for the deleted component and shift remaining down
        DIM DI AS INTEGER
        DI = SelIndex
        DIM SI AS INTEGER
        FOR SI = DI TO 99
            EvtOnClick(SI) = EvtOnClick(SI + 1)
            EvtOnDblClick(SI) = EvtOnDblClick(SI + 1)
            EvtOnChange(SI) = EvtOnChange(SI + 1)
            EvtOnMouseDown(SI) = EvtOnMouseDown(SI + 1)
            EvtOnMouseMove(SI) = EvtOnMouseMove(SI + 1)
            EvtOnMouseUp(SI) = EvtOnMouseUp(SI + 1)
            EvtOnKeyDown(SI) = EvtOnKeyDown(SI + 1)
            EvtOnKeyPress(SI) = EvtOnKeyPress(SI + 1)
            EvtOnKeyUp(SI) = EvtOnKeyUp(SI + 1)
            EvtOnTimer(SI) = EvtOnTimer(SI + 1)
            EvtOnPaint(SI) = EvtOnPaint(SI + 1)
            EvtOnEnter(SI) = EvtOnEnter(SI + 1)
            EvtOnConnect(SI) = EvtOnConnect(SI + 1)
            EvtOnDisconnect(SI) = EvtOnDisconnect(SI + 1)
            EvtOnError(SI) = EvtOnError(SI + 1)
            EvtOnQueryDone(SI) = EvtOnQueryDone(SI + 1)
        NEXT SI
        ' Clear the last slot
        EvtOnClick(100) = "" : EvtOnDblClick(100) = "" : EvtOnChange(100) = ""
        EvtOnMouseDown(100) = "" : EvtOnMouseMove(100) = "" : EvtOnMouseUp(100) = ""
        EvtOnKeyDown(100) = "" : EvtOnKeyPress(100) = "" : EvtOnKeyUp(100) = ""
        EvtOnTimer(100) = "" : EvtOnPaint(100) = "" : EvtOnEnter(100) = ""
        EvtOnConnect(100) = "" : EvtOnDisconnect(100) = "" : EvtOnError(100) = "" : EvtOnQueryDone(100) = ""

        SelIndex = 0
        UpdateObjCombo
        UpdateProjectTree
        FillProperties
        FillEvents
        StatusBar.Caption = "Deleted: " + CN
    END IF
END SUB

SUB IDEKeyDown(KeyCode AS INTEGER)
    ' Delete or Backspace key deletes selected component in design mode
    IF ShowingCode = 0 THEN
        IF KeyCode = 127 OR KeyCode = 8 THEN
            DeleteSelected
        END IF
    END IF
END SUB

SUB ObjComboChange
    IF SyncGuard = 1 THEN EXIT SUB
    SaveEvents
    DIM Idx AS INTEGER
    Idx = ObjCombo.ItemIndex
    IF Idx < 0 THEN EXIT SUB
    SelIndex = Idx
    IF Idx > 0 THEN
        DesignSurface.SelectComp(Idx - 1)
    END IF
    FillProperties
    FillEvents
END SUB

SUB ErrorListClick
    DIM Idx AS INTEGER
    Idx = ErrorList.ItemIndex
    IF Idx >= 0 AND Idx < ErrorCount THEN
        IF ShowingCode = 0 THEN
            GenerateCode
            DesignSurface.Hide
            CodeEditor.Visible = 1
            ShowingCode = 1
        END IF
        CodeEditor.GotoLine(ErrorLines(Idx))
    END IF
END SUB

SUB ExitIDE
    IDE.Close
END SUB

SUB ProjectTreeClick
    DIM SelItem AS STRING
    SelItem = ProjectTree.SelectedItem
    IF SelItem = "" THEN EXIT SUB

    ' Check if the clicked item matches a component name
    ' Tree items are like "Button1 (RButton)" — extract the name part
    DIM SpacePos AS INTEGER
    SpacePos = INSTR(SelItem, " ")
    DIM CompName AS STRING
    IF SpacePos > 0 THEN
        CompName = LEFT$(SelItem, SpacePos - 1)
    ELSE
        CompName = SelItem
    END IF

    ' Check if it's "Form1"
    IF UCASE$(CompName) = "FORM1" THEN
        SelIndex = 0
        UpdateObjCombo
        FillProperties
        FillEvents
        StatusBar.Caption = "Form1 selected"
        EXIT SUB
    END IF

    ' Find the component on the design surface
    DIM N AS INTEGER
    N = DesignSurface.CompCount
    DIM I AS INTEGER
    FOR I = 0 TO N - 1
        IF UCASE$(DesignSurface.GetName(I)) = UCASE$(CompName) THEN
            SelIndex = I + 1
            DesignSurface.SelectComp(I)
            UpdateObjCombo
            FillProperties
            FillEvents
            StatusBar.Caption = DesignSurface.GetType(I) + ": " + CompName + " selected"
            EXIT SUB
        END IF
    NEXT I
END SUB

' ============================================================
' EVENT EDITOR HANDLERS
' ============================================================

SUB OpenEventEditor(CompIdx AS INTEGER, EvtName AS STRING, HandlerName AS STRING)
    ' Store editing state
    EditingEvtIndex = CompIdx
    EditingEvtName = EvtName
    EditingEvtHandler = HandlerName
    EventEditorResult = 0

    ' Get event params for the header
    DIM Params AS STRING
    Params = GetEventParams(EvtName)
    IF Params <> "" THEN
        lblEvtHeader.Caption = "SUB " + HandlerName + "(" + Params + ")"
    ELSE
        lblEvtHeader.Caption = "SUB " + HandlerName
    END IF
    lblEvtFooter.Caption = "END SUB"

    ' Load existing code body from stored arrays only
    DIM ExistingBody AS STRING
    ExistingBody = GetEventCodeBody(CompIdx, EvtName)

    IF ExistingBody = "" THEN
        EditorTempCode = "    '-- Enter your code here" + CHR$(10)
    ELSE
        EditorTempCode = ExistingBody
    END IF

    ' Set the text BEFORE showing — first time won't have a widget yet,
    ' so also store it for the CREATE-time initialization
    edtEvtCode.Text = EditorTempCode

    EventEditorDlg.ShowModal

    ' After ShowModal returns, force-set the text again on next open
    ' (ensures the buffer is correctly synced with the widget)
END SUB

SUB EventEditorOK
    ' Save the code body back to the arrays
    DIM Body AS STRING
    Body = edtEvtCode.Text

    ' Trim trailing newlines
    DO WHILE RIGHT$(Body, 1) = CHR$(10)
        Body = LEFT$(Body, LEN(Body) - 1)
    LOOP

    SetEventCodeBody EditingEvtIndex, EditingEvtName, Body
    EventEditorResult = 1

    ' If code view is showing, regenerate to update the SUB
    IF ShowingCode = 1 THEN
        GenerateCode
        CodeDirty = 0
    END IF

    EventEditorDlg.Close
    StatusBar.Caption = "Event code saved: " + EditingEvtHandler
END SUB

SUB EventEditorCancel
    EventEditorResult = 0
    EventEditorDlg.Close
END SUB

SUB EventEditorOnShow
    ' Force-set the code editor text after the dialog window is fully shown.
    ' This ensures the widget and TextBuffer exist before we set text.
    edtEvtCode.Text = EditorTempCode
END SUB

' ============================================================
' EVENT EDITOR DIALOG
' ============================================================

CREATE EventEditorDlg AS RFORM
    Caption = "Event Editor"
    Width = 620
    Height = 520
    OnShow = EventEditorOnShow
    Center

    CREATE lblEvtHeader AS RLABEL
        Left = 10 : Top = 10
        Width = 596 : Height = 20
        Caption = "SUB EventHandler"
        Font.Name = "Courier New"
        Font.Size = 11
    END CREATE

    CREATE edtEvtCode AS RCODEEDITOR
        Left = 10 : Top = 34
        Width = 596 : Height = 400
    END CREATE

    CREATE lblEvtFooter AS RLABEL
        Left = 10 : Top = 438
        Width = 596 : Height = 20
        Caption = "END SUB"
        Font.Name = "Courier New"
        Font.Size = 11
    END CREATE

    CREATE btnEvtOK AS RBUTTON
        Left = 420 : Top = 462
        Width = 90 : Height = 28
        Caption = "OK"
        OnClick = EventEditorOK
    END CREATE

    CREATE btnEvtCancel AS RBUTTON
        Left = 516 : Top = 462
        Width = 90 : Height = 28
        Caption = "Cancel"
        OnClick = EventEditorCancel
    END CREATE
END CREATE

