FUNCTION GenerateCompName(CompType AS STRING) AS STRING
    DIM CT AS STRING
    CT = UCASE$(CompType)
    IF CT = "RBUTTON" THEN BtnCount = BtnCount + 1 : GenerateCompName = "Button" + STR$(BtnCount) : EXIT FUNCTION
    IF CT = "RLABEL" THEN LblCount = LblCount + 1 : GenerateCompName = "Label" + STR$(LblCount) : EXIT FUNCTION
    IF CT = "REDIT" THEN EdtCount = EdtCount + 1 : GenerateCompName = "Edit" + STR$(EdtCount) : EXIT FUNCTION
    IF CT = "RCHECKBOX" THEN ChkCount = ChkCount + 1 : GenerateCompName = "CheckBox" + STR$(ChkCount) : EXIT FUNCTION
    IF CT = "RCOMBOBOX" THEN CmbCount = CmbCount + 1 : GenerateCompName = "ComboBox" + STR$(CmbCount) : EXIT FUNCTION
    IF CT = "RPANEL" THEN PnlCount = PnlCount + 1 : GenerateCompName = "Panel" + STR$(PnlCount) : EXIT FUNCTION
    IF CT = "RRADIOBUTTON" THEN RadCount = RadCount + 1 : GenerateCompName = "Radio" + STR$(RadCount) : EXIT FUNCTION
    IF CT = "RLISTBOX" THEN LstCount = LstCount + 1 : GenerateCompName = "ListBox" + STR$(LstCount) : EXIT FUNCTION
    IF CT = "RGROUPBOX" THEN GrpCount = GrpCount + 1 : GenerateCompName = "GroupBox" + STR$(GrpCount) : EXIT FUNCTION
    IF CT = "RPROGRESSBAR" THEN PrgCount = PrgCount + 1 : GenerateCompName = "Progress" + STR$(PrgCount) : EXIT FUNCTION
    IF CT = "RTIMER" THEN TmrCount = TmrCount + 1 : GenerateCompName = "Timer" + STR$(TmrCount) : EXIT FUNCTION
    IF CT = "RRICHEDIT" THEN RchCount = RchCount + 1 : GenerateCompName = "RichEdit" + STR$(RchCount) : EXIT FUNCTION
    IF CT = "RCANVAS" THEN CnvCount = CnvCount + 1 : GenerateCompName = "Canvas" + STR$(CnvCount) : EXIT FUNCTION
    IF CT = "RMYSQL" THEN MySqlCount = MySqlCount + 1 : GenerateCompName = "MySQL" + STR$(MySqlCount) : EXIT FUNCTION
    IF CT = "RSQLITE" THEN SQLiteCount = SQLiteCount + 1 : GenerateCompName = "SQLite" + STR$(SQLiteCount) : EXIT FUNCTION
    IF CT = "RTREEVIEW" THEN TrvCount = TrvCount + 1 : GenerateCompName = "TreeView" + STR$(TrvCount) : EXIT FUNCTION
    IF CT = "RIMAGE" THEN ImgCount = ImgCount + 1 : GenerateCompName = "Image" + STR$(ImgCount) : EXIT FUNCTION
    IF CT = "RTRACKBAR" THEN TrkCount = TrkCount + 1 : GenerateCompName = "TrackBar" + STR$(TrkCount) : EXIT FUNCTION
    IF CT = "RSPLITTER" THEN SplCount = SplCount + 1 : GenerateCompName = "Splitter" + STR$(SplCount) : EXIT FUNCTION
    IF CT = "RSTRINGGRID" THEN SgdCount = SgdCount + 1 : GenerateCompName = "Grid" + STR$(SgdCount) : EXIT FUNCTION
    IF CT = "RSCROLLBOX" THEN SbxCount = SbxCount + 1 : GenerateCompName = "ScrollBox" + STR$(SbxCount) : EXIT FUNCTION
    IF CT = "RNUM" THEN NumCount = NumCount + 1 : GenerateCompName = "Num" + STR$(NumCount) : EXIT FUNCTION
    IF CT = "RDATAFRAME" THEN DfCount = DfCount + 1 : GenerateCompName = "DataFrame" + STR$(DfCount) : EXIT FUNCTION
    IF CT = "RPLOT" THEN PlotCount = PlotCount + 1 : GenerateCompName = "Plot" + STR$(PlotCount) : EXIT FUNCTION
    IF CT = "RCOOLBTN" THEN CoolBtnCount = CoolBtnCount + 1 : GenerateCompName = "CoolBtn" + STR$(CoolBtnCount) : EXIT FUNCTION
    IF CT = "ROVALBTN" THEN OvalBtnCount = OvalBtnCount + 1 : GenerateCompName = "OvalBtn" + STR$(OvalBtnCount) : EXIT FUNCTION
    IF CT = "RJSON" THEN JsnCount = JsnCount + 1 : GenerateCompName = "Json" + STR$(JsnCount) : EXIT FUNCTION
    GenerateCompName = "Widget1"
END FUNCTION

FUNCTION GetEventParams(EvtName AS STRING) AS STRING
    DIM EN AS STRING
    EN = UCASE$(EvtName)
    IF EN = "ONMOUSEDOWN" OR EN = "ONMOUSEMOVE" OR EN = "ONMOUSEUP" THEN
        GetEventParams = "(X AS INTEGER, Y AS INTEGER)"
        EXIT FUNCTION
    END IF
    IF EN = "ONKEYDOWN" OR EN = "ONKEYUP" OR EN = "ONKEYPRESS" THEN
        GetEventParams = "(KeyCode AS INTEGER)"
        EXIT FUNCTION
    END IF
    IF EN = "ONQUERYDONE" THEN
        GetEventParams = "(Result AS INTEGER)"
        EXIT FUNCTION
    END IF
    GetEventParams = ""
END FUNCTION

FUNCTION GetDefaultEvent(CompType AS STRING) AS STRING
    DIM CT AS STRING
    CT = UCASE$(CompType)
    IF CT = "RBUTTON" OR CT = "RCHECKBOX" OR CT = "RRADIOBUTTON" OR CT = "RCOOLBTN" OR CT = "ROVALBTN" THEN GetDefaultEvent = "OnClick" : EXIT FUNCTION
    IF CT = "REDIT" OR CT = "RCOMBOBOX" OR CT = "RTRACKBAR" THEN GetDefaultEvent = "OnChange" : EXIT FUNCTION
    IF CT = "RTIMER" THEN GetDefaultEvent = "OnTimer" : EXIT FUNCTION
    IF CT = "RLISTBOX" THEN GetDefaultEvent = "OnClick" : EXIT FUNCTION
    IF CT = "RCANVAS" THEN GetDefaultEvent = "OnPaint" : EXIT FUNCTION
    IF CT = "RMYSQL" OR CT = "RSQLITE" THEN GetDefaultEvent = "OnQueryDone" : EXIT FUNCTION
    GetDefaultEvent = "OnClick"
END FUNCTION

FUNCTION ExtractSub(Source AS STRING, SubName AS STRING) AS STRING
    DIM P AS INTEGER
    DIM SN AS STRING
    SN = "SUB " + UCASE$(SubName)
    P = INSTR(UCASE$(Source), SN)
    IF P > 0 THEN
        DIM E AS INTEGER
        E = INSTR(P + 1, UCASE$(Source), "END SUB")
        IF E > 0 THEN
            ExtractSub = MID$(Source, P, E - P + 7)
            EXIT FUNCTION
        END IF
    END IF
    ExtractSub = ""
END FUNCTION

FUNCTION GetEventCodeBody(CI AS INTEGER, EvtName AS STRING) AS STRING
    ' CI=0 means form-level events, CI>0 means component events
    DIM UE AS STRING
    UE = UCASE$(EvtName)
    IF CI = 0 THEN
        IF UE = "ONSHOW" THEN GetEventCodeBody = FormCodeOnShow
        IF UE = "ONCLOSE" THEN GetEventCodeBody = FormCodeOnClose
        IF UE = "ONRESIZE" THEN GetEventCodeBody = FormCodeOnResize
        IF UE = "ONCLICK" THEN GetEventCodeBody = FormCodeOnClick
        IF UE = "ONKEYDOWN" THEN GetEventCodeBody = FormCodeOnKeyDown
        IF UE = "ONPAINT" THEN GetEventCodeBody = FormCodeOnPaint
        IF UE = "ONMOUSEDOWN" THEN GetEventCodeBody = FormCodeOnMouseDown
        IF UE = "ONMOUSEMOVE" THEN GetEventCodeBody = FormCodeOnMouseMove
        IF UE = "ONMOUSEUP" THEN GetEventCodeBody = FormCodeOnMouseUp
    ELSE
        IF UE = "ONCLICK" THEN GetEventCodeBody = EvtCodeOnClick(CI)
        IF UE = "ONDBLCLICK" THEN GetEventCodeBody = EvtCodeOnDblClick(CI)
        IF UE = "ONCHANGE" THEN GetEventCodeBody = EvtCodeOnChange(CI)
        IF UE = "ONTIMER" THEN GetEventCodeBody = EvtCodeOnTimer(CI)
        IF UE = "ONPAINT" THEN GetEventCodeBody = EvtCodeOnPaint(CI)
        IF UE = "ONMOUSEDOWN" THEN GetEventCodeBody = EvtCodeOnMouseDown(CI)
        IF UE = "ONMOUSEMOVE" THEN GetEventCodeBody = EvtCodeOnMouseMove(CI)
        IF UE = "ONMOUSEUP" THEN GetEventCodeBody = EvtCodeOnMouseUp(CI)
        IF UE = "ONKEYDOWN" THEN GetEventCodeBody = EvtCodeOnKeyDown(CI)
        IF UE = "ONQUERYDONE" THEN GetEventCodeBody = EvtCodeOnQueryDone(CI)
    END IF
END FUNCTION

FUNCTION ExtractSubBody(Source AS STRING, SubName AS STRING) AS STRING
    DIM SN AS STRING
    SN = "SUB " + UCASE$(SubName)
    DIM P AS INTEGER
    P = INSTR(UCASE$(Source), SN)
    IF P > 0 THEN
        ' Find end of SUB header line
        DIM LineEnd AS INTEGER
        LineEnd = INSTR(P, Source, CHR$(10))
        IF LineEnd = 0 THEN
            ExtractSubBody = ""
            EXIT FUNCTION
        END IF
        DIM E AS INTEGER
        E = INSTR(LineEnd + 1, UCASE$(Source), "END SUB")
        IF E > 0 THEN
            DIM Body AS STRING
            Body = MID$(Source, LineEnd + 1, E - LineEnd - 1)
            ' Trim leading/trailing whitespace lines
            DO WHILE LEFT$(Body, 1) = CHR$(10)
                Body = MID$(Body, 2)
            LOOP
            DO WHILE RIGHT$(Body, 1) = CHR$(10)
                Body = LEFT$(Body, LEN(Body) - 1)
            LOOP
            ExtractSubBody = Body
            EXIT FUNCTION
        END IF
    END IF
    ExtractSubBody = ""
END FUNCTION

SUB SetEventCodeBody(CI AS INTEGER, EvtName AS STRING, CodeBody AS STRING)
    ' CI=0 means form-level events, CI>0 means component events
    DIM UE AS STRING
    UE = UCASE$(EvtName)
    IF CI = 0 THEN
        IF UE = "ONSHOW" THEN FormCodeOnShow = CodeBody
        IF UE = "ONCLOSE" THEN FormCodeOnClose = CodeBody
        IF UE = "ONRESIZE" THEN FormCodeOnResize = CodeBody
        IF UE = "ONCLICK" THEN FormCodeOnClick = CodeBody
        IF UE = "ONKEYDOWN" THEN FormCodeOnKeyDown = CodeBody
        IF UE = "ONPAINT" THEN FormCodeOnPaint = CodeBody
        IF UE = "ONMOUSEDOWN" THEN FormCodeOnMouseDown = CodeBody
        IF UE = "ONMOUSEMOVE" THEN FormCodeOnMouseMove = CodeBody
        IF UE = "ONMOUSEUP" THEN FormCodeOnMouseUp = CodeBody
    ELSE
        IF UE = "ONCLICK" THEN EvtCodeOnClick(CI) = CodeBody
        IF UE = "ONDBLCLICK" THEN EvtCodeOnDblClick(CI) = CodeBody
        IF UE = "ONCHANGE" THEN EvtCodeOnChange(CI) = CodeBody
        IF UE = "ONTIMER" THEN EvtCodeOnTimer(CI) = CodeBody
        IF UE = "ONPAINT" THEN EvtCodeOnPaint(CI) = CodeBody
        IF UE = "ONMOUSEDOWN" THEN EvtCodeOnMouseDown(CI) = CodeBody
        IF UE = "ONMOUSEMOVE" THEN EvtCodeOnMouseMove(CI) = CodeBody
        IF UE = "ONMOUSEUP" THEN EvtCodeOnMouseUp(CI) = CodeBody
        IF UE = "ONKEYDOWN" THEN EvtCodeOnKeyDown(CI) = CodeBody
        IF UE = "ONQUERYDONE" THEN EvtCodeOnQueryDone(CI) = CodeBody
    END IF
END SUB

SUB SyncEventCodeFromSource
    ' Extract all event handler code bodies from CodeEditor.Text back into EvtCode* arrays
    DIM Src AS STRING
    Src = CodeEditor.Text
    IF Src = "" THEN EXIT SUB

    DIM N AS INTEGER
    N = DesignSurface.CompCount

    ' Sync form-level events
    DIM FEvts(6) AS STRING
    FEvts(0) = "OnShow"
    FEvts(1) = "OnClose"
    FEvts(2) = "OnResize"
    FEvts(3) = "OnClick"
    FEvts(4) = "OnKeyDown"
    FEvts(5) = "OnPaint"
    DIM FI AS INTEGER
    FOR FI = 0 TO 5
        DIM FHandler AS STRING
        FHandler = ""
        IF FEvts(FI) = "OnShow" AND FormOnShow <> "" THEN FHandler = FormOnShow
        IF FEvts(FI) = "OnClose" AND FormOnClose <> "" THEN FHandler = FormOnClose
        IF FEvts(FI) = "OnResize" AND FormOnResize <> "" THEN FHandler = FormOnResize
        IF FEvts(FI) = "OnClick" AND FormOnClick <> "" THEN FHandler = FormOnClick
        IF FEvts(FI) = "OnKeyDown" AND FormOnKeyDown <> "" THEN FHandler = FormOnKeyDown
        IF FEvts(FI) = "OnPaint" AND FormOnPaint <> "" THEN FHandler = FormOnPaint
        IF FHandler <> "" THEN
            DIM FBody AS STRING
            FBody = ExtractSubBody(Src, FHandler)
            IF FBody <> "" THEN
                SetEventCodeBody 0, FEvts(FI), FBody
            END IF
        END IF
    NEXT FI

    ' Sync component events
    DIM SI AS INTEGER
    FOR SI = 0 TO N - 1
        DIM SCI AS INTEGER
        SCI = SI + 1
        DIM EvtNames(10) AS STRING
        EvtNames(0) = "OnClick"
        EvtNames(1) = "OnDblClick"
        EvtNames(2) = "OnChange"
        EvtNames(3) = "OnTimer"
        EvtNames(4) = "OnPaint"
        EvtNames(5) = "OnMouseDown"
        EvtNames(6) = "OnMouseMove"
        EvtNames(7) = "OnMouseUp"
        EvtNames(8) = "OnKeyDown"
        EvtNames(9) = "OnQueryDone"
        DIM EI AS INTEGER
        FOR EI = 0 TO 9
            DIM HName AS STRING
            HName = ""
            IF EvtNames(EI) = "OnClick" AND EvtOnClick(SCI) <> "" THEN HName = EvtOnClick(SCI)
            IF EvtNames(EI) = "OnDblClick" AND EvtOnDblClick(SCI) <> "" THEN HName = EvtOnDblClick(SCI)
            IF EvtNames(EI) = "OnChange" AND EvtOnChange(SCI) <> "" THEN HName = EvtOnChange(SCI)
            IF EvtNames(EI) = "OnTimer" AND EvtOnTimer(SCI) <> "" THEN HName = EvtOnTimer(SCI)
            IF EvtNames(EI) = "OnPaint" AND EvtOnPaint(SCI) <> "" THEN HName = EvtOnPaint(SCI)
            IF EvtNames(EI) = "OnMouseDown" AND EvtOnMouseDown(SCI) <> "" THEN HName = EvtOnMouseDown(SCI)
            IF EvtNames(EI) = "OnMouseMove" AND EvtOnMouseMove(SCI) <> "" THEN HName = EvtOnMouseMove(SCI)
            IF EvtNames(EI) = "OnMouseUp" AND EvtOnMouseUp(SCI) <> "" THEN HName = EvtOnMouseUp(SCI)
            IF EvtNames(EI) = "OnKeyDown" AND EvtOnKeyDown(SCI) <> "" THEN HName = EvtOnKeyDown(SCI)
            IF EvtNames(EI) = "OnQueryDone" AND EvtOnQueryDone(SCI) <> "" THEN HName = EvtOnQueryDone(SCI)
            IF HName <> "" THEN
                DIM EBody AS STRING
                EBody = ExtractSubBody(Src, HName)
                IF EBody <> "" THEN
                    SetEventCodeBody SCI, EvtNames(EI), EBody
                END IF
            END IF
        NEXT EI
    NEXT SI
END SUB

FUNCTION GenerateSubCode(ExistingCode AS STRING, HandlerName AS STRING, CompName AS STRING, EvtName AS STRING, CodeBody AS STRING) AS STRING
    DIM Params AS STRING
    Params = GetEventParams(EvtName)
    DIM Existing AS STRING
    Existing = ExtractSub(ExistingCode, HandlerName)
    IF Existing <> "" THEN
        ' If we have a stored code body, replace the existing SUB body
        IF CodeBody <> "" THEN
            DIM NewSub AS STRING
            NewSub = "SUB " + HandlerName + Params + CHR$(10)
            NewSub = NewSub + CodeBody + CHR$(10)
            NewSub = NewSub + "END SUB"
            DIM BeforeSub AS STRING
            DIM AfterSub AS STRING
            DIM SubPos AS INTEGER
            SubPos = INSTR(UCASE$(ExistingCode), "SUB " + UCASE$(HandlerName))
            IF SubPos > 0 THEN
                BeforeSub = LEFT$(ExistingCode, SubPos - 1)
                DIM EndSubPos AS INTEGER
                EndSubPos = INSTR(SubPos, UCASE$(ExistingCode), "END SUB")
                IF EndSubPos > 0 THEN
                    AfterSub = MID$(ExistingCode, EndSubPos + 7)
                    GenerateSubCode = BeforeSub + NewSub + AfterSub
                    EXIT FUNCTION
                END IF
            END IF
        END IF
        GenerateSubCode = ExistingCode
        EXIT FUNCTION
    END IF
    DIM Stub AS STRING
    Stub = CHR$(10) + "SUB " + HandlerName + Params + CHR$(10)
    IF CodeBody <> "" THEN
        Stub = Stub + CodeBody + CHR$(10)
    ELSE
        Stub = Stub + "    '-- Enter your code here" + CHR$(10)
    END IF
    Stub = Stub + "END SUB" + CHR$(10)

    ' Insert before the CREATE marker so SUBs stay above the GUI block
    DIM InsertPos AS INTEGER
    InsertPos = INSTR(ExistingCode, "' [AUTO-FORM]")
    IF InsertPos = 0 THEN InsertPos = INSTR(ExistingCode, "' === Main Form ===")
    IF InsertPos = 0 THEN InsertPos = INSTR(UCASE$(ExistingCode), "CREATE FORM1 AS RFORM")
    IF InsertPos > 0 THEN
        GenerateSubCode = LEFT$(ExistingCode, InsertPos - 1) + Stub + CHR$(10) + MID$(ExistingCode, InsertPos)
    ELSE
        GenerateSubCode = ExistingCode + Stub
    END IF
END FUNCTION

' ============================================================
' OBJECT COMBO & PROPERTY/EVENT MANAGEMENT
' ============================================================

SUB UpdateObjCombo
    DIM I AS INTEGER
    ObjCombo.Clear
    ObjCombo.AddItems("Form1")
    FOR I = 0 TO DesignSurface.CompCount - 1
        ObjCombo.AddItems(DesignSurface.GetName(I))
    NEXT I
    IF SelIndex >= 0 AND SelIndex <= DesignSurface.CompCount THEN
        ObjCombo.ItemIndex = SelIndex
    ELSE
        ObjCombo.ItemIndex = 0
    END IF
END SUB

SUB UpdateProjectTree
    ProjectTree.Clear
    ProjectTree.AddRoot("Project1")
    ProjectTree.AddChild("Project1", "Form1 (Form)")
    DIM I AS INTEGER
    FOR I = 0 TO DesignSurface.CompCount - 1
        DIM CN AS STRING
        DIM CT AS STRING
        CN = DesignSurface.GetName(I)
        CT = DesignSurface.GetType(I)
        ProjectTree.AddChild("Form1 (Form)", CN + " (" + CT + ")")
    NEXT I
END SUB

SUB SaveEvents
    DIM I AS INTEGER
    DIM CI AS INTEGER
    DIM NR AS INTEGER
    DIM EvtName AS STRING
    DIM HandlerName AS STRING

    IF SelIndex = 0 THEN
        NR = EvtGrid.RowCount
        FOR I = 1 TO NR - 1
            EvtName = UCASE$(EvtGrid.Cell(I, 0))
            HandlerName = EvtGrid.Cell(I, 1)
            IF EvtName = "ONSHOW" THEN FormOnShow = HandlerName
            IF EvtName = "ONCLOSE" THEN FormOnClose = HandlerName
            IF EvtName = "ONRESIZE" THEN FormOnResize = HandlerName
            IF EvtName = "ONKEYDOWN" THEN FormOnKeyDown = HandlerName
            IF EvtName = "ONKEYPRESS" THEN FormOnKeyPress = HandlerName
            IF EvtName = "ONKEYUP" THEN FormOnKeyUp = HandlerName
            IF EvtName = "ONCLICK" THEN FormOnClick = HandlerName
            IF EvtName = "ONMOUSEDOWN" THEN FormOnMouseDown = HandlerName
            IF EvtName = "ONMOUSEMOVE" THEN FormOnMouseMove = HandlerName
            IF EvtName = "ONMOUSEUP" THEN FormOnMouseUp = HandlerName
            IF EvtName = "ONPAINT" THEN FormOnPaint = HandlerName
        NEXT I
    ELSE
        CI = SelIndex
        IF CI < 1 OR CI > 100 THEN EXIT SUB
        NR = EvtGrid.RowCount
        FOR I = 1 TO NR - 1
            EvtName = UCASE$(EvtGrid.Cell(I, 0))
            HandlerName = EvtGrid.Cell(I, 1)
            IF EvtName = "ONCLICK" THEN EvtOnClick(CI) = HandlerName
            IF EvtName = "ONDBLCLICK" THEN EvtOnDblClick(CI) = HandlerName
            IF EvtName = "ONCHANGE" THEN EvtOnChange(CI) = HandlerName
            IF EvtName = "ONMOUSEDOWN" THEN EvtOnMouseDown(CI) = HandlerName
            IF EvtName = "ONMOUSEMOVE" THEN EvtOnMouseMove(CI) = HandlerName
            IF EvtName = "ONMOUSEUP" THEN EvtOnMouseUp(CI) = HandlerName
            IF EvtName = "ONKEYDOWN" THEN EvtOnKeyDown(CI) = HandlerName
            IF EvtName = "ONKEYPRESS" THEN EvtOnKeyPress(CI) = HandlerName
            IF EvtName = "ONKEYUP" THEN EvtOnKeyUp(CI) = HandlerName
            IF EvtName = "ONTIMER" THEN EvtOnTimer(CI) = HandlerName
            IF EvtName = "ONPAINT" THEN EvtOnPaint(CI) = HandlerName
            IF EvtName = "ONENTER" THEN EvtOnEnter(CI) = HandlerName
            IF EvtName = "ONCONNECT" THEN EvtOnConnect(CI) = HandlerName
            IF EvtName = "ONDISCONNECT" THEN EvtOnDisconnect(CI) = HandlerName
            IF EvtName = "ONERROR" THEN EvtOnError(CI) = HandlerName
            IF EvtName = "ONQUERYDONE" THEN EvtOnQueryDone(CI) = HandlerName
        NEXT I
    END IF
END SUB

' ============================================================
' FILL PROPERTIES (right panel)
' ============================================================

SUB FillProperties
    IF SyncGuard = 1 THEN EXIT SUB
    SyncGuard = 1
    PropGrid.Clear

    IF SelIndex = 0 THEN
        PropGrid.AddRow("(Name)", "Form1")
        PropGrid.AddRow("Caption", DesignSurface.FormCaption)
        PropGrid.AddRow("Width", STR$(DesignSurface.Width))
        PropGrid.AddRow("Height", STR$(DesignSurface.Height))
        PropGrid.AddRow("Color", "")
        PropGrid.AddRow("Font.Name", "Helvetica")
        PropGrid.AddRow("Font.Size", "12")
        PropGrid.AddRow("KeyPreview", "False")
    ELSE
        DIM CI AS INTEGER
        DIM CT AS STRING
        CI = SelIndex - 1
        CT = UCASE$(DesignSurface.GetType(CI))

        PropGrid.AddRow("(Name)", DesignSurface.GetName(CI))
        PropGrid.AddRow("Left", STR$(DesignSurface.GetCompX(CI)))
        PropGrid.AddRow("Top", STR$(DesignSurface.GetCompY(CI)))
        PropGrid.AddRow("Width", STR$(DesignSurface.GetCompW(CI)))
        PropGrid.AddRow("Height", STR$(DesignSurface.GetCompH(CI)))

        IF CT = "RBUTTON" OR CT = "RLABEL" OR CT = "RCHECKBOX" OR CT = "RRADIOBUTTON" OR CT = "RGROUPBOX" OR CT = "RCOOLBTN" OR CT = "ROVALBTN" THEN
            PropGrid.AddRow("Caption", DesignSurface.GetProp(CI, "caption"))
        END IF

        IF CT = "REDIT" OR CT = "RRICHEDIT" OR CT = "RCODEEDITOR" THEN
            PropGrid.AddRow("Text", DesignSurface.GetProp(CI, "text"))
        END IF

        IF CT = "RCOOLBTN" OR CT = "ROVALBTN" THEN
            DIM FlatVal AS STRING
            FlatVal = DesignSurface.GetProp(CI, "flat")
            IF FlatVal = "" THEN FlatVal = "False"
            PropGrid.AddRow("Flat", FlatVal)

            DIM GrpIdxVal AS STRING
            GrpIdxVal = DesignSurface.GetProp(CI, "groupindex")
            IF GrpIdxVal = "" THEN GrpIdxVal = "0"
            PropGrid.AddRow("GroupIndex", GrpIdxVal)

            DIM DownVal AS STRING
            DownVal = DesignSurface.GetProp(CI, "down")
            IF DownVal = "" THEN DownVal = "False"
            PropGrid.AddRow("Down", DownVal)

            DIM AllUpVal AS STRING
            AllUpVal = DesignSurface.GetProp(CI, "allowallup")
            IF AllUpVal = "" THEN AllUpVal = "False"
            PropGrid.AddRow("AllowAllUp", AllUpVal)
        END IF

        IF CT = "RCOOLBTN" THEN
            DIM NbVal AS STRING
            NbVal = DesignSurface.GetProp(CI, "numbmps")
            IF NbVal = "" THEN NbVal = "1"
            PropGrid.AddRow("NumBMPs", NbVal)
            PropGrid.AddRow("BMP", DesignSurface.GetProp(CI, "bmp"))
        END IF

        IF CT = "ROVALBTN" THEN
            PropGrid.AddRow("Color", DesignSurface.GetProp(CI, "color"))
            PropGrid.AddRow("ColorHighlight", DesignSurface.GetProp(CI, "colorhighlight"))
            PropGrid.AddRow("ColorShadow", DesignSurface.GetProp(CI, "colorshadow"))
        END IF

        IF CT = "RLABEL" THEN
            DIM AlVal AS STRING
            AlVal = DesignSurface.GetProp(CI, "alignment")
            IF AlVal = "" THEN AlVal = "0"
            PropGrid.AddRow("Alignment", AlVal)
            PropGrid.AddRow("WordWrap", DesignSurface.GetProp(CI, "wordwrap"))
        END IF

        IF CT = "RCHECKBOX" OR CT = "RRADIOBUTTON" THEN
            DIM ChkVal AS STRING
            ChkVal = DesignSurface.GetProp(CI, "checked")
            IF ChkVal = "" THEN ChkVal = "False"
            PropGrid.AddRow("Checked", ChkVal)
        END IF

        ' Color is now in the universal font/color section below

        IF CT = "RPANEL" OR CT = "RGROUPBOX" THEN
            DIM BSVal AS STRING
            BSVal = DesignSurface.GetProp(CI, "borderstyle")
            IF BSVal = "" THEN BSVal = "0"
            PropGrid.AddRow("BorderStyle", BSVal)
        END IF

        IF CT = "RIMAGE" THEN
            PropGrid.AddRow("BMP", DesignSurface.GetProp(CI, "bmp"))
            PropGrid.AddRow("Stretch", DesignSurface.GetProp(CI, "stretch"))
        END IF

        IF CT = "RPROGRESSBAR" THEN
            PropGrid.AddRow("Min", DesignSurface.GetProp(CI, "min"))
            PropGrid.AddRow("Max", DesignSurface.GetProp(CI, "max"))
            PropGrid.AddRow("Position", DesignSurface.GetProp(CI, "position"))
        END IF

        IF CT = "RTIMER" THEN
            DIM IntVal AS STRING
            IntVal = DesignSurface.GetProp(CI, "interval")
            IF IntVal = "" THEN IntVal = "1000"
            PropGrid.AddRow("Interval", IntVal)
            PropGrid.AddRow("Enabled", DesignSurface.GetProp(CI, "enabled"))
        END IF

        IF CT = "RTRACKBAR" THEN
            PropGrid.AddRow("Min", DesignSurface.GetProp(CI, "min"))
            PropGrid.AddRow("Max", DesignSurface.GetProp(CI, "max"))
            PropGrid.AddRow("Position", DesignSurface.GetProp(CI, "position"))
        END IF

        IF CT = "RSTRINGGRID" THEN
            PropGrid.AddRow("Cols", DesignSurface.GetProp(CI, "cols"))
            PropGrid.AddRow("ColWidth", DesignSurface.GetProp(CI, "colwidth"))
        END IF

        IF CT = "RCOMBOBOX" OR CT = "RLISTBOX" THEN
            PropGrid.AddRow("Items", DesignSurface.GetProp(CI, "items"))
        END IF

        IF CT = "REDIT" THEN
            PropGrid.AddRow("MaxLength", DesignSurface.GetProp(CI, "maxlength"))
            PropGrid.AddRow("ReadOnly", DesignSurface.GetProp(CI, "readonly"))
        END IF

        IF CT = "RMYSQL" OR CT = "RSQLITE" THEN
            PropGrid.AddRow("Database", DesignSurface.GetProp(CI, "database"))
            IF CT = "RMYSQL" THEN
                PropGrid.AddRow("Host", DesignSurface.GetProp(CI, "host"))
                PropGrid.AddRow("User", DesignSurface.GetProp(CI, "user"))
                PropGrid.AddRow("Password", DesignSurface.GetProp(CI, "password"))
                PropGrid.AddRow("Port", DesignSurface.GetProp(CI, "port"))
            END IF
        END IF

        IF CT = "RDATAFRAME" THEN
            PropGrid.AddRow("CsvFile", DesignSurface.GetProp(CI, "csvfile"))
            PropGrid.AddRow("DataSource", DesignSurface.GetProp(CI, "datasource"))
        END IF

        IF CT = "RSTRINGGRID" THEN
            DIM DSrcVal AS STRING
            DSrcVal = DesignSurface.GetProp(CI, "datasource")
            IF DSrcVal <> "" THEN
                PropGrid.AddRow("DataSource", DSrcVal)
            ELSE
                PropGrid.AddRow("DataSource", "")
            END IF
        END IF

        IF CT = "RPLOT" THEN
            PropGrid.AddRow("Title", DesignSurface.GetProp(CI, "title"))
            PropGrid.AddRow("XLabel", DesignSurface.GetProp(CI, "xlabel"))
            PropGrid.AddRow("YLabel", DesignSurface.GetProp(CI, "ylabel"))
            PropGrid.AddRow("Grid", DesignSurface.GetProp(CI, "grid"))
        END IF

        IF CT <> "RTIMER" AND CT <> "RMYSQL" AND CT <> "RSQLITE" AND CT <> "RNUM" AND CT <> "RDATAFRAME" AND CT <> "RPLOT" THEN
            DIM VisVal AS STRING
            VisVal = DesignSurface.GetProp(CI, "visible")
            IF VisVal = "" THEN VisVal = "True"
            PropGrid.AddRow("Visible", VisVal)
        END IF

        IF CT <> "RTIMER" THEN
            DIM EnVal AS STRING
            EnVal = DesignSurface.GetProp(CI, "enabled")
            IF EnVal = "" THEN EnVal = "True"
            PropGrid.AddRow("Enabled", EnVal)
        END IF

        ' Font & Color properties for all visual widgets
        IF CT <> "RTIMER" AND CT <> "RMYSQL" AND CT <> "RSQLITE" AND CT <> "RNUM" AND CT <> "RDATAFRAME" AND CT <> "RPLOT" THEN
            DIM FnVal AS STRING
            FnVal = DesignSurface.GetProp(CI, "font.name")
            IF FnVal = "" THEN FnVal = "Helvetica"
            PropGrid.AddRow("Font.Name", FnVal)

            DIM FsVal AS STRING
            FsVal = DesignSurface.GetProp(CI, "font.size")
            IF FsVal = "" THEN FsVal = "12"
            PropGrid.AddRow("Font.Size", FsVal)

            PropGrid.AddRow("FontColor", DesignSurface.GetProp(CI, "fontcolor"))
            PropGrid.AddRow("Color", DesignSurface.GetProp(CI, "color"))
        END IF
    END IF

    SyncGuard = 0
END SUB

' ============================================================
' FILL EVENTS (right panel)
' ============================================================

SUB FillEvents
    IF SyncGuard = 1 THEN EXIT SUB
    SyncGuard = 1
    EvtGrid.Clear

    ' Header row (row 0 is always rendered as non-editable header)
    EvtGrid.AddRow("Event", "Handler", "...")

    IF SelIndex = 0 THEN
        EvtGrid.AddRow("OnShow", FormOnShow, "...")
        EvtGrid.AddRow("OnClose", FormOnClose, "...")
        EvtGrid.AddRow("OnResize", FormOnResize, "...")
        EvtGrid.AddRow("OnClick", FormOnClick, "...")
        EvtGrid.AddRow("OnKeyDown", FormOnKeyDown, "...")
        EvtGrid.AddRow("OnKeyPress", FormOnKeyPress, "...")
        EvtGrid.AddRow("OnKeyUp", FormOnKeyUp, "...")
        EvtGrid.AddRow("OnMouseDown", FormOnMouseDown, "...")
        EvtGrid.AddRow("OnMouseMove", FormOnMouseMove, "...")
        EvtGrid.AddRow("OnMouseUp", FormOnMouseUp, "...")
        EvtGrid.AddRow("OnPaint", FormOnPaint, "...")
    ELSE
        DIM CI AS INTEGER
        DIM CT AS STRING
        CI = SelIndex
        IF CI < 1 OR CI > 100 THEN SyncGuard = 0 : EXIT SUB
        CT = UCASE$(DesignSurface.GetType(CI - 1))

        EvtGrid.AddRow("OnClick", EvtOnClick(CI), "...")
        EvtGrid.AddRow("OnDblClick", EvtOnDblClick(CI), "...")
        EvtGrid.AddRow("OnChange", EvtOnChange(CI), "...")
        EvtGrid.AddRow("OnMouseDown", EvtOnMouseDown(CI), "...")
        EvtGrid.AddRow("OnMouseMove", EvtOnMouseMove(CI), "...")
        EvtGrid.AddRow("OnMouseUp", EvtOnMouseUp(CI), "...")
        EvtGrid.AddRow("OnKeyDown", EvtOnKeyDown(CI), "...")
        EvtGrid.AddRow("OnKeyPress", EvtOnKeyPress(CI), "...")
        EvtGrid.AddRow("OnKeyUp", EvtOnKeyUp(CI), "...")

        IF CT = "RTIMER" THEN
            EvtGrid.AddRow("OnTimer", EvtOnTimer(CI), "...")
        END IF
        IF CT = "RCANVAS" THEN
            EvtGrid.AddRow("OnPaint", EvtOnPaint(CI), "...")
        END IF
        IF CT = "RMYSQL" OR CT = "RSQLITE" THEN
            EvtGrid.AddRow("OnConnect", EvtOnConnect(CI), "...")
            EvtGrid.AddRow("OnDisconnect", EvtOnDisconnect(CI), "...")
            EvtGrid.AddRow("OnError", EvtOnError(CI), "...")
            EvtGrid.AddRow("OnQueryDone", EvtOnQueryDone(CI), "...")
        END IF
    END IF

    SyncGuard = 0
END SUB

