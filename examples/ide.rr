    END CREATE
    CREATE BtnAddSQLite AS RBUTTON
        Caption = "SQLite"
        Left = 420 : Top = 34 : Width = 48 : Height = 24
        OnClick = SetToolSQLite
    END CREATE

    ' --- Action buttons (right side of toolbar) ---
    CREATE BtnDel AS RBUTTON
        Caption = "Del"
        Left = 700 : Top = 34 : Width = 36 : Height = 24
        OnClick = DeleteSelected
    END CREATE
    CREATE BtnSave AS RBUTTON
        Caption = "Save"
        Left = 740 : Top = 34 : Width = 42 : Height = 24
        OnClick = SaveProject
    END CREATE
    CREATE BtnRun AS RBUTTON
        Caption = "Run"
        Left = 786 : Top = 34 : Width = 36 : Height = 24
        OnClick = CompileAndRun
    END CREATE
    CREATE BtnCode AS RBUTTON
        Caption = "Code"
        Left = 826 : Top = 34 : Width = 42 : Height = 24
