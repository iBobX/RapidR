    END CREATE
    CREATE BtnAddImage AS RBUTTON
        Caption = "Img"
        Left = 188 : Top = 60 : Width = 32 : Height = 24
        OnClick = SetToolImage
    END CREATE
    CREATE BtnAddTrack AS RBUTTON
        Caption = "Trk"
        Left = 222 : Top = 60 : Width = 32 : Height = 24
