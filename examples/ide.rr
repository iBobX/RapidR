    ' === LEFT PANEL: Project Explorer (200px wide) ===
    CREATE LeftPanelLabel AS RLABEL
        Left = 4 : Top = 118
        Width = 190 : Height = 16
        Caption = "Project Explorer"
    END CREATE

    CREATE ProjectTree AS RTREEVIEW
        Left = 4 : Top = 136
        Width = 190 : Height = 340
        OnClick = ProjectTreeClick
    END CREATE

    ' === CENTER: Design Surface (embedded, MDI-style) ===
    CREATE DesignSurface AS RDESIGNSURFACE
        Left = 200 : Top = 118
        Width = 700 : Height = 540
        FormCaption = "Form1"
        OnSelect = DesignSelect
        OnMove = DesignMove
        OnDblClick = DesignDblClick
        OnBgClick = DesignBgClick
    END CREATE

    ' === CENTER: Code Editor (same area, hidden in design mode) ===
    CREATE CodeEditor AS RCODEEDITOR
        Left = 200 : Top = 118
        Width = 700 : Height = 540
        Visible = 0
    END CREATE

    ' === RIGHT PANEL: Object Combo + Properties/Events ===
    CREATE ObjCombo AS RCOMBOBOX
        Left = 906 : Top = 118
        Width = 288 : Height = 24
        OnChange = ObjComboChange
    END CREATE

    CREATE BtnProps AS RBUTTON
        Left = 906 : Top = 146
        Width = 142 : Height = 24
        Caption = "Properties"
        OnClick = ShowPropsGrid
    END CREATE
    CREATE BtnEvts AS RBUTTON
        Left = 1052 : Top = 146
        Width = 142 : Height = 24
        Caption = "Events"
        OnClick = ShowEvtsGrid
    END CREATE

    CREATE PropGrid AS RSTRINGGRID
        Left = 906 : Top = 174
        Width = 288 : Height = 484
        Cols = 2
        ColWidth = 140
        OnChange = PropGridChange
        OnDblClick = PropGridDblClick
    END CREATE

    CREATE EvtGrid AS RSTRINGGRID
        Left = 906 : Top = 174
        Width = 288 : Height = 484
        Cols = 2
        ColWidth = 140
        Visible = 0
        OnChange = EvtGridChange
        OnDblClick = EvtGridDblClick
    END CREATE

    ' === BOTTOM PANEL: Error List ===
    CREATE OutputPanel AS RPANEL
        Left = 0 : Top = 662
        Width = 1200 : Height = 90
    END CREATE

    CREATE ErrorList AS RLISTBOX
        Left = 4 : Top = 666
        Width = 1190 : Height = 80
        Visible = 0
        OnClick = ErrorListClick
    END CREATE

    ' === STATUS BAR ===
    CREATE StatusBar AS RLABEL
        Left = 0 : Top = 756
        Width = 1200 : Height = 22
        Caption = "Ready — RapidR Visual IDE v1.0"
    END CREATE
END CREATE

' === Dialogs (non-visual, outside form) ===
CREATE OpenDlg AS ROPENDIALOG
END CREATE

CREATE SaveDlg AS RSAVEDIALOG
END CREATE

CREATE ColorDlg AS RCOLORDIALOG
END CREATE

CREATE FontDlg AS RFONTDIALOG
END CREATE

' === Post-CREATE initialization ===
ObjCombo.AddItems("Form1")

ProjectTree.AddRoot("Project1")
ProjectTree.AddChild("Project1", "Form1 (Form)")

FillProperties
FillEvents

StatusBar.Caption = "Ready — RapidR Visual IDE v1.0 — Click a component button then click on the form"
IDE.ShowModal
