    CREATE BtnAddPanel AS RBUTTON
        Caption = "Pnl"
        Left = 294 : Top = 34 : Width = 32 : Height = 24
        OnClick = SetToolPanel
    END CREATE
    CREATE BtnAddGroup AS RBUTTON
        Caption = "Grp"
        Left = 328 : Top = 34 : Width = 32 : Height = 24
        OnClick = SetToolGroup
    END CREATE

    ' --- Row 2: Advanced controls ---
    CREATE BtnAddProgress AS RBUTTON
        Caption = "Prog"
        Left = 4 : Top = 60 : Width = 38 : Height = 24
