' ============================================================
' DESIGN SURFACE EVENT HANDLERS
' ============================================================

SUB DesignSelect(Index AS INTEGER)
    SaveEvents
    SelIndex = Index + 1
    UpdateObjCombo
    FillProperties
    FillEvents
    DIM CN AS STRING
    CN = DesignSurface.GetName(Index)
    DIM CT AS STRING
    CT = DesignSurface.GetType(Index)
    StatusBar.Caption = CT + ": " + CN + " selected"
END SUB

SUB DesignMove(Index AS INTEGER, X AS INTEGER, Y AS INTEGER, W AS INTEGER, H AS INTEGER)
    IF SyncGuard = 1 THEN EXIT SUB
    SyncGuard = 1
    CodeDirty = 1
    IF SelIndex = Index + 1 THEN
        FillProperties
    END IF
    SyncGuard = 0
END SUB

SUB DesignDblClick(Index AS INTEGER)
    ' Save current events before switching to code view
    SaveEvents

    ' Update selection to this widget
    SelIndex = Index + 1

    DIM CN AS STRING
    DIM CT AS STRING
    CN = DesignSurface.GetName(Index)
    CT = DesignSurface.GetType(Index)
    DIM DefEvt AS STRING
    DefEvt = GetDefaultEvent(CT)
    DIM HandlerName AS STRING
    HandlerName = CN + "_" + DefEvt

    DIM CI AS INTEGER
    CI = Index + 1

    ' Only set the default event if not already set
    IF UCASE$(DefEvt) = "ONCLICK" AND EvtOnClick(CI) = "" THEN EvtOnClick(CI) = HandlerName
    IF UCASE$(DefEvt) = "ONCHANGE" AND EvtOnChange(CI) = "" THEN EvtOnChange(CI) = HandlerName
    IF UCASE$(DefEvt) = "ONTIMER" AND EvtOnTimer(CI) = "" THEN EvtOnTimer(CI) = HandlerName
    IF UCASE$(DefEvt) = "ONPAINT" AND EvtOnPaint(CI) = "" THEN EvtOnPaint(CI) = HandlerName
    IF UCASE$(DefEvt) = "ONQUERYDONE" AND EvtOnQueryDone(CI) = "" THEN EvtOnQueryDone(CI) = HandlerName

    ' Use the existing handler name if one was already set
    IF UCASE$(DefEvt) = "ONCLICK" AND EvtOnClick(CI) <> "" THEN HandlerName = EvtOnClick(CI)
    IF UCASE$(DefEvt) = "ONCHANGE" AND EvtOnChange(CI) <> "" THEN HandlerName = EvtOnChange(CI)
    IF UCASE$(DefEvt) = "ONTIMER" AND EvtOnTimer(CI) <> "" THEN HandlerName = EvtOnTimer(CI)
    IF UCASE$(DefEvt) = "ONPAINT" AND EvtOnPaint(CI) <> "" THEN HandlerName = EvtOnPaint(CI)
    IF UCASE$(DefEvt) = "ONQUERYDONE" AND EvtOnQueryDone(CI) <> "" THEN HandlerName = EvtOnQueryDone(CI)

    GenerateCode
    CodeDirty = 0
    DIM Code AS STRING
    Code = CodeEditor.Text
    Code = GenerateSubCode(Code, HandlerName, CN, DefEvt)
    CodeEditor.Text = Code

    IF ShowingCode = 0 THEN
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
    END IF

    CodeEditor.GotoSub(HandlerName)
    FillEvents
    StatusBar.Caption = "Editing: SUB " + HandlerName
END SUB

SUB DesignBgClick(X AS INTEGER, Y AS INTEGER)
    SaveEvents
    IF CurrentTool <> "" THEN
        CodeDirty = 1
        DIM CompName AS STRING
        CompName = GenerateCompName(CurrentTool)
        DIM CW AS INTEGER
        DIM CH AS INTEGER
        CW = DefaultWidth(CurrentTool)
        CH = DefaultHeight(CurrentTool)
        DIM SX AS INTEGER
        DIM SY AS INTEGER
        SX = SnapToGrid(X)
        SY = SnapToGrid(Y)

        DesignSurface.AddComponent(CurrentTool, CompName, SX, SY, CW, CH)

        IF CurrentTool = "RBUTTON" OR CurrentTool = "RLABEL" OR CurrentTool = "RCHECKBOX" OR CurrentTool = "RRADIOBUTTON" THEN
            DIM NewIdx AS INTEGER
            NewIdx = DesignSurface.CompCount - 1
            DesignSurface.SetProp(NewIdx, "caption", CompName)
        END IF
        IF CurrentTool = "RGROUPBOX" THEN
            DesignSurface.SetProp(DesignSurface.CompCount - 1, "caption", CompName)
        END IF
        IF CurrentTool = "RTIMER" THEN
            DesignSurface.SetProp(DesignSurface.CompCount - 1, "interval", "1000")
            DesignSurface.SetProp(DesignSurface.CompCount - 1, "enabled", "True")
        END IF

        SelIndex = DesignSurface.CompCount
        DesignSurface.SelectComp(DesignSurface.CompCount - 1)
        StatusBar.Caption = "Placed " + CurrentTool + ": " + CompName
        CurrentTool = ""
        UpdateObjCombo
        UpdateProjectTree
        FillProperties
        FillEvents
    ELSE
        SelIndex = 0
        UpdateObjCombo
        FillProperties
        FillEvents
        StatusBar.Caption = "Form1 selected"
    END IF
END SUB

' ============================================================
' PROPERTY GRID CHANGE HANDLER
' ============================================================

SUB PropGridChange
    IF SyncGuard = 1 THEN EXIT SUB
    SyncGuard = 1
    CodeDirty = 1

    DIM R AS INTEGER
    DIM PropName AS STRING
    DIM PropVal AS STRING
    R = PropGrid.SelectedRow
    IF R < 1 THEN SyncGuard = 0 : EXIT SUB
    PropName = UCASE$(PropGrid.Cell(R, 0))
    PropVal = PropGrid.Cell(R, 1)

    IF SelIndex = 0 THEN
        IF PropName = "CAPTION" THEN DesignSurface.FormCaption = PropVal
        IF PropName = "WIDTH" THEN DesignSurface.Width = VAL(PropVal)
        IF PropName = "HEIGHT" THEN DesignSurface.Height = VAL(PropVal)
    ELSE
        DIM CI AS INTEGER
        CI = SelIndex - 1

        IF PropName = "(NAME)" THEN
            DesignSurface.SetName(CI, PropVal)
            UpdateObjCombo
            UpdateProjectTree
        ELSEIF PropName = "LEFT" THEN
            DesignSurface.SetCompBounds(CI, VAL(PropVal), DesignSurface.GetCompY(CI), DesignSurface.GetCompW(CI), DesignSurface.GetCompH(CI))
        ELSEIF PropName = "TOP" THEN
            DesignSurface.SetCompBounds(CI, DesignSurface.GetCompX(CI), VAL(PropVal), DesignSurface.GetCompW(CI), DesignSurface.GetCompH(CI))
        ELSEIF PropName = "WIDTH" THEN
            DesignSurface.SetCompBounds(CI, DesignSurface.GetCompX(CI), DesignSurface.GetCompY(CI), VAL(PropVal), DesignSurface.GetCompH(CI))
        ELSEIF PropName = "HEIGHT" THEN
            DesignSurface.SetCompBounds(CI, DesignSurface.GetCompX(CI), DesignSurface.GetCompY(CI), DesignSurface.GetCompW(CI), VAL(PropVal))
        ELSE
            DesignSurface.SetProp(CI, LCASE$(PropName), PropVal)
        END IF
    END IF

    SyncGuard = 0
END SUB

' Property grid double-click — opens pickers for color/font, toggles booleans
SUB PropGridDblClick
    IF SyncGuard = 1 THEN EXIT SUB
    SyncGuard = 1
    CodeDirty = 1

    DIM R AS INTEGER
    DIM PropName AS STRING
    DIM PropVal AS STRING
    R = PropGrid.SelectedRow
    IF R < 1 THEN SyncGuard = 0 : EXIT SUB
    PropName = UCASE$(PropGrid.Cell(R, 0))
    PropVal = PropGrid.Cell(R, 1)

    IF SelIndex = 0 THEN
        ' Boolean toggle for form-level boolean properties
        IF PropName = "KEYPREVIEW" THEN
            IF UCASE$(PropVal) = "TRUE" OR PropVal = "1" THEN
                PropVal = "False"
            ELSE
                PropVal = "True"
            END IF
            PropGrid.SetCell(R, 1, PropVal)
        END IF
        SyncGuard = 0
        EXIT SUB
    END IF

    DIM CI AS INTEGER
    CI = SelIndex - 1

    ' Boolean properties: toggle on double-click
    IF PropName = "CHECKED" OR PropName = "VISIBLE" OR PropName = "ENABLED" OR PropName = "READONLY" OR PropName = "WORDWRAP" OR PropName = "STRETCH" THEN
        IF UCASE$(PropVal) = "TRUE" OR PropVal = "1" THEN
            PropVal = "False"
        ELSE
            PropVal = "True"
        END IF
        PropGrid.SetCell(R, 1, PropVal)
        DesignSurface.SetProp(CI, LCASE$(PropName), PropVal)
        SyncGuard = 0
        EXIT SUB
    END IF

    ' Color properties: launch color picker
    IF PropName = "FONTCOLOR" OR PropName = "COLOR" OR PropName = "BACKGROUNDCOLOR" THEN
        IF ColorDlg.Execute THEN
            PropVal = ColorDlg.Color
            PropGrid.SetCell(R, 1, PropVal)
            DesignSurface.SetProp(CI, LCASE$(PropName), PropVal)
        END IF
        SyncGuard = 0
        EXIT SUB
    END IF

    ' Font properties: launch font picker
    IF PropName = "FONT.NAME" OR PropName = "FONTNAME" OR PropName = "FONT.SIZE" THEN
        IF FontDlg.Execute THEN
            DIM FName AS STRING
            DIM FSize AS STRING
            FName = FontDlg.FontName
            FSize = FontDlg.FontSize
            DesignSurface.SetProp(CI, "font.name", FName)
            DesignSurface.SetProp(CI, "font.size", FSize)
            DIM GR AS INTEGER
            FOR GR = 1 TO PropGrid.RowCount
                DIM GN AS STRING
                GN = UCASE$(PropGrid.Cell(GR, 0))
                IF GN = "FONT.NAME" OR GN = "FONTNAME" THEN PropGrid.SetCell(GR, 1, FName)
                IF GN = "FONT.SIZE" THEN PropGrid.SetCell(GR, 1, FSize)
            NEXT GR
        END IF
        SyncGuard = 0
        EXIT SUB
    END IF

    ' Alignment property: cycle through values
    IF PropName = "ALIGNMENT" THEN
        DIM AlNum AS INTEGER
        AlNum = VAL(PropVal)
        AlNum = AlNum + 1
        IF AlNum > 2 THEN AlNum = 0
        PropVal = STR$(AlNum)
        PropGrid.SetCell(R, 1, PropVal)
        DesignSurface.SetProp(CI, "alignment", PropVal)
        SyncGuard = 0
        EXIT SUB
    END IF

    ' BorderStyle property: cycle
    IF PropName = "BORDERSTYLE" THEN
        DIM BsNum AS INTEGER
        BsNum = VAL(PropVal)
        BsNum = BsNum + 1
        IF BsNum > 1 THEN BsNum = 0
        PropVal = STR$(BsNum)
        PropGrid.SetCell(R, 1, PropVal)
        DesignSurface.SetProp(CI, "borderstyle", PropVal)
        SyncGuard = 0
        EXIT SUB
    END IF

    SyncGuard = 0
END SUB

' ============================================================
' EVENT GRID HANDLERS
' ============================================================

SUB EvtGridChange
    SaveEvents
    CodeDirty = 1
END SUB

SUB EvtGridDblClick
    ' Save all current events first to prevent loss
    SaveEvents

    DIM R AS INTEGER
    R = EvtGrid.SelectedRow
    IF R < 1 THEN EXIT SUB
    DIM EvtName AS STRING
    EvtName = EvtGrid.Cell(R, 0)
    DIM HandlerName AS STRING
    HandlerName = EvtGrid.Cell(R, 1)
    DIM CompName AS STRING

    IF SelIndex = 0 THEN
        CompName = "Form1"
    ELSE
        CompName = DesignSurface.GetName(SelIndex - 1)
    END IF

    IF HandlerName = "" THEN
        HandlerName = CompName + "_" + EvtName
        EvtGrid.SetCell(R, 1, HandlerName)
        SaveEvents
    END IF

    GenerateCode
    CodeDirty = 0
    DIM Code AS STRING
    Code = CodeEditor.Text
    Code = GenerateSubCode(Code, HandlerName, CompName, EvtName)
    CodeEditor.Text = Code

    IF ShowingCode = 0 THEN
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
    END IF

    CodeEditor.GotoSub(HandlerName)
    StatusBar.Caption = "Editing: SUB " + HandlerName
END SUB

' ============================================================
' CODE GENERATION
' ============================================================

SUB GenerateCode
    DIM Code AS STRING
    DIM I AS INTEGER
    DIM N AS INTEGER
    DIM CT AS STRING

    Code = "' ============================================================" + CHR$(10)
    Code = Code + "' Generated by RapidR Visual IDE" + CHR$(10)
    Code = Code + "' ============================================================" + CHR$(10)
    Code = Code + "$THEME AquaClassic" + CHR$(10) + CHR$(10)

    Code = Code + "DIM Form1 AS RFORM" + CHR$(10)
    N = DesignSurface.CompCount
    FOR I = 0 TO N - 1
        CT = DesignSurface.GetType(I)
        Code = Code + "DIM " + DesignSurface.GetName(I) + " AS " + CT + CHR$(10)
    NEXT I
    Code = Code + CHR$(10)

    DIM ExistingCode AS STRING
    ExistingCode = CodeEditor.Text

    IF FormOnShow <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnShow, "Form1", "OnShow")
    IF FormOnClose <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnClose, "Form1", "OnClose")
    IF FormOnResize <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnResize, "Form1", "OnResize")
    IF FormOnClick <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnClick, "Form1", "OnClick")
    IF FormOnKeyDown <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnKeyDown, "Form1", "OnKeyDown")
    IF FormOnPaint <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, FormOnPaint, "Form1", "OnPaint")

    FOR I = 0 TO N - 1
        DIM CI2 AS INTEGER
        CI2 = I + 1
        DIM CmpN AS STRING
        CmpN = DesignSurface.GetName(I)
        IF EvtOnClick(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnClick(CI2), CmpN, "OnClick")
        IF EvtOnDblClick(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnDblClick(CI2), CmpN, "OnDblClick")
        IF EvtOnChange(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnChange(CI2), CmpN, "OnChange")
        IF EvtOnTimer(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnTimer(CI2), CmpN, "OnTimer")
        IF EvtOnPaint(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnPaint(CI2), CmpN, "OnPaint")
        IF EvtOnMouseDown(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnMouseDown(CI2), CmpN, "OnMouseDown")
        IF EvtOnMouseMove(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnMouseMove(CI2), CmpN, "OnMouseMove")
        IF EvtOnMouseUp(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnMouseUp(CI2), CmpN, "OnMouseUp")
        IF EvtOnKeyDown(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnKeyDown(CI2), CmpN, "OnKeyDown")
        IF EvtOnQueryDone(CI2) <> "" THEN ExistingCode = GenerateSubCode(ExistingCode, EvtOnQueryDone(CI2), CmpN, "OnQueryDone")
    NEXT I

    DIM SubPart AS STRING
    DIM SubStart AS INTEGER
    SubStart = INSTR(UCASE$(ExistingCode), CHR$(10) + "SUB ")
    IF SubStart = 0 THEN SubStart = INSTR(UCASE$(ExistingCode), "SUB ")
    IF SubStart > 0 THEN
        ' Stop before the CREATE block to avoid duplicating it
        DIM CreateMarker AS INTEGER
        CreateMarker = INSTR(ExistingCode, "' === Main Form ===")
        IF CreateMarker = 0 THEN CreateMarker = INSTR(UCASE$(ExistingCode), "CREATE FORM1 AS RFORM")
        IF CreateMarker > SubStart THEN
            SubPart = MID$(ExistingCode, SubStart, CreateMarker - SubStart)
        ELSE
            SubPart = MID$(ExistingCode, SubStart)
        END IF
    ELSE
        SubPart = ""
    END IF

    Code = Code + SubPart + CHR$(10) + CHR$(10)
    Code = Code + "' === Main Form ===" + CHR$(10)
    Code = Code + "CREATE Form1 AS RFORM" + CHR$(10)
    Code = Code + "    Caption = " + CHR$(34) + DesignSurface.FormCaption + CHR$(34) + CHR$(10)
    Code = Code + "    Width = " + STR$(DesignSurface.Width) + CHR$(10)
    Code = Code + "    Height = " + STR$(DesignSurface.Height) + CHR$(10)
    Code = Code + "    Center" + CHR$(10)

    IF FormOnShow <> "" THEN Code = Code + "    OnShow = " + FormOnShow + CHR$(10)
    IF FormOnClose <> "" THEN Code = Code + "    OnClose = " + FormOnClose + CHR$(10)
    IF FormOnResize <> "" THEN Code = Code + "    OnResize = " + FormOnResize + CHR$(10)
    IF FormOnClick <> "" THEN Code = Code + "    OnClick = " + FormOnClick + CHR$(10)
    IF FormOnKeyDown <> "" THEN Code = Code + "    OnKeyDown = " + FormOnKeyDown + CHR$(10)
    IF FormOnPaint <> "" THEN Code = Code + "    OnPaint = " + FormOnPaint + CHR$(10)

    FOR I = 0 TO N - 1
        CT = DesignSurface.GetType(I)
        DIM CN3 AS STRING
        CN3 = DesignSurface.GetName(I)
        Code = Code + CHR$(10) + "    CREATE " + CN3 + " AS " + CT + CHR$(10)
        Code = Code + "        Left = " + STR$(DesignSurface.GetCompX(I)) + CHR$(10)
        Code = Code + "        Top = " + STR$(DesignSurface.GetCompY(I)) + CHR$(10)
        Code = Code + "        Width = " + STR$(DesignSurface.GetCompW(I)) + CHR$(10)
        Code = Code + "        Height = " + STR$(DesignSurface.GetCompH(I)) + CHR$(10)

        DIM UCT AS STRING
        UCT = UCASE$(CT)
        DIM PropV AS STRING

        PropV = DesignSurface.GetProp(I, "caption")
        IF PropV <> "" AND (UCT = "RBUTTON" OR UCT = "RLABEL" OR UCT = "RCHECKBOX" OR UCT = "RRADIOBUTTON" OR UCT = "RGROUPBOX") THEN
            Code = Code + "        Caption = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)
        END IF

        PropV = DesignSurface.GetProp(I, "text")
        IF PropV <> "" AND (UCT = "REDIT" OR UCT = "RRICHEDIT") THEN
            Code = Code + "        Text = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)
        END IF

        PropV = DesignSurface.GetProp(I, "color")
        IF PropV <> "" THEN Code = Code + "        Color = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "fontcolor")
        IF PropV <> "" THEN Code = Code + "        FontColor = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "fontsize")
        IF PropV <> "" THEN Code = Code + "        FontSize = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "font.name")
        IF PropV <> "" AND PropV <> "Helvetica" THEN Code = Code + "        Font.Name = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "font.size")
        IF PropV <> "" AND PropV <> "12" THEN Code = Code + "        Font.Size = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "checked")
        IF PropV <> "" AND (UCT = "RCHECKBOX" OR UCT = "RRADIOBUTTON") THEN
            Code = Code + "        Checked = " + PropV + CHR$(10)
        END IF

        PropV = DesignSurface.GetProp(I, "alignment")
        IF PropV <> "" AND PropV <> "0" THEN Code = Code + "        Alignment = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "interval")
        IF PropV <> "" AND UCT = "RTIMER" THEN Code = Code + "        Interval = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "enabled")
        IF PropV <> "" THEN Code = Code + "        Enabled = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "bmp")
        IF PropV <> "" AND UCT = "RIMAGE" THEN Code = Code + "        BMP = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "stretch")
        IF PropV <> "" AND UCT = "RIMAGE" THEN Code = Code + "        Stretch = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "readonly")
        IF PropV <> "" THEN Code = Code + "        ReadOnly = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "cols")
        IF PropV <> "" AND UCT = "RSTRINGGRID" THEN Code = Code + "        Cols = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "colwidth")
        IF PropV <> "" AND UCT = "RSTRINGGRID" THEN Code = Code + "        ColWidth = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "visible")
        IF PropV <> "" AND UCASE$(PropV) = "FALSE" THEN Code = Code + "        Visible = 0" + CHR$(10)
        IF PropV = "0" THEN Code = Code + "        Visible = 0" + CHR$(10)

        PropV = DesignSurface.GetProp(I, "database")
        IF PropV <> "" THEN Code = Code + "        Database = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "host")
        IF PropV <> "" THEN Code = Code + "        Host = " + CHR$(34) + PropV + CHR$(34) + CHR$(10)

        PropV = DesignSurface.GetProp(I, "min")
        IF PropV <> "" THEN Code = Code + "        Min = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "max")
        IF PropV <> "" THEN Code = Code + "        Max = " + PropV + CHR$(10)

        PropV = DesignSurface.GetProp(I, "position")
        IF PropV <> "" THEN Code = Code + "        Position = " + PropV + CHR$(10)

        DIM CI3 AS INTEGER
        CI3 = I + 1
        IF EvtOnClick(CI3) <> "" THEN Code = Code + "        OnClick = " + EvtOnClick(CI3) + CHR$(10)
        IF EvtOnDblClick(CI3) <> "" THEN Code = Code + "        OnDblClick = " + EvtOnDblClick(CI3) + CHR$(10)
        IF EvtOnChange(CI3) <> "" THEN Code = Code + "        OnChange = " + EvtOnChange(CI3) + CHR$(10)
        IF EvtOnTimer(CI3) <> "" THEN Code = Code + "        OnTimer = " + EvtOnTimer(CI3) + CHR$(10)
        IF EvtOnPaint(CI3) <> "" THEN Code = Code + "        OnPaint = " + EvtOnPaint(CI3) + CHR$(10)
        IF EvtOnMouseDown(CI3) <> "" THEN Code = Code + "        OnMouseDown = " + EvtOnMouseDown(CI3) + CHR$(10)
        IF EvtOnMouseMove(CI3) <> "" THEN Code = Code + "        OnMouseMove = " + EvtOnMouseMove(CI3) + CHR$(10)
        IF EvtOnMouseUp(CI3) <> "" THEN Code = Code + "        OnMouseUp = " + EvtOnMouseUp(CI3) + CHR$(10)
        IF EvtOnKeyDown(CI3) <> "" THEN Code = Code + "        OnKeyDown = " + EvtOnKeyDown(CI3) + CHR$(10)
        IF EvtOnQueryDone(CI3) <> "" THEN Code = Code + "        OnQueryDone = " + EvtOnQueryDone(CI3) + CHR$(10)

        Code = Code + "    END CREATE" + CHR$(10)
    NEXT I

    Code = Code + "END CREATE" + CHR$(10) + CHR$(10)
    Code = Code + "Form1.ShowModal" + CHR$(10)

    CodeEditor.Text = Code
END SUB

' ============================================================
' VIEW TOGGLE
' ============================================================

SUB ToggleCodeView
    IF ShowingCode = 0 THEN
        IF CodeDirty = 1 OR CodeEditor.Text = "" THEN
            GenerateCode
            CodeDirty = 0
        END IF
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
        StatusBar.Caption = "Code View"
    ELSE
        CodeEditor.Visible = 0
        DesignSurface.Show
        ShowingCode = 0
        StatusBar.Caption = "Design View"
    END IF
END SUB

SUB ShowDesignView
    IF ShowingCode = 1 THEN
        CodeEditor.Visible = 0
        DesignSurface.Show
        ShowingCode = 0
        StatusBar.Caption = "Design View"
    END IF
END SUB

SUB ShowCodeView
    IF ShowingCode = 0 THEN
        IF CodeDirty = 1 OR CodeEditor.Text = "" THEN
            GenerateCode
            CodeDirty = 0
        END IF
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
        StatusBar.Caption = "Code View"
    END IF
END SUB

SUB ShowPropsGrid
    PropGrid.Visible = 1
    EvtGrid.Visible = 0
    StatusBar.Caption = "Properties"
END SUB

SUB ShowEvtsGrid
    PropGrid.Visible = 0
    EvtGrid.Visible = 1
    StatusBar.Caption = "Events"
END SUB

' ============================================================
' FILE / PROJECT OPERATIONS
' ============================================================

SUB NewProject
    DIM I AS INTEGER
    DesignSurface.ClearAll
    BtnCount = 0 : LblCount = 0 : EdtCount = 0
    ChkCount = 0 : CmbCount = 0 : PnlCount = 0
    RadCount = 0 : LstCount = 0 : GrpCount = 0
    PrgCount = 0 : TmrCount = 0 : RchCount = 0
    CnvCount = 0 : MySqlCount = 0 : SQLiteCount = 0
    TrvCount = 0 : ImgCount = 0 : TrkCount = 0
    SplCount = 0 : SgdCount = 0 : SbxCount = 0
    SelIndex = 0
    FormOnShow = "" : FormOnClose = "" : FormOnResize = "" : FormOnKeyDown = "" : FormOnKeyPress = ""
    FormOnKeyUp = "" : FormOnClick = "" : FormOnMouseDown = "" : FormOnMouseMove = "" : FormOnMouseUp = ""
    FormOnPaint = ""
    FOR I = 1 TO 100
        EvtOnClick(I) = "" : EvtOnDblClick(I) = "" : EvtOnChange(I) = ""
        EvtOnMouseDown(I) = "" : EvtOnMouseMove(I) = "" : EvtOnMouseUp(I) = ""
        EvtOnKeyDown(I) = "" : EvtOnKeyPress(I) = "" : EvtOnKeyUp(I) = ""
        EvtOnTimer(I) = "" : EvtOnPaint(I) = "" : EvtOnEnter(I) = ""
        EvtOnConnect(I) = "" : EvtOnDisconnect(I) = "" : EvtOnError(I) = "" : EvtOnQueryDone(I) = ""
    NEXT I
    ProjectFile = ""
    CodeEditor.Text = ""
    DesignSurface.FormCaption = "Form1"
    IF ShowingCode = 1 THEN
        CodeEditor.Visible = 0
        DesignSurface.Show
        ShowingCode = 0
    END IF
    UpdateObjCombo
    UpdateProjectTree
    FillProperties
    FillEvents
    StatusBar.Caption = "New project created"
END SUB

SUB OpenProject
    OpenDlg.Filter = "RapidR Files\t*.rr"
    OpenDlg.Title = "Open RapidR Project"
    IF OpenDlg.Execute THEN
        ProjectFile = OpenDlg.FileName
        DIM FS AS RFILESTREAM
        CREATE FS AS RFILESTREAM
        END CREATE
        FS.Open(ProjectFile)
        DIM Content AS STRING
        Content = FS.ReadAll
        FS.Close
        CodeEditor.Text = Content
        IF ShowingCode = 0 THEN
            DesignSurface.Hide
            CodeEditor.Visible = 1
            ShowingCode = 1
        END IF
        StatusBar.Caption = "Opened: " + ProjectFile
    END IF
END SUB

SUB SaveProject
    GenerateCode
    IF ProjectFile = "" THEN
        SaveDlg.Filter = "RapidR Files\t*.rr"
        SaveDlg.Title = "Save RapidR Project"
        IF SaveDlg.Execute THEN
            ProjectFile = SaveDlg.FileName
        ELSE
            EXIT SUB
        END IF
    END IF
    DIM FS AS RFILESTREAM
    CREATE FS AS RFILESTREAM
    END CREATE
    FS.Open(ProjectFile, 65535)
    FS.WriteLn(CodeEditor.Text)
    FS.Close
    StatusBar.Caption = "Saved: " + ProjectFile
END SUB

SUB SaveAsProject
    GenerateCode
    SaveDlg.Filter = "RapidR Files\t*.rr"
    SaveDlg.Title = "Save RapidR Project As"
    IF SaveDlg.Execute THEN
        ProjectFile = SaveDlg.FileName
        DIM FS AS RFILESTREAM
        CREATE FS AS RFILESTREAM
        END CREATE
        FS.Open(ProjectFile, 65535)
        FS.WriteLn(CodeEditor.Text)
        FS.Close
        StatusBar.Caption = "Saved: " + ProjectFile
    END IF
END SUB

' ============================================================
' COMPILE & RUN
' ============================================================

SUB CompileAndRun
    GenerateCode
    DIM Code AS STRING
    Code = CodeEditor.Text

    ' Use a unique temp directory based on random number
    DIM RandId AS INTEGER
    RandId = INT(RND(1) * 999999) + 100000
    DIM TmpName AS STRING
    TmpName = "rr_run_" + STR$(RandId)
    DIM TmpFile AS STRING
    TmpFile = "/tmp/" + TmpName + ".rr"
    DIM TmpDir AS STRING
    TmpDir = "/tmp/" + TmpName

    DIM FS AS RFILESTREAM
    CREATE FS AS RFILESTREAM
    END CREATE
    FS.Open(TmpFile, 65535)
    FS.WriteLn(Code)
    FS.Close

    StatusBar.Caption = "Compiling..."
    ErrorList.Clear
    ErrorList.Visible = 1
    ErrorCount = 0

    DIM CmdStr AS STRING
    CmdStr = "export RAPIDR_HOME=" + RapidRHome + " && rapidr build " + TmpFile + " " + TmpDir + " --release 2>&1"

    DIM Result AS INTEGER
    Result = SHELL(CmdStr)

    IF Result = 0 THEN
        StatusBar.Caption = "Compilation successful — running..."
        SHELL(TmpDir + "/target/release/" + TmpName + " &")
        StatusBar.Caption = "Running project"
    ELSE
        StatusBar.Caption = "Compilation failed — check errors"
        ErrorList.AddItems("Compilation failed (exit code: " + STR$(Result) + "). Run 'rapidr build' manually to see details.")
    END IF
END SUB

SUB BuildStandalone
    GenerateCode
    DIM Code AS STRING
    Code = CodeEditor.Text

    SaveDlg.Filter = "RapidR Files\t*.rr"
    SaveDlg.Title = "Save before building"
    IF ProjectFile = "" THEN
        IF SaveDlg.Execute THEN
            ProjectFile = SaveDlg.FileName
        ELSE
            EXIT SUB
        END IF
    END IF

    DIM FS AS RFILESTREAM
    CREATE FS AS RFILESTREAM
    END CREATE
    FS.Open(ProjectFile, 65535)
    FS.WriteLn(Code)
    FS.Close

    StatusBar.Caption = "Building standalone executable..."
    ErrorList.Clear
    ErrorList.Visible = 1

    DIM OutDir AS STRING
    OutDir = ProjectFile + "_rust"
    DIM Result AS INTEGER
    Result = SHELL("export RAPIDR_HOME=" + RapidRHome + " && rapidr build " + ProjectFile + " " + OutDir + " --release 2>&1")

    IF Result = 0 THEN
        StatusBar.Caption = "Build successful: " + OutDir
        ErrorList.AddItems("Build succeeded: " + OutDir)
    ELSE
        StatusBar.Caption = "Build failed"
        ErrorList.AddItems("Build failed. Check output for errors.")
    END IF
END SUB

SUB RunCodegen
    GenerateCode
    StatusBar.Caption = "Code generated"
    IF ShowingCode = 0 THEN
        DesignSurface.Hide
        CodeEditor.Visible = 1
        ShowingCode = 1
    END IF
END SUB

' ============================================================
' TOOLS MENU HANDLERS
' ============================================================

SUB ToolsPickColor
    IF ColorDlg.Execute THEN
        DIM ColorVal AS STRING
        ColorVal = ColorDlg.Color
        StatusBar.Caption = "Color: " + ColorVal
        IF SelIndex > 0 THEN
            DIM CI AS INTEGER
            CI = SelIndex - 1
            DesignSurface.SetProp(CI, "color", ColorVal)
            FillProperties
        END IF
    END IF
END SUB

SUB ToolsPickFont
    IF FontDlg.Execute THEN
        DIM FontName AS STRING
        FontName = FontDlg.FontName
        StatusBar.Caption = "Font: " + FontName
    END IF
END SUB

SUB ShowAbout
    MSGBOX("RapidR Visual IDE v1.0" + CHR$(10) + CHR$(10) + "A production visual development environment" + CHR$(10) + "for building RapidR BASIC applications." + CHR$(10) + CHR$(10) + "Transpiles BASIC to native Rust executables.")
END SUB

' ============================================================
' MISC HANDLERS
' ============================================================

SUB DeleteSelected
    IF SelIndex > 0 THEN
        CodeDirty = 1
        DIM CI AS INTEGER
        CI = SelIndex - 1
        DIM CN AS STRING
        CN = DesignSurface.GetName(CI)
        DesignSurface.RemoveComponent(CI)
        SelIndex = 0
        UpdateObjCombo
        UpdateProjectTree
        FillProperties
        FillEvents
        StatusBar.Caption = "Deleted: " + CN
    END IF
END SUB

SUB ObjComboChange
    IF SyncGuard = 1 THEN EXIT SUB
    SaveEvents
    DIM Idx AS INTEGER
    Idx = ObjCombo.ItemIndex
    IF Idx < 0 THEN EXIT SUB
    SelIndex = Idx
    IF Idx > 0 THEN
        DesignSurface.SelectComp(Idx - 1)
    END IF
    FillProperties
    FillEvents
END SUB

SUB ErrorListClick
    DIM Idx AS INTEGER
    Idx = ErrorList.ItemIndex
    IF Idx >= 0 AND Idx < ErrorCount THEN
        IF ShowingCode = 0 THEN
            GenerateCode
            DesignSurface.Hide
            CodeEditor.Visible = 1
            ShowingCode = 1
        END IF
        CodeEditor.GotoLine(ErrorLines(Idx))
    END IF
END SUB

SUB ExitIDE
    IDE.Close
END SUB

SUB ProjectTreeClick
    DIM SelItem AS STRING
    SelItem = ProjectTree.SelectedItem
    IF SelItem = "" THEN EXIT SUB

    ' Check if the clicked item matches a component name
    ' Tree items are like "Button1 (RButton)" — extract the name part
    DIM SpacePos AS INTEGER
    SpacePos = INSTR(SelItem, " ")
    DIM CompName AS STRING
    IF SpacePos > 0 THEN
        CompName = LEFT$(SelItem, SpacePos - 1)
    ELSE
        CompName = SelItem
    END IF

    ' Check if it's "Form1"
    IF UCASE$(CompName) = "FORM1" THEN
        SelIndex = 0
        UpdateObjCombo
        FillProperties
        FillEvents
        StatusBar.Caption = "Form1 selected"
        EXIT SUB
    END IF

    ' Find the component on the design surface
    DIM N AS INTEGER
    N = DesignSurface.CompCount
    DIM I AS INTEGER
    FOR I = 0 TO N - 1
        IF UCASE$(DesignSurface.GetName(I)) = UCASE$(CompName) THEN
            SelIndex = I + 1
            DesignSurface.SelectComp(I)
            UpdateObjCombo
            FillProperties
            FillEvents
            StatusBar.Caption = DesignSurface.GetType(I) + ": " + CompName + " selected"
            EXIT SUB
        END IF
    NEXT I
END SUB

' ============================================================
' CREATE IDE FORM — VB6-Style Layout
' ============================================================

CREATE IDE AS RFORM
    Caption = "RapidR Visual IDE"
    Width = 1200
    Height = 820
    Center

    ' === MENU BAR ===
    CREATE MainMenu AS RMAINMENU
        CREATE FileMenu AS RMENUITEM
            Caption = "&File"
            CREATE NewItem AS RMENUITEM
                Caption = "&New Project"
                OnClick = NewProject
            END CREATE
            CREATE OpenItem AS RMENUITEM
                Caption = "&Open..."
                OnClick = OpenProject
            END CREATE
            CREATE SaveItem AS RMENUITEM
                Caption = "&Save"
                OnClick = SaveProject
            END CREATE
            CREATE SaveAsItem AS RMENUITEM
                Caption = "Save &As..."
                OnClick = SaveAsProject
            END CREATE
            CREATE SepFile1 AS RMENUITEM
                Caption = "-"
            END CREATE
            CREATE ExitItem AS RMENUITEM
                Caption = "E&xit"
                OnClick = ExitIDE
            END CREATE
        END CREATE
        CREATE EditMenu AS RMENUITEM
            Caption = "&Edit"
            CREATE DeleteItem AS RMENUITEM
                Caption = "&Delete"
                OnClick = DeleteSelected
            END CREATE
        END CREATE
        CREATE ViewMenu AS RMENUITEM
            Caption = "&View"
            CREATE ViewCodeItem AS RMENUITEM
                Caption = "&Code"
                OnClick = ShowCodeView
            END CREATE
            CREATE ViewDesignItem AS RMENUITEM
                Caption = "&Design"
                OnClick = ShowDesignView
            END CREATE
        END CREATE
        CREATE RunMenu AS RMENUITEM
            Caption = "&Run"
            CREATE RunStartItem AS RMENUITEM
                Caption = "&Start (Compile && Run)"
                OnClick = CompileAndRun
            END CREATE
            CREATE SepRun1 AS RMENUITEM
                Caption = "-"
            END CREATE
            CREATE RunBuildItem AS RMENUITEM
                Caption = "&Build Standalone EXE"
                OnClick = BuildStandalone
            END CREATE
            CREATE RunCodegenItem AS RMENUITEM
                Caption = "&Generate Code"
                OnClick = RunCodegen
            END CREATE
        END CREATE
        CREATE ToolsMenu AS RMENUITEM
            Caption = "&Tools"
            CREATE ToolsColorItem AS RMENUITEM
                Caption = "&Color Picker..."
                OnClick = ToolsPickColor
            END CREATE
            CREATE ToolsFontItem AS RMENUITEM
                Caption = "&Font Picker..."
                OnClick = ToolsPickFont
            END CREATE
        END CREATE
        CREATE HelpMenu AS RMENUITEM
            Caption = "&Help"
            CREATE HelpAboutItem AS RMENUITEM
                Caption = "&About RapidR IDE"
                OnClick = ShowAbout
            END CREATE
        END CREATE
    END CREATE

    ' === COMPONENT PALETTE (Below menu bar) ===
    CREATE ToolbarPanel AS RPANEL
        Left = 0 : Top = 30
        Width = 1200 : Height = 84
    END CREATE

    ' --- Row 1: Standard controls ---
    CREATE BtnPtr AS RBUTTON
        Caption = "Ptr"
        Left = 4 : Top = 34 : Width = 30 : Height = 24
        OnClick = SetToolPointer
    END CREATE
    CREATE BtnAddLabel AS RBUTTON
        Caption = "Label"
        Left = 36 : Top = 34 : Width = 42 : Height = 24
        OnClick = SetToolLabel
    END CREATE
    CREATE BtnAddEdit AS RBUTTON
        Caption = "Edit"
        Left = 80 : Top = 34 : Width = 38 : Height = 24
        OnClick = SetToolEdit
    END CREATE
    CREATE BtnAddButton AS RBUTTON
        Caption = "Btn"
        Left = 120 : Top = 34 : Width = 32 : Height = 24
        OnClick = SetToolButton
    END CREATE
    CREATE BtnAddCheck AS RBUTTON
        Caption = "Chk"
        Left = 154 : Top = 34 : Width = 32 : Height = 24
        OnClick = SetToolCheck
    END CREATE
    CREATE BtnAddRadio AS RBUTTON
        Caption = "Rad"
        Left = 188 : Top = 34 : Width = 32 : Height = 24
        OnClick = SetToolRadio
    END CREATE
    CREATE BtnAddCombo AS RBUTTON
        Caption = "Cmb"
        Left = 222 : Top = 34 : Width = 34 : Height = 24
        OnClick = SetToolCombo
    END CREATE
    CREATE BtnAddList AS RBUTTON
        Caption = "List"
        Left = 258 : Top = 34 : Width = 34 : Height = 24
