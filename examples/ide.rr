DIM ProjectFile AS STRING        ' saved project path
DIM RapidRHome AS STRING         ' RapidR workspace root for compilation
DIM CodeDirty AS INTEGER         ' 1 = design surface changed, code needs regen
RapidRHome = "/Users/roanbema/Programming/rust/RapidR"

