' ============================================================
' web_calculator.rr — Calculator App for RapidR Web (WASM)
' ============================================================
' Build with:  rapidr --web web_calculator.rr
' ============================================================
$APPTYPE WEB

DIM Form1 AS RFORM
DIM Display AS REDIT
DIM Btn0 AS RBUTTON
DIM Btn1 AS RBUTTON
DIM Btn2 AS RBUTTON
DIM Btn3 AS RBUTTON
DIM Btn4 AS RBUTTON
DIM Btn5 AS RBUTTON
DIM Btn6 AS RBUTTON
DIM Btn7 AS RBUTTON
DIM Btn8 AS RBUTTON
DIM Btn9 AS RBUTTON
DIM BtnAdd AS RBUTTON
DIM BtnSub AS RBUTTON
DIM BtnMul AS RBUTTON
DIM BtnDiv AS RBUTTON
DIM BtnEq AS RBUTTON
DIM BtnClr AS RBUTTON
DIM BtnDot AS RBUTTON
DIM LblTitle AS RLABEL
DIM LblHistory AS RLABEL

DIM current AS STRING
DIM accumulator AS DOUBLE
DIM op AS STRING
DIM newNumber AS INTEGER

current = "0"
accumulator = 0
op = ""
newNumber = 1

CREATE Form1 AS RFORM
    .Caption = "RapidR Web Calculator"
    .Width = 340
    .Height = 500
    .Left = 80
    .Top = 30
END CREATE

