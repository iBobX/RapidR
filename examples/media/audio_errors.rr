' audio_errors.rr: what an RAudioOut tells you when the sound goes wrong.
'
'     Speaker.OnError = Heard         ' SUB Heard (Code AS INTEGER, Message AS STRING)
'
' Code is one of aeNoDevice, aeDeviceLost, aeBadSetting, aeUnderrun and
' aeNeedsClick; Message says it in words. The program plays a quiet tone and
' lists each event it hears, with the button that makes it happen:
'
'   Let it run dry    stops writing for half a second: aeUnderrun
'   Set a bad rate    SampleRate = 5, out of its range: aeBadSetting
'   (aeDeviceLost     unplug the headphones, or turn the sound device off, while it plays;
'    aeNoDevice       a computer with no sound device; aeNeedsClick a browser
'                     that has not had a click yet — Start from a button, as here)
'
'   rapidr run audio_errors.rr

DECLARE SUB Heard (Code AS INTEGER, Message AS STRING)
DECLARE SUB Feed (Count AS INTEGER)
DECLARE SUB StartStop
DECLARE SUB RunDry
DECLARE SUB BadRate
DECLARE SUB Resume

DIM Speaker AS RAudioOut
DIM Phase AS DOUBLE
DIM Dry AS INTEGER

CREATE Form AS RForm
    Caption = "Sound errors"
    ClientWidth = 520: ClientHeight = 300
    Center
    CREATE StartBtn AS RButton
        Caption = "&Start": Left = 16: Top = 16: Width = 96: Height = 32
        OnClick = StartStop
    END CREATE
    CREATE DryBtn AS RButton
        Caption = "&Let It Run Dry": Left = 120: Top = 16: Width = 128: Height = 32
        OnClick = RunDry
    END CREATE
    CREATE RateBtn AS RButton
        Caption = "Set a &Bad Rate": Left = 256: Top = 16: Width = 128: Height = 32
        OnClick = BadRate
    END CREATE
    CREATE Heading AS RLabel
        Caption = "What OnError heard:": Left = 16: Top = 64
    END CREATE
    CREATE Log AS RListBox
        Left = 16: Top = 88: Width = 488: Height = 170
        AccessibleName = "The errors heard"
    END CREATE
    CREATE Said AS RLabel
        Left = 16: Top = 268: Width = 488
    END CREATE
END CREATE

CREATE ResumeTimer AS RTimer
    Enabled = 0
    Interval = 500
    OnTimer = Resume
END CREATE

Speaker.Volume = 20
Speaker.OnNeedData = Feed
Speaker.OnError = Heard
Dry = 0

' The tone: a quiet 440 Hz, written when the stream asks (nothing while it "runs dry").
SUB Feed (Count AS INTEGER)
    DIM buf(Count - 1) AS INTEGER, i AS INTEGER
    IF Dry THEN EXIT SUB
    FOR i = 0 TO Count - 1
        buf(i) = SIN(Phase) * 6000
        Phase = Phase + 2 * 3.14159265 * 440 / Speaker.SampleRate
    NEXT
    Speaker.Write buf, Count
END SUB

SUB StartStop
    IF Speaker.Playing THEN
        Speaker.Stop
        StartBtn.Caption = "&Start"
    ELSE
        Speaker.Start
        StartBtn.Caption = "&Stop"
    END IF
END SUB

' Not writing for half a second: the queue empties, the stream goes quiet
' (a fade, no click) and OnError says aeUnderrun.
SUB RunDry
    Dry = 1
    ResumeTimer.Enabled = 1
END SUB

SUB Resume
    ResumeTimer.Enabled = 0
    Dry = 0
END SUB

SUB BadRate
    Speaker.SampleRate = 5
    Speaker.SampleRate = 44100
END SUB

' The event: its Code by name, the Message as it is, and how many so far.
SUB Heard (Code AS INTEGER, Message AS STRING)
    DIM name AS STRING
    SELECT CASE Code
        CASE aeNoDevice
            name = "aeNoDevice"
        CASE aeDeviceLost
            name = "aeDeviceLost"
        CASE aeBadSetting
            name = "aeBadSetting"
        CASE aeUnderrun
            name = "aeUnderrun"
        CASE aeNeedsClick
            name = "aeNeedsClick"
        CASE ELSE
            name = "code " + STR$(Code)
    END SELECT
    Log.AddItems name + ": " + Message
    Log.ItemIndex = Log.ItemCount - 1
    Said.Caption = STR$(Log.ItemCount) + " heard; Underruns is " + STR$(Speaker.Underruns)
END SUB

Said.Caption = "Nothing heard yet."
Form.ShowModal
