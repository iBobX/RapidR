' pixels_fast.rr: drawing a whole picture from data, fast. A plasma and the
' Game of Life, 50 frames a second, with the frames-a-second and where each
' frame's time goes written under the picture.
'
'   rapidr run pixels_fast.rr
'
' A program that draws a picture from numbers - an emulator's screen, a
' filter, a heat map - must not call Pset for every pixel: that is 49,152
' calls for a 256 x 192 picture, 70 ms in the interpreter, so 14 frames a
' second at best. Instead the program fills an ARRAY with the picture and
' hands it over in one call:
'
'   Frame.SetPixels8 Indexes, Palette, 256, 192     colour numbers -> colours, one lookup a pixel
'   Frame.SetPixels  Colours, 256, 192              (or the colours themselves, RGB numbers)
'   Screen.StretchDraw 0, 0, 512, 384, Frame        twice as large, every pixel crisp
'
' which takes well under a millisecond. The plasma never changes its numbers:
' each frame only turns its 256-colour palette round (palette cycling, as
' old machines did it). The Life grid is worked out in the program, every
' cell every frame, and still has time to spare. "Method" switches to the
' slow way to see the difference for yourself; Pause stops the frames.
'
' The clock: an RTimer ticks in steps of 15.6 ms (as Windows' own timers
' do), so Interval = 20 would give about 32 frames a
' second, not 50. This program lets the timer look every tick and draws a
' frame whenever one is due: the due times (nextAt) are 20 ms apart, so the
' average is exactly 50 a second whatever the ticks do - as long as a frame's
' own work is under about 4 ms, since a timer ticks again 15.6 ms after its
' handler ends. That is why the Life grid is a modest 64 x 48 cells.
$THEME rapidr

CONST PW = 256                   ' the plasma's picture: 256 x 192 pixels ...
CONST PH = 192
CONST LW = 64                    ' ... the Life grid: 64 x 48 cells, drawn eight times as large
CONST LH = 48
CONST LS = LW + 2                ' (the grid has a border of one cell, a copy of the opposite edge:
                                 '  every cell has 8 neighbours without a check)

DECLARE SUB Tick
DECLARE SUB Redraw
DECLARE SUB EffectClick
DECLARE SUB MethodClick
DECLARE SUB PauseClick
DECLARE SUB NewClick
DECLARE SUB DrawClick (Button AS INTEGER, X AS INTEGER, Y AS INTEGER, Shift AS INTEGER)

DIM plasma(0 TO PW * PH - 1) AS BYTE        ' colour numbers of the plasma picture
DIM cells(0 TO LW * LH - 1) AS BYTE         ' colour numbers of the Life picture: 0 dead, 1 alive, 2 born, 3 just died
DIM grid(0 TO LS * (LH + 2) - 1) AS BYTE    ' Life: 1 for alive (with its border)
DIM nextGrid(0 TO LS * (LH + 2) - 1) AS BYTE
DIM base(255) AS LONG, palette(255) AS LONG, lifePal(3) AS LONG
DIM effect AS INTEGER, method AS INTEGER    ' 0 plasma / 1 Life; 0 SetPixels8 / 1 Pset
DIM running AS INTEGER, phase AS INTEGER
DIM nextAt AS DOUBLE, framesSince AS INTEGER, since AS DOUBLE
DIM tCompute AS DOUBLE, tPut AS DOUBLE, tDraw AS DOUBLE    ' seconds spent since the readout was written
DIM Frame AS RBitmap

CREATE Form AS RForm
    Caption = "Pixels, fast": ClientWidth = 512 + 32: ClientHeight = 384 + 112
    Center
    CREATE Screen AS RCanvas: Left = 16: Top = 16: Width = 512: Height = 384: OnPaint = Redraw: OnMouseDown = DrawClick: AccessibleName = "Picture": AccessibleDescription = "A plasma or the Game of Life": END CREATE
    CREATE EffectBtn AS RButton: Caption = "&Life": Left = 16: Top = 408: Width = 120: Height = 30: OnClick = EffectClick: END CREATE
    CREATE MethodBtn AS RButton: Caption = "&Method: SetPixels8": Left = 144: Top = 408: Width = 168: Height = 30: OnClick = MethodClick: END CREATE
    CREATE PauseBtn AS RButton: Caption = "&Pause": Left = 320: Top = 408: Width = 100: Height = 30: OnClick = PauseClick: END CREATE
    CREATE NewBtn AS RButton: Caption = "&New": Left = 428: Top = 408: Width = 100: Height = 30: OnClick = NewClick: Enabled = 0: END CREATE
    CREATE Info AS RLabel: Caption = "starting ...": Left = 16: Top = 448: Width = 512: Font.Name = "Courier New": END CREATE
    CREATE Hint AS RLabel: Caption = "In Life, click the picture to add cells.": Left = 16: Top = 472: Width = 512: END CREATE
    CREATE Clock AS RTimer: Interval = 10: Enabled = 0: OnTimer = Tick: END CREATE      ' looks every 10 ms; a frame is due every 20
END CREATE

' --- the plasma: sines worked out once; a frame turns the palette ---

SUB MakePlasma
    DIM x AS INTEGER, y AS INTEGER, v AS DOUBLE, i AS INTEGER
    FOR y = 0 TO PH - 1
        FOR x = 0 TO PW - 1
            v = SIN(x / 16) + SIN(y / 11) + SIN((x + y) / 21) + SIN(SQR(x * x * 0.5 + y * y) / 9)     ' -4 to 4
            plasma(y * PW + x) = INT((v + 4) * 31.9)                                                  ' 0 to 255
        NEXT
    NEXT
    FOR i = 0 TO 255                                            ' the ring of colours the palette turns through
        base(i) = RGB(127 + 127 * SIN(i * 6.2831853 / 256), 127 + 127 * SIN(i * 6.2831853 / 256 + 2.1), 127 + 127 * SIN(i * 6.2831853 / 256 + 4.2))
    NEXT
END SUB

SUB StepPlasma
    DIM i AS INTEGER
    phase = (phase + 3) AND 255
    FOR i = 0 TO 255
        palette(i) = base((i + phase) AND 255)
    NEXT
END SUB

' --- Life: every cell's neighbours counted, every frame ---

SUB Seed (start AS INTEGER)
    DIM x AS INTEGER, y AS INTEGER, p AS INTEGER
    RANDOMIZE start
    FOR y = 1 TO LH
        FOR x = 1 TO LW
            p = y * LS + x
            grid(p) = IIF(RND < 0.28, 1, 0)
            cells((y - 1) * LW + x - 1) = grid(p)
        NEXT
    NEXT
END SUB

SUB StepLife
    DIM x AS INTEGER, y AS INTEGER, p AS INTEGER, n AS INTEGER, k AS INTEGER
    FOR x = 1 TO LW                                  ' the border: a copy of the opposite edge
        grid(x) = grid(LH * LS + x)
        grid((LH + 1) * LS + x) = grid(LS + x)
    NEXT
    FOR y = 0 TO LH + 1
        grid(y * LS) = grid(y * LS + LW)
        grid(y * LS + LW + 1) = grid(y * LS + 1)
    NEXT
    k = 0
    FOR y = 1 TO LH
        p = y * LS + 1
        FOR x = 1 TO LW
            n = grid(p - LS - 1) + grid(p - LS) + grid(p - LS + 1) + grid(p - 1) + grid(p + 1) + grid(p + LS - 1) + grid(p + LS) + grid(p + LS + 1)
            IF grid(p) = 1 THEN
                IF n = 2 OR n = 3 THEN
                    nextGrid(p) = 1: cells(k) = 1
                ELSE
                    nextGrid(p) = 0: cells(k) = 3
                END IF
            ELSEIF n = 3 THEN
                nextGrid(p) = 1: cells(k) = 2
            ELSE
                nextGrid(p) = 0: cells(k) = 0
            END IF
            p = p + 1: k = k + 1
        NEXT
    NEXT
    FOR p = 0 TO LS * (LH + 2) - 1                   ' what was worked out is now
        grid(p) = nextGrid(p)
    NEXT
END SUB

' --- one frame: work the picture out, put it into the bitmap, draw it larger ---

SUB DrawFrame
    DIM t0 AS DOUBLE, t1 AS DOUBLE, t2 AS DOUBLE, i AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER
    t0 = TIMER
    IF effect = 0 THEN StepPlasma ELSE StepLife
    t1 = TIMER
    IF effect = 0 THEN
        w = PW: h = PH
    ELSE
        w = LW: h = LH
    END IF
    IF method = 0 THEN
        IF effect = 0 THEN
            Frame.SetPixels8 plasma, palette, w, h        ' one call: all the pixels
        ELSE
            Frame.SetPixels8 cells, lifePal, w, h
        END IF
    ELSEIF effect = 0 THEN
        i = 0                                             ' the slow way: a call for every pixel
        FOR y = 0 TO h - 1
            FOR x = 0 TO w - 1
                Frame.Pset x, y, palette(plasma(i))
                i = i + 1
            NEXT
        NEXT
    ELSE
        i = 0
        FOR y = 0 TO h - 1
            FOR x = 0 TO w - 1
                Frame.Pset x, y, lifePal(cells(i))
                i = i + 1
            NEXT
        NEXT
    END IF
    t2 = TIMER
    Screen.StretchDraw 0, 0, 512, 384, Frame                ' twice (Life: eight times) as large, crisp
    tCompute = tCompute + (t1 - t0): tPut = tPut + (t2 - t1): tDraw = tDraw + (TIMER - t2)
END SUB

SUB Redraw
    Screen.StretchDraw 0, 0, 512, 384, Frame
END SUB

' --- the clock: a frame every 20 ms, 50 a second, however the ticks fall ---

SUB Tick
    DIM now AS DOUBLE, n AS DOUBLE
    IF NOT running THEN EXIT SUB
    now = TIMER
    IF now < nextAt THEN EXIT SUB                    ' not due yet
    nextAt = nextAt + 0.02
    IF nextAt < now THEN nextAt = now + 0.02         ' (behind: no burst to catch up)
    DrawFrame
    framesSince = framesSince + 1
    IF now - since >= 1 THEN                         ' the readout, once a second
        n = framesSince
        Info.Caption = FORMAT$("%4.1f", n / (now - since)) + " fps  work " + FORMAT$("%5.2f", tCompute * 1000 / n) + "  put " + FORMAT$("%5.2f", tPut * 1000 / n) + "  draw " + FORMAT$("%5.2f", tDraw * 1000 / n) + " ms"
        framesSince = 0: since = now
        tCompute = 0: tPut = 0: tDraw = 0
    END IF
END SUB

SUB StartFrames
    framesSince = 0: since = TIMER: nextAt = since
    tCompute = 0: tPut = 0: tDraw = 0
END SUB

' --- the buttons ---

SUB EffectClick
    effect = 1 - effect
    IF effect = 0 THEN
        Frame.Width = PW: Frame.Height = PH
        EffectBtn.Caption = "&Life"
        NewBtn.Enabled = 0
        Hint.Caption = "In Life, click the picture to add cells."
    ELSE
        Frame.Width = LW: Frame.Height = LH
        EffectBtn.Caption = "&Plasma"
        NewBtn.Enabled = -1
        Hint.Caption = "Click the picture to add cells."
    END IF
    StartFrames
END SUB

SUB MethodClick
    method = 1 - method
    MethodBtn.Caption = IIF(method = 0, "&Method: SetPixels8", "&Method: Pset")
    StartFrames
END SUB

SUB PauseClick
    running = NOT running
    PauseBtn.Caption = IIF(running, "&Pause", "&Resume")
    IF running THEN StartFrames
END SUB

SUB NewClick
    Seed TIMER                                       ' a different soup each time
END SUB

' A click adds a blob of live cells (Life)
SUB DrawClick (Button AS INTEGER, X AS INTEGER, Y AS INTEGER, Shift AS INTEGER)
    DIM cx AS INTEGER, cy AS INTEGER, dx AS INTEGER, dy AS INTEGER, p AS INTEGER
    IF effect = 0 THEN EXIT SUB
    cx = X \ 8 + 1: cy = Y \ 8 + 1
    FOR dy = -1 TO 1
        FOR dx = -1 TO 1
            IF cx + dx >= 1 AND cx + dx <= LW AND cy + dy >= 1 AND cy + dy <= LH THEN
                p = (cy + dy) * LS + cx + dx
                IF RND < 0.7 THEN grid(p) = 1
            END IF
        NEXT
    NEXT
END SUB

' --- set up ---

lifePal(0) = RGB(8, 8, 24)         ' dead
lifePal(1) = RGB(60, 200, 90)      ' alive
lifePal(2) = RGB(255, 255, 255)    ' born this frame
lifePal(3) = RGB(120, 40, 40)      ' died this frame: a short trail
Frame.Width = PW: Frame.Height = PH
MakePlasma
StepPlasma
Seed 2026                          ' (the same first soup every time)
running = -1
StartFrames
Clock.Enabled = -1
Form.ShowModal
