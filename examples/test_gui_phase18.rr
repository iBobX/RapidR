$TYPECHECK ON

PRINT "Creating dummy UI..."

CREATE Form AS RForm
    Width = 300
    Height = 200
    Caption = "Phase 18 Integration"
    
    CREATE Bar AS RProgressBar
        Top = 10
        Left = 10
        Width = 200
        Position = 50
    END CREATE
    
    CREATE View AS RListView
        Top = 40
        Left = 10
        Width = 200
        Height = 100
    END CREATE
    
    CREATE HTMLView AS PHTML
        Top = 150
        Left = 10
        Width = 200
        Height = 40
    END CREATE
END CREATE

DIM OpenDlg AS ROpenDialog
DIM WebSock AS RSocket

PRINT "App Instantiated Successfully."
Form.ShowModal
