' ============================================================
' web_datascience.rr — Data Science Demo (RNum, RDataFrame,
'                       RPlot, RSQLite) in the browser
' ============================================================
' Build with:  rapidr --web web_datascience.rr
' ============================================================
$APPTYPE WEB

DIM Form1 AS RFORM
DIM LblTitle AS RLABEL
DIM Tabs1 AS RTABCONTROL

' -- Num tab --
DIM BtnNumBasic AS RBUTTON
DIM BtnNumStats AS RBUTTON
DIM BtnNumMath AS RBUTTON
DIM GridNum AS RSTRINGGRID
DIM LblNumStatus AS RLABEL
DIM arr1 AS RNUM
DIM arr2 AS RNUM

' -- DataFrame tab --
DIM BtnDfCreate AS RBUTTON
DIM BtnDfFilter AS RBUTTON
DIM BtnDfStats AS RBUTTON
DIM GridDf AS RSTRINGGRID
DIM LblDfStatus AS RLABEL
DIM df1 AS RDATAFRAME

' -- Plot tab --
DIM BtnPlotLine AS RBUTTON
DIM BtnPlotBar AS RBUTTON
DIM BtnPlotPie AS RBUTTON
DIM Plot1 AS RPLOT
DIM LblPlotStatus AS RLABEL

' -- SQLite tab --
DIM BtnDbCreate AS RBUTTON
DIM BtnDbQuery AS RBUTTON
DIM BtnDbInsert AS RBUTTON
DIM GridDb AS RSTRINGGRID
DIM LblDbStatus AS RLABEL
DIM db AS RSQLITE

' ============================================================
' Form
' ============================================================
CREATE Form1 AS RFORM
    .Caption = "RapidR Data Science Demo"
    .Width = 720
    .Height = 560
    .Left = 40
    .Top = 20
END CREATE

CREATE LblTitle AS RLABEL
    .Caption = "Data Science Components"
    .Left = 20
    .Top = 8
    .Width = 350
    .Height = 28
    .FontSize = 17
    .FontBold = 1
END CREATE

CREATE Tabs1 AS RTABCONTROL
    .Left = 20
    .Top = 42
    .Width = 680
    .Height = 36
END CREATE

Tabs1.AddTab("RNum")
Tabs1.AddTab("DataFrame")
Tabs1.AddTab("Plot")
Tabs1.AddTab("SQLite")

