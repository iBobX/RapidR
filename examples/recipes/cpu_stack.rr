' Recipe: The stack (PUSH, POP, CALL, RET)
' Keywords: stack, stack pointer, SP, push, pop, call, return, RET, subroutine, nested calls, return address, LIFO, memory, pila, puntero de pila, apilar, desapilar, llamada, retorno, subrutina, pilha, ponteiro de pilha, empilhar, desempilhar, chamada, sub-rotina
' The stack is just a place in the memory array and a number, SP, that
' says where its top is. It grows DOWN: PUSH counts SP down, then stores the
' byte there; POP reads the byte, then counts SP up. CALL pushes the address
' of the next instruction (high byte first, so the low byte ends at the
' lower address) and jumps; RET pops it back into PC. Step through the little
' program and watch SP and the stack: PUSH saves A, the subroutine changes
' A, POP gets it back.
'
'   rapidr run cpu_stack.rr
$THEME rapidr

CONST OP_LDA = &H01
CONST OP_INC = &H07
CONST OP_PUSH = &H0B
CONST OP_POP = &H0C
CONST OP_CALL = &H0D
CONST OP_RET = &H0E
CONST OP_HLT = &HFF
CONST STACK_TOP = &H200       ' SP starts here: the first PUSH stores at 01FF

DECLARE SUB StepClick
DECLARE SUB RunClick
DECLARE SUB ResetClick

DIM mem(0 TO 65535) AS BYTE
DIM a AS INTEGER, pc AS INTEGER, sp AS INTEGER, halted AS INTEGER

CREATE Form AS RForm
    Caption = "The Stack"
    ClientWidth = 420: ClientHeight = 160
    Center
    CREATE Regs AS RLabel: Caption = "": Left = 16: Top = 16: Width = 388: Font.Name = "Courier New": END CREATE
    CREATE StackView AS RLabel: Caption = "": Left = 16: Top = 44: Width = 388: Font.Name = "Courier New": END CREATE
    CREATE Note AS RLabel: Caption = "": Left = 16: Top = 72: Width = 388: END CREATE
    CREATE StepBtn AS RButton: Caption = "&Step": Left = 16: Top = 108: Width = 120: Height = 32: OnClick = StepClick: END CREATE
    CREATE RunBtn AS RButton: Caption = "&Run": Left = 150: Top = 108: Width = 120: Height = 32: OnClick = RunClick: END CREATE
    CREATE ResetBtn AS RButton: Caption = "R&eset": Left = 284: Top = 108: Width = 120: Height = 32: OnClick = ResetClick: END CREATE
END CREATE

FUNCTION Hex2 (v AS INTEGER) AS STRING
    Result = RIGHT$(HEX$(v), 2)
END FUNCTION

FUNCTION Hex4 (v AS INTEGER) AS STRING
    Result = RIGHT$(HEX$(v), 4)
END FUNCTION

' Bytes written from an address: "01 05 ..."
SUB LoadAt (addr AS INTEGER, text AS STRING)
    DIM i AS INTEGER, n AS INTEGER, piece AS STRING
    n = addr
    FOR i = 1 TO TALLY(text, " ") + 1
        piece = FIELD$(text, " ", i)
        IF LEN(piece) > 0 THEN mem(n) = VAL(CONVBASE$(piece, 16, 10)): n = n + 1
    NEXT
END SUB

FUNCTION Fetch8 AS INTEGER
    Result = mem(pc)
    pc = (pc + 1) AND &HFFFF
END FUNCTION

' --- the stack: SP counts down on a push, up on a pop ---

SUB PushByte (v AS INTEGER)
    sp = (sp - 1) AND &HFFFF
    mem(sp) = v AND &HFF
END SUB

FUNCTION PopByte AS INTEGER
    Result = mem(sp)
    sp = (sp + 1) AND &HFFFF
END FUNCTION

SUB OneStep
    DIM op AS INTEGER, lo AS INTEGER, hi AS INTEGER, target AS INTEGER
    IF halted THEN EXIT SUB
    op = Fetch8
    SELECT CASE op
        CASE OP_LDA: a = Fetch8
        CASE OP_INC: a = (a + 1) AND 255
        CASE OP_PUSH: PushByte a
        CASE OP_POP: a = PopByte
        CASE OP_CALL
            lo = Fetch8: hi = Fetch8: target = lo + hi * 256
            PushByte pc \ 256                     ' the return address: high byte first
            PushByte pc AND 255
            pc = target
        CASE OP_RET
            lo = PopByte: hi = PopByte
            pc = lo + hi * 256
        CASE ELSE: halted = 1
    END SELECT
END SUB

SUB ShowState
    DIM addr AS INTEGER, s AS STRING
    Regs.Caption = "PC=" + Hex4(pc) + "  SP=" + Hex4(sp) + "  A=" + Hex2(a)
    ' the stack, from its top (SP) up to where it started
    s = ""
    FOR addr = sp TO STACK_TOP - 1
        s = s + " " + Hex2(mem(addr))
    NEXT
    StackView.Caption = IIF(sp >= STACK_TOP, "stack: empty", "stack " + Hex4(sp) + ":" + s)
    Note.Caption = IIF(halted, "Halted.", "Next opcode: " + Hex2(mem(pc)))
END SUB

SUB ResetClick
    DIM i AS INTEGER
    FOR i = 0 TO 65535: mem(i) = 0: NEXT
    LoadAt &H0, "01 05  0B  0D 10 00  0C  FF"        ' LDA 5, PUSH, CALL 0010, POP, HALT
    LoadAt &H10, "07  0E"                           ' 0010: INC A, RET
    a = 0: pc = 0: sp = STACK_TOP: halted = 0
    ShowState
END SUB

SUB StepClick
    OneStep
    ShowState
END SUB

SUB RunClick
    DIM n AS INTEGER
    DO WHILE halted = 0 AND n < 100000
        OneStep
        n = n + 1
    LOOP
    ShowState
END SUB

ResetClick
Form.ShowModal
