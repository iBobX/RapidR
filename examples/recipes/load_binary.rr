' Recipe: Load a binary file into memory (and read its header)
' Keywords: binary file, load file, ROM, ROM image, loader, snapshot, header, RFileStream, ReadNum, Num_Byte, Num_Word, little-endian, bytes, memory image, file format, offsets, magic number, WriteNum, WriteBinStr, archivo binario, cargar archivo, cabecera, encabezado, imagen de memoria, formato de archivo, arquivo binário, carregar arquivo, cabeçalho, imagem de memória
' A snapshot file: a 10-byte header, then the memory. The header has its
' fields at fixed offsets: 0-1 "TS" (so we know the file), 2 version, 3 A,
' 4 B, 5 flags, 6-7 PC and 8-9 SP (words, low byte first). RFileStream reads
' them in order: ReadBinStr(2) for the text, ReadNum(Num_Byte) for a byte,
' ReadNum(Num_Word) for a word. The memory comes in with a loop of
' ReadNum(Num_Byte): about a tenth of a second for 64 KB. (Don't read the
' file into one big string and walk it with MID$: that is far slower.)
' Make sample writes a file to load; the zeros go out in one WriteBinStr,
' not 65,000 single writes.
'
'   rapidr run load_binary.rr
$THEME rapidr

CONST SNAPSHOT = "sample.tsn"

DECLARE SUB MakeClick
DECLARE SUB LoadClick

DIM mem(0 TO 65535) AS BYTE

CREATE Form AS RForm
    Caption = "Load a Snapshot"
    ClientWidth = 440: ClientHeight = 190
    Center
    CREATE MakeBtn AS RButton: Caption = "&Make sample file": Left = 16: Top = 16: Width = 150: Height = 32: OnClick = MakeClick: END CREATE
    CREATE LoadBtn AS RButton: Caption = "&Load file": Left = 180: Top = 16: Width = 120: Height = 32: OnClick = LoadClick: END CREATE
    CREATE Header AS RLabel: Caption = "": Left = 16: Top = 66: Width = 408: Font.Name = "Courier New": END CREATE
    CREATE Image AS RLabel: Caption = "": Left = 16: Top = 94: Width = 408: Font.Name = "Courier New": END CREATE
    CREATE Loaded AS RLabel: Caption = "Make the sample file, then load it.": Left = 16: Top = 130: Width = 408: END CREATE
    CREATE Timing AS RLabel: Caption = "": Left = 16: Top = 156: Width = 408: END CREATE
END CREATE

FUNCTION Hex2 (v AS INTEGER) AS STRING
    Result = RIGHT$(HEX$(v), 2)
END FUNCTION

FUNCTION Hex4 (v AS INTEGER) AS STRING
    Result = RIGHT$(HEX$(v), 4)
END FUNCTION

' The file to load: header, then 64 KB of memory with a program at 0100
SUB MakeClick
    DIM f AS RFileStream, i AS INTEGER, prog AS STRING
    prog = "01 05 02 03 05 04 00 02 02 01 06 0A 0A 01 FF"
    f.Open(SNAPSHOT, fmCreate)
    f.WriteBinStr("TS", 2)                   ' 0-1  the file's name tag
    f.WriteNum(1, 1)                         ' 2    version
    f.WriteNum(&H2A, 1)                      ' 3    A
    f.WriteNum(7, 1)                         ' 4    B
    f.WriteNum(2, 1)                         ' 5    flags
    f.WriteNum(&H100, 2)                     ' 6-7  PC, a word
    f.WriteNum(&H200, 2)                     ' 8-9  SP
    f.WriteBinStr(STRING$(256, CHR$(0)), 256)            ' memory 0000-00FF: zeros
    FOR i = 1 TO TALLY(prog, " ") + 1
        f.WriteNum(VAL(CONVBASE$(FIELD$(prog, " ", i), 16, 10)), 1)
    NEXT
    f.WriteBinStr(STRING$(65536 - 256 - 15, CHR$(0)), 65536 - 256 - 15)   ' the rest
    f.Close
    Loaded.Caption = "Wrote " + SNAPSHOT + ": " + STR$(FILELEN(SNAPSHOT)) + " bytes."
END SUB

SUB LoadClick
    DIM f AS RFileStream, i AS INTEGER, count AS INTEGER, t AS DOUBLE
    DIM version AS INTEGER, ra AS INTEGER, rb AS INTEGER, flags AS INTEGER, pc AS INTEGER, sp AS INTEGER
    DIM s AS STRING
    IF FILEEXISTS(SNAPSHOT) = 0 THEN Loaded.Caption = "No " + SNAPSHOT + " yet: press Make sample file.": EXIT SUB
    f.Open(SNAPSHOT, fmOpenRead)
    IF f.ReadBinStr(2) <> "TS" THEN
        f.Close
        Loaded.Caption = "Not a snapshot file."
        EXIT SUB
    END IF
    ' the header, field by field, in the order of the file
    version = f.ReadNum(Num_Byte)
    ra = f.ReadNum(Num_Byte)
    rb = f.ReadNum(Num_Byte)
    flags = f.ReadNum(Num_Byte)
    pc = f.ReadNum(Num_Word)
    sp = f.ReadNum(Num_Word)
    ' the memory: what is left of the file (at most 64 KB)
    count = f.Size - 10
    IF count > 65536 THEN count = 65536
    t = TIMER
    FOR i = 0 TO count - 1
        mem(i) = f.ReadNum(Num_Byte)
    NEXT
    t = TIMER - t
    f.Close
    Header.Caption = "TS v" + STR$(version) + "  A=" + Hex2(ra) + " B=" + Hex2(rb) + " flags=" + Hex2(flags) + " PC=" + Hex4(pc) + " SP=" + Hex4(sp)
    s = ""
    FOR i = 0 TO 7
        s = s + " " + Hex2(mem((pc + i) AND &HFFFF))
    NEXT
    Image.Caption = "memory at PC:" + s
    Loaded.Caption = "Loaded " + STR$(count) + " bytes into memory."
    Timing.Caption = "Reading them took " + STR$(INT(t * 1000)) + " ms."
END SUB

Form.ShowModal
