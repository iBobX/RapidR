' Recipe: Unit converter
' Keywords: unit converter, convert, conversion, kilometers, miles, km, celsius, fahrenheit, temperature, kilograms, pounds, meters, feet, length, weight, combo box, conversor, convertir unidades, conversor de unidades
' Pick a conversion in the combo box, type a value: the result follows.
' Each conversion is a factor (and an offset for temperatures).
'
'   rapidr run unit_converter.rr
$THEME rapidr

DECLARE SUB Convert

CREATE Form AS RForm
    Caption = "Unit Converter"
    ClientWidth = 320: ClientHeight = 168
    Center
    CREATE KindLabel AS RLabel
        Caption = "&Convert:": Left = 16: Top = 20: Width = 80
    END CREATE
    CREATE KindBox AS RComboBox
        Left = 100: Top = 16: Width = 204
        AddItems "Kilometers to miles", "Miles to kilometers", "Celsius to Fahrenheit", "Fahrenheit to Celsius", "Kilograms to pounds", "Pounds to kilograms", "Meters to feet", "Feet to meters"
        ItemIndex = 0
        OnChange = Convert
    END CREATE
    CREATE ValueLabel AS RLabel
        Caption = "&Value:": Left = 16: Top = 56: Width = 80
    END CREATE
    CREATE ValueEdit AS REdit
        Text = "1": Left = 100: Top = 52: Width = 204
        OnChange = Convert
    END CREATE
    CREATE ConvertBtn AS RButton
        Caption = "C&onvert": Left = 100: Top = 88: Width = 100: Height = 28
        Default = 1
        OnClick = Convert
    END CREATE
    CREATE ResultLabel AS RLabel
        Caption = "": Left = 16: Top = 130: Width = 288
        Font.Size = 13: Font.Bold = 1
    END CREATE
END CREATE

SUB Convert
    DIM x AS DOUBLE, y AS DOUBLE, unit AS STRING
    x = VAL(ValueEdit.Text)
    SELECT CASE KindBox.ItemIndex
        CASE 0: y = x * 0.621371: unit = "miles"
        CASE 1: y = x / 0.621371: unit = "km"
        CASE 2: y = x * 9 / 5 + 32: unit = "F"
        CASE 3: y = (x - 32) * 5 / 9: unit = "C"
        CASE 4: y = x * 2.20462: unit = "lb"
        CASE 5: y = x / 2.20462: unit = "kg"
        CASE 6: y = x * 3.28084: unit = "ft"
        CASE 7: y = x / 3.28084: unit = "m"
    END SELECT
    ResultLabel.Caption = "= " + FORMAT$("%.2f", y) + " " + unit
END SUB

Convert
ValueEdit.SetFocus
Form.ShowModal
