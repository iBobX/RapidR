' Recipe: Quiz game
' Keywords: quiz, quiz game, trivia, questions, answers, multiple choice, score, game, capitals, test, juego de preguntas, preguntas, puntaje, jogo de perguntas, perguntas, pontuação
' The questions are DATA lines read into arrays; three answer buttons share
' one handler (Sender says which was pressed); the score is kept.
'
'   rapidr run quiz_game.rr
$THEME rapidr

CONST QUESTIONS = 3

DECLARE SUB Answer (Sender AS RButton)
DECLARE SUB PlayAgain

DIM question(QUESTIONS) AS STRING, choice(QUESTIONS, 3) AS STRING, correct(QUESTIONS) AS INTEGER
DIM current AS INTEGER, score AS INTEGER, i AS INTEGER, j AS INTEGER

' each question: the text, three answers, which one is right (1-3)
DATA "What is the capital of France?", "Madrid", "Paris", "Rome", 2
DATA "What is the capital of Japan?", "Tokyo", "Seoul", "Beijing", 1
DATA "What is the capital of Peru?", "Quito", "Bogota", "Lima", 3
FOR i = 1 TO QUESTIONS
    READ question(i)
    FOR j = 1 TO 3
        READ choice(i, j)
    NEXT
    READ correct(i)
NEXT

CREATE Form AS RForm
    Caption = "Quiz"
    ClientWidth = 360: ClientHeight = 236
    Center
    CREATE QuestionLabel AS RLabel
        Left = 16: Top = 16: Width = 328: Height = 40
        AutoSize = 0: WordWrap = 1: Font.Size = 12
    END CREATE
    CREATE Choice1 AS RButton: Left = 16: Top = 64: Width = 328: Height = 32: OnClick = Answer: END CREATE
    CREATE Choice2 AS RButton: Left = 16: Top = 102: Width = 328: Height = 32: OnClick = Answer: END CREATE
    CREATE Choice3 AS RButton: Left = 16: Top = 140: Width = 328: Height = 32: OnClick = Answer: END CREATE
    CREATE Feedback AS RLabel
        Caption = "": Left = 16: Top = 184: Width = 220
    END CREATE
    CREATE ScoreLabel AS RLabel
        Caption = "Score: 0": Left = 244: Top = 184: Width = 100: Alignment = 1
    END CREATE
    CREATE AgainBtn AS RButton
        Caption = "&Play again": Left = 244: Top = 204: Width = 100: Height = 26
        Visible = 0
        OnClick = PlayAgain
    END CREATE
END CREATE

SUB ShowQuestion
    QuestionLabel.Caption = "Question " + STR$(current) + " of " + STR$(QUESTIONS) + ": " + question(current)
    Choice1.Caption = choice(current, 1)
    Choice2.Caption = choice(current, 2)
    Choice3.Caption = choice(current, 3)
END SUB

SUB Answer (Sender AS RButton)
    IF current > QUESTIONS THEN EXIT SUB
    IF Sender.Caption = choice(current, correct(current)) THEN
        score = score + 1
        Feedback.Caption = "Right!"
    ELSE
        Feedback.Caption = "No: it's " + choice(current, correct(current)) + "."
    END IF
    ScoreLabel.Caption = "Score: " + STR$(score)
    current = current + 1
    IF current <= QUESTIONS THEN
        ShowQuestion
    ELSE
        QuestionLabel.Caption = "Done! You got " + STR$(score) + " of " + STR$(QUESTIONS) + "."
        Choice1.Enabled = 0: Choice2.Enabled = 0: Choice3.Enabled = 0
        AgainBtn.Visible = 1
    END IF
END SUB

SUB PlayAgain
    current = 1: score = 0
    ScoreLabel.Caption = "Score: 0": Feedback.Caption = ""
    Choice1.Enabled = 1: Choice2.Enabled = 1: Choice3.Enabled = 1
    AgainBtn.Visible = 0
    ShowQuestion
END SUB

PlayAgain
Form.ShowModal
