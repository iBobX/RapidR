' Recipe: Disassembler (opcode table to mnemonics)
' Keywords: disassembler, disassemble, opcode table, mnemonic, instruction, operand, machine code, listing, bytes to text, lookup table, DATA, READ, CPU, debugger, desensamblador, desensamblar, codigo maquina, mnemonico, instruccion, tabla de opcodes, depurador, desmontador, código de máquina, mnemônico, instrução, tabela de opcodes
' A disassembler turns bytes back into text, and it needs no SELECT CASE:
' one TABLE says, for each opcode, its name and what follows it. The table
' is DATA lines read once into two arrays indexed by the opcode. Kinds of
' operand: 0 none, 1 a byte (LDA 05), 2 an address (JMP 0010), 3 an address
' in brackets, the byte stored there (STA [0200]). A byte the table doesn't
' know prints as DB. Start in the middle of an instruction and the listing
' goes wrong, as a real one does.
'
'   rapidr run disassembler.rr
$THEME rapidr

DECLARE SUB ListClick

DIM mem(0 TO 65535) AS BYTE
DIM opName(255) AS STRING, opKind(255) AS INTEGER

' opcode (hex: a DATA number can't be written &H..), name, operand kind
DATA "00", "NOP", 0
DATA "01", "LDA", 1
DATA "02", "LDB", 1
DATA "03", "LDA", 3
DATA "04", "STA", 3
DATA "05", "ADD", 0
DATA "06", "SUB", 0
DATA "07", "INC", 0
DATA "08", "DEC", 0
DATA "09", "JMP", 2
DATA "0A", "JNZ", 2
DATA "0B", "PUSH", 0
DATA "0C", "POP", 0
DATA "0D", "CALL", 2
DATA "0E", "RET", 0
DATA "FF", "HALT", 0
DATA "", "", 0

DIM program AS STRING
program = "01 05  02 03  05  04 00 02  0B  0D 10 00  0C  03 00 02  07 0E  06 08  0A 10 00  09 00 00  00  5A  FF"

CREATE Form AS RForm
    Caption = "Disassembler"
    ClientWidth = 420: ClientHeight = 380
    Center
    CREATE FromLabel AS RLabel: Caption = "&From (hex):": Left = 16: Top = 20: Width = 90: END CREATE
    CREATE FromEdit AS REdit: Text = "0000": Left = 110: Top = 16: Width = 80: END CREATE
    CREATE ListBtn AS RButton: Caption = "&Disassemble": Left = 204: Top = 14: Width = 120: Height = 30: OnClick = ListClick: END CREATE
    CREATE Listing AS RListBox: Left = 16: Top = 56: Width = 388: Height = 312: Font.Name = "Courier New": END CREATE
END CREATE

FUNCTION Hex2 (v AS INTEGER) AS STRING
    Result = RIGHT$(HEX$(v), 2)
END FUNCTION

FUNCTION Hex4 (v AS INTEGER) AS STRING
    Result = RIGHT$(HEX$(v), 4)
END FUNCTION

FUNCTION HexVal (s AS STRING) AS INTEGER
    Result = VAL(CONVBASE$(UCASE$(TRIM$(s)), 16, 10))
END FUNCTION

' The table: -1 means "not an instruction"
SUB LoadTable
    DIM i AS INTEGER, code AS STRING, nm AS STRING, kind AS INTEGER
    FOR i = 0 TO 255: opKind(i) = -1: NEXT
    DO
        READ code, nm, kind
        IF code = "" THEN EXIT DO
        opName(HexVal(code)) = nm: opKind(HexVal(code)) = kind
    LOOP
END SUB

SUB LoadProgram
    DIM i AS INTEGER, n AS INTEGER, piece AS STRING
    FOR i = 1 TO TALLY(program, " ") + 1
        piece = FIELD$(program, " ", i)
        IF LEN(piece) > 0 THEN mem(n) = HexVal(piece): n = n + 1
    NEXT
END SUB

' How many bytes the instruction at addr takes: the opcode and its operand
FUNCTION Length (addr AS INTEGER) AS INTEGER
    SELECT CASE opKind(mem(addr AND &HFFFF))
        CASE 1: Result = 2
        CASE 2, 3: Result = 3
        CASE ELSE: Result = 1              ' no operand, or not an instruction
    END SELECT
END FUNCTION

' The instruction at addr as text
FUNCTION Mnemonic (addr AS INTEGER) AS STRING
    DIM op AS INTEGER, operand AS INTEGER
    op = mem(addr AND &HFFFF)
    operand = mem((addr + 1) AND &HFFFF) + mem((addr + 2) AND &HFFFF) * 256
    SELECT CASE opKind(op)
        CASE 0: Result = opName(op)
        CASE 1: Result = opName(op) + " " + Hex2(operand AND &HFF)
        CASE 2: Result = opName(op) + " " + Hex4(operand)
        CASE 3: Result = opName(op) + " [" + Hex4(operand) + "]"
        CASE ELSE: Result = "DB " + Hex2(op)
    END SELECT
END FUNCTION

' One listing line: address, the bytes, the text
FUNCTION ListLine (addr AS INTEGER) AS STRING
    DIM k AS INTEGER, bytes AS STRING
    FOR k = 0 TO Length(addr) - 1
        bytes = bytes + Hex2(mem((addr + k) AND &HFFFF)) + " "
    NEXT
    Result = Hex4(addr) + "  " + LEFT$(bytes + SPACE$(9), 9) + " " + Mnemonic(addr)
END FUNCTION

SUB ListClick
    DIM addr AS INTEGER, i AS INTEGER
    addr = HexVal(FromEdit.Text) AND &HFFFF
    Listing.Clear
    FOR i = 1 TO 18
        Listing.AddItems ListLine(addr)
        addr = (addr + Length(addr)) AND &HFFFF
    NEXT
END SUB

LoadTable
LoadProgram
ListClick
Form.ShowModal
