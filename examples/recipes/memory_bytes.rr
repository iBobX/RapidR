' Recipe: Memory as a byte array (peek, poke, 16-bit words)
' Keywords: memory, RAM, byte array, peek, poke, address, 16-bit word, little-endian, wrap around, 64K, BYTE, hex, AND &HFFFF, memoria, arreglo de bytes, direccion, palabra de 16 bits, memória, endereço, palavra de 16 bits, bytes
' A machine's memory is one array of 65,536 bytes (addresses 0000 to
' FFFF). Every access goes through four small helpers, so the address
' always wraps with AND &HFFFF and a value always fits a byte. A 16-bit word
' is two bytes, the low one first (little-endian). Try Poke word at FFFF:
' the high byte lands at 0000.
'
'   rapidr run memory_bytes.rr
$THEME rapidr

DECLARE SUB PokeByteClick
DECLARE SUB PeekByteClick
DECLARE SUB PokeWordClick
DECLARE SUB PeekWordClick

DIM mem(0 TO 65535) AS BYTE        ' the memory (BYTE: a store wraps at 255)

CREATE Form AS RForm
    Caption = "Memory"
    ClientWidth = 420: ClientHeight = 212
    Center
    CREATE AddrLabel AS RLabel: Caption = "&Address (hex):": Left = 16: Top = 20: Width = 110: END CREATE
    CREATE AddrEdit AS REdit: Text = "0100": Left = 130: Top = 16: Width = 100: END CREATE
    CREATE ValueLabel AS RLabel: Caption = "&Value (hex):": Left = 16: Top = 54: Width = 110: END CREATE
    CREATE ValueEdit AS REdit: Text = "5A": Left = 130: Top = 50: Width = 100: END CREATE
    CREATE PokeByteBtn AS RButton: Caption = "Poke &byte": Left = 16: Top = 90: Width = 92: Height = 30: OnClick = PokeByteClick: END CREATE
    CREATE PeekByteBtn AS RButton: Caption = "Peek b&yte": Left = 112: Top = 90: Width = 92: Height = 30: OnClick = PeekByteClick: END CREATE
    CREATE PokeWordBtn AS RButton: Caption = "Poke &word": Left = 208: Top = 90: Width = 92: Height = 30: OnClick = PokeWordClick: END CREATE
    CREATE PeekWordBtn AS RButton: Caption = "Peek w&ord": Left = 304: Top = 90: Width = 92: Height = 30: OnClick = PeekWordClick: END CREATE
    CREATE Result AS RLabel: Caption = "Type an address and a value.": Left = 16: Top = 136: Width = 388: END CREATE
    CREATE View AS RLabel: Caption = "": Left = 16: Top = 164: Width = 388: Font.Name = "Courier New": END CREATE
END CREATE

' --- the memory: every access wraps the address and fits the value ---

FUNCTION MemRead (addr AS INTEGER) AS INTEGER
    Result = mem(addr AND &HFFFF)
END FUNCTION

SUB MemWrite (addr AS INTEGER, value AS INTEGER)
    mem(addr AND &HFFFF) = value AND &HFF
END SUB

' A 16-bit word: the low byte at addr, the high byte at addr + 1
FUNCTION MemRead16 (addr AS INTEGER) AS INTEGER
    Result = MemRead(addr) + MemRead(addr + 1) * 256
END FUNCTION

SUB MemWrite16 (addr AS INTEGER, value AS INTEGER)
    MemWrite addr, value AND &HFF
    MemWrite addr + 1, (value SHR 8) AND &HFF
END SUB

' --- hex in and out (HEX$ has 8 digits: the last 2 or 4 are the byte or word) ---

FUNCTION Hex2 (v AS INTEGER) AS STRING
    Result = RIGHT$(HEX$(v), 2)
END FUNCTION

FUNCTION Hex4 (v AS INTEGER) AS STRING
    Result = RIGHT$(HEX$(v AND &HFFFF), 4)
END FUNCTION

FUNCTION HexVal (s AS STRING) AS INTEGER
    Result = VAL(CONVBASE$(UCASE$(TRIM$(s)), 16, 10))
END FUNCTION

' --- the window ---

' Eight bytes from the address, wrapping past FFFF
SUB ShowBytes (addr AS INTEGER)
    DIM i AS INTEGER, s AS STRING
    s = Hex4(addr) + ":"
    FOR i = 0 TO 7
        s = s + " " + Hex2(MemRead(addr + i))
    NEXT
    View.Caption = s
END SUB

SUB PokeByteClick
    DIM a AS INTEGER, v AS INTEGER
    a = HexVal(AddrEdit.Text) AND &HFFFF: v = HexVal(ValueEdit.Text) AND &HFF
    MemWrite a, v
    Result.Caption = "Wrote " + Hex2(v) + " at " + Hex4(a)
    ShowBytes a
END SUB

SUB PeekByteClick
    DIM a AS INTEGER
    a = HexVal(AddrEdit.Text) AND &HFFFF
    Result.Caption = "Read " + Hex2(MemRead(a)) + " at " + Hex4(a)
    ShowBytes a
END SUB

SUB PokeWordClick
    DIM a AS INTEGER, v AS INTEGER
    a = HexVal(AddrEdit.Text) AND &HFFFF: v = HexVal(ValueEdit.Text) AND &HFFFF
    MemWrite16 a, v
    Result.Caption = "Wrote " + Hex4(v) + " at " + Hex4(a) + ": " + Hex4(a) + "=" + Hex2(MemRead(a)) + ", " + Hex4(a + 1) + "=" + Hex2(MemRead(a + 1))
    ShowBytes a
END SUB

SUB PeekWordClick
    DIM a AS INTEGER
    a = HexVal(AddrEdit.Text) AND &HFFFF
    Result.Caption = "Read " + Hex4(MemRead16(a)) + " at " + Hex4(a) + " (low byte first)"
    ShowBytes a
END SUB

Form.ShowModal
