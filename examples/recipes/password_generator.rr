' Recipe: Password generator
' Keywords: password generator, password, random, generate, length, symbols, digits, letters, security, RND, RANDOMIZE, check box, generador de contraseñas, contraseña, gerador de senhas, senha
' RANDOMIZE seeds the random numbers once; RND gives 0 to just under 1, so
' INT(RND * n) + 1 picks a position in a string of the allowed characters.
'
'   rapidr run password_generator.rr
$THEME rapidr

DECLARE SUB Generate

RANDOMIZE TIMER

CREATE Form AS RForm
    Caption = "Password Generator"
    ClientWidth = 340: ClientHeight = 180
    Center
    CREATE LengthLabel AS RLabel
        Caption = "&Length:": Left = 16: Top = 20: Width = 70
    END CREATE
    CREATE LengthEdit AS REdit
        Text = "12": Left = 90: Top = 16: Width = 60
    END CREATE
    CREATE DigitsBox AS RCheckBox
        Caption = "&Digits": Left = 170: Top = 18: Width = 70: Checked = 1
    END CREATE
    CREATE SymbolsBox AS RCheckBox
        Caption = "&Symbols": Left = 246: Top = 18: Width = 80: Checked = 1
    END CREATE
    CREATE PasswordEdit AS REdit
        Text = "": Left = 16: Top = 56: Width = 308
        ReadOnly = 1: Font.Size = 14
    END CREATE
    CREATE GenerateBtn AS RButton
        Caption = "&Generate": Left = 16: Top = 104: Width = 120: Height = 32
        Default = 1
        OnClick = Generate
    END CREATE
    CREATE Info AS RLabel
        Caption = "": Left = 148: Top = 112: Width = 176
    END CREATE
END CREATE

SUB Generate
    DIM chars AS STRING, pw AS STRING, n AS INTEGER, i AS INTEGER
    chars = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ"
    IF DigitsBox.Checked THEN chars = chars + "23456789"
    IF SymbolsBox.Checked THEN chars = chars + "!@#$%&*?-+"
    n = VAL(LengthEdit.Text)
    IF n < 4 THEN n = 4
    IF n > 64 THEN n = 64
    LengthEdit.Text = STR$(n)
    pw = ""
    FOR i = 1 TO n
        pw = pw + MID$(chars, INT(RND * LEN(chars)) + 1, 1)
    NEXT
    PasswordEdit.Text = pw
    Info.Caption = STR$(n) + " characters"
END SUB

Generate
Form.ShowModal
