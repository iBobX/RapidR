' Recipe: Video memory drawn on a canvas (bitmap and colour attributes)
' Keywords: video memory, screen, framebuffer, bitmap, pixels, attributes, colour attributes, ink, paper, canvas, RCanvas, redraw, dirty cells, sprite, XOR, scale, 50 Hz, frame, RTimer, memoria de video, pantalla, mapa de bits, atributos de color, lienzo, sprite, cuadro, memória de vídeo, tela, atributos de cor, quadro
' The screen is a region of the memory array: 6,144 bytes of bitmap (256 x 192
' pixels, 1 bit each, 32 bytes a row, the leftmost pixel in bit 7) and 768
' bytes of attributes, one per 8 x 8 cell (bits 0-2 ink colour, 3-5 paper,
' bit 6 a bright ink). Drawing it is a loop that turns bits into coloured
' rectangles, 2 x 2 pixels each. To be fast it only draws what changed:
' every write into video memory marks its cell dirty, and a frame redraws
' just the dirty cells. A moving 8 x 8 ball is drawn with XOR: the same
' draw erases it. Run starts the 50 Hz timer; Frame makes one frame.
'
'   rapidr run video_memory.rr
$THEME rapidr

CONST VIDEO = &H8000          ' the bitmap: 32 bytes a row, 192 rows
CONST ATTR = &H9800           ' the colours: 32 x 24 cells
CONST SCALE = 2               ' a screen pixel is 2 x 2 on the canvas

DECLARE SUB Paint
DECLARE SUB NextFrame
DECLARE SUB RunClick

DIM mem(0 TO 65535) AS BYTE
DIM dirty(767) AS INTEGER                 ' one flag per cell
DIM colour(15) AS INTEGER                 ' 0-7 normal, 8-15 bright (ink only)
DIM sprite(7) AS INTEGER                  ' the ball, 8 rows of 8 bits
DIM bx AS INTEGER, by AS INTEGER, dx AS INTEGER, dy AS INTEGER
DIM frames AS INTEGER, redrawn AS INTEGER

CREATE Form AS RForm
    Caption = "Video Memory": ClientWidth = 512 + 32: ClientHeight = 384 + 72
    Center
    CREATE Screen AS RCanvas: Left = 16: Top = 16: Width = 512: Height = 384: OnPaint = Paint: AccessibleName = "Screen": AccessibleDescription = "The video memory drawn as pixels": END CREATE
    CREATE RunBtn AS RButton: Caption = "&Run": Left = 16: Top = 412: Width = 100: Height = 30: OnClick = RunClick: END CREATE
    CREATE FrameBtn AS RButton: Caption = "&Frame": Left = 124: Top = 412: Width = 100: Height = 30: OnClick = NextFrame: END CREATE
    CREATE Info AS RLabel: Caption = "": Left = 236: Top = 418: Width = 292: END CREATE
    CREATE Clock AS RTimer: Interval = 20: Enabled = 0: OnTimer = NextFrame: END CREATE      ' 50 frames a second
END CREATE

' --- memory: a write into video memory marks its cell dirty ---

SUB MemWrite (addr AS INTEGER, v AS INTEGER)
    DIM a AS INTEGER, off AS INTEGER
    a = addr AND &HFFFF
    mem(a) = v AND &HFF
    IF a >= VIDEO AND a < ATTR THEN
        off = a - VIDEO                          ' row * 32 + byte column; a cell is 8 rows high
        dirty((off \ 256) * 32 + off MOD 32) = 1
    ELSEIF a >= ATTR AND a < ATTR + 768 THEN
        dirty(a - ATTR) = 1
    END IF
END SUB

' --- the screen: one cell (8 bytes, 8 x 8 pixels) drawn from memory ---

SUB DrawCell (cell AS INTEGER)
    DIM cx AS INTEGER, cy AS INTEGER, row AS INTEGER, bit AS INTEGER, v AS INTEGER
    DIM at AS INTEGER, ink AS INTEGER, paper AS INTEGER, x0 AS INTEGER, y0 AS INTEGER
    at = mem(ATTR + cell)
    ink = colour((at AND 7) + IIF(at AND 64, 8, 0))
    paper = colour((at SHR 3) AND 7)
    cx = cell MOD 32: cy = cell \ 32
    x0 = cx * 8 * SCALE: y0 = cy * 8 * SCALE
    Screen.FillRect(x0, y0, x0 + 8 * SCALE, y0 + 8 * SCALE, paper)     ' the paper first
    FOR row = 0 TO 7
        v = mem(VIDEO + (cy * 8 + row) * 32 + cx)
        IF v <> 0 THEN
            FOR bit = 0 TO 7                                            ' bit 7 is the leftmost pixel
                IF v AND (128 SHR bit) THEN Screen.FillRect(x0 + bit * SCALE, y0 + row * SCALE, x0 + (bit + 1) * SCALE, y0 + (row + 1) * SCALE, ink)
            NEXT
        END IF
    NEXT
END SUB

' Redraw the dirty cells (all of them with force = 1); how many were drawn
FUNCTION Present (force AS INTEGER) AS INTEGER
    DIM cell AS INTEGER, n AS INTEGER
    FOR cell = 0 TO 767
        IF force OR dirty(cell) THEN DrawCell cell: dirty(cell) = 0: n = n + 1
    NEXT
    Result = n
END FUNCTION

SUB Paint
    redrawn = Present(1)                                  ' the window needs its picture: all of it
END SUB

' --- the "program": XOR the ball into the bitmap, a byte pair per row ---

SUB XorBall
    DIM row AS INTEGER, w AS INTEGER, addr AS INTEGER
    FOR row = 0 TO 7
        w = (sprite(row) * 256) SHR (bx AND 7)          ' 16 bits: the row, shifted to its pixel
        addr = VIDEO + (by + row) * 32 + bx \ 8
        MemWrite addr, mem(addr) XOR ((w SHR 8) AND 255)
        MemWrite addr + 1, mem(addr + 1) XOR (w AND 255)
    NEXT
END SUB

SUB NextFrame
    XorBall                                               ' erase it where it was
    bx = bx + dx: by = by + dy
    IF bx < 1 OR bx > 247 THEN dx = -dx: bx = bx + 2 * dx
    IF by < 1 OR by > 183 THEN dy = -dy: by = by + 2 * dy
    XorBall                                               ' and draw it where it is
    frames = frames + 1
    redrawn = Present(0)
    Info.Caption = "Frame " + STR$(frames) + "   ball at " + STR$(bx) + "," + STR$(by) + "   cells redrawn: " + STR$(redrawn)
END SUB

SUB RunClick
    Clock.Enabled = IIF(Clock.Enabled, 0, 1)
    RunBtn.Caption = IIF(Clock.Enabled, "&Pause", "&Run")
END SUB

' --- set up: colours, the attributes, a frame round the screen, the ball ---

SUB Setup
    DIM i AS INTEGER, cx AS INTEGER, cy AS INTEGER, shape AS STRING
    FOR i = 0 TO 7
        ' (a colour number is 3 bits: bit 0 red, bit 1 green, bit 2 blue)
        colour(i) = RGB((i AND 1) * 190, ((i SHR 1) AND 1) * 190, ((i SHR 2) AND 1) * 190)
        colour(i + 8) = RGB((i AND 1) * 255, ((i SHR 1) AND 1) * 255, ((i SHR 2) AND 1) * 255)
    NEXT
    FOR cy = 0 TO 23
        FOR cx = 0 TO 31
            ' yellow ink (3) on a blue (4) and black (0) chessboard, a bright ink
            MemWrite ATTR + cy * 32 + cx, 3 + IIF((cx + cy) AND 1, 4, 0) * 8 + 64
        NEXT
    NEXT
    FOR i = 0 TO 31                                        ' the frame: top and bottom rows ...
        MemWrite VIDEO + i, 255
        MemWrite VIDEO + 191 * 32 + i, 255
    NEXT
    FOR i = 1 TO 190                                       ' ... and the left and right columns
        MemWrite VIDEO + i * 32, mem(VIDEO + i * 32) OR 128
        MemWrite VIDEO + i * 32 + 31, mem(VIDEO + i * 32 + 31) OR 1
    NEXT
    shape = "3C 7E FF FF FF FF 7E 3C"
    FOR i = 0 TO 7
        sprite(i) = VAL(CONVBASE$(FIELD$(shape, " ", i + 1), 16, 10))
    NEXT
    bx = 40: by = 30: dx = 2: dy = 1
    XorBall
END SUB

Setup
Form.ShowModal
