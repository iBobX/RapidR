' Recipe: Flags and bit operations (8-bit add, subtract, rotate)
' Keywords: flags, flag register, bits, bit operations, carry, zero, sign, overflow, half carry, AND, OR, XOR, SHL, SHR, rotate, signed, unsigned, 8-bit, ALU, bandera, banderas, acarreo, desbordamiento, bits, rotar, registro de banderas, sinal, transbordo, estouro, rotacionar
' An 8-bit ALU in a few lines. The flags are bits of one number: set one
' with OR, clear it with AND (NOT mask), test it with AND. After an add or a
' subtract the flags say what happened: Carry (it didn't fit 8 bits),
' Zero, Sign (bit 7), Overflow (the signed result is wrong), Half-carry
' (a carry out of bit 3) and N (the last operation was a subtract).
' A rotate moves the bits through the carry. Try 7F + 01: Sign and
' Overflow, because 127 + 1 isn't -128.
'
'   rapidr run flags_bits.rr
$THEME rapidr

CONST FLAG_C = 1            ' carry
CONST FLAG_Z = 2            ' zero
CONST FLAG_S = 4            ' sign: bit 7 of the result
CONST FLAG_V = 8            ' overflow (signed)
CONST FLAG_H = 16           ' half-carry: out of bit 3
CONST FLAG_N = 32           ' the last operation subtracted

DECLARE SUB DoOp (Sender AS RButton)

DIM flags AS INTEGER        ' all the flags in one number

CREATE Form AS RForm
    Caption = "Flags"
    ClientWidth = 420: ClientHeight = 236
    Center
    CREATE ALabel AS RLabel: Caption = "&A (hex):": Left = 16: Top = 20: Width = 80: END CREATE
    CREATE AEdit AS REdit: Text = "7F": Left = 100: Top = 16: Width = 80: END CREATE
    CREATE BLabel AS RLabel: Caption = "&B (hex):": Left = 210: Top = 20: Width = 80: END CREATE
    CREATE BEdit AS REdit: Text = "01": Left = 294: Top = 16: Width = 80: END CREATE
    CREATE AddBtn AS RButton: Caption = "A + B": Left = 16: Top = 56: Width = 120: Height = 30: Tag = 1: OnClick = DoOp: END CREATE
    CREATE AdcBtn AS RButton: Caption = "A + B + carry": Left = 150: Top = 56: Width = 120: Height = 30: Tag = 2: OnClick = DoOp: END CREATE
    CREATE SubBtn AS RButton: Caption = "A - B": Left = 284: Top = 56: Width = 120: Height = 30: Tag = 3: OnClick = DoOp: END CREATE
    CREATE SbcBtn AS RButton: Caption = "A - B - carry": Left = 16: Top = 92: Width = 120: Height = 30: Tag = 4: OnClick = DoOp: END CREATE
    CREATE RolBtn AS RButton: Caption = "Rotate A left": Left = 150: Top = 92: Width = 120: Height = 30: Tag = 5: OnClick = DoOp: END CREATE
    CREATE RorBtn AS RButton: Caption = "Rotate A right": Left = 284: Top = 92: Width = 120: Height = 30: Tag = 6: OnClick = DoOp: END CREATE
    CREATE Result AS RLabel: Caption = "Pick an operation.": Left = 16: Top = 140: Width = 388: Font.Size = 12: END CREATE
    CREATE Bits AS RLabel: Caption = "": Left = 16: Top = 168: Width = 388: Font.Name = "Courier New": END CREATE
    CREATE FlagsLabel AS RLabel: Caption = "": Left = 16: Top = 198: Width = 388: Font.Name = "Courier New": END CREATE
END CREATE

FUNCTION HexVal (s AS STRING) AS INTEGER
    Result = VAL(CONVBASE$(UCASE$(TRIM$(s)), 16, 10)) AND &HFF
END FUNCTION

FUNCTION Hex2 (v AS INTEGER) AS STRING
    Result = RIGHT$(HEX$(v), 2)
END FUNCTION

' A byte as 8 binary digits (BIN$ leaves the leading zeros out)
FUNCTION Bin8 (v AS INTEGER) AS STRING
    Result = RIGHT$("00000000" + BIN$(v), 8)
END FUNCTION

' The same byte as a signed number: 80 to FF are -128 to -1
FUNCTION Signed (v AS INTEGER) AS INTEGER
    Result = IIF(v >= 128, v - 256, v)
END FUNCTION

' Set (on = 1) or clear (on = 0) the flag with this mask
SUB SetFlag (mask AS INTEGER, on AS INTEGER)
    IF on THEN
        flags = flags OR mask
    ELSE
        flags = flags AND (NOT mask)
    END IF
END SUB

FUNCTION GetFlag (mask AS INTEGER) AS INTEGER
    Result = IIF((flags AND mask) <> 0, 1, 0)
END FUNCTION

' Zero and Sign, which every operation sets from its result
SUB SetZS (r AS INTEGER)
    SetFlag FLAG_Z, r = 0
    SetFlag FLAG_S, (r AND &H80) <> 0
END SUB

' a + b + carry-in: the result, and every flag
FUNCTION AddBytes (a AS INTEGER, b AS INTEGER, cin AS INTEGER) AS INTEGER
    DIM t AS INTEGER, r AS INTEGER
    t = a + b + cin
    r = t AND &HFF
    SetFlag FLAG_C, t > &HFF
    SetFlag FLAG_H, (a AND &HF) + (b AND &HF) + cin > &HF
    SetFlag FLAG_V, ((a XOR r) AND (b XOR r) AND &H80) <> 0
    SetFlag FLAG_N, 0
    SetZS r
    Result = r
END FUNCTION

' a - b - borrow-in: carry means a borrow
FUNCTION SubBytes (a AS INTEGER, b AS INTEGER, cin AS INTEGER) AS INTEGER
    DIM t AS INTEGER, r AS INTEGER
    t = a - b - cin
    r = t AND &HFF
    SetFlag FLAG_C, t < 0
    SetFlag FLAG_H, (a AND &HF) - (b AND &HF) - cin < 0
    SetFlag FLAG_V, ((a XOR b) AND (a XOR r) AND &H80) <> 0
    SetFlag FLAG_N, 1
    SetZS r
    Result = r
END FUNCTION

' Rotate left through the carry: bit 7 goes to the carry, the carry to bit 0
FUNCTION RotLeft (a AS INTEGER) AS INTEGER
    DIM r AS INTEGER
    r = ((a SHL 1) OR GetFlag(FLAG_C)) AND &HFF
    SetFlag FLAG_C, (a AND &H80) <> 0
    Result = r
END FUNCTION

FUNCTION RotRight (a AS INTEGER) AS INTEGER
    DIM r AS INTEGER
    r = (a SHR 1) OR (GetFlag(FLAG_C) SHL 7)
    SetFlag FLAG_C, (a AND 1) <> 0
    Result = r
END FUNCTION

SUB DoOp (Sender AS RButton)
    DIM a AS INTEGER, b AS INTEGER, r AS INTEGER
    a = HexVal(AEdit.Text): b = HexVal(BEdit.Text)
    SELECT CASE Sender.Tag
        CASE 1: r = AddBytes(a, b, 0)
        CASE 2: r = AddBytes(a, b, GetFlag(FLAG_C))
        CASE 3: r = SubBytes(a, b, 0)
        CASE 4: r = SubBytes(a, b, GetFlag(FLAG_C))
        CASE 5: r = RotLeft(a)
        CASE ELSE: r = RotRight(a)
    END SELECT
    AEdit.Text = Hex2(r)                       ' the result is the next A
    Result.Caption = "A = " + Hex2(r) + "   unsigned " + STR$(r) + ", signed " + STR$(Signed(r))
    Bits.Caption = "bits  " + Bin8(r)
    FlagsLabel.Caption = "S=" + STR$(GetFlag(FLAG_S)) + " Z=" + STR$(GetFlag(FLAG_Z)) + " H=" + STR$(GetFlag(FLAG_H)) + " V=" + STR$(GetFlag(FLAG_V)) + " N=" + STR$(GetFlag(FLAG_N)) + " C=" + STR$(GetFlag(FLAG_C))
END SUB

Form.ShowModal
