# RapidR Studio project (format 2)

format = 2
name = "Tip Calculator"
main = "main.rr"

[[files]]
path = "main.rr"
kind = "module"

[[files]]
path = "art/tips.svg"
kind = "resource"

[build]
icon = "art/tips.svg"
app_name = "Tip Calculator"
bundle_id = "dev.rapidr.example.tips"
version = "1.2.0"
company = "RapidR Examples"
copyright = "(c) 2026 RapidR Examples"
description = "Splits the bill and the tip between friends"
website = "https://github.com/iBobX/RapidR"
category = "finance"
targets = ["bytecode"]
output = "build"
