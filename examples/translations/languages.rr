' languages.rr: one program in four languages. Its text is written in
' English and wrapped in TR$ (and TRN$ for "1 file" / "5 files"); the
' translations are PO files in the lang folder beside it: lang/es.po,
' lang/pt.po, lang/zh-Hans.po. It starts in the system's language; the list
' at the top switches (Application.Language), and Application.OnLanguageChange
' writes every caption again. Add a file counts in each language's way. A
' canvas draws the greeting with TextOut: Chinese on a canvas shows as it
' does on a label (RapidR uses the system's CJK font for what its own fonts
' lack).
'
'   rapidr run languages.rr        (the system's language)
'   rapidr run languages.rr es     (Spanish; pt, zh-Hans, en)
'
' The manual: docs/manual/translations.md.
$THEME rapidr

DECLARE SUB ShowTexts
DECLARE SUB Pick
DECLARE SUB AddFile
DECLARE SUB DrawBanner

DIM files AS INTEGER
files = 1
IF COMMAND$(1) <> "" THEN Application.Language = COMMAND$(1)

CREATE Form AS RForm
    Width = 380: Height = 250
    Center
    ' (fixed widths, AutoSize off: room for the longest language)
    CREATE LanguageLabel AS RLabel
        Left = 16: Top = 18: Width = 130: AutoSize = 0
    END CREATE
    CREATE Languages AS RComboBox
        Left = 150: Top = 14: Width = 200
        AddItems "English", "Español", "Português", "中文"
    END CREATE
    CREATE Greeting AS RLabel
        Left = 16: Top = 56: Width = 340: AutoSize = 0
    END CREATE
    CREATE FileCount AS RLabel
        Left = 16: Top = 84: Width = 340: AutoSize = 0
    END CREATE
    CREATE AddButton AS RButton
        Left = 16: Top = 122: Width = 160
        OnClick = AddFile
    END CREATE
    CREATE SaveButton AS RButton
        Left = 190: Top = 122: Width = 160
    END CREATE
    ' (the greeting drawn, not a label: the same text, TextOut's way)
    CREATE Banner AS RCanvas
        Left = 16: Top = 164: Width = 334: Height = 40
    END CREATE
END CREATE

' The captions, in the language the program speaks now.
SUB ShowTexts
    Form.Caption = TR$("Languages")
    LanguageLabel.Caption = TR$("Language:")
    Greeting.Caption = TR$("Hello, {name}!", "name", "Ana")
    FileCount.Caption = TRN$("{n} file", "{n} files", files)
    AddButton.Caption = TR$("&Add a file")
    SaveButton.Caption = TR$("&Save", "button")
    DrawBanner
END SUB

' The greeting drawn on the canvas.
SUB DrawBanner
    Banner.Cls
    Banner.FontSize = 14
    Banner.TextOut 6, 8, Greeting.Caption, &H202020, -1
END SUB

' The list picked a language: the program speaks it from now on.
SUB Pick
    SELECT CASE Languages.ItemIndex
        CASE 1: Application.Language = "es"
        CASE 2: Application.Language = "pt"
        CASE 3: Application.Language = "zh-Hans"
        CASE ELSE: Application.Language = "en"
    END SELECT
END SUB

SUB AddFile
    files = files + 1
    FileCount.Caption = TRN$("{n} file", "{n} files", files)
END SUB

' The list shows the language the program starts in.
SELECT CASE LEFT$(Application.Language, 2)
    CASE "es": Languages.ItemIndex = 1
    CASE "pt": Languages.ItemIndex = 2
    CASE "zh": Languages.ItemIndex = 3
    CASE ELSE: Languages.ItemIndex = 0
END SELECT
ShowTexts
Languages.OnChange = Pick
Application.OnLanguageChange = ShowTexts
Form.ShowModal
