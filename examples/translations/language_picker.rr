' language_picker.rr: a window that follows the language you pick, with
' the least code. Its captions are TR$ in the CREATE blocks and nothing
' else: when Application.Language changes they change by themselves. The
' list of languages comes from the catalogs beside the program
' (Application.Languages: lang/es.po, lang/pt.po, lang/zh-Hans.po), each
' shown by its own name (Application.LanguageName: Español, Português,
' 中文（简体）). Only the line made with a value — "2 files" — is made again
' in Application.OnLanguageChange.
'
'   rapidr run language_picker.rr
'
' The manual: docs/manual/translations.md, "The language".
$THEME rapidr

DECLARE SUB Pick
DECLARE SUB ShowCount
DECLARE SUB AddFile

DIM Tags(16) AS STRING
DIM TagCount AS INTEGER
DIM Files AS INTEGER

CREATE Form AS RForm
    Caption = TR$("Languages")
    Width = 360: Height = 170
    Center
    CREATE LanguageLabel AS RLabel
        Caption = TR$("Language:")
        Left = 16: Top = 20: Width = 120: AutoSize = 0
    END CREATE
    CREATE Languages AS RComboBox
        Style = 2
        AccessibleName = TR$("Language:")
        Left = 140: Top = 16: Width = 190
    END CREATE
    CREATE AddButton AS RButton
        Caption = TR$("&Add a file")
        Left = 16: Top = 62: Width = 150
        OnClick = AddFile
    END CREATE
    CREATE FileCount AS RLabel
        Left = 180: Top = 68: Width = 160: AutoSize = 0
    END CREATE
END CREATE

' "1 file", "2 files": a text made with a value — made again when the
' language changes.
SUB ShowCount
    FileCount.Caption = TRN$("{n} file", "{n} files", Files)
END SUB

SUB AddFile
    Files = Files + 1
    ShowCount
END SUB

SUB Pick
    IF Languages.ItemIndex >= 0 THEN Application.Language = Tags(Languages.ItemIndex)
END SUB

' English (the program's own text), then each catalog's language.
DIM all AS STRING, i AS INTEGER, t AS STRING
Tags(0) = "en": Languages.AddItems "English"
TagCount = 1
all = Application.Languages
FOR i = 1 TO TALLY(all, CHR$(10)) + 1
    t = FIELD$(all, CHR$(10), i)
    IF t <> "" AND TagCount < 16 THEN
        Tags(TagCount) = t
        Languages.AddItems Application.LanguageName(t)
        IF LEFT$(Application.Language, LEN(t)) = t THEN Languages.ItemIndex = TagCount
        TagCount = TagCount + 1
    END IF
NEXT
IF Languages.ItemIndex < 0 THEN Languages.ItemIndex = 0
ShowCount
Languages.OnChange = Pick
Application.OnLanguageChange = ShowCount
Form.ShowModal
