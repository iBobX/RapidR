' helpers.rr: a small window to try RapidR Studio's code helpers on. Open
' it in Studio and each value shows beside the code: a colour's swatch,
' the picture's thumbnail, the font's sample, the line's help at its end.
' Click a swatch (or put the caret on a value and press Ctrl+., Cmd+. on a
' Mac) to change it: a colour wheel, the project's pictures, the fonts,
' the choices. Hold Ctrl a moment to see every argument's name.
'
'   rapidr run studio/helpers.rr

DECLARE SUB PaintStripes
DECLARE SUB Recolour

DIM turn AS INTEGER

CREATE Form AS RForm
    Caption = "Helpers"
    Width = 360: Height = 250
    Color = RGB(250, 246, 238)
    Center
    CREATE Logo AS RImage
        Left = 16: Top = 16: Width = 48: Height = 48
    END CREATE
    CREATE Title AS RLabel
        Caption = "Colours, pictures and fonts"
        Left = 76: Top = 30: Width = 260
        FontColor = &H6B3A1F
    END CREATE
    CREATE Stripes AS RCanvas
        Left = 16: Top = 80: Width = 320: Height = 60
        OnPaint = PaintStripes
    END CREATE
    CREATE Again AS RButton
        Caption = "&Recolour"
        Left = 16: Top = 160: Width = 100
        Align = alNone
        OnClick = Recolour
    END CREATE
END CREATE

DIM TitleFont AS RFont
TitleFont.Name = "Inter"
TitleFont.Size = 12
Title.Font = TitleFont
Logo.Load "logo.svg"

' The stripes: three colours, each written its own way.
SUB PaintStripes
    Stripes.FillRect 0, 0, 107, 60, RGB(255, 130, 20)
    Stripes.FillRect 107, 0, 214, 60, clTeal
    Stripes.FillRect 214, 0, 320, 60, &HC08040
END SUB

' The button turns the form's colour round three.
SUB Recolour
    turn = (turn + 1) MOD 3
    SELECT CASE turn
        CASE 0: Form.Color = RGB(250, 246, 238)
        CASE 1: Form.Color = RGB(232, 244, 236)
        CASE 2: Form.Color = RGB(236, 240, 250)
    END SELECT
    Title.Caption = "Colour " + STR$(turn + 1) + " of 3"
END SUB

Form.ShowModal
