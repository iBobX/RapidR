' RDiffView's three views (Versions, docs/manual/versions.md): two
' versions of something compared, as RapidR Studio shows "What changed?".
'   Text:  two versions of a program, line by line; the changed words are
'          marked, each run of changes (a hunk) can be accepted or rejected.
'   Form:  two versions of a form's CREATE blocks: the form before and
'          after, drawn as the designer draws it, the changed components
'          outlined, the changed properties listed in words.
'   Table: two versions of a CSV file: rows added, removed and changed,
'          the changed cells marked, a new column tinted.
' The line under the view is the Summary property: the changes in words.
'
'   rapidr run studio/diff_views.rr
'
' (The form view needs RapidR Studio's form designer: `rapidr run`, RapidR
' Studio and web programs have it; an executable built on its own shows a
' note instead.)
$THEME rapidr

DECLARE SUB ShowText
DECLARE SUB ShowForm
DECLARE SUB ShowTable
DECLARE SUB Report

CREATE Main AS RForm
  Caption = "What changed?"
  Width = 860: Height = 600
  Center
  CREATE BText AS RButton
    Caption = "&Text": Left = 8: Top = 8: Width = 90
    OnClick = ShowText
  END CREATE
  CREATE BForm AS RButton
    Caption = "&Form": Left = 104: Top = 8: Width = 90
    OnClick = ShowForm
  END CREATE
  CREATE BTable AS RButton
    Caption = "T&able": Left = 200: Top = 8: Width = 90
    OnClick = ShowTable
  END CREATE
  CREATE Diff AS RDiffView
    Left = 8: Top = 42: Width = 828: Height = 470
  END CREATE
  CREATE Info AS RLabel
    Left = 8: Top = 520: Width = 828: Height = 40
  END CREATE
END CREATE

NL$ = CHR$(10)
Q$ = CHR$(34)

SUB Report
  ' (the first line of the summary, and how many changes in all)
  S$ = Diff.Summary
  P = INSTR(S$, CHR$(10))
  IF P > 0 THEN S$ = LEFT$(S$, P - 1) + " ..."
  Info.Caption = STR$(Diff.ChangeCount) + " change(s): " + S$
END SUB

SUB ShowText
  Diff.Kind = "text"
  Diff.LeftText = "SUB Greet" + NL$ + "  Answer.Caption = " + Q$ + "Hello, " + Q$ + " + Who$" + NL$ + "END SUB" + NL$
  Diff.RightText = "SUB Greet" + NL$ + "  Answer.Caption = " + Q$ + "Hello again, " + Q$ + " + Who$ + " + Q$ + "!" + Q$ + NL$ + "  Clicks = Clicks + 1" + NL$ + "END SUB" + NL$
  Report
END SUB

SUB ShowForm
  Diff.Kind = "form"
  Diff.LeftText = "CREATE Hello AS RForm" + NL$ + "  Caption = " + Q$ + "Hello" + Q$ + ": Width = 300: Height = 150" + NL$ + "  CREATE NameEdit AS REdit" + NL$ + "    Left = 16: Top = 16: Width = 180" + NL$ + "  END CREATE" + NL$ + "  CREATE Go AS RButton" + NL$ + "    Caption = " + Q$ + "OK" + Q$ + NL$ + "    Left = 16: Top = 56" + NL$ + "  END CREATE" + NL$ + "END CREATE" + NL$
  Diff.RightText = "CREATE Hello AS RForm" + NL$ + "  Caption = " + Q$ + "Hello" + Q$ + ": Width = 300: Height = 150" + NL$ + "  CREATE NameEdit AS REdit" + NL$ + "    Left = 16: Top = 16: Width = 180" + NL$ + "  END CREATE" + NL$ + "  CREATE Go AS RButton" + NL$ + "    Caption = " + Q$ + "Say hello" + Q$ + NL$ + "    Left = 16: Top = 56: Width = 110" + NL$ + "  END CREATE" + NL$ + "  CREATE Answer AS RLabel" + NL$ + "    Left = 140: Top = 60: Width = 140" + NL$ + "    Caption = " + Q$ + "Hello, you!" + Q$ + NL$ + "  END CREATE" + NL$ + "END CREATE" + NL$
  Report
END SUB

SUB ShowTable
  Diff.Kind = "table"
  Diff.LeftText = "Id,Name,Score" + NL$ + "1,Ana,10" + NL$ + "2,Ben,7" + NL$ + "3,Cy,5" + NL$
  Diff.RightText = "Id,Name,Score,City" + NL$ + "1,Ana,12,Lima" + NL$ + "3,Cy,5,Rome" + NL$ + "4,Dee,9,Kyiv" + NL$
  Report
END SUB

ShowText
Main.ShowModal
