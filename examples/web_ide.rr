        END CREATE
        CREATE MNewForm AS RMENUITEM
            Caption = "New Form"
        END CREATE
        CREATE MToggle AS RMENUITEM
            Caption = "Code/Design"
        END CREATE
        CREATE MGenerate AS RMENUITEM
