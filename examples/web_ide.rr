        Height = 18
    END CREATE
    CREATE PropGrid AS RSTRINGGRID
        Left = 984
        Top = 90
        Width = 288
        Height = 380
    END CREATE
    CREATE BtnApply AS RBUTTON
        Caption = "Apply Properties"
        Left = 984
        Top = 478
        Width = 288
        Height = 28
    END CREATE
    CREATE LblEvents AS RLABEL
