    END CREATE
    CREATE FormsList AS RLISTBOX
        Left = 8
        Top = 478
        Width = 180
        Height = 220
    END CREATE
    CREATE BtnDelForm AS RBUTTON
        Caption = "Delete Form"
        Left = 8
        Top = 704
        Width = 180
        Height = 28
    END CREATE

    CREATE Designer AS RCANVAS
        Left = 196
        Top = 70
        Width = 780
        Height = 662
    END CREATE

    CREATE CodeEditor AS RCODEEDITOR
        Left = 196
        Top = 70
        Width = 780
