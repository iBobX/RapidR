' ============================================================
' RapidR Web IDE v2 — visual designer with realistic previews,
' draggable form windows, multiple forms, pointer/select mode.
' Build:  ./rapidr --web examples/web_ide.rr
' Serve:  python3 -m http.server -d examples/web_ide_web 8090
' ============================================================
$APPTYPE WEB

' ============================================================
' GLOBAL STATE
' ============================================================
DIM CurrentTool AS STRING            ' "" or "Pointer" = select mode; otherwise component name
DIM SelKind AS INTEGER               ' 0=none, 1=form, 2=component
DIM SelIndex AS INTEGER              ' if SelKind=2, index into Comp arrays
DIM ShowingCode AS INTEGER           ' 0=design, 1=code

' Drag state
DIM DragMode AS INTEGER              ' 0=none, 1=move-component, 2=move-form
DIM DragStartX AS INTEGER
DIM DragStartY AS INTEGER
DIM DragOrigX AS INTEGER
DIM DragOrigY AS INTEGER

' --- Forms (up to 20) ---
DIM FormCount AS INTEGER
DIM ActiveForm AS INTEGER            ' index of currently shown form
DIM FormName(20) AS STRING
DIM FormCaption(20) AS STRING
DIM FormX(20) AS INTEGER             ' window position within workspace
DIM FormY(20) AS INTEGER
DIM FormW(20) AS INTEGER
DIM FormH(20) AS INTEGER
DIM FormSeq AS INTEGER               ' next form number
DIM FormState(20) AS INTEGER         ' 0=normal, 1=minimized, 2=maximized
DIM FormPrevX(20) AS INTEGER
DIM FormPrevY(20) AS INTEGER
DIM FormPrevW(20) AS INTEGER
DIM FormPrevH(20) AS INTEGER

' --- Components (up to 400 across all forms) ---
DIM CompForm(400) AS INTEGER         ' which form this comp belongs to
DIM CompName(400) AS STRING
DIM CompType(400) AS STRING
DIM CompX(400) AS INTEGER            ' relative to form's body (below titlebar)
DIM CompY(400) AS INTEGER
DIM CompW(400) AS INTEGER
DIM CompH(400) AS INTEGER
DIM CompCaption(400) AS STRING
DIM CompCount AS INTEGER

' --- Event handlers (per-component code bodies) ---
'   Each component can have several events with code. Stored in flat tables.
DIM EvCompIdx(800) AS INTEGER        ' which component owns this event
DIM EvName(800) AS STRING            ' "OnClick", "OnChange", "OnMouseDown"...
DIM EvBody(800) AS STRING            ' BASIC source for the body
DIM EvCount AS INTEGER

' Event-edit context: when ShowingCode = 2, we are editing this event.
DIM EditEvIdx AS INTEGER             ' index into Ev arrays, or -1
DIM EditEvCompName AS STRING
DIM EditEvName AS STRING

' Mirror of EventsList items (because RLISTBOX has no GetItem)
DIM EvListNames(8) AS STRING
DIM EvListCount AS INTEGER

' --- Counters for unique naming ---
DIM BtnSeq AS INTEGER
DIM LblSeq AS INTEGER
DIM EdtSeq AS INTEGER
DIM MmoSeq AS INTEGER
DIM ChkSeq AS INTEGER
DIM RadSeq AS INTEGER
DIM CmbSeq AS INTEGER
DIM LstSeq AS INTEGER
DIM PnlSeq AS INTEGER
DIM GrpSeq AS INTEGER
DIM PrgSeq AS INTEGER
DIM ImgSeq AS INTEGER
DIM CnvSeq AS INTEGER
DIM SgdSeq AS INTEGER
DIM TabSeq AS INTEGER
DIM TrvSeq AS INTEGER

CONST TITLEBAR_H = 24

' Hit-test results
DIM HitRegion AS INTEGER             ' 0=empty, 1=titlebar, 2=form body, 3=component, 4=min, 5=max, 6=close
DIM HitInfo AS INTEGER

' ============================================================
' MAIN UI
' ============================================================
CREATE IDE AS RFORM
    Caption = "RapidR Web IDE"
    Width = 1280
    Height = 800
    Left = 0
    Top = 0

    CREATE MainMenu AS RMAINMENU
        CREATE MNew AS RMENUITEM
            Caption = "New Project"
        END CREATE
        CREATE MOpen AS RMENUITEM
            Caption = "Open..."
        END CREATE
        CREATE MSave AS RMENUITEM
