        Left = 984
        Top = 514
        Width = 288
        Height = 18
    END CREATE
    CREATE EventsList AS RLISTBOX
        Left = 984
        Top = 534
        Width = 288
        Height = 140
    END CREATE
    CREATE BtnEditEvent AS RBUTTON
        Caption = "Edit Event Code"
        Left = 984
        Top = 678
        Width = 288
