' rai_models.rr: RAI, RapidR's AI component — choose a provider, give it
' your API key, list the provider's models, ask one a question and watch
' the answer stream in.
'
'   rapidr run rai_models.rr
'   rapidr run rai_models.rr http://localhost:11434/v1   (a server on this
'                                                         machine: Ollama, LM Studio …)
'
' Your key is never written into the program. APIKeySource says where it
' comes from: "env:OPENAI_API_KEY|ask" — the provider's environment
' variable if it is set, else the program asks (OnKeyNeeded) and you type
' it in the box, kept only while the program runs. An Anthropic key made
' outside a workspace needs the workspace's ID too (Workspace ID, shown for
' Anthropic only; or ANTHROPIC_WORKSPACE_ID). No model is chosen for you:
' List Models shows the provider's own, the fast, low-cost ones first (by
' the words of their names). A question costs a little on a paid provider:
' "See prices" says how much.

DECLARE SUB ProviderPicked
DECLARE SUB AddressTyped
DECLARE SUB KeyTyped
DECLARE SUB WorkspaceTyped
DECLARE SUB ListModels
DECLARE SUB ModelsIn(Count AS INTEGER)
DECLARE SUB ModelPicked
DECLARE SUB AskOrStop
DECLARE SUB TokenIn(Text AS STRING)
DECLARE SUB AnswerDone(Status AS STRING)
DECLARE SUB Failed(Message AS STRING)
DECLARE SUB KeyNeeded
DECLARE SUB PricesClick
DECLARE SUB GetKeyClick
DECLARE SUB LayOut

DIM AI AS RAI
DIM ProvIds(16) AS STRING

CREATE Form AS RForm
    Caption = "Ask an AI"
    Width = 600: Height = 560
    Center
    OnResize = LayOut
    CREATE ProvLabel AS RLabel
        Caption = "&Provider:"
    END CREATE
    CREATE ProviderBox AS RComboBox
        Style = 2   ' pick from the list
        AccessibleName = "AI provider"
        OnChange = ProviderPicked
    END CREATE
    ' (links: labels that open the provider's pages in the browser, in the
    ' theme's link colour — LayOut sets it)
    CREATE PricesLink AS RLabel
        Caption = "See prices": Cursor = -21: Visible = 0
        AccessibleName = "The provider's prices, in the browser"
        OnClick = PricesClick
    END CREATE
    CREATE KeyLink AS RLabel
        Caption = "Get a key": Cursor = -21: Visible = 0
        AccessibleName = "Where the provider makes keys, in the browser"
        OnClick = GetKeyClick
    END CREATE
    CREATE AddrLabel AS RLabel
        Caption = "A&ddress:"
    END CREATE
    CREATE AddrEdit AS REdit
        AccessibleName = "The provider's address"
        OnChange = AddressTyped
    END CREATE
    CREATE KeyLabel AS RLabel
        Caption = "API &key:"
    END CREATE
    CREATE KeyEdit AS REdit
        PasswordChar = "*"
        AccessibleName = "API key"
        AccessibleDescription = "Kept only while this program runs, never saved"
        OnChange = KeyTyped
    END CREATE
    CREATE KeyNote AS RLabel
        Caption = "kept only while this runs"
    END CREATE
    ' (Anthropic only: the workspace a key made outside one works in)
    CREATE WsLabel AS RLabel
        Caption = "&Workspace ID:": Visible = 0
    END CREATE
    CREATE WsEdit AS REdit
        Visible = 0
        AccessibleName = "Anthropic workspace ID (optional)"
        AccessibleDescription = "Only for a key made outside a workspace: the Claude Console lists your workspaces"
        OnChange = WorkspaceTyped
    END CREATE
    CREATE ListBtn AS RButton
        Caption = "&List Models"
        OnClick = ListModels
    END CREATE
    CREATE ModelBox AS RComboBox
        Style = 2
        AccessibleName = "Model"
        OnChange = ModelPicked
    END CREATE
    CREATE Question AS REdit
        Text = "Say hello in five words."
        AccessibleName = "Your question"
    END CREATE
    CREATE AskBtn AS RButton
        Caption = "&Ask": Default = 1
        OnClick = AskOrStop
    END CREATE
    ' (the answer is Markdown: shown formatted, kept at its end as it grows)
    CREATE Answer AS RMarkdownView
        FollowEnd = 1
        EmptyText = "The answer shows here."
        AccessibleName = "The answer"
    END CREATE
    ' (what is happening, or what went wrong — in a few lines, wrapped)
    CREATE Info AS RLabel
        WordWrap = 1: AutoSize = 0
        Caption = "Choose a provider."
        AccessibleName = "Status"
    END CREATE
END CREATE

AI.OnToken = TokenIn
AI.OnDone = AnswerDone
AI.OnError = Failed
AI.OnModelsLoaded = ModelsIn
AI.OnKeyNeeded = KeyNeeded

' The providers RAI knows: "id<TAB>name<TAB>short name" a line.
DIM i AS INTEGER, line AS STRING
FOR i = 1 TO TALLY(AI.Providers, CHR$(10)) + 1
    line = FIELD$(AI.Providers, CHR$(10), i)
    IF line <> "" THEN
        ProvIds(ProviderBox.ItemCount) = FIELD$(line, CHR$(9), 1)
        ProviderBox.AddItems FIELD$(line, CHR$(9), 2)
    END IF
NEXT

' Every control placed for the window's size (it can be made bigger): the
' rows at the top, the answer filling the middle, the status under it.
SUB LayOut
    DIM w AS INTEGER, h AS INTEGER, y AS INTEGER, fx AS INTEGER, fw AS INTEGER, rh AS INTEGER
    w = Form.ClientWidth: h = Form.ClientHeight
    IF w < 420 THEN w = 420
    IF h < 420 THEN h = 420
    fx = 112: fw = w - fx - 12
    rh = 36
    y = 12
    ProvLabel.Left = 12: ProvLabel.Top = y + 4: ProvLabel.Width = 96
    ProviderBox.Left = fx: ProviderBox.Top = y: ProviderBox.Width = fw - 190
    PricesLink.Left = fx + fw - 180: PricesLink.Top = y + 4: PricesLink.Width = 84
    KeyLink.Left = fx + fw - 88: KeyLink.Top = y + 4: KeyLink.Width = 88
    y = y + rh
    AddrLabel.Left = 12: AddrLabel.Top = y + 4: AddrLabel.Width = 96
    AddrEdit.Left = fx: AddrEdit.Top = y: AddrEdit.Width = fw
    y = y + rh
    KeyLabel.Left = 12: KeyLabel.Top = y + 4: KeyLabel.Width = 96
    KeyEdit.Left = fx: KeyEdit.Top = y: KeyEdit.Width = fw - 190
    KeyNote.Left = fx + fw - 180: KeyNote.Top = y + 4: KeyNote.Width = 180
    y = y + rh
    IF WsEdit.Visible THEN
        WsLabel.Left = 12: WsLabel.Top = y + 4: WsLabel.Width = 96
        WsEdit.Left = fx: WsEdit.Top = y: WsEdit.Width = fw
        y = y + rh
    END IF
    ListBtn.Left = 12: ListBtn.Top = y - 1: ListBtn.Width = 96
    ModelBox.Left = fx: ModelBox.Top = y: ModelBox.Width = fw
    y = y + rh + 8
    Question.Left = 12: Question.Top = y: Question.Width = w - 12 - 12 - 96 - 8
    AskBtn.Left = w - 12 - 96: AskBtn.Top = y - 1: AskBtn.Width = 96
    y = y + rh + 4
    ' (the status: four lines at the bottom — the longest explanation fits)
    Info.Left = 12: Info.Width = w - 24: Info.Height = 72
    Info.Top = h - 12 - Info.Height
    Answer.Left = 12: Answer.Top = y: Answer.Width = w - 24
    Answer.Height = Info.Top - 8 - y
    ' (link colours from the theme: readable in light, dark and high contrast)
    PricesLink.Font.Color = Application.ThemeColor("page.link")
    KeyLink.Font.Color = Application.ThemeColor("page.link")
    KeyNote.Font.Color = Application.ThemeColor("page.dim")
END SUB

SUB ProviderPicked
    IF ProviderBox.ItemIndex < 0 THEN EXIT SUB
    AI.Provider = ProvIds(ProviderBox.ItemIndex)
    ' (a model is the provider's own: chosen again from its list)
    AI.Model = ""
    ' (the environment's key first, else ask; a local server needs none)
    IF AI.NeedsKey THEN
        AI.APIKeySource = "env:" + AI.KeyEnv + "|ask"
    ELSE
        AI.APIKeySource = ""
    END IF
    KeyEdit.Text = ""
    KeyEdit.Enabled = AI.NeedsKey
    AddrEdit.Text = AI.BaseURL
    ' (the workspace row: Anthropic's only)
    WsEdit.Visible = (AI.Provider = "anthropic")
    WsLabel.Visible = WsEdit.Visible
    IF WsEdit.Visible = 0 THEN WsEdit.Text = ""
    LayOut
    ModelBox.Clear
    PricesLink.Visible = (AI.PricingURL <> "")
    KeyLink.Visible = (AI.KeysURL <> "")
    IF AI.NeedsKey = 0 THEN
        Info.Caption = "No key needed: check the address, then List Models."
    ELSEIF AI.HasKey THEN
        Info.Caption = "The key comes from " + AI.KeyEnv + ". List Models, then pick one."
    ELSE
        Info.Caption = "Type your API key, then List Models."
    END IF
END SUB

SUB AddressTyped
    AI.BaseURL = AddrEdit.Text
END SUB

SUB KeyTyped
    ' (in memory only: never saved by this program)
    AI.APIKey = KeyEdit.Text
END SUB

SUB WorkspaceTyped
    AI.WorkspaceID = WsEdit.Text
END SUB

SUB ListModels
    ModelBox.Clear
    IF AI.RefreshModels THEN
        Info.Caption = "Asking for the models…"
        ListBtn.Enabled = 0
    ELSE
        Info.Caption = AI.Error
    END IF
END SUB

' Models: "id<TAB>name<TAB>hint" a line; ModelName(i) is line i's id.
SUB ModelsIn(Count AS INTEGER)
    DIM i AS INTEGER, hint AS STRING
    ListBtn.Enabled = 1
    FOR i = 0 TO Count - 1
        hint = FIELD$(FIELD$(AI.Models, CHR$(10), i + 1), CHR$(9), 3)
        IF hint <> "" THEN
            ModelBox.AddItems AI.ModelName(i) + "  (" + hint + ")"
        ELSE
            ModelBox.AddItems AI.ModelName(i)
        END IF
    NEXT
    Info.Caption = STR$(Count) + " models: pick one (the fast, low-cost ones are first)."
    IF Count > 0 THEN ModelBox.SetFocus
END SUB

SUB ModelPicked
    IF ModelBox.ItemIndex >= 0 THEN AI.Model = AI.ModelName(ModelBox.ItemIndex)
END SUB

SUB AskOrStop
    IF AI.Busy THEN
        AI.Cancel
        EXIT SUB
    END IF
    ' (a question each time: nothing earlier is sent again)
    AI.NewChat
    Answer.Text = ""
    IF AI.Ask(Question.Text) THEN
        AskBtn.Caption = "&Stop"
        Info.Caption = "Asking " + AI.Model + "…"
    ELSE
        Info.Caption = AI.Error
    END IF
END SUB

' The answer, a few words at a time.
SUB TokenIn(Text AS STRING)
    Answer.Text = Answer.Text + Text
END SUB

' (OnDone: a question answered or stopped — or a models list dropped
' because another provider was picked meanwhile)
SUB AnswerDone(Status AS STRING)
    ListBtn.Enabled = 1
    IF AskBtn.Caption = "&Stop" THEN
        AskBtn.Caption = "&Ask"
        IF Status = "ok" THEN Info.Caption = AI.Usage
        IF Status = "cancelled" THEN Info.Caption = "Stopped."
    END IF
END SUB

' (a refused key, a wrong address, no answer … in plain words; the buttons
' work again at once: fix what it says and try again)
SUB Failed(Message AS STRING)
    AskBtn.Caption = "&Ask"
    ListBtn.Enabled = 1
    Info.Caption = Message
    IF WsEdit.Visible AND INSTR(Message, "Workspace ID") > 0 THEN WsEdit.SetFocus
END SUB

SUB KeyNeeded
    Info.Caption = "Type your API key first."
    KeyEdit.SetFocus
END SUB

' (an RMarkdownView opens web links in the browser — for link labels too)
SUB PricesClick
    Answer.OpenLink AI.PricingURL
END SUB

SUB GetKeyClick
    Answer.OpenLink AI.KeysURL
END SUB

LayOut

' A server's address given (a local one: Ollama, LM Studio …): the
' OpenAI-compatible provider, at that address.
IF COMMAND$ <> "" THEN
    FOR i = 0 TO ProviderBox.ItemCount - 1
        IF ProvIds(i) = "compatible" THEN ProviderBox.ItemIndex = i
    NEXT
    ProviderPicked
    AddrEdit.Text = COMMAND$
    AI.BaseURL = COMMAND$
END IF

Form.ShowModal
