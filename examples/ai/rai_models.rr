' rai_models.rr: RAI, RapidR's AI component — choose a provider, give it
' your API key, list the provider's models, ask one a question and watch
' the answer stream in.
'
'   rapidr run rai_models.rr
'   rapidr run rai_models.rr http://localhost:11434/v1   (a server on this
'                                                         machine: Ollama, LM Studio …)
'
' Your key is never written into the program. APIKeySource says where it
' comes from: "env:OPENAI_API_KEY|ask" — the provider's environment
' variable if it is set, else the program asks (OnKeyNeeded) and you type
' it in the box, kept only while the program runs. No model is chosen for
' you: List Models shows the provider's own, the fast, low-cost ones first
' (by the words of their names). A question costs a little on a paid
' provider: "See prices" says how much.

DECLARE SUB ProviderPicked
DECLARE SUB AddressTyped
DECLARE SUB KeyTyped
DECLARE SUB ListModels
DECLARE SUB ModelsIn(Count AS INTEGER)
DECLARE SUB ModelPicked
DECLARE SUB AskOrStop
DECLARE SUB TokenIn(Text AS STRING)
DECLARE SUB AnswerDone(Status AS STRING)
DECLARE SUB Failed(Message AS STRING)
DECLARE SUB KeyNeeded
DECLARE SUB PricesClick
DECLARE SUB GetKeyClick

DIM AI AS RAI
DIM ProvIds(16) AS STRING

CREATE Form AS RForm
    Caption = "Ask an AI"
    Width = 580: Height = 470
    Center
    CREATE ProvLabel AS RLabel
        Caption = "&Provider:": Left = 12: Top = 16: Width = 80
    END CREATE
    CREATE ProviderBox AS RComboBox
        Left = 100: Top = 12: Width = 270: Style = 2   ' pick from the list
        OnChange = ProviderPicked
    END CREATE
    ' (links: labels that open the provider's pages in the browser)
    CREATE PricesLink AS RLabel
        Caption = "See prices": Left = 382: Top = 16: Width = 80
        Font.Color = &HC0661A: Cursor = -21: Visible = 0
        OnClick = PricesClick
    END CREATE
    CREATE KeyLink AS RLabel
        Caption = "Get a key": Left = 470: Top = 16: Width = 90
        Font.Color = &HC0661A: Cursor = -21: Visible = 0
        OnClick = GetKeyClick
    END CREATE
    CREATE AddrLabel AS RLabel
        Caption = "A&ddress:": Left = 12: Top = 50: Width = 80
    END CREATE
    CREATE AddrEdit AS REdit
        Left = 100: Top = 46: Width = 270
        OnChange = AddressTyped
    END CREATE
    CREATE KeyLabel AS RLabel
        Caption = "API &key:": Left = 12: Top = 84: Width = 80
    END CREATE
    CREATE KeyEdit AS REdit
        Left = 100: Top = 80: Width = 270: PasswordChar = "*"
        OnChange = KeyTyped
    END CREATE
    CREATE KeyNote AS RLabel
        Left = 382: Top = 84: Width = 186
        Caption = "kept only while this runs"
    END CREATE
    CREATE ListBtn AS RButton
        Caption = "&List Models": Left = 12: Top = 116: Width = 80
        OnClick = ListModels
    END CREATE
    CREATE ModelBox AS RComboBox
        Left = 100: Top = 117: Width = 270: Style = 2
        OnChange = ModelPicked
    END CREATE
    CREATE Question AS REdit
        Left = 12: Top = 156: Width = 466
        Text = "Say hello in five words."
    END CREATE
    CREATE AskBtn AS RButton
        Caption = "&Ask": Left = 486: Top = 154: Width = 82: Default = 1
        OnClick = AskOrStop
    END CREATE
    ' (the answer is Markdown: shown formatted, kept at its end as it grows)
    CREATE Answer AS RMarkdownView
        Left = 12: Top = 192: Width = 556: Height = 210
        FollowEnd = 1
        EmptyText = "The answer shows here."
    END CREATE
    CREATE Info AS RLabel
        Left = 12: Top = 412: Width = 556
        Caption = "Choose a provider."
    END CREATE
END CREATE

AI.OnToken = TokenIn
AI.OnDone = AnswerDone
AI.OnError = Failed
AI.OnModelsLoaded = ModelsIn
AI.OnKeyNeeded = KeyNeeded

' The providers RAI knows: "id<TAB>name<TAB>short name" a line.
DIM i AS INTEGER, line AS STRING
FOR i = 1 TO TALLY(AI.Providers, CHR$(10)) + 1
    line = FIELD$(AI.Providers, CHR$(10), i)
    IF line <> "" THEN
        ProvIds(ProviderBox.ItemCount) = FIELD$(line, CHR$(9), 1)
        ProviderBox.AddItems FIELD$(line, CHR$(9), 2)
    END IF
NEXT

SUB ProviderPicked
    IF ProviderBox.ItemIndex < 0 THEN EXIT SUB
    AI.Provider = ProvIds(ProviderBox.ItemIndex)
    ' (the environment's key first, else ask; a local server needs none)
    IF AI.NeedsKey THEN
        AI.APIKeySource = "env:" + AI.KeyEnv + "|ask"
    ELSE
        AI.APIKeySource = ""
    END IF
    KeyEdit.Text = ""
    KeyEdit.Enabled = AI.NeedsKey
    AddrEdit.Text = AI.BaseURL
    ModelBox.Clear
    PricesLink.Visible = (AI.PricingURL <> "")
    KeyLink.Visible = (AI.KeysURL <> "")
    IF AI.NeedsKey = 0 THEN
        Info.Caption = "No key needed: check the address, then List Models."
    ELSEIF AI.HasKey THEN
        Info.Caption = "The key comes from " + AI.KeyEnv + ". List Models, then pick one."
    ELSE
        Info.Caption = "Type your API key, then List Models."
    END IF
END SUB

SUB AddressTyped
    AI.BaseURL = AddrEdit.Text
END SUB

SUB KeyTyped
    ' (in memory only: never saved by this program)
    AI.APIKey = KeyEdit.Text
END SUB

SUB ListModels
    ModelBox.Clear
    IF AI.RefreshModels THEN
        Info.Caption = "Asking for the models…"
    ELSE
        Info.Caption = AI.Error
    END IF
END SUB

' Models: "id<TAB>name<TAB>hint" a line; ModelName(i) is line i's id.
SUB ModelsIn(Count AS INTEGER)
    DIM i AS INTEGER, hint AS STRING
    FOR i = 0 TO Count - 1
        hint = FIELD$(FIELD$(AI.Models, CHR$(10), i + 1), CHR$(9), 3)
        IF hint <> "" THEN
            ModelBox.AddItems AI.ModelName(i) + "  (" + hint + ")"
        ELSE
            ModelBox.AddItems AI.ModelName(i)
        END IF
    NEXT
    Info.Caption = STR$(Count) + " models: pick one (the fast, low-cost ones are first)."
END SUB

SUB ModelPicked
    IF ModelBox.ItemIndex >= 0 THEN AI.Model = AI.ModelName(ModelBox.ItemIndex)
END SUB

SUB AskOrStop
    IF AI.Busy THEN
        AI.Cancel
        EXIT SUB
    END IF
    ' (a question each time: nothing earlier is sent again)
    AI.NewChat
    Answer.Text = ""
    IF AI.Ask(Question.Text) THEN
        AskBtn.Caption = "&Stop"
        Info.Caption = "Asking " + AI.Model + "…"
    ELSE
        Info.Caption = AI.Error
    END IF
END SUB

' The answer, a few words at a time.
SUB TokenIn(Text AS STRING)
    Answer.Text = Answer.Text + Text
END SUB

SUB AnswerDone(Status AS STRING)
    AskBtn.Caption = "&Ask"
    IF Status = "ok" THEN Info.Caption = AI.Usage
    IF Status = "cancelled" THEN Info.Caption = "Stopped."
END SUB

SUB Failed(Message AS STRING)
    AskBtn.Caption = "&Ask"
    Info.Caption = Message
END SUB

SUB KeyNeeded
    Info.Caption = "Type your API key first."
    KeyEdit.SetFocus
END SUB

' (an RMarkdownView opens web links in the browser — for link labels too)
SUB PricesClick
    Answer.OpenLink AI.PricingURL
END SUB

SUB GetKeyClick
    Answer.OpenLink AI.KeysURL
END SUB

' A server's address given (a local one: Ollama, LM Studio …): the
' OpenAI-compatible provider, at that address.
IF COMMAND$ <> "" THEN
    FOR i = 0 TO ProviderBox.ItemCount - 1
        IF ProvIds(i) = "compatible" THEN ProviderBox.ItemIndex = i
    NEXT
    ProviderPicked
    AddrEdit.Text = COMMAND$
    AI.BaseURL = COMMAND$
END IF

Form.ShowModal
