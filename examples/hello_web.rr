' ============================================================
' hello_web.rr — Hello World for RapidR Web (WASM)
' ============================================================
' Build with:  rapidr --web hello_web.rr
' Or:          rapidr build hello_web.rr --web
' ============================================================
$APPTYPE WEB

DIM Counter AS INTEGER
Counter = 0

CREATE Form1 AS RFORM
    Caption = "Hello from the Web!"
    Width = 500
    Height = 350
    Left = 50
    Top = 50

    CREATE Label1 AS RLABEL
        Caption = "Welcome to RapidR in the browser!"
        Left = 20
        Top = 20
        Width = 400
        Height = 30
    END CREATE

    CREATE Edit1 AS REDIT
        Text = "Type your name here"
        Left = 20
        Top = 60
        Width = 300
        Height = 30
    END CREATE

    CREATE Button1 AS RBUTTON
        Caption = "Click Me!"
        Left = 20
        Top = 100
        Width = 120
        Height = 35
        OnClick = Button1_OnClick
    END CREATE
END CREATE


SUB Button1_OnClick()
    Counter = Counter + 1
    DIM name AS STRING
    name = Edit1.Text
    IF name = "" THEN name = "World"
    Label1.Caption = "Hello, " + name + "! (Click #" + STR(Counter) + ")"
    PRINT "Button clicked " + STR(Counter) + " times"
END SUB
