' on_error.rr: a program that keeps going after a mistake in its own code,
' and says so. Each button has a bug: Average divides by the number of
' scores before there are any, Halve takes the remainder of a division by
' zero. A run-time error ends the button's handler (the window keeps
' working, as it always does), and Application.OnError hears it: the
' message, the file and the line. Here it is shown in the window and
' counted; a real program would also write it to a log and save the
' user's work.
'
'   rapidr run on_error.rr
'
' (RapidR's Application.OnError: the interpreter, native builds and the
' web. A native build says no file or line.)
$THEME rapidr

DIM Count AS INTEGER
DIM Total AS INTEGER, Scores AS INTEGER

CREATE Form AS RForm
  Caption = "When something goes wrong"
  ClientWidth = 420
  ClientHeight = 170
  Center
  CREATE AverageBtn AS RButton
    Caption = "Average"
    Left = 16: Top = 16: Width = 120: Height = 30
  END CREATE
  CREATE HalveBtn AS RButton
    Caption = "Halve"
    Left = 148: Top = 16: Width = 120: Height = 30
  END CREATE
  CREATE Said AS RLabel
    Caption = "Press a button: each one has a bug."
    Left = 16: Top = 64: Width = 388: Height = 60
    WordWrap = 1
  END CREATE
  CREATE Counted AS RLabel
    Caption = "Errors so far: 0"
    Left = 16: Top = 134: Width = 388: Height = 20
  END CREATE
END CREATE

' (the bug: no scores yet, so nothing to divide by)
SUB AverageClick
  Said.Caption = "Average: " + STR$(Total \ Scores)
END SUB

' (the bug: the remainder of a division by zero)
SUB HalveClick
  DIM n AS INTEGER, zero AS INTEGER
  n = 10 MOD zero
  Said.Caption = "Halved: " + STR$(n)
END SUB

' A handler's run-time error: what, where; the program goes on.
SUB Failed(Message AS STRING, File AS STRING, Line AS INTEGER)
  Count = Count + 1
  IF Line > 0 THEN
    Said.Caption = "Something went wrong: " + Message + " (" + File + ", line " + LTRIM$(STR$(Line)) + "). The window still works."
  ELSE
    Said.Caption = "Something went wrong: " + Message + ". The window still works."
  END IF
  Counted.Caption = "Errors so far: " + LTRIM$(STR$(Count))
END SUB

AverageBtn.OnClick = AverageClick
HalveBtn.OnClick = HalveClick
Application.OnError = Failed
Form.ShowModal
