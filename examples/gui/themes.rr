' themes.rr: RapidR's looks for the same form, and a program that follows
' them. It opens in RapidR's look as the system is — light, dark or high
' contrast: every program's default — and follows the system when you
' switch it; the buttons on the left pick a look while it
' runs (Application.Theme). Application.OnThemeChange says the look
' changed, by the system or by the program: the colours this program took
' from the theme with Application.ThemeColor (the card) are taken again,
' and the line at the bottom says the look now.
'
'   rapidr run themes.rr
'
' A theme changes colours and how controls are drawn, never their places,
' sizes or fonts; colours a program sets as numbers (Color, Font.Color)
' stay as written. (RAPIDR_THEME=dark in the environment sets the theme of
' programs that don't name one.)
' (no $THEME: the same as $THEME rapidr; $THEME classic is the classic Windows look)

DECLARE SUB Switch

CREATE Form AS RForm
    Caption = "Themes"
    Width = 380: Height = 340
    Center
    CREATE PickSystem AS RRadioButton
        Caption = "&System": Left = 16: Top = 16: Width = 110: Checked = 1
        OnClick = Switch
    END CREATE
    CREATE PickLight AS RRadioButton
        Caption = "&Light": Left = 16: Top = 40: Width = 110
        OnClick = Switch
    END CREATE
    CREATE PickDark AS RRadioButton
        Caption = "&Dark": Left = 16: Top = 64: Width = 110
        OnClick = Switch
    END CREATE
    CREATE PickContrast AS RRadioButton
        Caption = "&High contrast": Left = 16: Top = 88: Width = 110
        OnClick = Switch
    END CREATE
    CREATE PickClassic AS RRadioButton
        Caption = "&Classic": Left = 16: Top = 112: Width = 110
        OnClick = Switch
    END CREATE
    CREATE Box AS RGroupBox
        Caption = "Some controls": Left = 140: Top = 10: Width = 210: Height = 170
        CREATE Edit AS REdit
            Left = 12: Top = 24: Width = 186: Text = "Text to edit"
        END CREATE
        CREATE Check AS RCheckBox
            Caption = "A check box": Left = 12: Top = 56: Width = 150: Checked = 1
        END CREATE
        CREATE Combo AS RComboBox
            Left = 12: Top = 84: Width = 186
            AddItems "One", "Two", "Three"
            ItemIndex = 1
        END CREATE
        CREATE Bar AS RProgressBar
            Left = 12: Top = 118: Width = 186: Height = 18: Position = 65
        END CREATE
        CREATE Off AS RButton
            Caption = "Disabled": Left = 12: Top = 140: Width = 90: Enabled = 0
        END CREATE
    END CREATE
    ' (a card in the theme's own colours, which follow the look)
    CREATE Card AS RPanel
        Left = 16: Top = 190: Width = 334: Height = 50: BevelOuter = 0
        CREATE CardTitle AS RLabel
            Caption = "The theme's colours": Left = 12: Top = 8: Width = 310
        END CREATE
        CREATE CardText AS RLabel
            Caption = "Taken again each time the look changes": Left = 12: Top = 26: Width = 310
        END CREATE
    END CREATE
    CREATE Own AS RLabel
        Caption = "My own colours stay": Left = 16: Top = 250: Width = 334
        Color = &HE0FFFF: Font.Color = &H800000
    END CREATE
    CREATE Now AS RLabel
        Left = 16: Top = 276: Width = 334
    END CREATE
END CREATE

' The colours taken from the theme, and what the line says.
SUB TakeColors
    Card.Color = Application.ThemeColor("card")
    CardTitle.Font.Color = Application.ThemeColor("page.text")
    CardText.Font.Color = Application.ThemeColor("page.dim")
    Now.Caption = "Theme: " + Application.Theme
END SUB

' A button names a look: the program draws in it from now on (System:
' as the system is, and as it becomes) — LookChanged follows.
SUB Switch (Sender AS RRadioButton)
    SELECT CASE Sender.Caption
        CASE "&System"
            Application.Theme = "rapidr"
        CASE "&Light"
            Application.Theme = "rapidr light"
        CASE "&Dark"
            Application.Theme = "rapidr dark"
        CASE "&High contrast"
            Application.Theme = "rapidr high contrast"
        CASE ELSE
            Application.Theme = "classic"
    END SELECT
END SUB

' (the look changed: the system switched, or Switch picked another)
SUB LookChanged
    TakeColors
END SUB

TakeColors
Application.OnThemeChange = LookChanged
Form.ShowModal
