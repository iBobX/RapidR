' snapshot.rr: a program that takes pictures of its own window and checks
' its own layout, with RWindowCapture — a "Save as picture" button, and a
' "Check layout" button that lists what a person would see wrong.
'
'   rapidr run gui/snapshot.rr
'
' RWindowCapture sees only the program's own windows (never the screen or
' another program): SaveToFile saves a PNG of one window, or of all of
' them side by side; LayoutReport and Problems say where everything is
' and what looks wrong (text cut off, controls on top of each other, a
' control past the window's edge). Make the window narrow and check again.

$THEME rapidr

DECLARE SUB SaveClick
DECLARE SUB CheckClick
DECLARE SUB SizeClick

DIM Eyes AS RWindowCapture

CREATE Form AS RForm
    Caption = "Snapshot"
    ClientWidth = 360
    ClientHeight = 236
    Center
    CREATE NameLabel AS RLabel
        Caption = "Your name:"
        Left = 16: Top = 20: Width = 80
    END CREATE
    CREATE NameEdit AS REdit
        Text = "Ada"
        Left = 100: Top = 16: Width = 160
    END CREATE
    CREATE SaveButton AS RButton
        Caption = "Save as picture"
        Left = 16: Top = 56: Width = 120
        OnClick = SaveClick
    END CREATE
    CREATE CheckButton AS RButton
        Caption = "Check layout"
        Left = 144: Top = 56: Width = 100
        OnClick = CheckClick
    END CREATE
    CREATE SizeButton AS RButton
        Caption = "Narrow"
        Left = 252: Top = 56: Width = 90
        OnClick = SizeClick
    END CREATE
    CREATE Status AS RLabel
        ' (sized by us, its text wrapped inside: AutoSize off first)
        AutoSize = 0
        WordWrap = 1
        Caption = "Save a picture of this window, or check its layout."
        Left = 16: Top = 100: Width = 330: Height = 120
    END CREATE
END CREATE

' The picture: this window only, at 1x (the program's own pixels), with
' its title bar. Saved beside the program; where that can't be written
' (an installed, read-only folder), said.
SUB SaveClick
    Eyes.Scale = 1
    Eyes.Frame = 1
    IF Eyes.SaveToFile("snapshot.png", "Form") THEN
        Status.Caption = "Saved snapshot.png (" + STR$(Eyes.Width) + " x " + STR$(Eyes.Height) + " pixels)."
    ELSE
        Status.Caption = "Couldn't save the picture: " + Eyes.Error
    END IF
END SUB

' What a person would see wrong, or that nothing is.
SUB CheckClick
    DIM found AS STRING
    found = Eyes.Problems("Form")
    IF found = "" THEN
        Status.Caption = "The layout looks right: nothing cut off, nothing on top of another."
    ELSE
        Status.Caption = found
    END IF
END SUB

' Narrow the button so its caption no longer fits — then Check layout.
SUB SizeClick
    IF SaveButton.Width = 120 THEN
        SaveButton.Width = 60
        SizeButton.Caption = "Wide"
    ELSE
        SaveButton.Width = 120
        SizeButton.Caption = "Narrow"
    END IF
END SUB

Form.ShowModal
