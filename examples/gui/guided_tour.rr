' guided_tour.rr: a "Show me" button that uses the program for you, with
' RAppDriver — a pointer glides to each control, types and clicks, and a
' list says each step as it is done. Good for help pages, demos, lessons
' and self-tests.
'
'   rapidr run gui/guided_tour.rr
'
' RAppDriver plays clicks and keys into the program's own windows as a
' person's would be (its handlers run as for you), found by what they show:
' a button's caption ("Add"), the label beside a box ("Task"), or a name.
' Each call returns at once and queues its step; OnDone says how it went.
' It never moves your real mouse and can't touch other programs. With the
' system's reduced motion the pointer jumps instead of gliding.

$THEME rapidr

DECLARE SUB AddClick
DECLARE SUB ClearClick
DECLARE SUB TourClick
DECLARE SUB StepDone(Id AS INTEGER, Ok AS INTEGER, Text AS STRING)

CREATE Form AS RForm
    Caption = "To-do, with a tour"
    ClientWidth = 420
    ClientHeight = 300
    Center
    CREATE TaskLabel AS RLabel
        Caption = "Task:"
        Left = 16: Top = 20: Width = 44
    END CREATE
    CREATE TaskEdit AS REdit
        Left = 64: Top = 16: Width = 200
    END CREATE
    CREATE AddButton AS RButton
        Caption = "Add"
        Left = 272: Top = 15: Width = 64
        OnClick = AddClick
    END CREATE
    CREATE ClearButton AS RButton
        Caption = "Clear"
        Left = 340: Top = 15: Width = 64
        OnClick = ClearClick
    END CREATE
    CREATE Tasks AS RListBox
        Left = 16: Top = 52: Width = 388: Height = 120
    END CREATE
    CREATE TourButton AS RButton
        Caption = "Show me"
        Left = 16: Top = 184: Width = 100
        OnClick = TourClick
    END CREATE
    CREATE Steps AS RListBox
        Left = 16: Top = 216: Width = 388: Height = 70
    END CREATE
END CREATE

CREATE Tour AS RAppDriver
    OnDone = StepDone
END CREATE

SUB AddClick
    IF TaskEdit.Text <> "" THEN
        Tasks.AddItems TaskEdit.Text
        TaskEdit.Text = ""
    END IF
END SUB

SUB ClearClick
    Tasks.Clear
END SUB

' The tour: each step queued now, played one after the other.
SUB TourClick
    IF Tour.Busy THEN EXIT SUB
    Steps.Clear
    Tour.TypeText "label:Task", "Buy milk"
    Tour.Click "Add"
    Tour.TypeText "label:Task", "Call Ada"
    Tour.PressKeys "Enter"
    Tour.Click "Add"
END SUB

' Each step, as it is done.
SUB StepDone(Id AS INTEGER, Ok AS INTEGER, Text AS STRING)
    IF Ok THEN Steps.AddItems Text ELSE Steps.AddItems "Not done: " + Text
    Steps.ItemIndex = Steps.ItemCount - 1
END SUB

Form.ShowModal
