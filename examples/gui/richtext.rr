' richtext.rr: a small rich-text editor — bold, italic, underline, a
' colour and a font for the selected text; paragraphs aligned and
' bulleted; the document opened and saved as rich text (.rtf).
'
'   rapidr run richtext.rr
'
' An RRichEdit's SelAttributes is the format of the selected text — or, at
' the caret, of what is typed next: set its Bold, Italic, Underline,
' Color, Name and Size, or give it a whole RFont. Reading it tells the
' tool bar what the selection looks like. Paragraph (RapidR's) aligns and
' bullets the paragraphs the selection is in. LoadFromFile / SaveToFile
' read and write RTF, which WordPad, Word and TextEdit open too.
$INCLUDE "RAPIDQ.INC"

DECLARE SUB OpenDoc
DECLARE SUB SaveDoc
DECLARE SUB ToggleBold
DECLARE SUB ToggleItalic
DECLARE SUB ToggleUnderline
DECLARE SUB PickColour
DECLARE SUB PickFont
DECLARE SUB AlignLeft
DECLARE SUB AlignCentre
DECLARE SUB AlignRight
DECLARE SUB ToggleBullets
DECLARE SUB ShowState

CREATE OpenDlg AS ROpenDialog
    Caption = "Open a document"
    Filter = "Rich text|*.rtf|Text files|*.txt|All files|*.*"
END CREATE
CREATE SaveDlg AS RSaveDialog
    Caption = "Save the document"
    Filter = "Rich text|*.rtf"
END CREATE
CREATE ColourDlg AS RColorDialog
END CREATE
CREATE FontDlg AS RFontDialog
END CREATE
DIM PickedFont AS RFont

CREATE Form AS RForm
    Caption = "Rich text"
    Width = 600
    Height = 420
    Center
    CREATE Tools AS RPanel
        Align = alTop: Height = 32: BevelOuter = bvNone
        CREATE OpenBtn AS RCoolBtn
            Caption = "Open": Left = 4: Top = 4: Width = 52: Height = 24: Hint = "Open a document": ShowHint = 1
            OnClick = OpenDoc
        END CREATE
        CREATE SaveBtn AS RCoolBtn
            Caption = "Save": Left = 58: Top = 4: Width = 52: Height = 24: Hint = "Save as rich text": ShowHint = 1
            OnClick = SaveDoc
        END CREATE
        CREATE BoldBtn AS RCoolBtn
            Caption = "B": Left = 122: Top = 4: Width = 28: Height = 24: GroupIndex = 1: AllowAllUp = 1
            Font.Bold = 1: Hint = "Bold": ShowHint = 1
            OnClick = ToggleBold
        END CREATE
        CREATE ItalicBtn AS RCoolBtn
            Caption = "I": Left = 152: Top = 4: Width = 28: Height = 24: GroupIndex = 2: AllowAllUp = 1
            Font.Italic = 1: Hint = "Italic": ShowHint = 1
            OnClick = ToggleItalic
        END CREATE
        CREATE UnderlineBtn AS RCoolBtn
            Caption = "U": Left = 182: Top = 4: Width = 28: Height = 24: GroupIndex = 3: AllowAllUp = 1
            Font.Underline = 1: Hint = "Underline": ShowHint = 1
            OnClick = ToggleUnderline
        END CREATE
        CREATE ColourBtn AS RCoolBtn
            Caption = "Colour": Left = 216: Top = 4: Width = 56: Height = 24: Hint = "The selected text's colour": ShowHint = 1
            OnClick = PickColour
        END CREATE
        CREATE FontBtn AS RCoolBtn
            Caption = "Font": Left = 274: Top = 4: Width = 48: Height = 24: Hint = "The selected text's font and size": ShowHint = 1
            OnClick = PickFont
        END CREATE
        CREATE LeftBtn AS RCoolBtn
            Caption = "Left": Left = 332: Top = 4: Width = 44: Height = 24: GroupIndex = 4: Down = 1
            OnClick = AlignLeft
        END CREATE
        CREATE CentreBtn AS RCoolBtn
            Caption = "Centre": Left = 378: Top = 4: Width = 52: Height = 24: GroupIndex = 4
            OnClick = AlignCentre
        END CREATE
        CREATE RightBtn AS RCoolBtn
            Caption = "Right": Left = 432: Top = 4: Width = 48: Height = 24: GroupIndex = 4
            OnClick = AlignRight
        END CREATE
        CREATE BulletBtn AS RCoolBtn
            Caption = "Bullets": Left = 486: Top = 4: Width = 60: Height = 24: GroupIndex = 5: AllowAllUp = 1
            OnClick = ToggleBullets
        END CREATE
    END CREATE
    CREATE Status AS RStatusBar
        SimplePanel = 1
    END CREATE
    CREATE Doc AS RRichEdit
        Align = alClient
        ScrollBars = ssVertical
        OnKeyUp = ShowState
        OnMouseUp = ShowState
    END CREATE
END CREATE

' The document to start with, formatted the way a program does it: pick a
' piece of the text, then set its SelAttributes.
SUB Pick(Word AS STRING)
    Doc.SelStart = INSTR(Doc.Text, Word) - 1
    Doc.SelLength = LEN(Word)
END SUB

CRLF$ = CHR$(13) + CHR$(10)
Doc.Text = "A rich text document" + CRLF$ + _
    "Select some text, then press B, I or U, pick a colour or a font. What you type next to formatted text takes its format." + CRLF$ + _
    "Paragraphs line up left, centred or right" + CRLF$ + _
    "and take bullets." + CRLF$ + _
    "Save keeps it all in an .rtf file."
Pick "A rich text document"
Doc.SelAttributes.Size = 16
Doc.SelAttributes.Bold = 1
Doc.SelAttributes.Color = &HD77800
Doc.Paragraph.Alignment = taCenter
Pick "B, I or U"
Doc.SelAttributes.Bold = 1
Pick "colour"
Doc.SelAttributes.Color = &H2828DC
Pick "font"
Doc.SelAttributes.Name = "Times New Roman"
Doc.SelAttributes.Size = 12
Pick "takes its format"
Doc.SelAttributes.Italic = 1
Pick "and take bullets."
Doc.Paragraph.Numbering = 1
Pick "Paragraphs"
Doc.Paragraph.Numbering = 1
Pick ".rtf"
Doc.SelAttributes.Underline = 1
Doc.SelStart = 0

' The tool bar shows the selection's format, the status bar where the
' caret is and what it types in.
SUB ShowState
    BoldBtn.Down = Doc.SelAttributes.Bold
    ItalicBtn.Down = Doc.SelAttributes.Italic
    UnderlineBtn.Down = Doc.SelAttributes.Underline
    SELECT CASE Doc.Paragraph.Alignment
        CASE taCenter: CentreBtn.Down = 1
        CASE taRightJustify: RightBtn.Down = 1
        CASE ELSE: LeftBtn.Down = 1
    END SELECT
    BulletBtn.Down = Doc.Paragraph.Numbering
    Status.SimpleText = "Line " + STR$(Doc.WhereY + 1) + ", column " + STR$(Doc.WhereX + 1) + "   " + Doc.SelAttributes.Name + " " + STR$(Doc.SelAttributes.Size) + " pt"
END SUB

SUB ToggleBold
    Doc.SelAttributes.Bold = BoldBtn.Down
    ShowState
END SUB

SUB ToggleItalic
    Doc.SelAttributes.Italic = ItalicBtn.Down
    ShowState
END SUB

SUB ToggleUnderline
    Doc.SelAttributes.Underline = UnderlineBtn.Down
    ShowState
END SUB

SUB PickColour
    ColourDlg.Color = Doc.SelAttributes.Color
    IF ColourDlg.Execute THEN Doc.SelAttributes.Color = ColourDlg.Color
    ShowState
END SUB

SUB PickFont
    ' (the dialog starts from the selection's font; SetFont copies what
    ' was chosen into PickedFont, which SelAttributes then takes whole)
    PickedFont.Name = Doc.SelAttributes.Name
    PickedFont.Size = Doc.SelAttributes.Size
    PickedFont.Color = Doc.SelAttributes.Color
    PickedFont.Bold = Doc.SelAttributes.Bold
    PickedFont.Italic = Doc.SelAttributes.Italic
    PickedFont.Underline = Doc.SelAttributes.Underline
    FontDlg.GetFont(PickedFont)
    IF FontDlg.Execute THEN
        FontDlg.SetFont(PickedFont)
        Doc.SelAttributes = PickedFont
    END IF
    ShowState
END SUB

SUB AlignLeft
    Doc.Paragraph.Alignment = taLeftJustify
    ShowState
END SUB

SUB AlignCentre
    Doc.Paragraph.Alignment = taCenter
    ShowState
END SUB

SUB AlignRight
    Doc.Paragraph.Alignment = taRightJustify
    ShowState
END SUB

SUB ToggleBullets
    Doc.Paragraph.Numbering = BulletBtn.Down
    ShowState
END SUB

SUB OpenDoc
    IF OpenDlg.Execute THEN
        Doc.LoadFromFile OpenDlg.FileName
        Form.Caption = "Rich text - " + OpenDlg.FileName
        ShowState
    END IF
END SUB

SUB SaveDoc
    DIM Target AS STRING
    IF SaveDlg.Execute THEN
        Target = SaveDlg.FileName
        IF LCASE$(RIGHT$(Target, 4)) <> ".rtf" THEN Target = Target + ".rtf"
        Doc.SaveToFile Target
        Form.Caption = "Rich text - " + Target
    END IF
END SUB

ShowState
Form.ShowModal
