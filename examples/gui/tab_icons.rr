' tab_icons.rr: tabs with icons. TabIcons gives each tab of an
' RTabControl one of RapidR's icons by name, before the tab's name.
'
'   rapidr run tab_icons.rr
'
' Make the window narrower (drag its edge, or click Narrower): when one
' line of tabs can't show every name, the tabs show their icons alone
' (never a cut name), each with its name as a tooltip and for a screen
' reader. Make it wider again and the names come back.
'
' The names are RapidR's icons' (the icon picker in Studio lists them),
' separated by commas, one a tab, in the tabs' order; "" leaves a tab
' without one. The icons follow the look: light, dark, high contrast.
DECLARE SUB PageChanged
DECLARE SUB WidthClicked

CREATE Form AS RForm
    Caption = "Photo album"
    Width = 460
    Height = 240
    Center
    CREATE Pages AS RTabControl
        Left = 8: Top = 8: Width = 428: Height = 150
        Anchors = akLeft + akTop + akRight
        TabIcons = "image,audio,video,settings"
        AccessibleName = "Album pages"
        OnChange = PageChanged
        CREATE Note AS RLabel
            Left = 16: Top = 48: Width = 380
        END CREATE
    END CREATE
    CREATE WidthBtn AS RButton
        Left = 8: Top = 168: Width = 96: Height = 28
        Caption = "&Narrower"
        OnClick = WidthClicked
    END CREATE
END CREATE

Pages.AddTabs "Pictures", "Music", "Videos", "Settings"

' The page's words, from the tab picked.
SUB PageChanged
    Note.Caption = "The " + Pages.Tab(Pages.TabIndex) + " page."
END SUB

' Narrower or wider: the tabs follow the window's width (Anchors).
SUB WidthClicked
    IF Form.Width > 300 THEN
        Form.Width = 220
        WidthBtn.Caption = "&Wider"
    ELSE
        Form.Width = 460
        WidthBtn.Caption = "&Narrower"
    END IF
END SUB

PageChanged
Form.ShowModal
