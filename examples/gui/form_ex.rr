' form_ex.rr: RFormEx, a form with more. Drop files on it, send it to the
' system tray and back, make it see-through, keep it on top, and see when
' it gets and loses the focus.
'
'   rapidr run form_ex.rr
'
' - Drag files from Finder, File Explorer or a file manager onto the box at
'   the top (its DragZone): each one is listed with where it landed.
' - "To the tray" hides the window and puts its icon in the tray (the menu
'   bar on macOS); double-click the icon to bring it back, right-click it
'   for a message. Minimising the window does the same (OnMinimise).
' - The slider sets how see-through the whole window is (Transparent);
'   "Hole" lets the desktop show through the form's background colour
'   (TransparentClient); "On top" keeps it above other windows.
' Windows, macOS and Linux (see-through windows need X11 there), and a web
' page (its own tray strip; the page shows through instead of the desktop).

DECLARE SUB Dropped (File AS STRING)
DECLARE SUB ToTray
DECLARE SUB BackFromTray
DECLARE SUB TrayMenu
DECLARE SUB Minimised
DECLARE SUB SeeThrough
DECLARE SUB HoleClicked
DECLARE SUB OnTopClicked
DECLARE SUB Active
DECLARE SUB Inactive

CREATE Main AS RFormEx
    Caption = "RFormEx"
    Width = 460
    Height = 360
    Color = &HF4EEE8
    Center
    DragEnable = True
    OnDrag = Dropped
    OnMinimise = Minimised
    OnTrayDblClick = BackFromTray
    OnTrayClick = TrayMenu
    OnGetFocus = Active
    OnLostFocus = Inactive
    TrayIconHint = "RFormEx: double-click to come back"
    CREATE DropBox AS RPanel
        Left = 16: Top = 16: Width = 420: Height = 120
        Caption = "Drop files here"
        BevelOuter = bvLowered
        Color = &HFFFFFF
    END CREATE
    CREATE Files AS RListBox
        Left = 16: Top = 146: Width = 420: Height = 90
    END CREATE
    CREATE TrayBtn AS RButton
        Left = 16: Top = 248: Width = 110
        Caption = "To the &tray"
        OnClick = ToTray
    END CREATE
    CREATE HoleBox AS RCheckBox
        Left = 140: Top = 252: Width = 70
        Caption = "&Hole"
        OnClick = HoleClicked
    END CREATE
    CREATE OnTopBox AS RCheckBox
        Left = 214: Top = 252: Width = 80
        Caption = "On to&p"
        OnClick = OnTopClicked
    END CREATE
    CREATE OpacityLbl AS RLabel
        Left = 304: Top = 236: Width = 132
        Caption = "See-through"
    END CREATE
    CREATE Opacity AS RTrackBar
        Left = 300: Top = 252: Width = 136
        Min = 60: Max = 255: Position = 255
        Frequency = 65
        AccessibleName = "See-through"
        OnChange = SeeThrough
    END CREATE
    CREATE Status AS RLabel
        Left = 16: Top = 290: Width = 420
        Caption = "Drag files onto the white box."
    END CREATE
END CREATE

' (only the white box takes files: client pixels, Right and Bottom outside)
Main.DragZone.Left = DropBox.Left
Main.DragZone.Top = DropBox.Top
Main.DragZone.Right = DropBox.Left + DropBox.Width
Main.DragZone.Bottom = DropBox.Top + DropBox.Height

SUB Dropped (File AS STRING)
    Files.AddItems File + "   (at " + STR$(Main.DropPoint.X) + ", " + STR$(Main.DropPoint.Y) + ")"
    Status.Caption = STR$(Files.ItemCount) + " file(s) dropped."
END SUB

SUB ToTray
    Main.AddTrayIcon
    Main.Visible = False
END SUB

SUB Minimised
    ToTray
END SUB

SUB BackFromTray
    Main.DelTrayIcon
    Main.WindowState = wsNormal
    Main.Visible = True
    Status.Caption = "Back from the tray."
END SUB

SUB TrayMenu
    ShowMessage "RFormEx is in the tray: double-click its icon to bring it back."
END SUB

SUB SeeThrough
    Main.Transparent = Opacity.Position
END SUB

SUB HoleClicked
    Main.TransparentClient = HoleBox.Checked
END SUB

SUB OnTopClicked
    IF OnTopBox.Checked THEN Main.FormStyle = fsStayOnTop ELSE Main.FormStyle = fsNormal
END SUB

SUB Active
    Status.Caption = "Active: the keyboard is here."
END SUB

SUB Inactive
    Status.Caption = "Another window has the keyboard."
END SUB

Main.ShowModal
