' tray.rr: an icon in the system tray. RapidQ programs add one this way
' (and RapidR runs them as they are): a QNOTIFYICONDATA given to
' Shell_NotifyIcon, the icon's clicks heard in the form's WndProc.
'
'   rapidr run tray.rr
'
' "Hide in the tray" hides the window and adds the icon; clicking the icon
' brings the window back and removes it. RapidR shows the icon on Windows,
' macOS and Linux alike (and in a strip on a web page).
$INCLUDE "RAPIDQ.INC"

CONST NIM_ADD = 0
CONST NIM_MODIFY = 1
CONST NIM_DELETE = 2
CONST NIF_MESSAGE = 1
CONST NIF_ICON = 2
CONST NIF_TIP = 4
CONST WM_TRAYICON = &H400 + 100     ' a message number of the program's choosing
CONST WM_LBUTTONUP = &H202

DECLARE FUNCTION Shell_NotifyIcon LIB "shell32" ALIAS "Shell_NotifyIconA" (BYVAL dwMessage AS LONG, NIData AS QNOTIFYICONDATA) AS LONG
DECLARE SUB FormProc (hWnd AS LONG, uMsg AS LONG, wParam AS LONG, lParam AS LONG)
DECLARE SUB ToTray

DIM Tray AS QNOTIFYICONDATA
DIM visits AS INTEGER

CREATE Form AS QFORM
    Caption = "Tray icon"
    Width = 320
    Height = 150
    Center
    WndProc = FormProc
    CREATE HideBtn AS QBUTTON
        Caption = "&Hide in the tray": Left = 16: Top = 16: Width = 140
        OnClick = ToTray
    END CREATE
    CREATE Info AS QLABEL
        Caption = "Click the button, then the tray icon.": Left = 16: Top = 56: Width = 290
    END CREATE
END CREATE

SUB ToTray
    Tray.hWnd = Form.Handle
    Tray.uID = 1
    Tray.uFlags = NIF_MESSAGE OR NIF_ICON OR NIF_TIP
    Tray.hIcon = Application.Icon
    Tray.uCallbackMessage = WM_TRAYICON
    Tray.szTip = "Tray example: click to come back"
    IF Shell_NotifyIcon(NIM_ADD, Tray) THEN
        Form.Visible = 0
        Info.Caption = "In the tray"
    END IF
END SUB

SUB FormProc (hWnd AS LONG, uMsg AS LONG, wParam AS LONG, lParam AS LONG)
    ' the icon's mouse messages arrive as the message we chose; lParam
    ' says which (here: the left button released on it)
    IF uMsg = WM_TRAYICON AND (lParam AND &HFFFF) = WM_LBUTTONUP THEN
        Shell_NotifyIcon(NIM_DELETE, Tray)
        visits = visits + 1
        Form.Visible = 1
        Info.Caption = "Back from the tray (" + STR$(visits) + ")"
    END IF
END SUB

Form.ShowModal
