$TYPECHECK ON

PRINT "=== Phase 3 Builtins Test ==="

PRINT ""
PRINT "--- New Math Functions ---"
PRINT "FIX(-3.7) = " + STR$(FIX(-3.7))
PRINT "FIX(3.7)  = " + STR$(FIX(3.7))
PRINT "FRAC(3.75) = " + STR$(FRAC(3.75))
PRINT "CINT(3.6) = " + STR$(CINT(3.6))
PRINT "CINT(3.4) = " + STR$(CINT(3.4))
PRINT "CLNG(-2.7) = " + STR$(CLNG(-2.7))
PRINT "IIF(1, 'yes', 'no') = " + IIF(1, "yes", "no")

PRINT ""
PRINT "--- Conversion Functions ---"
PRINT "HEXTODEC('FF') = " + STR$(HEXTODEC("FF"))
PRINT "CONVBASE$('255', 10, 16) = " + CONVBASE$("255", 10, 16)
PRINT "CONVBASE$('FF', 16, 10) = " + CONVBASE$("FF", 16, 10)
PRINT "CONVBASE$('10', 10, 2) = " + CONVBASE$("10", 10, 2)

PRINT ""
PRINT "--- New String Functions ---"
PRINT "INSERT$('Hello World', 6, ' Beautiful') = " + INSERT$("Hello World", 6, " Beautiful")
PRINT "DELETE$('Hello World', 6, 1) = " + DELETE$("Hello World", 6, 1)
PRINT "REVERSE$('Hello') = " + REVERSE$("Hello")
PRINT "FIELD$('one,two,three', ',', 2) = " + FIELD$("one,two,three", ",", 2)
PRINT "TALLY('hello world hello', 'hello') = " + STR$(TALLY("hello world hello", "hello"))
PRINT "RINSTR('hello world hello', 'hello') = " + STR$(RINSTR("hello world hello", "hello"))
PRINT "FORMAT$('#.##', 3.14159) = " + FORMAT$("#.##", 3.14159)

PRINT ""
PRINT "--- System Functions ---"
PRINT "DATE$ = " + DATE$()
PRINT "TIME$ = " + TIME$()
PRINT "CURDIR$ = " + CURDIR$()
PRINT "VARTYPE(42) = " + STR$(VARTYPE(42))
PRINT "VARTYPE('hello') = " + STR$(VARTYPE("hello"))
PRINT "SIZEOF('hello') = " + STR$(SIZEOF("hello"))

PRINT ""
PRINT "--- Random Numbers ---"
DIM r AS DOUBLE
r = RND(0)
PRINT "RND(0) = " + STR$(r)
r = RND(10)
PRINT "RND(10) = " + STR$(r)

PRINT ""
PRINT "--- File I/O ---"
DIM fn AS INTEGER
fn = FREEFILE()
PRINT "FREEFILE = " + STR$(fn)

PRINT ""
PRINT "=== All Phase 3 tests complete ==="
