' ── RapidR Chat Server Demo ──
' Simple TCP echo server using RServerSocket
$APPTYPE CONSOLE

DIM server AS RServerSocket
DIM running AS INTEGER

SUB OnClientConnect(addr AS STRING)
    PRINT "Client connected: " + addr
END SUB

SUB OnClientDisconnect(addr AS STRING)
    PRINT "Client disconnected: " + addr
END SUB

SUB OnDataReceived(addr AS STRING, data AS STRING)
    PRINT addr + ": " + data
    ' Echo back to all clients
    server.broadcast data
END SUB

server.host = "0.0.0.0"
server.port = 9999
server.onclientconnect = OnClientConnect
server.onclientdisconnect = OnClientDisconnect
server.ondatareceived = OnDataReceived

PRINT "Starting chat server on port 9999..."
server.start

PRINT "Server running. Press Ctrl+C to stop."
running = 1
DO WHILE running = 1
    server.poll
    SLEEP 50
LOOP

server.stop
PRINT "Server stopped."
