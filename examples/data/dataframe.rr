' dataframe.rr: data science on a form, linked — a CSV file read into
' RDataFrames, one shown in a grid, one drawn as a chart, all connected by
' properties: RapidR Studio's designer shows the real staff and their
' salaries while you design the form.
'
'   rapidr run dataframe.rr
'
' Staff (an RCSV) reads staff.csv (made-up data); FileName = STAFF_CSV is
' the $RESOURCE, so the file is built into the program and it runs from
' anywhere, a browser too. Team and Pay (RDataFrames, pandas-like) take its
' rows (Source = Staff). The RDBGrid shows Team (DataSource = Team); the
' RPlot draws Pay (DataSource = Pay: a bar over each Name, as tall as its
' Salary). The buttons change the frames — Refresh, Filter, Sort, GroupBy —
' and the grid and the chart follow by themselves.
$RESOURCE STAFF_CSV AS "staff.csv"

DECLARE SUB ShowAll
DECLARE SUB ShowEngineers
DECLARE SUB ShowTopPaid
DECLARE SUB ChartByDepartment

CREATE Form AS RForm
    Caption = "Staff explorer"
    Width = 620
    Height = 490
    Center
    ' (the data components: in the designer's tray, read live there)
    CREATE Staff AS RCSV
        FileName = STAFF_CSV
    END CREATE
    CREATE Team AS RDataFrame
        Source = Staff
    END CREATE
    CREATE Pay AS RDataFrame
        Source = Staff
    END CREATE
    CREATE AllBtn AS RButton
        Caption = "&Everyone": Left = 10: Top = 10: Width = 100: OnClick = ShowAll
    END CREATE
    CREATE EngBtn AS RButton
        Caption = "E&ngineering": Left = 118: Top = 10: Width = 100: OnClick = ShowEngineers
    END CREATE
    CREATE TopBtn AS RButton
        Caption = "&Top paid": Left = 226: Top = 10: Width = 100: OnClick = ShowTopPaid
    END CREATE
    CREATE ChartBtn AS RButton
        Caption = "&Chart": Left = 334: Top = 10: Width = 100: OnClick = ChartByDepartment
    END CREATE
    CREATE Grid AS RDBGrid
        Left = 10: Top = 44: Width = 590: Height = 170
        DataSource = Team
    END CREATE
    CREATE Chart AS RPlot
        Left = 10: Top = 222: Width = 590: Height = 200
        Title = "Salaries"
        DataSource = Pay
        Kind = "bar"
        X = "Name"
        Y = "Salary"
    END CREATE
    CREATE Info AS RLabel
        Left = 10: Top = 430: Width = 590
    END CREATE
END CREATE

' how many people the grid shows
SUB CountPeople
    Info.Caption = STR$(Team.RowCount) + " people"
END SUB

SUB ShowAll
    Team.Refresh                ' Staff's rows again, all of them
    CountPeople
END SUB

SUB ShowEngineers
    Team.Refresh
    Team.Filter("Department", "==", "Engineering")
    CountPeople
END SUB

SUB ShowTopPaid
    Team.Refresh
    Team.Filter("Salary", ">", "70000")
    Team.Sort("Salary", 0)        ' 0: highest first
    CountPeople
    Info.Caption = Info.Caption + " earn over 70000; " + Team.Cell(0, 0) + " the most"
END SUB

SUB ChartByDepartment
    ' each department's average salary: Pay grouped by Department (its
    ' rows become the departments, Salary their mean) — the chart follows,
    ' a bar over each department's name
    DIM r AS INTEGER, best AS INTEGER, line AS STRING
    Pay.Refresh
    Pay.GroupBy("Department", "mean")
    Chart.Title = "Average salary"
    Chart.X = "Department"
    FOR r = 0 TO Pay.RowCount - 1
        line = line + IIF(r > 0, ",", "") + STR$(INT(VAL(Pay.Cell(r, 2)) / 1000))
        IF VAL(Pay.Cell(r, 2)) > VAL(Pay.Cell(best, 2)) THEN best = r
    NEXT
    Info.Caption = "Averages: " + line + " (thousands). Highest: " + Pay.Cell(best, 0)
END SUB

CountPeople
Form.ShowModal
