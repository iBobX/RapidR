' secrets.rr: a program's own passwords in the operating system's keychain
' (RSecrets, RapidR's): the macOS Keychain, Windows Credential Manager, the
' Secret Service on Linux. Type a password and Save it; the box empties.
' Read brings it back (shown as dots); Delete removes it. Nothing is written
' in the program, a file or its settings.
'
'   rapidr run data/secrets.rr
'
' Each program has its own items, kept under its name (Secrets.Program), so
' no program reads another's. The debugger shows •••• for what Read gives,
' and an AI is never given it. A browser has no keychain: there the buttons
' say so. (RAPIDR_AI_KEYSTORE=memory keeps everything in the program's
' memory instead: for tests, the keychain is never touched.)

DECLARE SUB SaveClick
DECLARE SUB ReadClick
DECLARE SUB DeleteClick

DIM Secrets AS RSecrets

CREATE Form AS RForm
    Caption = "Secrets"
    Width = 380: Height = 270
    Center
    CREATE ServiceLabel AS RLabel
        Caption = "&Service": Left = 16: Top = 20: Width = 80
    END CREATE
    CREATE ServiceEdit AS REdit
        Text = "MySQL": Left = 100: Top = 16: Width = 250
    END CREATE
    CREATE NameLabel AS RLabel
        Caption = "&Name": Left = 16: Top = 52: Width = 80
    END CREATE
    CREATE NameEdit AS REdit
        Text = "office": Left = 100: Top = 48: Width = 250
    END CREATE
    CREATE ValueLabel AS RLabel
        Caption = "&Password": Left = 16: Top = 84: Width = 80
    END CREATE
    CREATE ValueEdit AS REdit
        PasswordChar = "*": Left = 100: Top = 80: Width = 250
    END CREATE
    CREATE SaveBtn AS RButton
        Caption = "Sa&ve": Left = 100: Top = 116: Width = 76
        OnClick = SaveClick
    END CREATE
    CREATE ReadBtn AS RButton
        Caption = "&Read": Left = 187: Top = 116: Width = 76
        OnClick = ReadClick
    END CREATE
    CREATE DeleteBtn AS RButton
        Caption = "&Delete": Left = 274: Top = 116: Width = 76
        OnClick = DeleteClick
    END CREATE
    CREATE Status AS RLabel
        Left = 16: Top = 160: Width = 340: Height = 40: AutoSize = 0: WordWrap = 1
    END CREATE
    CREATE KeptIn AS RLabel
        Left = 16: Top = 208: Width = 340
    END CREATE
END CREATE

IF Secrets.Available THEN
    KeptIn.Caption = "Kept in " + Secrets.Store
    Status.Caption = "Type a password, then Save."
ELSE
    KeptIn.Caption = "Nowhere to keep it: " + Secrets.Store
    Status.Caption = "The buttons say why."
END IF

SUB SaveClick
    IF Secrets.Save(ServiceEdit.Text, NameEdit.Text, ValueEdit.Text) THEN
        ValueEdit.Text = ""
        Status.Caption = "Saved. Read brings it back."
    ELSE
        Status.Caption = "Not saved: " + Secrets.Error
    END IF
END SUB

SUB ReadClick
    DIM Password AS STRING
    Password = Secrets.Read(ServiceEdit.Text, NameEdit.Text)
    IF Secrets.Error <> "" THEN
        Status.Caption = "Not read: " + Secrets.Error
    ELSEIF Password = "" THEN
        Status.Caption = "Nothing is kept as " + NameEdit.Text + " of " + ServiceEdit.Text + "."
    ELSE
        ValueEdit.Text = Password
        Status.Caption = "Read back: " + STR$(LEN(Password)) + " characters."
    END IF
END SUB

SUB DeleteClick
    IF Secrets.Delete(ServiceEdit.Text, NameEdit.Text) THEN
        ValueEdit.Text = ""
        Status.Caption = "Deleted."
    ELSEIF Secrets.Error <> "" THEN
        Status.Caption = "Not deleted: " + Secrets.Error
    ELSE
        Status.Caption = "There was nothing to delete."
    END IF
END SUB

Form.ShowModal
