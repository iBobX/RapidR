' archives.rr: zip, 7z, tar.gz and .gz files with RArchive (RapidR's).
' Pick a sample or open your own file: the program takes a Z80 snapshot as
' it is, or finds the first .z80 inside any archive — what an emulator does
' when people give it "game.z80" or "game.zip". The archive's entries are
' listed; click one to see its first bytes. "Make a zip" packs two notes
' into my-notes.zip and opens it.
'
'   rapidr run archives.rr          (from this folder)
'
' The samples are made-up: hello.z80 is 64 bytes of RapidR's own, not a
' real program; snapshots.zip and snapshots.7z hold it and a readme.
' RArchive works out the format from a file's first bytes, never trusts
' its name, and treats it as untrusted: a zip bomb, a name that would leave
' the folder, an encrypted entry or a RAR file is an error you can show
' (Archive.Error), never a crash.

DECLARE SUB PickSample
DECLARE SUB OpenClick
DECLARE SUB EntryClick
DECLARE SUB MakeClick

DIM Archive AS RArchive
DIM Raw AS RFileStream

CREATE Dlg AS ROpenDialog
    Caption = "Open a snapshot or an archive"
    Filter = "Snapshots and archives|*.z80;*.zip;*.7z;*.gz;*.tgz;*.tar;*.xz;*.zst|All files|*.*"
END CREATE

CREATE Form AS RForm
    Caption = "Archives"
    Width = 600: Height = 420
    Center
    CREATE FileLabel AS RLabel
        Caption = "&File": Left = 16: Top = 18: Width = 60
    END CREATE
    CREATE Samples AS RComboBox
        Left = 80: Top = 14: Width = 200: Style = csDropDownList
        OnChange = PickSample
    END CREATE
    CREATE OpenBtn AS RButton
        Caption = "&Open…": Left = 290: Top = 13: Width = 90
        OnClick = OpenClick
    END CREATE
    CREATE WantLabel AS RLabel
        Caption = "&Look for": Left = 394: Top = 18: Width = 64
    END CREATE
    CREATE Wanted AS REdit
        Text = ".z80": Left = 462: Top = 14: Width = 110
    END CREATE
    CREATE Info AS RLabel
        Left = 16: Top = 52: Width = 556
    END CREATE
    CREATE Entries AS RListBox
        Left = 16: Top = 76: Width = 556: Height = 170
        OnClick = EntryClick
    END CREATE
    CREATE Loaded AS RLabel
        Left = 16: Top = 258: Width = 556
    END CREATE
    CREATE HexView AS RLabel
        Left = 16: Top = 282: Width = 556: FontName = "Courier New"
    END CREATE
    CREATE MakeBtn AS RButton
        Caption = "&Make a zip": Left = 16: Top = 330: Width = 110
        OnClick = MakeClick
    END CREATE
    CREATE Status AS RLabel
        Left = 140: Top = 334: Width = 432
    END CREATE
END CREATE

' The first bytes of Bytes, in hex.
FUNCTION Hex16 (Bytes AS STRING) AS STRING
    DIM i AS INTEGER, s AS STRING
    FOR i = 1 TO 16
        IF i > LEN(Bytes) THEN EXIT FOR
        s = s + RIGHT$("0" + HEX$(ASC(MID$(Bytes, i, 1))), 2) + " "
    NEXT
    Hex16 = RTRIM$(s)
END FUNCTION

' The emulator's pattern: a snapshot as it is, or the first file whose name
' ends in Wanted.Text inside an archive. Returns its bytes ("" with Info
' saying why there are none) and lists what it found.
FUNCTION LoadSnapshot (FileName AS STRING) AS STRING
    DIM i AS INTEGER, Ext AS STRING, Found AS INTEGER
    Entries.Clear
    IF Archive.FormatOf(FileName) = "" THEN
        ' (not an archive: the file itself — a .z80)
        IF FILEEXISTS(FileName) = 0 THEN
            Info.Caption = FileName + ": no such file"
            EXIT FUNCTION
        END IF
        Raw.Open FileName, 0
        LoadSnapshot = Raw.ReadBinStr(Raw.Size)
        Raw.Close
        Archive.Close
        Info.Caption = FileName + ": not an archive — the snapshot itself"
        Entries.AddItems FileName
        Entries.ItemIndex = 0
        EXIT FUNCTION
    END IF
    IF Archive.Open(FileName) = 0 THEN
        Info.Caption = FileName + ": " + Archive.Error
        EXIT FUNCTION
    END IF
    Info.Caption = FileName + ": " + Archive.Format + ", " + STR$(Archive.Count) + " entries"
    Ext = LCASE$(Wanted.Text)
    Found = -1
    FOR i = 0 TO Archive.Count - 1
        IF Archive.IsFolder(i) THEN
            Entries.AddItems Archive.Name(i)
        ELSE
            Entries.AddItems Archive.Name(i) + "   " + STR$(Archive.Size(i)) + " bytes   " + Archive.DateTime(i)
            IF Found < 0 AND RIGHT$(LCASE$(Archive.Name(i)), LEN(Ext)) = Ext THEN Found = i
        END IF
    NEXT
    IF Found < 0 THEN
        Info.Caption = Info.Caption + " — no " + Wanted.Text + " inside"
        EXIT FUNCTION
    END IF
    Entries.ItemIndex = Found
    LoadSnapshot = Archive.Extract(Found)
    IF Archive.Error <> "" THEN Info.Caption = Archive.Name(Found) + ": " + Archive.Error
END FUNCTION

SUB Show (FileName AS STRING)
    DIM Snapshot AS STRING
    Snapshot = LoadSnapshot(FileName)
    IF Snapshot = "" THEN
        Loaded.Caption = "Nothing loaded."
        HexView.Caption = ""
    ELSE
        Loaded.Caption = "Loaded " + STR$(LEN(Snapshot)) + " bytes, starting:"
        HexView.Caption = Hex16(Snapshot)
    END IF
END SUB

SUB PickSample
    Show Samples.Item(Samples.ItemIndex)
END SUB

SUB OpenClick
    IF Dlg.Execute THEN Show Dlg.FileName
END SUB

' (an entry clicked: its own first bytes)
SUB EntryClick
    DIM i AS INTEGER, Bytes AS STRING
    i = Entries.ItemIndex
    IF i < 0 OR Archive.Count = 0 THEN EXIT SUB
    IF Archive.IsFolder(i) THEN
        Loaded.Caption = Archive.Name(i) + " is a folder."
        HexView.Caption = ""
        EXIT SUB
    END IF
    Bytes = Archive.Extract(i)
    IF Archive.Error <> "" THEN
        Loaded.Caption = Archive.Error
        HexView.Caption = ""
    ELSE
        Loaded.Caption = Archive.Name(i) + ": " + STR$(LEN(Bytes)) + " bytes, starting:"
        HexView.Caption = Hex16(Bytes)
    END IF
END SUB

' Two notes packed into my-notes.zip, then opened like any other.
SUB MakeClick
    Archive.Level = 9
    IF Archive.Create("my-notes.zip") = 0 THEN
        Status.Caption = Archive.Error
        EXIT SUB
    END IF
    Archive.AddText "notes/hello.txt", "Hello from RapidR!" + CHR$(10)
    Archive.AddText "notes/today.txt", "Made on " + DATE$ + " at " + TIME$ + CHR$(10)
    IF Archive.Close THEN
        Status.Caption = "Made my-notes.zip (" + STR$(FILELEN("my-notes.zip")) + " bytes)"
        Wanted.Text = ".txt"
        Show "my-notes.zip"
    ELSE
        Status.Caption = Archive.Error
    END IF
END SUB

Samples.AddItems "snapshots.zip", "snapshots.7z", "hello.z80.gz", "hello.z80"
Samples.ItemIndex = 0
Show "snapshots.zip"

Form.ShowModal
