' local_api.rr: a web API in a program (RHttpServer, RapidR's). It listens
' on 127.0.0.1 — this computer only — and every request needs the token
' the window shows. Three addresses:
'   GET  /hello    a greeting
'   POST /echo     sends back the body it got
'   GET  /events   three Server-Sent Events, a third of a second apart
'
'   rapidr run network/local_api.rr                 (port 47110, a new token)
'   rapidr run network/local_api.rr 47110 mytoken   (a port and a token)
'
' Then, in a terminal (the window shows these with the real token):
'   curl -H "Authorization: Bearer TOKEN" http://127.0.0.1:47110/hello
'   curl -H "Authorization: Bearer TOKEN" -d "hi" http://127.0.0.1:47110/echo
'   curl -N -H "Authorization: Bearer TOKEN" http://127.0.0.1:47110/events
'
' The server itself refuses a request without the token (401), one from
' another site's web page (403) and one for another host name (403). A
' link or an image on another site can still send a GET with no Origin, so
' the GETs here only read; anything that changes something needs the token.
' The token comes from Web.NewToken: the system's secure random source
' (never RND, which is not for secrets). Desktop only: a web page can't
' listen.
' Each request answered is announced to screen readers (Application.Announce).

$THEME rapidr

DECLARE SUB Answer (Method AS STRING, Path AS STRING, Headers AS STRING, Body AS STRING)
DECLARE SUB Tick
DECLARE SUB StartClick
DECLARE SUB StopClick

DIM Web AS RHttpServer
DIM Ticker AS RTimer
DIM Stream AS INTEGER, Sent AS INTEGER, Served AS INTEGER
DIM Token AS STRING

CREATE Form AS RForm
    Caption = "Local API"
    Width = 520: Height = 360
    Center
    CREATE UrlLabel AS RLabel
        Left = 16: Top = 16: Width = 480
    END CREATE
    CREATE TokenLabel AS RLabel
        Left = 16: Top = 40: Width = 480
    END CREATE
    CREATE Try AS REdit
        Left = 16: Top = 66: Width = 480: ReadOnly = 1
        AccessibleName = "Try it in a terminal"
    END CREATE
    CREATE Log AS RListBox
        Left = 16: Top = 100: Width = 480: Height = 170
        AccessibleName = "Requests"
    END CREATE
    CREATE StartBtn AS RButton
        Caption = "&Start": Left = 16: Top = 284: Width = 90
        OnClick = StartClick
    END CREATE
    CREATE StopBtn AS RButton
        Caption = "S&top": Left = 116: Top = 284: Width = 90
        OnClick = StopClick
    END CREATE
    CREATE Status AS RLabel
        Left = 220: Top = 290: Width = 276
    END CREATE
END CREATE

SUB Answer (Method AS STRING, Path AS STRING, Headers AS STRING, Body AS STRING)
    DIM kind AS STRING
    Served = Served + 1
    Log.AddItems Method + " " + Path + "  (" + Web.Peer + ")"
    Log.ItemIndex = Log.ItemCount - 1
    IF Method = "GET" AND Path = "/hello" THEN
        Web.Respond 200, "Content-Type: text/plain; charset=utf-8", "Hello from RapidR" + CHR$(10)
    ELSEIF Method = "POST" AND Path = "/echo" THEN
        kind = Web.Header("Content-Type")
        IF kind = "" THEN kind = "text/plain; charset=utf-8"
        Web.Respond 200, "Content-Type: " + kind, Body
    ELSEIF Method = "GET" AND Path = "/events" THEN
        IF Stream <> 0 THEN
            Web.Respond 409, "", "One stream at a time: try again in a second." + CHR$(10)
        ELSE
            ' (answered later: the request's number kept for the timer)
            Stream = Web.Request
            Sent = 0
            Web.BeginStream
            Ticker.Enabled = 1
        END IF
    ELSE
        Web.Respond 404, "", "Not here: try /hello, /echo or /events." + CHR$(10)
    END IF
    Status.Caption = STR$(Served) + " requests answered"
    ' (a screen reader says it without moving the focus: politely)
    Application.Announce Method + " " + Path + " answered"
END SUB

SUB Tick
    Sent = Sent + 1
    ' (JSON's quotes: CHR$(34))
    IF Web.SendEvent("{" + CHR$(34) + "tick" + CHR$(34) + ":" + LTRIM$(STR$(Sent)) + "}", "tick", Stream) = 0 OR Sent >= 3 THEN
        Web.EndStream Stream
        Stream = 0
        Ticker.Enabled = 0
    END IF
END SUB

SUB StartClick
    IF Web.Listening THEN EXIT SUB
    IF Web.Start THEN
        UrlLabel.Caption = "Listening on " + Web.Url + " (this computer only)"
        TokenLabel.Caption = "Token: " + Token
        Try.Text = "curl -H " + CHR$(34) + "Authorization: Bearer " + Token + CHR$(34) + " " + Web.Url + "hello"
        PRINT "Listening on "; Web.Url
    ELSE
        UrlLabel.Caption = "Not listening: " + Web.Error
    END IF
END SUB

SUB StopClick
    Web.Stop
    Ticker.Enabled = 0
    Stream = 0
    UrlLabel.Caption = "Stopped."
END SUB

Web.OnRequest = Answer
Ticker.Interval = 330
Ticker.Enabled = 0
Ticker.OnTimer = Tick
Web.Port = 47110
IF COMMAND$(1) <> "" THEN Web.Port = VAL(COMMAND$(1))
' (the token: the one given, else a new random one — keep a real
' program's with RSecrets)
Token = COMMAND$(2)
IF Token = "" THEN
    Token = Web.NewToken
ELSE
    Web.Token = Token
END IF
StartClick
Form.ShowModal
Web.Stop
