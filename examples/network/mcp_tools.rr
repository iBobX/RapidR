' mcp_tools.rr: a program's own tools for AI apps (RMcpServer, RapidR's).
' A notes list an AI app can read and add to while you watch: every call
' shows in the window as it happens, and you decide whether an AI app may
' change the list.
'
'   rapidr run network/mcp_tools.rr                 (port 47120, a new token)
'   rapidr run network/mcp_tools.rr 47120 mytoken   (a port and a token)
'
' An AI app that supports MCP connects with the address and the token the
' window shows (its MCP settings take both: the address, and the header
' Authorization: Bearer <token>). Three tools:
'   list_notes   the notes, one a line              (it only reads)
'   add_note     adds a note: Text AS STRING        (it changes the list)
'   find_notes   the notes with a word: Word AS STRING
'
' The server listens on 127.0.0.1 only — this computer — and refuses a
' request without the token, one from a web page and one for another host
' name by itself. Each tool's arguments are checked before the program sees
' them: an AI app that calls add_note without Text is told what it needs.
' Desktop only: a web page can't listen.

$THEME rapidr

DECLARE SUB ToolCalled (Tool AS STRING, Arguments AS STRING, CallId AS INTEGER)
DECLARE SUB ClientIn (Client AS STRING)
DECLARE SUB ClientOut (Client AS STRING)
DECLARE SUB StartClick
DECLARE SUB StopClick

DIM Mcp AS RMcpServer
DIM Token AS STRING
DIM Calls AS INTEGER

CREATE Form AS RForm
    Caption = "Notes for AI Apps"
    Width = 560: Height = 420
    Center
    CREATE UrlLabel AS RLabel
        Left = 16: Top = 16: Width = 520
    END CREATE
    CREATE TokenEdit AS REdit
        Left = 16: Top = 40: Width = 520: ReadOnly = 1
        AccessibleName = "The header an AI app sends"
    END CREATE
    CREATE NotesLabel AS RLabel
        Caption = "&Notes": Left = 16: Top = 76
    END CREATE
    CREATE Notes AS RListBox
        Left = 16: Top = 96: Width = 250: Height = 220
        AccessibleName = "Notes"
    END CREATE
    CREATE LogLabel AS RLabel
        Caption = "What AI apps did": Left = 286: Top = 76
    END CREATE
    CREATE Log AS RListBox
        Left = 286: Top = 96: Width = 250: Height = 220
        AccessibleName = "What AI apps did"
    END CREATE
    CREATE AllowBox AS RCheckBox
        Caption = "&Let AI apps add notes": Left = 16: Top = 326: Width = 250
        Checked = 1
    END CREATE
    CREATE StartBtn AS RButton
        Caption = "&Start": Left = 16: Top = 352: Width = 90
        OnClick = StartClick
    END CREATE
    CREATE StopBtn AS RButton
        Caption = "S&top": Left = 116: Top = 352: Width = 90
        OnClick = StopClick
    END CREATE
    CREATE Status AS RLabel
        Left = 220: Top = 358: Width = 316
    END CREATE
END CREATE

' (the notes, one a line; "" when there are none)
FUNCTION NotesText (Word AS STRING) AS STRING
    DIM i AS INTEGER, t AS STRING
    FOR i = 0 TO Notes.ItemCount - 1
        IF Word = "" OR INSTR(LCASE$(Notes.Item(i)), LCASE$(Word)) > 0 THEN t = t + Notes.Item(i) + CHR$(10)
    NEXT
    NotesText = t
END FUNCTION

SUB ToolCalled (Tool AS STRING, Arguments AS STRING, CallId AS INTEGER)
    DIM t AS STRING
    Calls = Calls + 1
    Log.AddItems Mcp.ClientName + ": " + Tool
    Log.ItemIndex = Log.ItemCount - 1
    SELECT CASE Tool
        CASE "list_notes"
            t = NotesText("")
            IF t = "" THEN t = "There are no notes yet."
            Mcp.Reply CallId, t
        CASE "find_notes"
            t = NotesText(Mcp.Argument("Word"))
            IF t = "" THEN t = "No note has " + CHR$(34) + Mcp.Argument("Word") + CHR$(34) + " in it."
            Mcp.Reply CallId, t
        CASE "add_note"
            IF AllowBox.Checked = 0 THEN
                ' (an error the AI reads: what happened and what it can do)
                Mcp.Reply CallId, "The person using Notes doesn't let AI apps add notes now. Tell them what you wanted to add.", 1
            ELSE
                Notes.AddItems Mcp.Argument("Text")
                Mcp.Reply CallId, "Added. There are " + LTRIM$(STR$(Notes.ItemCount)) + " notes."
            END IF
    END SELECT
    Status.Caption = LTRIM$(STR$(Calls)) + " calls from " + LTRIM$(STR$(Mcp.ClientCount)) + " AI app(s)"
    ' (a screen reader says it without moving the focus: politely)
    Application.Announce Mcp.ClientName + " called " + Tool
END SUB

SUB ClientIn (Client AS STRING)
    Log.AddItems Client + " connected"
END SUB

SUB ClientOut (Client AS STRING)
    Log.AddItems Client + " left"
END SUB

SUB StartClick
    IF Mcp.Listening THEN EXIT SUB
    IF Mcp.Start THEN
        UrlLabel.Caption = "AI apps connect to " + Mcp.Url + " (this computer only)"
        TokenEdit.Text = "Authorization: Bearer " + Token
        PRINT "Listening on "; Mcp.Url
    ELSE
        UrlLabel.Caption = "Not listening: " + Mcp.Error
    END IF
END SUB

SUB StopClick
    Mcp.Stop
    UrlLabel.Caption = "Stopped: AI apps can't connect."
END SUB

Notes.AddItems "Buy milk"
Notes.AddItems "Call the library about the book"
Mcp.OnToolCall = ToolCalled
Mcp.OnConnect = ClientIn
Mcp.OnDisconnect = ClientOut
Mcp.ServerName = "notes"
Mcp.ServerTitle = "Notes"
Mcp.Instructions = "A short list of notes the user keeps. Read them with list_notes or find_notes; add one with add_note only when the user asks."
Mcp.AddTool "list_notes", "The user's notes, one a line.", "", "read"
Mcp.AddTool "find_notes", "The notes that have a word in them (any case).", "Word AS STRING", "read"
Mcp.AddTool "add_note", "Adds a note at the end of the user's list.", "Text AS STRING", "change"
Mcp.Port = 47120
IF COMMAND$(1) <> "" THEN Mcp.Port = VAL(COMMAND$(1))
' (the token: the one given, else a new random one — keep a real
' program's with RSecrets)
Token = COMMAND$(2)
IF Token = "" THEN
    Token = Mcp.NewToken
ELSE
    Mcp.Token = Token
END IF
StartClick
Form.ShowModal
Mcp.Stop
