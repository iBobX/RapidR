' socket_client.rr: a TCP client and a server in one window, on this
' computer only (127.0.0.1).
'
'   rapidr run network/socket_client.rr
'
' The server (RServerSocket) answers every line with "echo: " and the
' line. The client (RSocket) connects with Connect(Host, Port): Connected
' says 1 while the connection is open. "Send a line" writes a line; a
' timer asks IsServerReady (it answers at once, never waits) and reads the
' answer when it has come, so the window never waits for the network —
' and the server, in this same program, gets its turn to answer.
' Disconnect closes the connection: the server sees its client go at once.
' "Restart server" stops the server and starts it again on the same port,
' at once; its clients are cut off, and Connected says so.
$THEME rapidr

DECLARE SUB ServerHeard (Address AS STRING, Data AS STRING)
DECLARE SUB Tick
DECLARE SUB DoConnect
DECLARE SUB DoSend
DECLARE SUB DoDisconnect
DECLARE SUB DoRestart

DIM Client AS RSocket
DIM Count AS INTEGER

CREATE Form AS RForm
    Caption = "Socket client"
    ClientWidth = 400
    ClientHeight = 236
    Center
    CREATE Srv AS RServerSocket
        Host = "127.0.0.1"            ' this computer only
        Port = 0                      ' the system picks a free port
        OnDataReceived = ServerHeard
    END CREATE
    CREATE Poller AS RTimer
        Interval = 100
        OnTimer = Tick
    END CREATE
    CREATE BConnect AS RButton
        Caption = "&Connect"
        Left = 16: Top = 16: Width = 110
        OnClick = DoConnect
    END CREATE
    CREATE BSend AS RButton
        Caption = "&Send a line"
        Left = 142: Top = 16: Width = 110
        OnClick = DoSend
    END CREATE
    CREATE BDisconnect AS RButton
        Caption = "&Disconnect"
        Left = 268: Top = 16: Width = 116
        OnClick = DoDisconnect
    END CREATE
    CREATE BRestart AS RButton
        Caption = "&Restart server"
        Left = 16: Top = 56: Width = 236
        OnClick = DoRestart
    END CREATE
    CREATE Status AS RLabel
        Left = 16: Top = 104: Width = 368
    END CREATE
    CREATE Answer AS RLabel
        Left = 16: Top = 136: Width = 368
        Caption = "Connect, then send a line."
    END CREATE
END CREATE

' The server: every line comes back with "echo: ".
SUB ServerHeard (Address AS STRING, Data AS STRING)
    Srv.SendTo Address, "echo: " + Data
END SUB

' A tenth of a second: the server's events, the client's answer if one has
' come (IsServerReady never waits), and the state in words.
SUB Tick
    Srv.Poll
    IF Client.Connected THEN
        IF Client.IsServerReady(Client.MySocket) THEN
            Answer.Caption = "Got: " + Client.ReadLine(Client.MySocket)
        END IF
    END IF
    Status.Caption = "Server on port" + STR$(Srv.Port) + ", clients:" + STR$(Srv.ClientCount) + " · client Connected:" + STR$(Client.Connected)
END SUB

SUB DoConnect
    DIM sock AS INTEGER
    Client.Timeout = 2000             ' Connect and each Read wait at most 2 s
    sock = Client.Connect("127.0.0.1", Srv.Port)
    IF sock < 0 THEN
        Answer.Caption = "Couldn't connect: is the server running?"
    ELSE
        Answer.Caption = "Connected (socket" + STR$(sock) + ")."
    END IF
END SUB

SUB DoSend
    IF Client.Connected = 0 THEN
        Answer.Caption = "Not connected: Connect first."
        EXIT SUB
    END IF
    Count = Count + 1
    Client.WriteLine Client.MySocket, "hello" + STR$(Count)
    Answer.Caption = "Sent hello" + STR$(Count) + "..."
END SUB

SUB DoDisconnect
    Client.Disconnect
    Answer.Caption = "Disconnected: the server sees its client go."
END SUB

SUB DoRestart
    DIM p AS INTEGER
    p = Srv.Port
    Srv.Stop
    IF Srv.Start THEN
        Answer.Caption = "The server stopped and started again on port" + STR$(p) + "."
    ELSE
        Answer.Caption = "The server couldn't start again."
    END IF
END SUB

Srv.Start
Form.ShowModal
Srv.Stop
