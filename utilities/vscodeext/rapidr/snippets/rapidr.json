{
  "DIM Variable": {
    "prefix": "dim",
    "body": [
      "DIM ${1:name} AS ${2|INTEGER,STRING,DOUBLE,SINGLE,LONG,BYTE,WORD,DWORD,INT64,CURRENCY,VARIANT,POBJECT|}"
    ],
    "description": "Declare a variable with DIM"
  },
  "DIM Array": {
    "prefix": "dima",
    "body": [
      "DIM ${1:name}(${2:size}) AS ${3|INTEGER,STRING,DOUBLE,SINGLE,LONG|}"
    ],
    "description": "Declare an array with DIM"
  },
  "CONST": {
    "prefix": "const",
    "body": [
      "CONST ${1:NAME} = ${2:value}"
    ],
    "description": "Declare a constant"
  },
  "IF...THEN...END IF": {
    "prefix": "if",
    "body": [
      "IF ${1:condition} THEN",
      "\t${2:' code here}",
      "END IF"
    ],
    "description": "IF block"
  },
  "IF...THEN...ELSE...END IF": {
    "prefix": "ife",
    "body": [
      "IF ${1:condition} THEN",
      "\t${2:' then code}",
      "ELSE",
      "\t${3:' else code}",
      "END IF"
    ],
    "description": "IF...ELSE block"
  },
  "IF...ELSEIF...ELSE...END IF": {
    "prefix": "ifeif",
    "body": [
      "IF ${1:condition1} THEN",
      "\t${2:' code}",
      "ELSEIF ${3:condition2} THEN",
      "\t${4:' code}",
      "ELSE",
      "\t${5:' code}",
      "END IF"
    ],
    "description": "IF...ELSEIF...ELSE block"
  },
  "FOR...NEXT": {
    "prefix": "for",
    "body": [
      "FOR ${1:i} = ${2:1} TO ${3:10}",
      "\t${4:' code here}",
      "NEXT ${1:i}"
    ],
    "description": "FOR loop"
  },
  "FOR...STEP...NEXT": {
    "prefix": "fors",
    "body": [
      "FOR ${1:i} = ${2:start} TO ${3:end} STEP ${4:step}",
      "\t${5:' code here}",
      "NEXT ${1:i}"
    ],
    "description": "FOR loop with STEP"
  },
  "WHILE...WEND": {
    "prefix": "while",
    "body": [
      "WHILE ${1:condition}",
      "\t${2:' code here}",
      "WEND"
    ],
    "description": "WHILE loop"
  },
  "DO...LOOP WHILE": {
    "prefix": "dowhile",
    "body": [
      "DO",
      "\t${1:' code here}",
      "LOOP WHILE ${2:condition}"
    ],
    "description": "DO...LOOP WHILE (post-condition)"
  },
  "DO...LOOP UNTIL": {
    "prefix": "dountil",
    "body": [
      "DO",
      "\t${1:' code here}",
      "LOOP UNTIL ${2:condition}"
    ],
    "description": "DO...LOOP UNTIL (post-condition)"
  },
  "DO WHILE...LOOP": {
    "prefix": "dowhilepre",
    "body": [
      "DO WHILE ${1:condition}",
      "\t${2:' code here}",
      "LOOP"
    ],
    "description": "DO WHILE...LOOP (pre-condition)"
  },
  "SELECT CASE": {
    "prefix": "select",
    "body": [
      "SELECT CASE ${1:expression}",
      "\tCASE ${2:value1}",
      "\t\t${3:' code}",
      "\tCASE ${4:value2}",
      "\t\t${5:' code}",
      "\tCASE ELSE",
      "\t\t${6:' default code}",
      "END SELECT"
    ],
    "description": "SELECT CASE block"
  },
  "SUB": {
    "prefix": "sub",
    "body": [
      "SUB ${1:Name}(${2:params})",
      "\t${3:' code here}",
      "END SUB"
    ],
    "description": "Subroutine definition"
  },
  "FUNCTION": {
    "prefix": "func",
    "body": [
      "FUNCTION ${1:Name}(${2:params}) AS ${3|INTEGER,STRING,DOUBLE,LONG,VARIANT|}",
      "\t${4:' code here}",
      "\t${1:Name} = ${5:result}",
      "END FUNCTION"
    ],
    "description": "Function definition"
  },
  "TYPE": {
    "prefix": "type",
    "body": [
      "TYPE ${1:TypeName}",
      "\t${2:Field1} AS ${3|INTEGER,STRING,DOUBLE,LONG|}",
      "\t${4:Field2} AS ${5|INTEGER,STRING,DOUBLE,LONG|}",
      "END TYPE"
    ],
    "description": "User-defined type (struct)"
  },
  "TYPE with CONSTRUCTOR": {
    "prefix": "typec",
    "body": [
      "TYPE ${1:TypeName}",
      "\t${2:Field1} AS ${3|STRING,INTEGER,DOUBLE,LONG|}",
      "",
      "\tCONSTRUCTOR",
      "\t\t.${2:Field1} = ${4:defaultValue}",
      "\tEND CONSTRUCTOR",
      "",
      "\tSUB ${5:MethodName}()",
      "\t\t${6:' code}",
      "\tEND SUB",
      "END TYPE"
    ],
    "description": "User-defined type with constructor and method"
  },
  "CREATE Form": {
    "prefix": "createform",
    "body": [
      "CREATE ${1:Form1} AS RForm",
      "\tCaption = \"${2:My Application}\"",
      "\tWidth = ${3:800}",
      "\tHeight = ${4:600}",
      "\tCenter",
      "\t",
      "\t${5:' Add child components here}",
      "END CREATE",
      "",
      "${1:Form1}.ShowModal"
    ],
    "description": "Create a RForm window"
  },
  "CREATE Button": {
    "prefix": "createbutton",
    "body": [
      "CREATE ${1:Button1} AS RButton",
      "\tCaption = \"${2:Click Me}\"",
      "\tLeft = ${3:10}",
      "\tTop = ${4:10}",
      "\tWidth = ${5:100}",
      "\tHeight = ${6:30}",
      "\tOnClick = ${7:HandleClick}",
      "END CREATE"
    ],
    "description": "Create a RButton"
  },
  "CREATE Label": {
    "prefix": "createlabel",
    "body": [
      "CREATE ${1:Label1} AS RLabel",
      "\tCaption = \"${2:Label Text}\"",
      "\tLeft = ${3:10}",
      "\tTop = ${4:10}",
      "\tAutoSize = TRUE",
      "END CREATE"
    ],
    "description": "Create a RLabel"
  },
  "CREATE Edit": {
    "prefix": "createedit",
    "body": [
      "CREATE ${1:Edit1} AS REdit",
      "\tText = \"${2:}\"",
      "\tLeft = ${3:10}",
      "\tTop = ${4:10}",
      "\tWidth = ${5:200}",
      "\tHeight = ${6:25}",
      "END CREATE"
    ],
    "description": "Create a REdit text field"
  },
  "CREATE Panel": {
    "prefix": "createpanel",
    "body": [
      "CREATE ${1:Panel1} AS RPanel",
      "\tLeft = ${2:0}",
      "\tTop = ${3:0}",
      "\tWidth = ${4:400}",
      "\tHeight = ${5:300}",
      "\tColor = ${6:&HFFFFFF}",
      "\t",
      "\t${7:' Add child components here}",
      "END CREATE"
    ],
    "description": "Create a RPanel container"
  },
  "CREATE Timer": {
    "prefix": "createtimer",
    "body": [
      "CREATE ${1:Timer1} AS RTimer",
      "\tInterval = ${2:1000}",
      "\tEnabled = ${3:TRUE}",
      "\tOnTimer = ${4:HandleTimer}",
      "END CREATE"
    ],
    "description": "Create a RTimer"
  },
  "CREATE ListBox": {
    "prefix": "createlistbox",
    "body": [
      "CREATE ${1:ListBox1} AS RListBox",
      "\tLeft = ${2:10}",
      "\tTop = ${3:10}",
      "\tWidth = ${4:200}",
      "\tHeight = ${5:150}",
      "END CREATE"
    ],
    "description": "Create a RListBox"
  },
  "CREATE ComboBox": {
    "prefix": "createcombo",
    "body": [
      "CREATE ${1:ComboBox1} AS RComboBox",
      "\tLeft = ${2:10}",
      "\tTop = ${3:10}",
      "\tWidth = ${4:200}",
      "END CREATE"
    ],
    "description": "Create a RComboBox"
  },
  "CREATE StringGrid": {
    "prefix": "creategrid",
    "body": [
      "CREATE ${1:Grid1} AS RStringGrid",
      "\tLeft = ${2:10}",
      "\tTop = ${3:10}",
      "\tWidth = ${4:400}",
      "\tHeight = ${5:200}",
      "\tCols = ${6:5}",
      "\tRows = ${7:10}",
      "\tFixedCols = ${8:1}",
      "\tFixedRows = ${9:1}",
      "END CREATE"
    ],
    "description": "Create a RStringGrid"
  },
  "CREATE RichEdit": {
    "prefix": "createrichedit",
    "body": [
      "CREATE ${1:RichEdit1} AS RRichEdit",
      "\tLeft = ${2:10}",
      "\tTop = ${3:10}",
      "\tWidth = ${4:400}",
      "\tHeight = ${5:300}",
      "END CREATE"
    ],
    "description": "Create a RRichEdit multiline text editor"
  },
  "CREATE Canvas": {
    "prefix": "createcanvas",
    "body": [
      "CREATE ${1:Canvas1} AS RCanvas",
      "\tLeft = ${2:10}",
      "\tTop = ${3:10}",
      "\tWidth = ${4:400}",
      "\tHeight = ${5:300}",
      "\tColor = ${6:&HFFFFFF}",
      "END CREATE"
    ],
    "description": "Create a RCanvas for drawing"
  },
  "CREATE CodeEditor": {
    "prefix": "createcodeeditor",
    "body": [
      "CREATE ${1:CodeEditor1} AS RCodeEditor",
      "\tLeft = ${2:10}",
      "\tTop = ${3:10}",
      "\tWidth = ${4:600}",
      "\tHeight = ${5:400}",
      "\tLineNumbers = TRUE",
      "END CREATE"
    ],
    "description": "Create a RCodeEditor with code editing features"
  },
  "CREATE Menu": {
    "prefix": "createmenu",
    "body": [
      "CREATE ${1:MainMenu1} AS RMainMenu",
      "\tCREATE ${2:FileMenu} AS RMenuItem",
      "\t\tCaption = \"${3:&File}\"",
      "\t\tCREATE ${4:MenuItem1} AS RMenuItem",
      "\t\t\tCaption = \"${5:&Open}\"",
      "\t\t\tOnClick = ${6:HandleOpen}",
      "\t\tEND CREATE",
      "\tEND CREATE",
      "END CREATE"
    ],
    "description": "Create a RMainMenu with menu items"
  },
  "CREATE MySQL": {
    "prefix": "createmysql",
    "body": [
      "CREATE ${1:db} AS RMySQL",
      "\tHost = \"${2:localhost}\"",
      "\tUser = \"${3:root}\"",
      "\tPassword = \"${4:}\"",
      "\tDatabase = \"${5:mydb}\"",
      "END CREATE",
      "",
      "${1:db}.Connect"
    ],
    "description": "Create a RMySQL database connection"
  },
  "CREATE SQLite": {
    "prefix": "createsqlite",
    "body": [
      "CREATE ${1:db} AS RSQLite",
      "\tDatabase = \"${2:data.db}\"",
      "END CREATE",
      "",
      "${1:db}.Connect"
    ],
    "description": "Create a RSQLite database connection"
  },
  "CREATE Socket": {
    "prefix": "createsocket",
    "body": [
      "CREATE ${1:Socket1} AS RSocket",
      "\tHost = \"${2:localhost}\"",
      "\tPort = ${3:8080}",
      "END CREATE"
    ],
    "description": "Create a RSocket network connection"
  },
  "CREATE HTTP": {
    "prefix": "createhttp",
    "body": [
      "CREATE ${1:Http1} AS RHTTP",
      "\tHost = \"${2:api.example.com}\"",
      "\tPort = ${3:443}",
      "\tUseSSL = TRUE",
      "END CREATE"
    ],
    "description": "Create a RHTTP client"
  },
  "WITH block": {
    "prefix": "with",
    "body": [
      "WITH ${1:object}",
      "\t.${2:Property} = ${3:value}",
      "END WITH"
    ],
    "description": "WITH block for object property access"
  },
  "IMPORT": {
    "prefix": "import",
    "body": [
      "IMPORT \"${1:module}\" AS ${2:alias}"
    ],
    "description": "Import a Python module"
  },
  "DECLARE": {
    "prefix": "declare",
    "body": [
      "DECLARE ${1|SUB,FUNCTION|} ${2:Name} LIB \"${3:library}\" ALIAS \"${4:Alias}\" (${5:params})"
    ],
    "description": "Declare an external function from a library"
  },
  "BIND": {
    "prefix": "bind",
    "body": [
      "BIND ${1:Component}.${2:OnClick} TO ${3:HandlerSub}"
    ],
    "description": "Bind an event to a handler"
  },
  "$INCLUDE": {
    "prefix": "$include",
    "body": [
      "$$INCLUDE \"${1:filename.rr}\""
    ],
    "description": "Include an external source file"
  },
  "$DEFINE": {
    "prefix": "$define",
    "body": [
      "$$DEFINE ${1:SYMBOL} ${2:value}"
    ],
    "description": "Define a text substitution macro"
  },
  "$IFDEF": {
    "prefix": "$ifdef",
    "body": [
      "$$IFDEF ${1:SYMBOL}",
      "\t${2:' conditional code}",
      "$$ENDIF"
    ],
    "description": "Conditional compilation block"
  },
  "$APPTYPE": {
    "prefix": "$apptype",
    "body": [
      "$$APPTYPE ${1|GUI,CONSOLE,CGI,WEB|}"
    ],
    "description": "Set application type"
  },
  "$TYPECHECK": {
    "prefix": "$typecheck",
    "body": [
      "$$TYPECHECK ${1|ON,OFF|}"
    ],
    "description": "Enable or disable strict type checking"
  },
  "Console App Skeleton": {
    "prefix": "rpcons",
    "body": [
      "' ${1:Program Name}",
      "' RapidR Console Application",
      "$$APPTYPE CONSOLE",
      "",
      "${2:' Your code here}",
      "PRINT \"Hello, World!\"",
      ""
    ],
    "description": "RapidR console application template"
  },
  "GUI App Skeleton": {
    "prefix": "rpgui",
    "body": [
      "' ${1:Program Name}",
      "' RapidR GUI Application",
      "$$APPTYPE GUI",
      "",
      "CREATE ${2:MainForm} AS RForm",
      "\tCaption = \"${3:My Application}\"",
      "\tWidth = ${4:800}",
      "\tHeight = ${5:600}",
      "\tCenter",
      "\t",
      "\tCREATE ${6:Label1} AS RLabel",
      "\t\tCaption = \"Welcome to RapidR!\"",
      "\t\tLeft = 20",
      "\t\tTop = 20",
      "\t\tAutoSize = TRUE",
      "\tEND CREATE",
      "\t",
      "\tCREATE ${7:Button1} AS RButton",
      "\t\tCaption = \"Click Me\"",
      "\t\tLeft = 20",
      "\t\tTop = 50",
      "\t\tWidth = 100",
      "\t\tHeight = 30",
      "\t\tOnClick = ${8:OnButtonClick}",
      "\tEND CREATE",
      "END CREATE",
      "",
      "SUB ${8:OnButtonClick}(Sender AS POBJECT)",
      "\tSHOWMESSAGE \"Hello from RapidR!\"",
      "END SUB",
      "",
      "${2:MainForm}.ShowModal",
      ""
    ],
    "description": "RapidR GUI application template"
  },
  "Database App Skeleton": {
    "prefix": "rpdb",
    "body": [
      "' ${1:Program Name}",
      "' RapidR Database Application",
      "$$APPTYPE CONSOLE",
      "",
      "CREATE ${2:db} AS RSQLite",
      "\tDatabase = \"${3:data.db}\"",
      "END CREATE",
      "",
      "${2:db}.Connect",
      "${2:db}.Query \"${4:SELECT * FROM table1}\"",
      "",
      "WHILE ${2:db}.FetchRow",
      "\tPRINT ${2:db}.FetchField(0)",
      "WEND",
      "",
      "${2:db}.Close",
      ""
    ],
    "description": "RapidR database application template"
  },
  "CREATE RNum": {
    "prefix": "createnum",
    "body": [
      "CREATE ${1:Num1} AS RNum",
      "END CREATE",
      "",
      "${1:Num1}.${2|Arange,Linspace,Zeros,Ones,FromList|}(${3:0, 10})"
    ],
    "description": "Create an RNum numeric array (NumPy-compatible)"
  },
  "CREATE RDataFrame": {
    "prefix": "createdf",
    "body": [
      "CREATE ${1:DF1} AS RDataFrame",
      "END CREATE",
      "",
      "${1:DF1}.LoadFromCSV \"${2:data.csv}\"",
      "PRINT ${1:DF1}.Head"
    ],
    "description": "Create an RDataFrame and load CSV (Pandas-compatible)"
  },
  "CREATE RPlot": {
    "prefix": "createplot",
    "body": [
      "CREATE ${1:Plot1} AS RPlot",
      "\tTitle = \"${2:My Plot}\"",
      "\tXLabel = \"${3:X}\"",
      "\tYLabel = \"${4:Y}\"",
      "\tGrid = TRUE",
      "END CREATE"
    ],
    "description": "Create an RPlot chart (Matplotlib-compatible)"
  },
  "Data Science App Skeleton": {
    "prefix": "rpdata",
    "body": [
      "' ${1:Program Name}",
      "' RapidR Data Science Application",
      "$$APPTYPE CONSOLE",
      "",
      "CREATE DF AS RDataFrame",
      "END CREATE",
      "",
      "CREATE Plot AS RPlot",
      "\tTitle = \"${2:Analysis}\"",
      "\tXLabel = \"${3:X}\"",
      "\tYLabel = \"${4:Y}\"",
      "\tGrid = TRUE",
      "END CREATE",
      "",
      "DF.LoadFromCSV \"${5:data.csv}\"",
      "PRINT DF.Describe",
      "",
      "' Plot the data",
      "DIM xData AS STRING",
      "DIM yData AS STRING",
      "xData = \"${6:1,2,3,4,5}\"",
      "yData = \"${7:10,20,30,40,50}\"",
      "Plot.Plot xData, yData, \"blue\", \"Series 1\"",
      "Plot.Legend",
      "Plot.SaveFig \"${8:output.png}\"",
      ""
    ],
    "description": "RapidR data science application template with DataFrame and Plot"
  },
  "RNum Arange": {
    "prefix": "numarange",
    "body": [
      "${1:Num1}.Arange ${2:0}, ${3:100}, ${4:1}"
    ],
    "description": "Create evenly spaced array values"
  },
  "RNum Linspace": {
    "prefix": "numlinspace",
    "body": [
      "${1:Num1}.Linspace ${2:0}, ${3:1}, ${4:50}"
    ],
    "description": "Create linearly spaced array values"
  },
  "RNum Random": {
    "prefix": "numrand",
    "body": [
      "${1:Num1}.Rand ${2:100}"
    ],
    "description": "Fill array with random values"
  },
  "DataFrame LoadCSV": {
    "prefix": "dfload",
    "body": [
      "${1:DF1}.LoadFromCSV \"${2:data.csv}\""
    ],
    "description": "Load CSV into DataFrame"
  },
  "DataFrame Filter": {
    "prefix": "dffilter",
    "body": [
      "${1:DF1}.Filter \"${2:column}\", \"${3|>,<,>=,<=,=,!=,contains|}\", \"${4:value}\""
    ],
    "description": "Filter DataFrame rows"
  },
  "DataFrame GroupBy": {
    "prefix": "dfgroupby",
    "body": [
      "${1:DF1}.GroupBy \"${2:groupColumn}\", \"${3:aggColumn}\", \"${4|mean,sum,count,min,max,first,last|}\""
    ],
    "description": "Group DataFrame by column and aggregate"
  },
  "DataFrame to Grid": {
    "prefix": "dftogrid",
    "body": [
      "${1:DF1}.ToGrid \"${2:Grid1}\""
    ],
    "description": "Populate RStringGrid from DataFrame"
  },
  "Plot Line": {
    "prefix": "plotline",
    "body": [
      "${1:Plot1}.Plot \"${2:x1,x2,x3}\", \"${3:y1,y2,y3}\", \"${4:blue}\", \"${5:Series 1}\""
    ],
    "description": "Draw a line plot"
  },
  "Plot Bar": {
    "prefix": "plotbar",
    "body": [
      "${1:Plot1}.Bar \"${2:A,B,C}\", \"${3:10,20,30}\", \"${4:steelblue}\", \"${5:Values}\""
    ],
    "description": "Draw a bar chart"
  },
  "Plot Scatter": {
    "prefix": "plotscatter",
    "body": [
      "${1:Plot1}.Scatter \"${2:x1,x2,x3}\", \"${3:y1,y2,y3}\", \"${4:red}\", \"${5:Points}\""
    ],
    "description": "Draw a scatter plot"
  },
  "Plot Histogram": {
    "prefix": "plothist",
    "body": [
      "${1:Plot1}.Hist \"${2:data values}\", ${3:10}, \"${4:steelblue}\", \"${5:Distribution}\""
    ],
    "description": "Draw a histogram"
  },
  "Plot Pie": {
    "prefix": "plotpie",
    "body": [
      "${1:Plot1}.Pie \"${2:A,B,C}\", \"${3:30,50,20}\""
    ],
    "description": "Draw a pie chart"
  },
  "Plot Save": {
    "prefix": "plotsave",
    "body": [
      "${1:Plot1}.Legend",
      "${1:Plot1}.SaveFig \"${2:output.png}\""
    ],
    "description": "Add legend and save plot to PNG"
  },

  "Web App Skeleton": {
    "prefix": "rpweb",
    "body": [
      "' ${1:Program Name}",
      "' RapidR Web Application (compiles to WASM)",
      "$$APPTYPE WEB",
      "",
      "CREATE ${2:MainForm} AS RForm",
      "\tCaption = \"${3:My Web App}\"",
      "\tWidth = ${4:800}",
      "\tHeight = ${5:600}",
      "\t",
      "\tCREATE ${6:Label1} AS RLabel",
      "\t\tCaption = \"Welcome to RapidR Web!\"",
      "\t\tLeft = 20",
      "\t\tTop = 20",
      "\tEND CREATE",
      "\t",
      "\tCREATE ${7:Button1} AS RButton",
      "\t\tCaption = \"Click Me\"",
      "\t\tLeft = 20",
      "\t\tTop = 60",
      "\t\tWidth = 120",
      "\t\tHeight = 35",
      "\t\tOnClick = ${8:OnButtonClick}",
      "\tEND CREATE",
      "END CREATE",
      "",
      "SUB ${8:OnButtonClick}(Sender AS POBJECT)",
      "\tSHOWMESSAGE \"Hello from the browser!\"",
      "END SUB",
      ""
    ],
    "description": "RapidR web application template (WASM)"
  },
  "CREATE WebView": {
    "prefix": "createwebview",
    "body": [
      "CREATE ${1:WebView1} AS RWebView",
      "\tLeft = ${2:10}",
      "\tTop = ${3:10}",
      "\tWidth = ${4:400}",
      "\tHeight = ${5:300}",
      "\tUrl = \"${6:https://example.com}\"",
      "END CREATE"
    ],
    "description": "Create an RWebView (iframe) — web only"
  },
  "CREATE DOM Element": {
    "prefix": "createdom",
    "body": [
      "CREATE ${1:Div1} AS RDOM",
      "\tTagName = \"${2:div}\"",
      "\tInnerHTML = \"${3:<p>Hello</p>}\"",
      "\tCSSClass = \"${4:my-class}\"",
      "END CREATE"
    ],
    "description": "Create an RDOM element — web only"
  },
  "CREATE JavaScript": {
    "prefix": "createjs",
    "body": [
      "CREATE ${1:JS1} AS RJavaScript",
      "END CREATE",
      "",
      "DIM ${2:result} AS STRING",
      "${2:result} = ${1:JS1}.Eval(\"${3:document.title}\")"
    ],
    "description": "Create an RJavaScript helper — web only"
  },
  "CREATE WebStorage": {
    "prefix": "createwebstorage",
    "body": [
      "CREATE ${1:Storage1} AS RWebStorage",
      "\tStorageType = \"${2|local,session|}\"",
      "END CREATE",
      "",
      "${1:Storage1}.Set \"${3:key}\", \"${4:value}\"",
      "DIM ${5:val} AS STRING",
      "${5:val} = ${1:Storage1}.Get(\"${3:key}\")"
    ],
    "description": "Create an RWebStorage — web only"
  },
  "CREATE WebAudio": {
    "prefix": "createwebaudio",
    "body": [
      "CREATE ${1:Audio1} AS RWebAudio",
      "\tSrc = \"${2:audio.mp3}\"",
      "\tControls = TRUE",
      "END CREATE"
    ],
    "description": "Create an RWebAudio player — web only"
  },
  "CREATE WebVideo": {
    "prefix": "createwebvideo",
    "body": [
      "CREATE ${1:Video1} AS RWebVideo",
      "\tSrc = \"${2:video.mp4}\"",
      "\tWidth = ${3:640}",
      "\tHeight = ${4:360}",
      "\tControls = TRUE",
      "END CREATE"
    ],
    "description": "Create an RWebVideo player — web only"
  },
  "CREATE WebNotification": {
    "prefix": "createnotification",
    "body": [
      "CREATE ${1:Notify1} AS RWebNotification",
      "\tTitle = \"${2:Alert}\"",
      "\tBody = \"${3:Something happened!}\"",
      "END CREATE",
      "",
      "${1:Notify1}.RequestPermission",
      "${1:Notify1}.Show"
    ],
    "description": "Create an RWebNotification — web only"
  },
  "CREATE Router": {
    "prefix": "createrouter",
    "body": [
      "CREATE ${1:Router1} AS RRouter",
      "\tOnRouteChange = ${2:HandleRoute}",
      "END CREATE",
      "",
      "SUB ${2:HandleRoute}(Sender AS POBJECT)",
      "\t' Handle route change",
      "END SUB"
    ],
    "description": "Create an RRouter for SPA navigation — web only"
  },
  "CREATE JSON": {
    "prefix": "createjson",
    "body": [
      "DIM ${1:Json1} AS RJSON",
      "CREATE ${1:Json1} AS RJSON",
      "END CREATE",
      "${1:Json1}.Parse(\"${2:{}}\")"
    ],
    "description": "Create an RJSON component for JSON parsing and generation"
  },
  "CREATE ColorDialog": {
    "prefix": "createcolordialog",
    "body": [
      "CREATE ${1:ColorDlg1} AS RColorDialog",
      "END CREATE",
      "",
      "IF ${1:ColorDlg1}.Execute() THEN",
      "\tDIM ${2:c} AS INTEGER",
      "\t${2:c} = ${1:ColorDlg1}.Color",
      "END IF"
    ],
    "description": "Create an RColorDialog and read the chosen colour"
  },
  "CREATE FontDialog": {
    "prefix": "createfontdialog",
    "body": [
      "CREATE ${1:FontDlg1} AS RFontDialog",
      "END CREATE",
      "",
      "IF ${1:FontDlg1}.Execute() THEN",
      "\tDIM ${2:fname} AS STRING",
      "\tDIM ${3:fsize} AS INTEGER",
      "\t${2:fname} = ${1:FontDlg1}.FontName",
      "\t${3:fsize} = ${1:FontDlg1}.FontSize",
      "END IF"
    ],
    "description": "Create an RFontDialog and read the chosen font"
  },
  "Canvas SetFont + DrawText": {
    "prefix": "canvassetfont",
    "body": [
      "${1:Canvas1}.SetFont \"${2:Segoe UI}\", ${3:14}",
      "${1:Canvas1}.DrawText ${4:x}, ${5:y}, \"${6:Hello}\", RGB(${7:0}, ${8:0}, ${9:0})"
    ],
    "description": "Set a canvas font and draw text in it (web + desktop runtimes)"
  }
}
