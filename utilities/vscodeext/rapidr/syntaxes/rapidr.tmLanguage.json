{
  "scopeName": "source.rapidr",
  "name": "RapidR",
  "fileTypes": [
    "rr",
    "bas",
    "inc"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants-language"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-type"
    },
    {
      "include": "#keywords-operator"
    },
    {
      "include": "#keywords-other"
    },
    {
      "include": "#rust-block"
    },
    {
      "include": "#component-types"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.rapidr",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.rapidr",
          "match": "(?i)\\bREM\\b.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.rapidr",
          "match": "(?i)^\\s*(\\$(?:INCLUDE|DEFINE|UNDEF|IFDEF|IFNDEF|ELSE|ENDIF|MACRO|APPTYPE|OPTIMIZE|ESCAPECHARS|TYPECHECK|OPTION|RESOURCE|THEME))\\b(.*)?$",
          "captures": {
            "1": {
              "name": "keyword.control.directive.rapidr"
            },
            "2": {
              "name": "string.unquoted.directive-value.rapidr"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rapidr",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rapidr",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.rapidr",
          "match": "(?i)&H[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.octal.rapidr",
          "match": "(?i)&O[0-7]+"
        },
        {
          "name": "constant.numeric.binary.rapidr",
          "match": "(?i)&B[01]+"
        },
        {
          "name": "constant.numeric.float.rapidr",
          "match": "\\b\\d+\\.\\d*(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.scientific.rapidr",
          "match": "\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.rapidr",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants-language": {
      "patterns": [
        {
          "name": "constant.language.boolean.rapidr",
          "match": "(?i)\\b(TRUE|FALSE)\\b"
        },
        {
          "name": "constant.language.null.rapidr",
          "match": "(?i)\\b(NOTHING|NULL)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.rapidr",
          "match": "(?i)\\b(DIM|CONST|TYPE|STRUCT|DECLARE|IMPORT|AS|LIB|ALIAS|EXTENDS|PROPERTY|SET|BYVAL|BYREF|CONSTRUCTOR|EVENT|BIND|PRIVATE|PUBLIC|PROTECTED|GLOBAL|PRESERVE|STATIC)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.rapidr",
          "match": "(?i)\\b(IF|THEN|ELSE|ELSEIF|END\\s+(?:IF|SUB|SUBI|FUNCTION|FUNCTIONI|TYPE|STRUCT|CREATE|WITH|SELECT|CONSTRUCTOR|EVENT|PROPERTY)|END)\\b"
        },
        {
          "name": "keyword.control.loop.rapidr",
          "match": "(?i)\\b(FOR|TO|STEP|NEXT|WHILE|WEND|DO|LOOP|UNTIL)\\b"
        },
        {
          "name": "keyword.control.flow.rapidr",
          "match": "(?i)\\b(SELECT|CASE|EXIT|RETURN|GOTO|GOSUB|CALL|ON\\s+ERROR)\\b"
        },
        {
          "name": "keyword.control.block.rapidr",
          "match": "(?i)\\b(SUB|SUBI|FUNCTION|FUNCTIONI|CREATE|WITH)\\b"
        }
      ]
    },
    "keywords-type": {
      "patterns": [
        {
          "name": "storage.type.rapidr",
          "match": "(?i)\\b(INTEGER|STRING|DOUBLE|SINGLE|BYTE|WORD|DWORD|LONG|SHORT|INT64|CURRENCY|VARIANT|QOBJECT|ROBJECT)\\b"
        }
      ]
    },
    "keywords-operator": {
      "patterns": [
        {
          "name": "keyword.operator.logical.rapidr",
          "match": "(?i)\\b(AND|OR|NOT|XOR|IS)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.rapidr",
          "match": "(?i)\\b(MOD)\\b"
        }
      ]
    },
    "keywords-other": {
      "patterns": [
        {
          "name": "keyword.other.rapidr",
          "match": "(?i)\\b(PRINT|INPUT|WRITE|SEEK|DEFSTR|DEFINT|DEFBYTE|DEFWORD|DEFDWORD|DEFLONG|DEFLNG|DEFSHORT|DEFSNG|DEFDBL|DEFCUR|DATA|DEC|INC|LINE\\s+INPUT|READ|RESTORE)\\b"
        },
        {
          "name": "variable.language.rapidr",
          "match": "(?i)\\b(SUPER|THIS)\\b"
        }
      ]
    },
    "rust-block": {
      "patterns": [
        {
          "name": "meta.embedded.block.rust.rapidr",
          "begin": "(?i)^\\s*(RUSTSTART)\\b",
          "end": "(?i)^\\s*(RUSTEND)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.ruststart.rapidr"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.rustend.rapidr"
            }
          },
          "contentName": "meta.embedded.block.rust"
        }
      ]
    },
    "component-types": {
      "patterns": [
        {
          "name": "entity.name.type.component.rapidr",
          "match": "(?i)\\b[QR](?:WEBNOTIFICATION|D3DMESHBUILDER|DATETIMEPICKER|NOTIFYICONDATA|WEBGEOLOCATION|DESIGNSURFACE|MEMORYSTREAM|SERVERSOCKET|COLORDIALOG|DXIMAGELIST|FILELISTBOX|PROGRESSBAR|RADIOBUTTON|CODEEDITOR|D3DTEXTURE|DIGDISPLAY|DXJOYSTICK|FILEDIALOG|FILESTREAM|FONTDIALOG|GLASSFRAME|JAVASCRIPT|OPENDIALOG|SAVEDIALOG|STRINGGRID|STRINGLIST|TABCONTROL|WEBSTORAGE|D3DVECTOR|D3DVISUAL|DATAFRAME|IMAGELIST|POPUPMENU|SCROLLBAR|SCROLLBOX|STATUSBAR|CHECKBOX|COMBOBOX|D3DFRAME|D3DLIGHT|DOWNLOAD|DXSCREEN|GROUPBOX|LISTVIEW|MAINMENU|MENUITEM|PROGRESS|REGISTRY|RICHEDIT|SPLITTER|TRACKBAR|TREEVIEW|WEBAUDIO|WEBVIDEO|CDAUDIO|COMPORT|COOLBTN|D3DFACE|D3DMESH|D3DWRAP|DIRTREE|DXSOUND|DXTIMER|FORMMDI|LISTBOX|OVALBTN|PRINTER|TOOLBAR|WEBVIEW|BITMAP|BUTTON|CANVAS|HEADER|ROUTER|SOCKET|SQLITE|UPDOWN|BEVEL|IMAGE|LABEL|MYSQL|PANEL|TIMER|VIDEO|EDIT|FONT|FORM|HTTP|JSON|MEMO|MIDI|PLOT|RECT|WAVE|CGI|DOM|NUM|AI|AIPROJECTTOOLS|COMMANDPALETTE|CSV|D3DANIMATION|D3DANIMATIONSET|DATASOURCE|DBGRID|DIFFVIEW|DIRLISTVIEW|DOCKFORM|DOCKMANAGER|GAUGE|HTTPSERVER|LANGUAGESERVICE|MARKDOWNVIEW|OUTPUTCONSOLE|PROGRAMSESSION|PROJECT|PROJECTTREE|PROPERTYINSPECTOR|SECRETS|TOOLBOX)\\b"
        },
        {
          "name": "support.class.global.rapidr",
          "match": "(?i)\\b(Application|Clipboard|FileRec|Mouse|Screen)\\b"
        },
        {
          "name": "entity.name.type.item.rapidr",
          "match": "(?i)\\b(HeaderSection|ListColumn|ListItem|ParaAttributes|StatusPanel|TreeNode)\\b"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.string.rapidr",
          "match": "(?i)\\b(CHR\\$?|ASC|LEFT\\$?|RIGHT\\$?|MID\\$?|LEN|INSTR|RINSTR|UCASE\\$?|LCASE\\$?|LTRIM\\$?|RTRIM\\$?|TRIM\\$?|SPACE\\$?|STRING\\$?|REPLACE|REPLACESUBSTR|INSERT|REVERSE|FIELD|TALLY|STRF|STR\\$?|ISNUMERIC|TRN\\$?|TR\\$?)\\b"
        },
        {
          "name": "support.function.math.rapidr",
          "match": "(?i)\\b(ABS|ATN|COS|SIN|TAN|EXP|LOG|SQR|RND|CEIL|ACOS|ASIN|FLOOR|FIX|FRAC|ROUND|SGN|CINT|CLNG|INT|FLOAT|VAL|HEXTODEC|CONVBASE|RANDOMIZE|CBOOL|CDBL|CSNG|INV|PI|SHL|SHR)\\b"
        },
        {
          "name": "support.function.io.rapidr",
          "match": "(?i)\\b(OPEN|CLOSE|PRINT|INPUT|DIR\\$?|CURDIR\\$?|DIREXISTS|CHDIR|MKDIR|RMDIR|KILL|RENAME|FILEEXISTS|CHDRIVE|CSRLIN|EXTRACTRESOURCE|FILELEN|FREEFILE|INKEY\\$?|ISCONSOLE|LOCATE|LOF|PCOPY|POS|RESOURCE|RESOURCECOUNT|SETCONSOLETITLE)\\b"
        },
        {
          "name": "support.function.system.rapidr",
          "match": "(?i)\\b(SHELL|SHELLWAIT|RUN|END|SLEEP|TIMER|DATE\\$?|TIME\\$?|COMMAND\\$?|ENVIRON\\$?|DOEVENTS|SOUND|PLAYWAV|INP|INPW|KILLMESSAGE|LFLUSH|LIBRARYINST|LPRINT|MOUSEX|MOUSEY|OUT|OUTW|POSTMESSAGE|SENDMESSAGE|UNLOADLIBRARY)\\b"
        },
        {
          "name": "support.function.gui.rapidr",
          "match": "(?i)\\b(SHOWMESSAGE|MESSAGEBOX|MESSAGEDLG|RGB|CALLBACK|CALLFUNC|VARPTR\\$?|VARTYPE|IIF|BEEP|MSGBOX|PLAYSOUND)\\b"
        },
        {
          "name": "support.function.conversion.rapidr",
          "match": "(?i)\\b(HEX\\$?|BIN\\$?|OCT\\$?|FORMAT\\$?)\\b"
        },
        {
          "name": "support.function.array.rapidr",
          "match": "(?i)\\b(LBOUND|UBOUND|QUICKSORT|INITARRAY|SWAP|REDIM|MEMCMP|MEMCPY|MEMSET|POKE|SIZEOF|UDTPTR)\\b"
        },
        {
          "name": "support.function.delete.rapidr",
          "match": "(?i)\\b(DELETE)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.rapidr",
          "match": "(?i)\\b(CODEPTR|CONVBASEX|GETCAPTURE|GETFOCUS|MICROTIMER|NVIEWLIBPRESENT|PARAMSTRCOUNT|PARAMSTR\\$?|PARAMVAL|PARAMVALCOUNT|RELEASECAPTURE|RTLMOVEMEMORY|SETCAPTURE|WSTRING|WSTRINGTOASCII)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.rapidr",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*[\\$%#&!]?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.rapidr",
          "match": "<>|<=|>=|<|>|="
        },
        {
          "name": "keyword.operator.arithmetic.rapidr",
          "match": "[+\\-*/\\\\^&]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.parenthesis.open.rapidr",
          "match": "\\("
        },
        {
          "name": "punctuation.parenthesis.close.rapidr",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.rapidr",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.rapidr",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.semicolon.rapidr",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.dot.rapidr",
          "match": "\\."
        }
      ]
    }
  }
}
