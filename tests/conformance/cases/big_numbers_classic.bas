' A RapidQ program (no INT64, UINT64 or UINT32): big literals read as
' RC.EXE reads them (probe 2026-11-05) — beyond 32 bits a whole number
' prints -2147483648, a decimal beyond 64 bits is a DOUBLE (RapidR read it
' as text before), &H keeps its low 32 bits.
PRINT 18446744073709551615
PRINT STR$(18446744073709551615)
DIM x AS DOUBLE
x = 18446744073709551615
PRINT STR$(x + 1)
PRINT 3000000000
PRINT STR$(3000000000)
PRINT 3000000000 \ 2
PRINT HEX$(&H123456789)
PRINT 9007199254740993
PRINT STR$(9007199254740993)
DIM l AS LONG
l = 9007199254740993
PRINT l
PRINT &HFFFFFFFF
PRINT 2147483647 * 2
