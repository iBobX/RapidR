' A single-line IF with its ELSE, in every form RapidQ's compiler takes
' (the .expected is RC.EXE's own output, docs/rapidq-ground-truth.md):
'  - a PRINT right before an ELSE ends without a new line: the THEN part's,
'    the ELSE part's before a second ELSE, a nested IF's, with ";", "," or
'    nothing printed;
'  - the IF waiting for its ELSE is the innermost: a nested IF in the THEN
'    part takes its place, so an outer ELSE after the nested IF's own is a
'    second ELSE of the nested one, and the outer IF's false part skips the
'    line;
'  - a second ELSE is taken and the statement after it never runs (the ones
'    after a ":" do run); a third is refused (if_third_else).
DIM x AS INTEGER
PRINT "-- p01"
IF 1 THEN PRINT "a" ELSE PRINT "b"
PRINT "c"
IF 0 THEN PRINT "d" ELSE PRINT "e"
PRINT "f"
PRINT "-- p02"
IF 1 THEN PRINT "a"; ELSE PRINT "b"
PRINT "c"
IF 0 THEN PRINT "d"; ELSE PRINT "e"
PRINT "f"
PRINT "-- p03"
IF 1 THEN PRINT "a", ELSE PRINT "b"
PRINT "c"
IF 0 THEN PRINT "d", ELSE PRINT "e"
PRINT "f"
PRINT "-- p04"
IF 1 THEN PRINT "a": PRINT "b" ELSE PRINT "c"
PRINT "d"
IF 0 THEN PRINT "e": PRINT "f" ELSE PRINT "g"
PRINT "h"
PRINT "-- p05"
IF 1 THEN IF 1 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c"
PRINT "d"
IF 1 THEN IF 0 THEN PRINT "e" ELSE PRINT "f" ELSE PRINT "g"
PRINT "h"
IF 0 THEN IF 1 THEN PRINT "i" ELSE PRINT "j" ELSE PRINT "k"
PRINT "l"
PRINT "-- p06"
IF 0 THEN PRINT "a" ELSE IF 1 THEN PRINT "b" ELSE PRINT "c"
PRINT "d"
IF 0 THEN PRINT "e" ELSE IF 0 THEN PRINT "f" ELSE PRINT "g"
PRINT "h"
IF 1 THEN PRINT "i" ELSE IF 1 THEN PRINT "j" ELSE PRINT "k"
PRINT "l"
PRINT "-- p07"
IF 1 THEN PRINT ELSE PRINT "w"
PRINT "x"
IF 0 THEN PRINT ELSE PRINT "y"
PRINT "z"
PRINT "-- p08"
IF 1 THEN PRINT "a", 1+1 ELSE PRINT "b"
PRINT "c"
IF 1 THEN PRINT 7 ELSE PRINT 8
PRINT "d"
IF 1 THEN PRINT "e" + "f" ELSE PRINT "g"
PRINT "h"
PRINT "-- p09"
IF 0 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c"
PRINT "d"
IF 1 THEN PRINT "e" ELSE PRINT "f" ELSE PRINT "g"
PRINT "h"
PRINT "-- p10"
IF 1 THEN PRINT "a"
PRINT "b"
IF 1 THEN PRINT "c": PRINT "d"
PRINT "e"
IF 0 THEN PRINT "f": PRINT "g"
PRINT "h"
PRINT "-- p11"
IF 1 THEN x = 1 : PRINT "a" ELSE x = 2
PRINT "b"
IF 1 THEN PRINT "c" : x = 3 ELSE PRINT "d"
PRINT "e"
IF 0 THEN PRINT "f" ELSE x = 4 : PRINT "g"
PRINT "h"
PRINT "-- p13"
IF 1 THEN PRINT "a"; : PRINT "b" ELSE PRINT "c"
PRINT "d"
IF 1 THEN PRINT "e" : PRINT "f"; ELSE PRINT "g"
PRINT "h"
PRINT "-- p14"
IF 1 THEN
  PRINT "a"
ELSE
  PRINT "b"
END IF
PRINT "c"
IF 0 THEN PRINT "d" ELSE PRINT "e": PRINT "f"
PRINT "g"
PRINT "-- r03"
IF 0 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c" : PRINT "y"
PRINT "z"
IF 1 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c" : PRINT "y"
PRINT "z"
PRINT "-- r04"
IF 0 THEN IF 1 THEN PRINT "a" ELSE PRINT "b"
PRINT "z"
IF 1 THEN IF 0 THEN PRINT "a" ELSE PRINT "b"
PRINT "z"
IF 1 THEN IF 1 THEN PRINT "a" ELSE PRINT "b"
PRINT "z"
PRINT "-- r05"
IF 0 THEN PRINT "p" : IF 1 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c"
PRINT "z"
IF 1 THEN PRINT "p" : IF 0 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c"
PRINT "z"
IF 1 THEN PRINT "p" : IF 1 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c"
PRINT "z"
PRINT "-- r06"
IF 1 THEN PRINT "a" ELSE IF 1 THEN PRINT "b" ELSE PRINT "c" ELSE PRINT "d"
PRINT "z"
IF 0 THEN PRINT "a" ELSE IF 0 THEN PRINT "b" ELSE PRINT "c" ELSE PRINT "d"
PRINT "z"
IF 0 THEN PRINT "a" ELSE IF 1 THEN PRINT "b" ELSE PRINT "c" ELSE PRINT "d"
PRINT "z"
PRINT "-- r07"
IF 0 THEN x = 1 ELSE x = 2 ELSE x = 3
PRINT x
IF 1 THEN x = 4 ELSE x = 5 ELSE x = 6
PRINT x
x = 7
IF 0 THEN IF 1 THEN x = 8 ELSE x = 9 ELSE x = 10
PRINT x
PRINT "-- r08"
IF 0 THEN PRINT "a" ELSE PRINT "b"; ELSE PRINT "c"
PRINT "z"
IF 0 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c"; : PRINT "y"
PRINT "z"
PRINT "-- r09"
IF 0 THEN PRINT "a" ELSE IF 0 THEN IF 1 THEN PRINT "b" ELSE PRINT "c" ELSE PRINT "d"
PRINT "z"
IF 0 THEN PRINT "a" ELSE IF 1 THEN IF 0 THEN PRINT "b" ELSE PRINT "c" ELSE PRINT "d"
PRINT "z"
PRINT "-- s02"
IF 0 THEN PRINT "a" ELSE PRINT "b" ELSE IF 1 THEN PRINT "c" ELSE PRINT "d"
PRINT "z"
IF 1 THEN PRINT "a" ELSE PRINT "b" ELSE IF 1 THEN PRINT "c" ELSE PRINT "d"
PRINT "z"
PRINT "-- s05"
IF 0 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c" : PRINT "d" : PRINT "e"
PRINT "z"
IF 1 THEN PRINT "a" ELSE PRINT "b" ELSE PRINT "c" : PRINT "d" : PRINT "e"
PRINT "z"
PRINT "-- s06"
IF 1 THEN IF 0 THEN PRINT "a" ELSE PRINT "b" : PRINT "c" ELSE PRINT "d"
PRINT "z"
IF 0 THEN IF 1 THEN PRINT "a" ELSE PRINT "b" : PRINT "c" ELSE PRINT "d"
PRINT "z"
