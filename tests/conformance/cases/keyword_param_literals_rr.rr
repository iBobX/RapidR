' A parameter or a variable a keyword names (Print, Step, Type, Case,
' Bind, Open…) never changes a string literal with its text, and a
' button's Caption "Open" set after a SUB with a parameter Open stays
' "Open" (Database Studio's case). (RC.EXE refuses a parameter named Print
' where the SUB reads it; RapidR reads it: an extension.)
SUB ShowPrint(Print AS STRING)
  PRINT "Print: sub [" + Print + "] Print " + "Print"
END SUB
PRINT "Print"
PRINT "Print it, " + "Print" + "!"; " "; "print"; " "; "PRINT"
FUNCTION GetPrint(Print AS STRING) AS STRING
  GetPrint = "Print" + "=" + Print
END FUNCTION
PRINT "Print"
SUB UnusedPrint(Print AS STRING)
  PRINT Print
END SUB
PRINT "Print" + "Print"
FUNCTION UnusedFPrint(Print AS STRING) AS STRING
  UnusedFPrint = Print
END FUNCTION
s$ = "Print": PRINT s$; " "; "xPrintx"
ShowPrint "a"
PRINT GetPrint("b")
SUB ShowStep(Step AS STRING)
  PRINT "Step: sub [" + Step + "] Step " + "Step"
END SUB
PRINT "Step"
PRINT "Step it, " + "Step" + "!"; " "; "step"; " "; "STEP"
FUNCTION GetStep(Step AS STRING) AS STRING
  GetStep = "Step" + "=" + Step
END FUNCTION
PRINT "Step"
SUB UnusedStep(Step AS STRING)
  PRINT Step
END SUB
PRINT "Step" + "Step"
FUNCTION UnusedFStep(Step AS STRING) AS STRING
  UnusedFStep = Step
END FUNCTION
s$ = "Step": PRINT s$; " "; "xStepx"
ShowStep "a"
PRINT GetStep("b")
