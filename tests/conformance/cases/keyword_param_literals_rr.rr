Step = 2
PRINT "Step"; " "; Step; " "; "step"
DEFSTR return
return = "r"
PRINT return + "return" + "RETURN"
SUB OpenFile(Open AS STRING)
  PRINT "opening " + Open
END SUB
CREATE Win AS RForm
  CREATE OpenButton AS RButton
    Caption = "Open"
  END CREATE
END CREATE
OpenButton.Caption = "Open"
PRINT OpenButton.Caption
OpenFile "a.db"
