' RArchive (RapidR's) treats an archive as untrusted input, the same on
' every runtime: a zip-slip zip (names with .., an absolute path) lists but
' ExtractAll writes nothing; a tar's link is never extracted; a zip bomb
' stops at MaxRatio and at MaxSize with a clear error; encrypted entries
' and an encrypted 7z are refused; a RAR is refused in plain words; a
' damaged archive is an error, never a crash.
$RESOURCE SLIP_FILE AS "archive_files/archive-evil-slip.zip"
$RESOURCE LINK_FILE AS "archive_files/archive-evil-link.tar"
$RESOURCE BOMB_FILE AS "archive_files/archive-bomb.zip"
$RESOURCE LOCKED_ZIP AS "archive_files/archive-encrypted.zip"
$RESOURCE LOCKED_7Z AS "archive_files/archive-encrypted-list.7z"
$RESOURCE RAR_FILE AS "archive_files/archive-not-open.rar"
$RESOURCE ZIP_FILE AS "archive_files/archive-games.zip"

DIM A AS RArchive
DIM i AS INTEGER

PRINT "zip-slip:"; A.Open(SLIP_FILE); " "; A.Count
FOR i = 0 TO A.Count - 1
    PRINT "  "; A.Name(i)
NEXT
PRINT "  ExtractAll="; A.ExtractAll("archive-guard-out")
PRINT "  "; A.Error
PRINT "  written:"; FILEEXISTS("archive-guard-out/ok.txt"); FILEEXISTS("evil.txt"); FILEEXISTS("up.txt")
' (one good entry extracted by its own name is fine: the program names the file)
PRINT "  ok.txt:"; A.Extract("ok.txt");

PRINT "link:"; A.Open(LINK_FILE); " "; A.Count
FOR i = 0 TO A.Count - 1
    PRINT "  "; A.Name(i)
NEXT
PRINT "  ["; A.Extract("escape"); "] "; A.Error

PRINT "bomb:"; A.Open(BOMB_FILE); " "; A.Name(0); " says "; A.Size(0); " bytes in "; A.CompressedSize(0) < 40000
PRINT "  "; LEN(A.Extract(0)); " "; A.Error
A.MaxRatio = 0
A.MaxSize = 1000000
PRINT "  "; LEN(A.Extract(0)); " "; A.Error
A.MaxSize = 0
PRINT "  MaxSize 0 means the default:"; A.MaxSize > 1000000

PRINT "encrypted zip:"; A.Open(LOCKED_ZIP); " "; A.Name(0); " "; A.IsEncrypted(0)
PRINT "  ["; A.Extract(0); "] "; A.Error
PRINT "encrypted 7z:"; A.Open(LOCKED_7Z); " "; A.Error

PRINT "rar:"; A.FormatOf(RAR_FILE); " "; A.Open(RAR_FILE)
PRINT "  "; A.Error

' (a zip cut in half, and one with a byte changed in its data)
DIM S AS RMemoryStream, Z AS STRING
S.ExtractRes ZIP_FILE
Z = S.Text
PRINT "cut:"; A.OpenData(LEFT$(Z, 200)); " "; A.Error
Z = LEFT$(Z, 59) + CHR$(ASC(MID$(Z, 60, 1)) XOR 255) + MID$(Z, 61)
PRINT "changed:"; A.OpenData(Z); " "; A.Count; " ["; A.Extract("readme.txt") = ""; "] "; LEN(A.Error) > 0
PRINT "not an archive:"; A.OpenData("plain text"); " "; A.Error
PRINT "no file:"; A.Open("no-such-archive.zip"); " "; A.Error
