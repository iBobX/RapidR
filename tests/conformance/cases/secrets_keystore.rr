' xfail: web — a browser has no keychain: RSecrets' calls fail there (Available is False; Error says so)
' RSecrets (RapidR's): the OS keychain for programs, here the test keystore
' (the runner sets RAPIDR_AI_KEYSTORE=memory: the real keychain is never
' touched). Saved, read back, found, replaced, deleted; another service or
' name has nothing; refusals say why, never the value.
DIM Secrets AS RSecrets
PRINT Secrets.Available; " "; Secrets.Store
PRINT LEN(Secrets.Program) > 0
PRINT Secrets.Exists("MySQL", "office")
PRINT Secrets.Save("MySQL", "office", "s3cret-pw"); " ["; Secrets.Error; "]"
pw$ = Secrets.Read("MySQL", "office")
PRINT LEN(pw$); " "; pw$ = "s3cret-pw"
PRINT Secrets.Exists("MySQL", "office"); " "; Secrets.Exists("MySQL", "home"); " "; Secrets.Exists("Other", "office")
PRINT "["; Secrets.Read("MySQL", "home"); "] ["; Secrets.Error; "]"
PRINT Secrets.Save("MySQL", "office", "another-pw"); " "; Secrets.Read("MySQL", "office") = "another-pw"
PRINT Secrets.Delete("MySQL", "office"); " "; Secrets.Delete("MySQL", "office"); " "; Secrets.Exists("MySQL", "office")
PRINT Secrets.Save("", "office", "x"); " "; Secrets.Error
PRINT Secrets.Save("MySQL", "office", ""); " "; Secrets.Error
PRINT Secrets.Save("MySQL", "office", STRING$(1025, "x")); " "; Secrets.Error
PRINT Secrets.Exists("MySQL", "office"); " ["; Secrets.Error; "]"
