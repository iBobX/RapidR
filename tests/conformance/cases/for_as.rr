' FOR i AS INTEGER (a RapidR extension, docs/rai-mistake-ledger.md): the
' counter is declared where it isn't yet; a plain FOR is unchanged.
FOR i AS INTEGER = 1 TO 3: PRINT i: NEXT
' (again: i is that INTEGER now)
FOR i AS INTEGER = 4 TO 5
    PRINT i
NEXT i
PRINT "after:"; i
' (declared before with the same type: that variable)
DIM k AS LONG
FOR k AS LONG = 10 TO 0 STEP -5: PRINT k: NEXT
' (a fraction counts in a DOUBLE; INTEGER stores whole numbers)
FOR d AS DOUBLE = 0 TO 1 STEP 0.5: PRINT d * 2: NEXT
FOR n AS INTEGER = 1 TO 2.6: PRINT n: NEXT
' (in a SUB: a local of its own, the global i untouched)
SUB Count
    FOR i AS INTEGER = 7 TO 8
        PRINT "sub"; i
    NEXT
END SUB
Count
PRINT "global i:"; i
' (a plain FOR, as RapidQ writes it)
FOR j = 1 TO 2: PRINT "j"; j: NEXT
