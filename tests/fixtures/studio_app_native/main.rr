' hello_form.rr: a window with a text box, a button and a label; the
' button's OnClick event answers.
'
'   rapidr run hello_form.rr
'
' CREATE … END CREATE builds a form and what is on it (components inside
' are its children). Events are SUBs named by the component's OnClick,
' OnChange, … properties. Form.ShowModal shows the form and runs until
' it is closed.

DECLARE SUB Greet
DECLARE SUB NameChanged

DIM clicks AS INTEGER

CREATE Form AS RForm
    Caption = "Hello, RapidR"
    Width = 340
    Height = 170
    Center
    CREATE NameLabel AS RLabel
        Caption = "Your &name:"
        Left = 16: Top = 20: Width = 92
    END CREATE
    CREATE NameEdit AS REdit
        Text = "World"
        Left = 112: Top = 16: Width = 200
        OnChange = NameChanged
    END CREATE
    CREATE GreetButton AS RButton
        Caption = "&Greet"
        Left = 112: Top = 52: Width = 90
        Default = 1          ' Enter presses it
        OnClick = Greet
    END CREATE
    CREATE Answer AS RLabel
        Caption = "Type a name, then Greet."
        Left = 16: Top = 96: Width = 300
    END CREATE
END CREATE

SUB Greet
    clicks = clicks + 1
    Answer.Caption = "Hello, " + NameEdit.Text + "! (" + STR$(clicks) + ")"
END SUB

SUB NameChanged
    ' (the button only makes sense with a name)
    GreetButton.Enabled = LEN(NameEdit.Text) > 0
END SUB

NameEdit.SetFocus
Form.ShowModal
