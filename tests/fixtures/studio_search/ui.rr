' The window: how many times the server started, and a Stop button.
DECLARE SUB ShowCount

CREATE MainForm AS RForm
    Caption = "Counter"
    Width = 320: Height = 160
    CREATE CountLabel AS RLabel
        Left = 16: Top = 16: Width = 280
    END CREATE
    CREATE StopButton AS RButton
        Caption = "Stop": Left = 16: Top = 60
        OnClick = ShowCount
    END CREATE
END CREATE

SUB ShowCount
    StopServer
    CountLabel.Caption = "Started " + STR$(Counter) + " times"
END SUB
