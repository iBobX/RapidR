' main.rr: the classic-compatible project of RapidR Studio's inspector test
' (tests/studio_flows.mjs): a project kept classic-compatible marks, in the
' Properties pane, the members a classic program doesn't have.
$APPTYPE GUI

CREATE Form1 AS QFORM
    Caption = "Classic"
    Width = 320
    Height = 160
    Center
    CREATE Greeting AS QLABEL
        Caption = "Made for classic programs"
        Left = 16: Top = 16: Width = 280
    END CREATE
    CREATE GoBtn AS QBUTTON
        Caption = "&Go"
        Left = 16: Top = 56: Width = 96
    END CREATE
END CREATE

Form1.ShowModal
