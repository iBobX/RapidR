' greeter.rqw: a small program written the way RapidQ programs are (for
' RapidR Studio's File > Import RapidQ Project or File test): RapidQ's
' component names, an include from a folder of its own, $TYPECHECK.
$TYPECHECK ON
$APPTYPE GUI
$INCLUDE "RAPIDQ.INC"
$INCLUDE "include\shapes.inc"

DECLARE SUB SayHello (Sender AS QBUTTON)

CREATE Form AS QFORM
    Caption = "Greeter"
    Width = 320
    Height = 160
    Center
    CREATE NameEdit AS QEDIT
        Text = "World"
        Left = 16: Top = 16: Width = 180
    END CREATE
    CREATE HelloBtn AS QBUTTON
        Caption = "&Hello"
        Left = 208: Top = 14: Width = 88
        OnClick = SayHello
    END CREATE
    CREATE Answer AS QLABEL
        Caption = "Press Hello."
        Left = 16: Top = 56: Width = 280
    END CREATE
END CREATE

SUB SayHello (Sender AS QBUTTON)
    Answer.Caption = "Hello, " + NameEdit.Text + "! (" + Shape$(LEN(NameEdit.Text)) + ")"
    PRINT Answer.Caption
END SUB

Form.ShowModal
