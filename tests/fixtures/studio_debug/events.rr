' events.rr: one handler for each kind of event a program answers, each a
' place for a breakpoint (tests/studio_flows.mjs debug-events-*,
' tools/macos/debug_walk.py's events path): a click, a key, the list
' getting the focus, a resize, the close box (cancelled), a timer, the
' mouse moving, a handler that fires another (Grow widens the form: its
' OnResize runs inside), a run-time error in a handler.
$THEME rapidr
DECLARE SUB Clicked
DECLARE SUB Typed(Key AS BYTE)
DECLARE SUB ListFocused
DECLARE SUB Resized
DECLARE SUB Closing(Action AS INTEGER)
DECLARE SUB Ticked(Sender AS RTimer)
DECLARE SUB Moved(X AS INTEGER, Y AS INTEGER, Shift AS INTEGER)
DECLARE SUB Changed
DECLARE SUB Grow
DECLARE SUB Oops

DIM clicks AS INTEGER, keys AS INTEGER, focuses AS INTEGER, sizes AS INTEGER
DIM closes AS INTEGER, ticks AS INTEGER, moves AS INTEGER, changes AS INTEGER
DIM zero AS INTEGER

CREATE Form AS RForm
    Caption = "Events"
    Width = 360: Height = 230
    OnResize = Resized
    OnClose = Closing
    OnMouseMove = Moved
    CREATE Btn AS RButton
        Caption = "Click": Left = 16: Top = 16: Width = 90
        OnClick = Clicked
    END CREATE
    CREATE Box AS REdit
        Left = 120: Top = 16: Width = 200
        OnKeyPress = Typed
        OnChange = Changed
    END CREATE
    CREATE List AS RListBox
        Left = 16: Top = 56: Width = 120: Height = 60
        AddItems "One", "Two"
        OnEnter = ListFocused
    END CREATE
    CREATE GrowBtn AS RButton
        Caption = "Grow": Left = 150: Top = 56: Width = 90
        OnClick = Grow
    END CREATE
    CREATE OopsBtn AS RButton
        Caption = "Oops": Left = 150: Top = 92: Width = 90
        OnClick = Oops
    END CREATE
    CREATE Tick AS RTimer
        Interval = 1000
        OnTimer = Ticked
    END CREATE
END CREATE

SUB Clicked
    clicks = clicks + 1
END SUB

SUB Typed(Key AS BYTE)
    keys = keys + 1
END SUB

SUB ListFocused
    focuses = focuses + 1
END SUB

SUB Resized
    sizes = sizes + 1
END SUB

SUB Closing(Action AS INTEGER)
    closes = closes + 1
    Action = 0
END SUB

SUB Ticked(Sender AS RTimer)
    ticks = ticks + 1
END SUB

SUB Moved(X AS INTEGER, Y AS INTEGER, Shift AS INTEGER)
    moves = moves + 1
END SUB

SUB Changed
    changes = changes + 1
END SUB

SUB Grow
    Form.Width = Form.Width + 10
END SUB

SUB Oops
    PRINT 1 \ zero
END SUB

Form.ShowModal
