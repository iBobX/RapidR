' split.rr: a run-time error in a handler — Split divides by the edit's 0
' (tools/macos/debug_walk.py's error path: break on error, Continue, Stop)
$THEME rapidr
DECLARE SUB DoSplit

CREATE Form AS RForm
    Caption = "Share the bill"
    Width = 320: Height = 160
    Center
    CREATE People AS REdit
        Left = 16: Top = 16: Width = 100: Text = "0"
    END CREATE
    CREATE SplitBtn AS RButton
        Caption = "Split": Left = 130: Top = 14: Width = 80
        OnClick = DoSplit
    END CREATE
    CREATE Answer AS RLabel
        Left = 16: Top = 60: Width = 280
    END CREATE
END CREATE

SUB DoSplit
    Answer.Caption = "each gets " + STR$(100 \ VAL(People.Text))
END SUB

Form.ShowModal
