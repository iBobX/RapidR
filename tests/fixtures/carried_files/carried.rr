' carried.rr: a program whose files are in folders below its own — its
' Spanish in lang/es.po, its logo in art/logo.svg — for the tests that build
' it and run it somewhere else (tests/web_bundle_lang.mjs; lane T1b).
' The language is the first argument (on the web, the page's query: ?es-AR),
' Spanish when there is none.
$THEME rapidr

IF COMMAND$(1) <> "" THEN Application.Language = COMMAND$(1) ELSE Application.Language = "es"

CREATE Form AS RForm
    Width = 380: Height = 200
    Center
    Caption = TR$("Carried files")
    CREATE Logo AS RImage
        Left = 16: Top = 16: Width = 96: Height = 96
    END CREATE
    CREATE Greeting AS RLabel
        Left = 128: Top = 28: Width = 230: AutoSize = 0
        Caption = TR$("Hello, world!")
    END CREATE
    CREATE Info AS RLabel
        Left = 128: Top = 60: Width = 230: AutoSize = 0
    END CREATE
    CREATE Found AS RLabel
        Left = 128: Top = 92: Width = 230: AutoSize = 0
    END CREATE
END CREATE

Logo.Load "art/logo.svg"
Info.Caption = TR$("Language: {lang}", "lang", Application.Language)
IF FILEEXISTS("art/logo.svg") THEN Found.Caption = TR$("The logo is here") ELSE Found.Caption = TR$("No logo")
Form.ShowModal
