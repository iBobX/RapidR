    IF NOT FILEEXISTS("file22.txt") THEN PRINT "missing 22"
    IF NOT FILEEXISTS("file23.txt") THEN PRINT "missing 23"
    IF NOT FILEEXISTS("file24.txt") THEN PRINT "missing 24"
