' ui.rr: the program's three windows — the shelf, a new item, the options.

CREATE Form AS RForm
    Caption = "Shelf"
    Width = 360: Height = 260
    CREATE ShelfList AS RListBox
        Left = 12: Top = 12: Width = 220: Height = 196
    END CREATE
    CREATE AddBtn AS RButton
        Caption = "&Add..."
        Left = 244: Top = 12: Width = 96
    END CREATE
    CREATE OptionsBtn AS RButton
        Caption = "&Options..."
        Left = 244: Top = 48: Width = 96
    END CREATE
END CREATE

CREATE NewForm AS RForm
    Caption = "New Item"
    Width = 300: Height = 140
    CREATE NameLabel AS RLabel
        Caption = "&Name:"
        Left = 12: Top = 16: Width = 60
    END CREATE
    CREATE NameEdit AS REdit
        Left = 76: Top = 12: Width = 200
    END CREATE
    CREATE AddOkBtn AS RButton
        Caption = "Add"
        Left = 180: Top = 56: Width = 96
    END CREATE
END CREATE

CREATE CfgForm AS RForm
    Caption = "Options"
    Width = 300: Height = 140
    CREATE ShopLabel AS RLabel
        Caption = "&Shop:"
        Left = 12: Top = 16: Width = 60
    END CREATE
    CREATE ShopEdit AS REdit
        Left = 76: Top = 12: Width = 200
    END CREATE
    CREATE CfgOkBtn AS RButton
        Caption = "OK"
        Left = 180: Top = 56: Width = 96
    END CREATE
END CREATE
