' main.rr: RapidR Studio's workspace test project (tests/studio_flows.mjs):
' a form whose button calls a SUB of the module it includes — two files
' to split the documents area between, and the word Greeting in both for
' Find in Files.

$INCLUDE "greeting.inc"

CREATE Form AS QFORM
    Caption = "Greeting"
    Width = 320
    Height = 160
    CREATE Hello AS QBUTTON
        Caption = "&Hello"
        Left = 16: Top = 16: Width = 90
        OnClick = SayGreeting
    END CREATE
    CREATE Answer AS QLABEL
        Caption = ""
        Left = 16: Top = 56: Width = 280
    END CREATE
END CREATE

Form.ShowModal
