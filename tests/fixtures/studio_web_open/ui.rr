' The program's three windows.
CREATE MainForm AS RForm
  Caption = "Kiosk"
  Width = 320: Height = 200
  CREATE StartBtn AS RButton
    Caption = "Start": Left = 16: Top = 16
    OnClick = StartServer
  END CREATE
END CREATE

CREATE NewForm AS RForm
  Caption = "New site"
  Width = 280: Height = 160
END CREATE

CREATE CfgForm AS RForm
  Caption = "Settings"
  Width = 280: Height = 160
END CREATE
