.DS_Store
.vscode
*.bak
*_old.*
*.db
# examples/: only the programs and their data are tracked — not builds
# (`rapidr build` puts the executable beside the source), nor the files a
# program writes as it runs (the IDE's, an example's *.tmp.*)
examples/**
!examples/**/
!examples/**/*.rr
!examples/**/*.bas
!examples/**/*.md
!examples/**/*.csv
!examples/**/*.json
!examples/**/*.mid
!examples/**/*.wav
!examples/**/*.avi
!examples/**/*.dxg
!examples/**/*.x
examples/**/*_rust/
examples/**/*_web/
examples/**/*.tmp.*
examples/_ide_errors.json
examples/ide.config.json
utilities/vscodeext/rapidr/*.vsix
tests/node_modules
tests/.matrix
tests/.ide-matrix
tests/screenshots
tests/web-screenshots
tests/results
*.vsix
target
rapidr
# (the line above is the binary; the VS Code extension's folder has the same name)
!utilities/vscodeext/rapidr/
# (the old IDE built natively: examples/ide; RapidR Studio lives in ide/)
/examples/ide
*.compiled
*.interp
*.zip
tests/conformance/.work
.reference/
crates/rapidr-ui-proto/target
/dist
/.release-share
# (the notices every build writes beside its executable: docs/licensing.md)
THIRD-PARTY-NOTICES.txt
__pycache__/

# (tests/fixtures/dir_list_view.bas writes it where it runs)
dirlv/

# (the company's own papers, kept beside the code, never committed)
private/
