.DS_Store
.vscode
*.bak
*_old.*
*.db
# examples/: only the programs and their data are tracked — not builds
# (`rapidr build` puts the executable beside the source), nor the files a
# program writes as it runs (the IDE's, an example's *.tmp.*)
examples/**
!examples/**/
!examples/**/*.rr
!examples/**/*.bas
!examples/**/*.inc
!examples/**/*.md
!examples/**/*.csv
!examples/**/*.json
!examples/**/*.mid
!examples/**/*.wav
!examples/**/*.avi
!examples/**/*.dxg
!examples/**/*.x
# (pictures an example builds in with $RESOURCE: gui/icons/*.svg)
!examples/**/*.svg
# (translations: lang/es.po beside a program)
!examples/**/*.po
examples/**/*_rust/
examples/**/*_web/
examples/**/*.tmp.*
# (what the data examples write when run in their folder)
examples/data/big*.csv
examples/data/*_edited.*
examples/_ide_errors.json
examples/ide.config.json
utilities/vscodeext/rapidr/*.vsix
tests/node_modules
tests/.matrix
tests/.ide-matrix
tests/screenshots
tests/web-screenshots
tests/results
*.vsix
target
rapidr
# (the line above is the binary; the VS Code extension's folder has the same name)
!utilities/vscodeext/rapidr/
# (the old IDE built natively: examples/ide; RapidR Studio lives in ide/)
/examples/ide
*.compiled
*.interp
*.zip
tests/conformance/.work
.reference/
crates/rapidr-ui-proto/target
/dist
/.release-share
# (the notices every build writes beside its executable: docs/licensing.md)
THIRD-PARTY-NOTICES.txt
__pycache__/

# (tests/fixtures/dir_list_view.bas writes it where it runs)
dirlv/

# (the company's own papers, kept beside the code, never committed)
private/

# Claude handoff notes (local)
.remember/
design/brand/3D/intro3/

# (Chrome headless stderr from local test runs)
chrome_run*.log

# (RArchive: its samples and test archives, made by other tools, are tracked
# — a zip an example makes as it runs, my-notes.zip, is not)
!examples/data/snapshots.zip
!examples/data/snapshots.7z
!examples/data/hello.z80
!examples/data/hello.z80.gz
!crates/rapidr-archive/tests/fixtures/*.zip
!tests/conformance/cases/resource_files/archive-*.zip
