' The pixel benchmark: how long a whole 256 x 192 frame (49,152 pixels, an
' emulator's screen) takes to put into a bitmap and to draw twice as large.
' Run it on each runtime and compare:
'
'   rapidr run tools/bench/pixels.rr                 the interpreter (the VM)
'   rapidr build tools/bench/pixels.rr <folder>      native, then run the program
'   (the web: tests/web_pixels_bench.mjs)
'
' Milliseconds a frame, the average of several. The budget of the
' pixel-block methods is under 2 ms a frame on the interpreter (a frame is
' 20 ms at 50 a second); a Pset for every pixel is the way they replace.
$APPTYPE CONSOLE

CONST W = 256
CONST H = 192
CONST N = W * H

DIM Screen AS RBitmap, Big AS RBitmap
DIM Colours(N - 1) AS LONG, Indexes(N - 1) AS BYTE, Palette(15) AS LONG, Back(N - 1) AS LONG
DIM x AS INTEGER, y AS INTEGER, i AS INTEGER, k AS INTEGER, t AS DOUBLE

FUNCTION Ms (seconds AS DOUBLE, frames AS INTEGER) AS DOUBLE
    Result = INT(seconds * 1000000 / frames + 0.5) / 1000
END FUNCTION

SUB Report (name AS STRING, ms AS DOUBLE)
    PRINT LEFT$(name + SPACE$(46), 46); STR$(ms); " ms a frame"
END SUB

Screen.Width = W: Screen.Height = H
Big.Width = 2 * W: Big.Height = 2 * H
FOR i = 0 TO 15
    Palette(i) = RGB(i * 16, 255 - i * 16, (i * 37) AND 255)
NEXT
FOR i = 0 TO N - 1
    Indexes(i) = (i + i \ W) MOD 16
    Colours(i) = Palette(Indexes(i))
NEXT

PRINT "A " + STR$(W) + " x " + STR$(H) + " frame, " + STR$(N) + " pixels"

t = TIMER
FOR k = 1 TO 3
    FOR y = 0 TO H - 1
        FOR x = 0 TO W - 1
            Screen.Pset x, y, Colours(y * W + x)
        NEXT
    NEXT
NEXT
Report "Pset for every pixel (the slow way)", Ms(TIMER - t, 3)

t = TIMER
FOR k = 1 TO 300
    Screen.SetPixels Colours, W, H
NEXT
Report "SetPixels (colours)", Ms(TIMER - t, 300)

t = TIMER
FOR k = 1 TO 300
    Screen.SetPixels8 Indexes, Palette, W, H
NEXT
Report "SetPixels8 (palette indexes)", Ms(TIMER - t, 300)

t = TIMER
FOR k = 1 TO 300
    Screen.GetPixels Back, 0, 0, W, H
NEXT
Report "GetPixels", Ms(TIMER - t, 300)

t = TIMER
FOR k = 1 TO 300
    Big.StretchDraw 0, 0, 2 * W, 2 * H, Screen
NEXT
Report "StretchDraw 2x (to 512 x 384)", Ms(TIMER - t, 300)

t = TIMER
FOR k = 1 TO 300
    Screen.SetPixels8 Indexes, Palette, W, H
    Big.StretchDraw 0, 0, 2 * W, 2 * H, Screen
NEXT
Report "a whole frame: SetPixels8 + StretchDraw 2x", Ms(TIMER - t, 300)

' the answer is right: the last frame is what was put in
DIM same AS INTEGER
same = -1
FOR y = 0 TO H - 1 STEP 7
    FOR x = 0 TO W - 1 STEP 5
        IF Screen.Pixel(x, y) <> Colours(y * W + x) THEN same = 0
        IF Big.Pixel(2 * x, 2 * y) <> Colours(y * W + x) THEN same = 0
    NEXT
NEXT
IF same THEN PRINT "checked: the pixels are the ones put in" ELSE PRINT "WRONG PIXELS"
