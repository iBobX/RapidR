' vm_bench: a 10,000,000-iteration FOR loop adding integers, at the
' program's top level (globals).
$APPTYPE CONSOLE
DIM i AS INTEGER
DIM s AS INTEGER
s = 0
FOR i = 1 TO 10000000
  s = s + i
NEXT
PRINT s

' (under the debugger, vm_bench sets a breakpoint here: a line that never
' runs, so the VM watches every statement and never stops)
SUB NeverCalled
  PRINT "never"
END SUB
