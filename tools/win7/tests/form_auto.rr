' form_auto.rr: the Windows 7 smoke test for windows. A form with a label,
' a text box and a button; it closes itself after TIMEOUT seconds so a test
' run needs no one (click Greet meanwhile to see events work).
'
'   rapidr run form_auto.rr

DECLARE SUB Greet
DECLARE SUB Tick

CONST TIMEOUT = 20
DIM secs AS INTEGER
secs = TIMEOUT

CREATE Form AS RForm
    Caption = "RapidR on Windows 7"
    Width = 360
    Height = 190
    Center
    CREATE NameLabel AS RLabel
        Caption = "Your &name:"
        Left = 16: Top = 20: Width = 92
    END CREATE
    CREATE NameEdit AS REdit
        Text = "Windows 7"
        Left = 112: Top = 16: Width = 220
    END CREATE
    CREATE GreetButton AS RButton
        Caption = "&Greet"
        Left = 112: Top = 52: Width = 90
        OnClick = Greet
    END CREATE
    CREATE Answer AS RLabel
        Caption = "Click Greet."
        Left = 16: Top = 96: Width = 330
    END CREATE
    CREATE Countdown AS RLabel
        Caption = ""
        Left = 16: Top = 124: Width = 330
    END CREATE
    CREATE Clock AS RTimer
        Interval = 1000
        OnTimer = Tick
    END CREATE
END CREATE

SUB Greet
    Answer.Caption = "Hello, " + NameEdit.Text + "!"
END SUB

SUB Tick
    secs = secs - 1
    Countdown.Caption = "Closing in " + STR$(secs) + " s"
    IF secs <= 0 THEN Form.Close
END SUB

Form.ShowModal
