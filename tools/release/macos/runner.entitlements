<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The interpreted runners (rapidrintr-runner*) under the hardened runtime
     (signed releases only): their JIT compiles a program's hot code into
     MAP_JIT memory (docs/jit-design.md §7). allow-jit only — never
     allow-unsigned-executable-memory; without it the interpreter runs. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
