<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The rapidr CLI under the hardened runtime (signed releases only): the
     programs it runs load the user's own libraries (`DECLARE … LIB`, RFFI),
     which aren't signed by RapidR's Team ID; and its JIT compiles their hot
     code into MAP_JIT memory (docs/jit-design.md §7: allow-jit, never
     allow-unsigned-executable-memory — without it the interpreter runs). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
