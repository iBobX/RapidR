@@ -992,6 +1007,8 @@ SUB McpDecide(Choice AS INTEGER)
   NEXT
   McpWaitCount = McpWaitCount - 1
   IF Choice = 2 AND INSTR(McpGrants, "|" + kind + "|") = 0 THEN McpGrants = McpGrants + "|" + kind + "|"
+  ' (mcpapp.inc: using the program allowed — for the rest of this run)
