APP-EYES-HANDS: the ide/mcp.inc part of Studio's app_* tools (for the lead to apply).

ide/mcp.inc belonged to the design-guide lane while this lane ran, so these
lines wait here: everything else (ide/mcpapp.inc, the runtime, the session
protocol, tests/app_eyes.mjs) is committed. Each change is marked
"mcpapp.inc" in a comment. Apply from the repository's root:

    git apply tools/patches/app-eyes-mcp-inc.patch

(if the design-guide lane changed the same lines, apply by hand: 9 small
hunks — the include after the globals, the tools listed (McpAppTools),
McpKindOf's drive kind, McpDecision's once-per-run grant, McpDecide's
grant, McpShowAsk's question, McpRun's case, SetUpMcp's McpAppSetUp, and
two sentences: the AI app's instructions and what Settings says AI apps
can see). Then: node tests/app_eyes.mjs (all four modes) and delete this
file.

diff --git a/ide/mcp.inc b/ide/mcp.inc
index d4ec9580..616abec6 100644
--- a/ide/mcp.inc
+++ b/ide/mcp.inc
@@ -168,6 +168,11 @@ DIM McpRevCount AS INTEGER
 DIM McpRevAt AS INTEGER
 DIM McpRevDecided AS INTEGER
 
+' (mcpapp.inc: the eyes and hands on the program Studio runs — app_layout,
+' app_screenshot, app_click, app_type, app_key, app_drag, app_scroll,
+' app_wait)
+$INCLUDE "mcpapp.inc"
+
 ' ---- the AI Apps pane: who is connected, what they do, what waits for you -------
 CREATE McpPanel AS RPanel
   BevelOuter = 0
@@ -360,6 +365,8 @@ FUNCTION McpKindOf(Tool AS STRING) AS STRING
   SELECT CASE Tool
     CASE "propose_edit", "write_file", "create_project", "open_project", "set_property": Result = "change"
     CASE "run_program", "debug": Result = "run"
+    ' (mcpapp.inc: looking at or using the running program — asked once per run)
+    CASE "app_layout", "app_screenshot", "app_click", "app_type", "app_key", "app_drag", "app_scroll": Result = "drive"
     CASE "ask_rai": Result = "rai"
     CASE ELSE: Result = "read"
   END SELECT
@@ -421,6 +428,8 @@ FUNCTION McpDecision(Kind AS STRING) AS STRING
   ' (Allow for This Session: that kind until Studio closes, the server
   ' stops or another project opens)
   IF Result = "ask" AND INSTR(McpGrants, "|" + Kind + "|") > 0 THEN Result = "allow"
+  ' (mcpapp.inc: using the program, allowed once — the rest of this run)
+  IF Result = "ask" AND Kind = "drive" AND RunStarted <> 0 AND McpAppRunAllowed = RunStarted THEN Result = "allow"
 END FUNCTION
 
 ' (the mode of the project open now: its own, kept, else Ask before changes)
@@ -556,10 +565,12 @@ SUB SetUpMcp
   Mcp.OnToolCall = McpToolCalled
   Mcp.OnConnect = McpClientIn
   Mcp.OnDisconnect = McpClientOut
+  ' (mcpapp.inc: the running program's answers)
+  McpAppSetUp
   Mcp.ServerName = "rapidr-studio"
   Mcp.ServerTitle = "RapidR Studio"
   Mcp.ServerVersion = Lang.Version
-  Mcp.Instructions = "RapidR Studio, the IDE of RapidR (a modern BASIC), with the user watching every call. Start with studio_status. Read the project with list_files and read_file; check code with check_code before proposing a change; change files only with propose_edit (small edits) or write_file (new files) — the user may be asked to allow each change; run the program with run_program and read what it printed with read_output. rapidr_describe and search_manual answer questions about RapidR. ask_rai asks RapidR's own assistant. Paths are relative to the project's folder."
+  Mcp.Instructions = "RapidR Studio, the IDE of RapidR (a modern BASIC), with the user watching every call. Start with studio_status. Read the project with list_files and read_file; check code with check_code before proposing a change; change files only with propose_edit (small edits) or write_file (new files) — the user may be asked to allow each change; run the program with run_program and read what it printed with read_output; see the running program with app_layout and app_screenshot and use it with app_click, app_type and app_key (the user sees a pointer do it). rapidr_describe and search_manual answer questions about RapidR. ask_rai asks RapidR's own assistant. Paths are relative to the project's folder."
   McpTimer.Interval = 250
   McpTimer.Enabled = 0
   McpTimer.OnTimer = McpTickTimer
@@ -585,7 +596,7 @@ END SUB
 FUNCTION McpSeeText AS STRING
   DIM nl AS STRING
   nl = CHR$(10)
-  Result = "What AI apps can see. With this on, an AI app that has your token can, through Studio: list and read the files of your open project (your code, forms and data files), and nothing outside the project or hidden in it; check code, look things up in RapidR's help, and propose changes (applied only as you choose above); run your program and read what it prints; read and ask RAI's chat. It never sees your AI provider keys or passwords (your keychain keeps them). RapidR sends none of this anywhere, but the AI app may pass what it reads to the company that makes it, under that company's terms. Many AI apps are for adults only: if you are under 18, set this up with a parent or teacher. Connect only AI apps you trust. Turn this off, or Reset Token, to disconnect every AI app."
+  Result = "What AI apps can see. With this on, an AI app that has your token can, through Studio: list and read the files of your open project (your code, forms and data files), and nothing outside the project or hidden in it; check code, look things up in RapidR's help, and propose changes (applied only as you choose above); run your program and read what it prints; see your running program's windows and click and type in them (shown by a pointer, never your real mouse or keyboard, never other apps); read and ask RAI's chat. It never sees your AI provider keys or passwords (your keychain keeps them). RapidR sends none of this anywhere, but the AI app may pass what it reads to the company that makes it, under that company's terms. Many AI apps are for adults only: if you are under 18, set this up with a parent or teacher. Connect only AI apps you trust. Turn this off, or Reset Token, to disconnect every AI app."
 END FUNCTION
 
 SUB McpStart
@@ -666,6 +677,8 @@ SUB McpSyncTools
   Mcp.AddTool "get_rai_transcript", "RAI's chat as the user sees it, as Markdown: its last Chars characters (8000 by default).", "[Chars AS INTEGER]", "read"
   Mcp.AddTool "get_rai_audit", "RAI's audit log: its last Count lines (30 by default) — each request to its provider, each tool, each change it proposed and what the user decided.", "[Count AS INTEGER]", "read"
   Mcp.AddTool "layout_report", "The program's forms as the source makes them: each form's client area, each component's place and size (Left, Top, Width, Height, or aligned), then what looks wrong — a control cut off by its form, two on top of each other, a caption too long for its button.", "", "read"
+  ' (mcpapp.inc: the running program's eyes and hands)
+  McpAppTools
