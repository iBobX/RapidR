DIM clicks AS INTEGER

SUB Greet
  clicks = clicks + 1
  Answer.Caption = "Hello! (" + STR$(clicks) + ")"
END SUB

CREATE Form AS RFORM
  Caption = "Greeter"
  Width = 280: Height = 140
  CREATE GreetButton AS RBUTTON
    Caption = "&Greet"
    Left = 16: Top = 16: Width = 90
    OnClick = Greet
  END CREATE
  CREATE Answer AS RLABEL
    Caption = "Press Greet."
    Left = 16: Top = 56: Width = 240
  END CREATE
END CREATE

Form.ShowModal
