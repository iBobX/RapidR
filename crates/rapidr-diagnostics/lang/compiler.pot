#. The word that labels a hint under a compiler message
msgctxt "hint.label"
msgid "hint"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.set"
msgid "RapidR has no SET: write x = 1 (the name, =, then the value)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.let"
msgid "RapidR has no LET: write x = 1 (the name, =, then the value)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.var"
msgid "a variable is declared with DIM name AS type (DIM total AS DOUBLE); a constant with CONST NAME = value"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.as-as"
msgid "a name takes one `AS type`: DIM ready AS INTEGER (not AS INTEGER AS INTEGER)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.for-foreign"
msgid "a counting loop is FOR i = 1 TO 10 … NEXT (STEP 2 to skip); RapidR has no `for … in range()`, `for (…;…;…)` or FOR EACH — to visit a list's items count them: FOR i = 0 TO List.ItemCount - 1"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.end-loop"
msgid "a FOR loop ends with NEXT, a WHILE with WEND, a DO with LOOP — not END FOR, END WHILE or END DO"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.endif"
msgid "it's END IF, two words"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.endword"
msgid "END SUB, END FUNCTION, END IF, END SELECT, END WITH, END TYPE and END CREATE are two words with a space"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.elseif"
msgid "it's ELSEIF, one word: IF … THEN … ELSEIF … THEN … ELSE … END IF"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.if-then"
msgid "IF needs THEN on the same line: IF a = 1 THEN … END IF"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.missing-next"
msgid "every FOR needs its NEXT: FOR i = 1 TO 3 … NEXT i"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.missing-wend"
msgid "every WHILE needs its WEND: WHILE a < 3 … WEND"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.missing-loop"
msgid "every DO needs its LOOP: DO … LOOP UNTIL a > 3"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.missing-end-if"
msgid "every block IF needs its END IF: IF a THEN, the lines, END IF (a one-line IF needs none)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.else-if"
msgid "ELSE IF starts a second IF that needs an END IF of its own: write ELSEIF, one word — IF … THEN … ELSEIF … THEN … ELSE … END IF"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.missing-end-select"
msgid "every SELECT CASE needs its END SELECT"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.and-and"
msgid "RapidR uses AND and OR: IF a > 0 AND b > 0 THEN (`&&` is `&`: it joins text and adds numbers, so such a test is never what you meant)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.else-line"
msgid "a one-line IF takes its ELSE on the same line (IF a THEN x ELSE y); for several lines write IF a THEN, the lines, ELSE, the lines, END IF"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.colon"
msgid "no `:` after IF, ELSE, FOR, WHILE or SUB: write IF a = 1 THEN, the statements on the lines below, then END IF"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.braces"
msgid "BASIC has no braces: a block ends with its own words — END SUB, END FUNCTION, END IF, NEXT, WEND, LOOP"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.semicolon"
msgid "statements end at the end of the line: no `;`"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.function"
msgid "a routine is SUB Name(a AS INTEGER) … END SUB, or FUNCTION Name(a AS INTEGER) AS INTEGER … Result = … END FUNCTION"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.return"
msgid "a FUNCTION gives its value with `Result = …` (or `FunctionName = …`); RETURN only goes back from a GOSUB"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.switch"
msgid "RapidR has no switch: write SELECT CASE x, CASE 1, CASE ELSE, END SELECT"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.break"
msgid "RapidR has no break: leave a loop with EXIT FOR, EXIT DO or EXIT WHILE"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.continue"
msgid "RapidR has no continue: put the rest of the loop inside IF … THEN … END IF"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.include"
msgid "to use another file write $INCLUDE \"file.rr\" at the top: RapidR has no #include or import"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.new"
msgid "components are made with CREATE Name AS RButton … END CREATE (or DIM Name AS RButton), not `new`"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.event"
msgid "an event takes a SUB's name: OnChange = ValueChanged — with DECLARE SUB ValueChanged at the top and SUB ValueChanged … END SUB below; leave the line out if nothing should happen"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.console-log"
msgid "use PRINT to write a line: PRINT \"hi\" (console.log is JavaScript); in a window, set a label's Caption"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.print"
msgid "to write a line: PRINT \"Total: \"; total (no brackets around the list); in a window, set a label's Caption instead"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.mod"
msgid "RapidR has no %: a remainder is MOD — 7 MOD 3 is 1 (a \\ b is whole division, a / b exact)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.compound"
msgid "the shortcuts are += -= *= /= &=; for any other write it out: x = x ^ 2, x = x \\ 2, x = x MOD 3"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.pow"
msgid "RapidR has no **: a power is ^ — 2 ^ 3 is 8"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.intdiv"
msgid "RapidR has no //: whole division is \\ — 7 \\ 2 is 3 (a / b gives decimals)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.ternary"
msgid "RapidR has no a ? b : c: write IF a THEN x = 1 ELSE x = 2, or x = IIF(a, 1, 2)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.ne"
msgid "`!=` isn't BASIC: \"not equal\" is `<>` — IF a <> b THEN"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.bang"
msgid "`!` isn't BASIC: \"not equal\" is `<>` (IF a <> b THEN), and \"is false\" is IF x = 0 THEN"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.or"
msgid "`||` isn't BASIC: use OR — IF a > 0 OR b > 0 THEN"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.brackets"
msgid "BASIC has no `[ ]`: an array is DIM names(3) AS STRING, filled one item at a time — names(1) = \"Ana\"; its items are names(i)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.squote"
msgid "text goes in double quotes — s = \"hello\" (a single quote starts a comment)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.comment"
msgid "a comment starts with ' (an apostrophe), not //"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.null"
msgid "BASIC has no null: use \"\" for an empty string, 0 for a number"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.bool"
msgid "truth values are numbers: 1 is true, 0 is false — DIM done AS INTEGER: done = 1, then IF done THEN (a .rr program's True is -1 while a check box's Checked is 1: don't compare with True)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.length"
msgid "a string's length is LEN(s); a list's items are .ItemCount"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.fn-str"
msgid "RapidR has no str(): text from a number is STR$(n) — PRINT \"n = \" + STR$(n)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.fn-tostring"
msgid "RapidR has no toString(): text from a number is STR$(n)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.fn-int"
msgid "RapidR has no int(): a number from text is VAL(s); INT(x) cuts the decimals of a number"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.fn-float"
msgid "RapidR has no float(): a number from text is VAL(s)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.fn-parseint"
msgid "RapidR has no parseInt(): a number from text is VAL(s)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.fn-parsefloat"
msgid "RapidR has no parseFloat(): a number from text is VAL(s)"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.fn-input"
msgid "RapidR has no input(): in a console program INPUT name; in a window an REdit, read its Text"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
msgctxt "hint.fn-prompt"
msgid "RapidR has no prompt(): ask with INPUTBOX$(\"Question\") or read an REdit's Text"
msgstr ""

#. A hint under a compiler message: what to write in RapidR instead (code stays as written)
