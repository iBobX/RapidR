#: crates/rapidr-ai/src/rai.rs
msgid "1 step"
msgstr "1 etapa"

#: crates/rapidr-ai/src/rai.rs
msgid "{n} steps"
msgstr "{n} etapas"

#: crates/rapidr-ai/src/rai.rs
msgid "show"
