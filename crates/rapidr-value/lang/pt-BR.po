msgstr "{name} lê ou escreve em uma porta de hardware, o que um programa não pode fazer em um sistema moderno"

#: crates/rapidr-value/src/runtime_text.rs
msgid "'{name}' is a function of a DLL ({base}): this program calls Windows itself, and the web can't load DLLs, so it runs on Windows only"
msgstr "'{name}' é uma função de uma DLL ({base}): este programa chama o Windows diretamente, e a web não pode carregar DLLs, então ele só roda no Windows"

#: crates/rapidr-value/src/runtime_text.rs
msgid "'{name}' is a Windows function ({base}): this program calls Windows itself, so it runs on Windows only"
msgstr "'{name}' é uma função do Windows ({base}): este programa chama o Windows diretamente, então só roda no Windows"

#: crates/rapidr-value/src/runtime_text.rs
msgid "'{name}' is a function of {base}.dll, a Windows DLL: this program calls a DLL, so it runs on Windows only"
msgstr "'{name}' é uma função de {base}.dll, uma DLL do Windows: este programa chama uma DLL, então só roda no Windows"

#: crates/rapidr-value/src/runtime_text.rs
msgid "this variable does not refer to an object (reading field {slot} of {what})"
msgstr "esta variável não se refere a um objeto (lendo o campo {slot} de {what})"

#: crates/rapidr-value/src/runtime_text.rs
msgid "this variable does not refer to an object (setting field {slot} of {what})"
msgstr "esta variável não se refere a um objeto (definindo o campo {slot} de {what})"

#: crates/rapidr-value/src/runtime_text.rs
msgid "out of memory for addresses (VARPTR)"
msgstr "sem memória para endereços (VARPTR)"

#: crates/rapidr-value/src/runtime_text.rs
msgid "address {addr} belongs to an array or TYPE that no longer exists"
msgstr "o endereço {addr} pertence a um array ou TYPE que não existe mais"

#: crates/rapidr-value/src/runtime_text.rs
msgid "address {addr} isn't memory of this program (use VARPTR of a variable, an array element, a TYPE, or a stream's Pointer)"
msgstr "o endereço {addr} não é memória deste programa (use VARPTR de uma variável, de um elemento de array, de um TYPE, ou o Pointer de um stream)"

#: crates/rapidr-value/src/runtime_text.rs
msgid "{n} bytes at address {addr} run past the end of its memory ({left} bytes left)"
msgstr "{n} bytes no endereço {addr} passam do fim da memória dele (restam {left} bytes)"

#: crates/rapidr-value/src/runtime_text.rs
msgid "a STRING isn't an address: use VARPTR(s$)"
msgstr "um STRING não é um endereço: use VARPTR(s$)"

#: crates/rapidr-value/src/runtime_text.rs
msgid "VARPTR of an element of something that isn't an array"
msgstr "VARPTR de um elemento de algo que não é um array"

#: crates/rapidr-value/src/runtime_text.rs
msgid "a negative byte count ({n})"
msgstr "uma contagem de bytes negativa ({n})"

#: crates/rapidr-value/src/runtime_text.rs
msgid "PEEK takes an address, or a page and an address"
msgstr "PEEK recebe um endereço, ou uma página e um endereço"

#: crates/rapidr-value/src/runtime_text.rs
msgid "POKE takes an address and a byte, or a page, an address and a byte"
msgstr "POKE recebe um endereço e um byte, ou uma página, um endereço e um byte"

#: crates/rapidr-value/src/runtime_text.rs
