#: crates/rapidr-ai/src/rai.rs
msgid "Copy"
msgstr "Copiar"

#: crates/rapidr-ai/src/rai.rs
msgid "Insert"
msgstr "Inserir"

#: crates/rapidr-ai/src/rai.rs
msgid "Thought for {secs} s"
msgstr "Pensou por {secs} s"

#: crates/rapidr-ai/src/rai.rs
msgid "An earlier draft said this was done before it was — Studio asked it to actually do it."
msgstr "Um rascunho anterior dizia que isto estava feito antes de estar — o Studio pediu que ele realmente o fizesse."

#: crates/rapidr-ai/src/rai.rs
msgid "Choose an AI provider first (Provider)."
msgstr "Escolha antes um provedor de IA (Provider)."

# legal
#: crates/rapidr-ai/src/rai.rs
msgid "There is no {provider} API key yet: give one (APIKey), or say where it is kept (APIKeySource)."
msgstr "Ainda não há chave de API de {provider}: informe uma (APIKey), ou diga onde ela fica guardada (APIKeySource)."

#: crates/rapidr-ai/src/rai.rs
msgid "Continuing (part {n})"
msgstr "Continuando (parte {n})"

#: crates/rapidr-ai/src/rai.rs
msgid "Fixing the errors"
msgstr "Corrigindo os erros"

#: crates/rapidr-ai/src/rai.rs
msgid "Fixing 1 problem"
msgstr "Corrigindo 1 problema"

#: crates/rapidr-ai/src/rai.rs
msgid "Fixing {n} problems"
msgstr "Corrigindo {n} problemas"

#: crates/rapidr-ai/src/rai.rs
msgid "Thinking"
msgstr "Pensando"

#: crates/rapidr-ai/src/rai.rs
msgid "Writing the answer"
msgstr "Escrevendo a resposta"

#: crates/rapidr-ai/src/rai.rs
msgid "Using {name}"
msgstr "Usando {name}"

#: crates/rapidr-ai/src/rai.rs
msgid "Still answering: wait for it, or Stop."
msgstr "Ainda respondendo: espere ou use Parar."

#: crates/rapidr-ai/src/rai.rs
msgid "There is no question {n} in this chat."
msgstr "Não há pergunta {n} neste chat."

#: crates/rapidr-ai/src/rai.rs
msgid "That question is from before the chat was compacted: it can't be edited. Ask it again as a new question."
msgstr "Essa pergunta é de antes de o chat ser compactado: não pode ser editada. Faça-a de novo como uma nova pergunta."

#: crates/rapidr-ai/src/rai.rs
msgid "Nothing to compact yet: the chat is still short."
msgstr "Nada a compactar ainda: o chat ainda é curto."

#: crates/rapidr-ai/src/rai.rs
msgid "Choose a model first (RefreshModels lists the provider's)."
msgstr "Escolha antes um modelo (RefreshModels lista os do provedor)."

#: crates/rapidr-ai/src/rai.rs
msgid "You"
msgstr "Você"

#: crates/rapidr-ai/src/rai.rs
msgid "Edit"
msgstr "Editar"

#: crates/rapidr-ai/src/rai.rs
msgid "Assistant"
msgstr "Assistente"

#: crates/rapidr-ai/src/rai.rs
msgid "Retry"
msgstr "Tentar de novo"

#: crates/rapidr-ai/src/rai.rs
msgid "Asking the server about the model"
msgstr "Perguntando ao servidor sobre o modelo"

#: crates/rapidr-ai/src/rai.rs
msgid "Compacting the conversation"
msgstr "Compactando a conversa"

#: crates/rapidr-ai/src/rai.rs
msgid "Summarising the chat to keep it short"
msgstr "Resumindo o chat para mantê-lo curto"

#: crates/rapidr-ai/src/rai.rs
msgid "Answering…"
msgstr "Respondendo…"

#: crates/rapidr-ai/src/rai.rs
msgid "This model takes {window} tokens at once (its context window, as the server runs it now), fewer than the instructions and tools alone need (about {need}). Choose a model or a server setting with a larger window: 16,384 tokens or more."
msgstr "Este modelo aceita {window} tokens de uma vez (a janela de contexto dele, como o servidor o executa agora), menos do que só as instruções e as ferramentas precisam (cerca de {need}). Escolha um modelo ou uma configuração do servidor com uma janela maior: 16.384 tokens ou mais."

#: crates/rapidr-ai/src/rai.rs
msgid "Type a question or a request first."
msgstr "Digite antes uma pergunta ou um pedido."

#: crates/rapidr-ai/src/rai.rs
msgid "Still answering: wait for it, or Cancel."
msgstr "Ainda respondendo: espere ou use Cancelar."

#: crates/rapidr-ai/src/rai.rs
msgid "Asking {provider} for its models…"
msgstr "Pedindo os modelos a {provider}…"

#: crates/rapidr-ai/src/rai.rs
msgid "Stopped."
msgstr "Parado."

#: crates/rapidr-ai/src/rai.rs
msgid "Error: {message}"
msgstr "Erro: {message}"

#: crates/rapidr-ai/src/rai.rs
msgid "This model takes no effort setting: it answers as it usually does."
msgstr "Este modelo não aceita ajuste de esforço: ele responde como costuma."

#: crates/rapidr-ai/src/rai.rs
msgid "This model can't think at an effort while it uses tools here: it answers without one."
msgstr "Este modelo não consegue pensar com um esforço enquanto usa ferramentas aqui: ele responde sem isso."

#: crates/rapidr-ai/src/rai.rs
msgid "{provider} lists {n} models."
msgstr "{provider} lista {n} modelos."

#: crates/rapidr-ai/src/rai.rs
msgid "{provider} answered, but not with a models list: {error}."
msgstr "{provider} respondeu, mas não com uma lista de modelos: {error}."

#: crates/rapidr-ai/src/rai.rs
msgid "The chat was compacted: what each question sends of it went from about {before} tokens to about {after}."
msgstr "O chat foi compactado: o que cada pergunta envia dele passou de cerca de {before} tokens para cerca de {after}."

#: crates/rapidr-ai/src/rai.rs
msgid "The conversation so far was summarised, to keep each question cheap."
msgstr "A conversa até agora foi resumida, para manter cada pergunta barata."

#: crates/rapidr-ai/src/rai.rs
msgid "Done."
msgstr "Pronto."

#: crates/rapidr-ai/src/rai.rs
msgid "The chat wasn't compacted: the model gave no summary."
msgstr "O chat não foi compactado: o modelo não deu nenhum resumo."

#: crates/rapidr-ai/src/rai.rs
msgid "{provider} stopped answering: {error}"
msgstr "{provider} parou de responder: {error}"

#: crates/rapidr-ai/src/rai.rs
msgid "Asked the model to make the change it described"
msgstr "Pediu ao modelo que fizesse a alteração que ele descreveu"

#: crates/rapidr-ai/src/rai.rs
msgid "Continue in smaller steps"
msgstr "Continue em etapas menores"

#: crates/rapidr-ai/src/rai.rs
msgid "RAI stopped here: the answer kept reaching its length limit ({tokens} tokens), {parts} parts in a row. What it finished is above."
msgstr "A RAI parou aqui: a resposta continuou chegando ao limite de tamanho ({tokens} tokens), {parts} partes seguidas. O que ela concluiu está acima."

#: crates/rapidr-ai/src/rai.rs
msgid "The model declined to answer this."
msgstr "O modelo se recusou a responder isto."

#: crates/rapidr-ai/src/rai.rs
msgid "Answer was long: continuing (part {part} of up to {parts})"
msgstr "A resposta ficou longa: continuando (parte {part} de até {parts})"

#: crates/rapidr-ai/src/rai.rs
msgid "Continued after the length limit ({n} of {max})"
msgstr "Continuou após o limite de tamanho ({n} de {max})"

#: crates/rapidr-ai/src/rai.rs
msgid "Continuing (part {n})…"
msgstr "Continuando (parte {n})…"

#: crates/rapidr-ai/src/rai.rs
msgid "The assistant didn't make the change you asked for. Ask again, or try a larger model."
msgstr "O assistente não fez a alteração que você pediu. Peça de novo, ou tente um modelo maior."

#: crates/rapidr-ai/src/rai.rs
msgid "Answered."
msgstr "Respondido."

#: crates/rapidr-ai/src/rai.rs
msgid "Summarising the conversation, to keep it cheap…"
msgstr "Resumindo a conversa, para mantê-la barata…"

