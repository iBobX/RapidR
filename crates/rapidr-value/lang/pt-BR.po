msgstr "nesta aba do navegador, até ela fechar"

#: crates/rapidr-ai/src/rai.rs
msgid "this browser, on this device"
msgstr "neste navegador, neste dispositivo"

#: crates/rapidr-ai/src/rai.rs
msgid "memory, until the program ends (this computer has no keychain RapidR can use)"
msgstr "na memória, até o programa terminar (este computador não tem um chaveiro que o RapidR possa usar)"

