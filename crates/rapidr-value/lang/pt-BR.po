msgid "The key is forgotten."
msgstr "A chave foi esquecida."

#: crates/rapidr-ai/src/rai.rs
msgid "the macOS Keychain"
msgstr "no Acesso às Chaves do macOS"

#: crates/rapidr-ai/src/rai.rs
msgid "Windows Credential Manager"
msgstr "no Gerenciador de Credenciais do Windows"

