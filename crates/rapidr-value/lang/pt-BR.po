msgid "an environment variable"
msgstr "em uma variável de ambiente"

#: crates/rapidr-ai/src/wire.rs
msgid "({name} says: \"{said}\")"
msgstr "({name} diz: \"{said}\")"

#: crates/rapidr-ai/src/wire.rs
msgid "This Anthropic key isn't made inside a workspace, so Anthropic needs to know which workspace to use: fill in the Workspace ID (the Claude Console lists your workspaces), or make a key inside a workspace."
msgstr "Esta chave da Anthropic não foi criada dentro de um workspace, então a Anthropic precisa saber qual workspace usar: preencha o ID do workspace (o Claude Console lista os seus workspaces), ou crie uma chave dentro de um workspace."

# legal
#: crates/rapidr-ai/src/wire.rs
msgid "Your {name} account has no credit left for this key{quoted}. Add credit on {name}'s website; RapidR can't do it for you."
msgstr "Sua conta de {name} não tem mais crédito para esta chave{quoted}. Adicione crédito no site de {name}; o RapidR não pode fazer isso por você."

#: crates/rapidr-ai/src/wire.rs
msgid "{name} refused the API key (401){quoted}. Check the key: it may be mistyped, revoked, or a key of another provider."
msgstr "{name} recusou a chave de API (401){quoted}. Verifique a chave: ela pode estar digitada errado, revogada ou ser de outro provedor."

#: crates/rapidr-ai/src/wire.rs
msgid "{name} doesn't let this key do that (403){quoted}."
msgstr "{name} não deixa esta chave fazer isso (403){quoted}."

#: crates/rapidr-ai/src/wire.rs
msgid "{name} is short of memory for this conversation{quoted}. Wait for the model to finish what it is doing, close other apps, start a new chat (it sends less), or choose a smaller model."
msgstr "{name} está sem memória para esta conversa{quoted}. Espere o modelo terminar o que está fazendo, feche outros apps, inicie um novo chat (ele envia menos) ou escolha um modelo menor."

#: crates/rapidr-ai/src/wire.rs
msgid "The conversation is too long for this model{quoted}. Start a new chat, or pick a model that takes more."
msgstr "A conversa é longa demais para este modelo{quoted}. Inicie um novo chat, ou escolha um modelo que aceite mais."

#: crates/rapidr-ai/src/wire.rs
msgid "this model isn't available to your key (404){quoted}. List the provider's models again and pick one of them."
msgstr "este modelo não está disponível para a sua chave (404){quoted}. Liste de novo os modelos do provedor e escolha um deles."

#: crates/rapidr-ai/src/wire.rs
msgid "The model \"{model}\" isn't available to your key (404){quoted}. List the provider's models again and pick one of them."
msgstr "O modelo \"{model}\" não está disponível para a sua chave (404){quoted}. Liste de novo os modelos do provedor e escolha um deles."

#: crates/rapidr-ai/src/wire.rs
msgid "{name} is limiting how often this key asks (429): wait {n} seconds and try again."
msgstr "{name} está limitando a frequência com que esta chave pede (429): espere {n} segundos e tente de novo."

#: crates/rapidr-ai/src/wire.rs
msgid "{name} is limiting how often this key asks (429): wait a minute and try again."
msgstr "{name} está limitando a frequência com que esta chave pede (429): espere um minuto e tente de novo."

# legal
#: crates/rapidr-ai/src/wire.rs
msgid "{name} sent the request on to another address ({status}): RapidR doesn't follow it with your key. If you trust that address, set the base URL to it."
msgstr "{name} redirecionou o pedido para outro endereço ({status}): o RapidR não o segue com a sua chave. Se você confia nesse endereço, defina a URL base para ele."

#: crates/rapidr-ai/src/wire.rs
msgid "{name} is overloaded or having trouble ({status}){quoted}. Try again in a minute."
msgstr "{name} está sobrecarregado ou com problemas ({status}){quoted}. Tente de novo em um minuto."

#: crates/rapidr-ai/src/wire.rs
msgid "{name} refused the request ({status}){quoted}."
msgstr "{name} recusou o pedido ({status}){quoted}."

#: crates/rapidr-ai/src/wire.rs
msgid "The server at {host} began answering, then sent nothing more ({what}): a model on this computer writing a long change, or short of memory, can be that slow. Try again, ask for a smaller step, or choose a smaller model."
msgstr "O servidor em {host} começou a responder, mas depois não enviou mais nada ({what}): um modelo neste computador escrevendo uma alteração longa, ou com pouca memória, pode ser assim tão lento. Tente de novo, peça um passo menor ou escolha um modelo menor."

#: crates/rapidr-ai/src/wire.rs
msgid "Couldn't reach {host}: {what}. Is the local server running (Ollama, LM Studio)? On the web, Ollama also needs OLLAMA_ORIGINS to allow this page."
msgstr "Não foi possível alcançar {host}: {what}. O servidor local está em execução (Ollama, LM Studio)? Na web, o Ollama também precisa de OLLAMA_ORIGINS para permitir esta página."

#: crates/rapidr-ai/src/wire.rs
msgid "Couldn't reach {host}: {what}. Try again in a moment, and check the internet connection."
msgstr "Não foi possível alcançar {host}: {what}. Tente de novo daqui a pouco e verifique a conexão com a internet."

#: crates/rapidr-ai/src/wire.rs
msgid "Couldn't reach {host}: {what}. Check the internet connection."
msgstr "Não foi possível alcançar {host}: {what}. Verifique a conexão com a internet."

