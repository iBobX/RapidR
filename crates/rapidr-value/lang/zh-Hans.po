#: crates/rapidr-value/src/panels/toolbox.rs
msgid "Templates"
msgstr "模板"

#: crates/rapidr-value/src/panels/toolbox.rs
msgid "(desktop only)"
msgstr "（仅限桌面）"

#: crates/rapidr-value/src/panels/toolbox.rs
msgid "(web only)"
msgstr "（仅限 Web）"

#: crates/rapidr-value/src/panels/toolbox.rs
msgid "Click or double-click: Project > Add Form, a new form file of the program; dragged onto an RFormMDI: one of its child windows."
msgstr "点击或双击：项目 > 添加窗体，即程序的一个新窗体文件；拖到 RFormMDI 上：它的一个子窗口。"

#: crates/rapidr-value/src/panels/toolbox.rs
msgid "Click or double-click: a new MDI main window file of the program."
msgstr "点击或双击：程序的一个新 MDI 主窗口文件。"

#: crates/rapidr-value/src/runtime_text.rs
msgid "Division by zero"
msgstr "除以零"

#: crates/rapidr-value/src/runtime_text.rs
msgid "{name}: bits {from} to {to} are outside the value's {width} bits"
msgstr "{name}：第 {from} 到 {to} 位超出了该值的 {width} 位范围"

#: crates/rapidr-value/src/runtime_text.rs
msgid "WriteInteger keeps 32 bits (a REG_DWORD): {n} doesn't fit — WriteString(name, STR$(n)) keeps it whole"
msgstr "WriteInteger 只保留 32 位（REG_DWORD）：{n} 放不下——用 WriteString(name, STR$(n)) 可以完整保存"

#: crates/rapidr-value/src/runtime_text.rs
msgid "Subscript out of range: index {i} is outside {lo} TO {hi}"
msgstr "下标超出范围：索引 {i} 不在 {lo} TO {hi} 之内"

#: crates/rapidr-value/src/runtime_text.rs
msgid "Out of DATA: READ found no more DATA items"
msgstr "DATA 已用完：READ 找不到更多的 DATA 项"

#: crates/rapidr-value/src/runtime_text.rs
msgid "indexing a value that is not an array"
msgstr "对不是数组的值使用了索引"

#: crates/rapidr-value/src/runtime_text.rs
msgid "assigning to an element of a variable that is not an array (DIM it with a size first)"
msgstr "给不是数组的变量的元素赋值（请先用 DIM 指定大小）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "stack overflow: more than {n} nested calls (a SUB or FUNCTION calling itself without end?)"
msgstr "堆栈溢出：嵌套调用超过 {n} 层（是不是某个 SUB 或 FUNCTION 在无休止地调用自己？）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "arrays have at most {n} dimensions"
msgstr "数组最多有 {n} 个维度"

#: crates/rapidr-value/src/runtime_text.rs
msgid "string too long: strings are limited to {n} characters"
msgstr "字符串太长：字符串最多 {n} 个字符"

#: crates/rapidr-value/src/runtime_text.rs
msgid "this variable does not refer to an object (reading a field of {what})"
msgstr "这个变量没有引用任何对象（正在读取 {what} 的字段）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "this variable does not refer to an object (setting a field of {what})"
msgstr "这个变量没有引用任何对象（正在设置 {what} 的字段）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "CALLFUNC: {ptr} is not a function pointer (use BIND or CODEPTR)"
msgstr "CALLFUNC：{ptr} 不是函数指针（请使用 BIND 或 CODEPTR）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "Unknown builtin function '{name}'"
msgstr "未知的内置函数 '{name}'"

#: crates/rapidr-value/src/runtime_text.rs
msgid "the evaluation ran too long and was stopped"
msgstr "计算运行时间过长，已被停止"

#: crates/rapidr-value/src/runtime_text.rs
msgid "END can't run in an evaluation"
msgstr "END 不能在计算中运行"

#: crates/rapidr-value/src/runtime_text.rs
msgid "the evaluation ended the program"
msgstr "这次计算结束了程序"

#: crates/rapidr-value/src/runtime_text.rs
msgid "the evaluation would wait (a dialog or a form): not while the program is stopped"
msgstr "这次计算需要等待（对话框或窗体）：程序停止期间不能这样做"

#: crates/rapidr-value/src/runtime_text.rs
msgid "too many event arguments"
msgstr "事件参数太多"

#: crates/rapidr-value/src/runtime_text.rs
msgid "no frame {i}"
msgstr "没有栈帧 {i}"

#: crates/rapidr-value/src/runtime_text.rs
msgid "{what}({n}): strings are limited to {max} characters"
msgstr "{what}({n})：字符串最多 {max} 个字符"

#: crates/rapidr-value/src/runtime_text.rs
msgid "{what} ran inside itself {n} times: its handler fires it again before it ends"
msgstr "{what} 在自己内部运行了 {n} 次：它的事件处理程序在结束之前又触发了它"

#: crates/rapidr-value/src/runtime_text.rs
msgid "events ran inside each other {n} deep (the last: {what}): their handlers fire events before they end"
msgstr "事件相互嵌套运行了 {n} 层（最后一个：{what}）：它们的事件处理程序在结束之前又触发了事件"

#: crates/rapidr-value/src/runtime_text.rs
msgid "{name} reads or writes a hardware port, which a program can't do on a modern system"
msgstr "{name} 会读写硬件端口，而在现代系统上，程序无法这样做"

#: crates/rapidr-value/src/runtime_text.rs
msgid "'{name}' is a function of a DLL ({base}): this program calls Windows itself, and the web can't load DLLs, so it runs on Windows only"
msgstr "'{name}' 是 DLL ({base}) 中的函数：这个程序直接调用 Windows，而 Web 无法加载 DLL，所以它只能在 Windows 上运行"

#: crates/rapidr-value/src/runtime_text.rs
msgid "'{name}' is a Windows function ({base}): this program calls Windows itself, so it runs on Windows only"
msgstr "'{name}' 是 Windows 函数 ({base})：这个程序直接调用 Windows，所以它只能在 Windows 上运行"

#: crates/rapidr-value/src/runtime_text.rs
msgid "'{name}' is a function of {base}.dll, a Windows DLL: this program calls a DLL, so it runs on Windows only"
msgstr "'{name}' 是 {base}.dll（一个 Windows DLL）中的函数：这个程序调用了 DLL，所以它只能在 Windows 上运行"

#: crates/rapidr-value/src/runtime_text.rs
msgid "this variable does not refer to an object (reading field {slot} of {what})"
msgstr "这个变量没有引用任何对象（正在读取 {what} 的字段 {slot}）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "this variable does not refer to an object (setting field {slot} of {what})"
msgstr "这个变量没有引用任何对象（正在设置 {what} 的字段 {slot}）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "out of memory for addresses (VARPTR)"
msgstr "地址的内存不足 (VARPTR)"

#: crates/rapidr-value/src/runtime_text.rs
msgid "address {addr} belongs to an array or TYPE that no longer exists"
msgstr "地址 {addr} 属于一个已不存在的数组或 TYPE"

#: crates/rapidr-value/src/runtime_text.rs
msgid "address {addr} isn't memory of this program (use VARPTR of a variable, an array element, a TYPE, or a stream's Pointer)"
msgstr "地址 {addr} 不是这个程序的内存（请使用变量、数组元素、TYPE 的 VARPTR，或流的 Pointer）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "{n} bytes at address {addr} run past the end of its memory ({left} bytes left)"
msgstr "地址 {addr} 处的 {n} 个字节超出了其内存的末尾（还剩 {left} 个字节）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "a STRING isn't an address: use VARPTR(s$)"
msgstr "STRING 不是地址：请使用 VARPTR(s$)"

#: crates/rapidr-value/src/runtime_text.rs
msgid "VARPTR of an element of something that isn't an array"
msgstr "对不是数组的东西的元素使用了 VARPTR"

#: crates/rapidr-value/src/runtime_text.rs
msgid "a negative byte count ({n})"
msgstr "字节数为负数（{n}）"

#: crates/rapidr-value/src/runtime_text.rs
msgid "PEEK takes an address, or a page and an address"
msgstr "PEEK 需要一个地址，或一个页和一个地址"

#: crates/rapidr-value/src/runtime_text.rs
msgid "POKE takes an address and a byte, or a page, an address and a byte"
msgstr "POKE 需要一个地址和一个字节，或一个页、一个地址和一个字节"

#: crates/rapidr-value/src/runtime_text.rs
msgid "Cannot open file {path}."
msgstr "无法打开文件 {path}。"

#: crates/rapidr-value/src/runtime_text.rs
msgid "Cannot create file {path}."
msgstr "无法创建文件 {path}。"

#: crates/rapidr-value/src/runtime_text.rs
msgid "{what}: argument is not an array, or it has no dimension {d}"
msgstr "{what}：参数不是数组，或没有第 {d} 维"

#: crates/rapidr-value/src/runtime_text.rs
msgid "Waiting for events"
msgstr "正在等待事件"

#: crates/rapidr-value/src/runtime_text.rs
msgid "run-time error: {message}"
msgstr "运行时错误：{message}"

#: crates/rapidr-value/src/runtime_text.rs
msgid "The breakpoint's condition `{cond}` failed: {error}"
msgstr "断点的条件 `{cond}` 失败了：{error}"

#: crates/rapidr-value/src/runtime_text.rs
msgid "(at {file} line {n})"
msgstr "（位于 {file} 第 {n} 行）"
